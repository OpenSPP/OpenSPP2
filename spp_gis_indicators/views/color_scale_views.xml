<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- List View -->
    <record id="view_gis_color_scale_tree" model="ir.ui.view">
        <field name="name">spp.gis.color.scale.tree</field>
        <field name="model">spp.gis.color.scale</field>
        <field name="arch" type="xml">
            <list string="Color Scales">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="scale_type" />
                <field name="description" />
                <field name="active" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_gis_color_scale_form" model="ir.ui.view">
        <field name="name">spp.gis.color.scale.form</field>
        <field name="model">spp.gis.color.scale</field>
        <field name="arch" type="xml">
            <form string="Color Scale">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget
                            name="web_ribbon"
                            title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"
                        />
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="scale_type" />
                            <field name="sequence" />
                            <field name="active" invisible="1" />
                        </group>
                        <separator string="Description" />
                        <field name="description" nolabel="1" class="oe_inline" />
                    </group>
                    <group string="Colors">
                        <field name="colors_json" widget="text" />
                    </group>
                    <group string="Preview" name="preview">
                        <div class="o_color_scale_preview">
                            <p class="text-muted">
                                Enter colors as JSON array of hex codes, e.g.:
                                <br />
                                <code
                            >["#f7fbff", "#deebf7", "#c6dbef", "#9ecae1", "#6baed6"]</code>
                            </p>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_gis_color_scale_search" model="ir.ui.view">
        <field name="name">spp.gis.color.scale.search</field>
        <field name="model">spp.gis.color.scale</field>
        <field name="arch" type="xml">
            <search string="Color Scales">
                <field name="name" />
                <field name="scale_type" />
                <separator />
                <filter
                    string="Active"
                    name="active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Archived"
                    name="archived"
                    domain="[('active', '=', False)]"
                />
                <separator />
                <group>
                    <filter
                        string="Scale Type"
                        name="group_by_scale_type"
                        context="{'group_by': 'scale_type'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_gis_color_scale" model="ir.actions.act_window">
        <field name="name">Color Scales</field>
        <field name="path">gis-color-scales</field>
        <field name="res_model">spp.gis.color.scale</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new color scale
            </p>
            <p>
                Color scales define how data values are mapped to colors in choropleth visualizations.
                Several preset scales are provided based on ColorBrewer schemes.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem
        id="menu_gis_color_scale"
        name="Color Scales"
        parent="menu_gis_config_root"
        action="action_gis_color_scale"
        sequence="20"
    />
</odoo>
