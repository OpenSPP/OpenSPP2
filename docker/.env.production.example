# OpenSPP Production Environment Configuration
#
# Copy this file to .env.production and configure for your deployment:
#   cp docker/.env.production.example docker/.env.production
#
# SECURITY: Never commit .env.production to version control!

# =============================================================================
# COMPOSE PROFILE - Choose deployment mode
# =============================================================================
# Nginx mode (choose one):
#   https = Nginx with SSL + Certbot (production)
#   http  = Nginx HTTP only, no SSL (dev / isolated on-premises)
# Optional add-ons (comma-separated):
#   clamav = ClamAV antivirus scanning (adds ~1GB RAM)
#
# Examples:
#   COMPOSE_PROFILES=https            # HTTPS only
#   COMPOSE_PROFILES=https,clamav     # HTTPS + antivirus
#   COMPOSE_PROFILES=http             # HTTP only (dev)
COMPOSE_PROFILES=https

# =============================================================================
# REQUIRED - You must set these values
# =============================================================================

# Domain name for your OpenSPP instance
DOMAIN=openspp.example.org

# Email for Let's Encrypt SSL certificate notifications
ACME_EMAIL=admin@example.org

# Database password (use a strong, random password)
# If using strict mode with a separate DB_ADMIN_USER, set the Odoo user password
# in docker/initdb/01-create-roles.sql to match DB_PASSWORD (or adjust accordingly).
# Generate with: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Odoo admin/master password (for database management)
# Generate with: openssl rand -base64 32
ODOO_ADMIN_PASSWD=CHANGE_ME_ADMIN_PASSWORD_HERE

# =============================================================================
# DATABASE - Local PostgreSQL or External (RDS/Cloud SQL)
# =============================================================================

# Option 1: Local PostgreSQL (default)
# Uses the db service defined in docker-compose.production.yml
DB_HOST=db
DB_PORT=5432
# DB_ADMIN_USER is created as a superuser by the database container on first init.
# Option A (strict): set DB_ADMIN_USER to an admin role and create DB_USER via init scripts.
# Option B (flexible): set DB_ADMIN_USER=DB_USER (default).
DB_ADMIN_USER=odoo
DB_USER=odoo
DB_NAME=openspp

# Option 2: External Database (RDS, Cloud SQL, etc.)
# Uncomment DATABASE_URL and comment out the db service in compose file
# DATABASE_URL=postgres://user:password@hostname:5432/openspp?sslmode=require

# SSL mode for database connection
# Options: disable, allow, prefer, require, verify-ca, verify-full
DB_SSLMODE=prefer

# =============================================================================
# PERFORMANCE - Adjust based on your VPS size
# =============================================================================

# Sizing Guide:
#   10k beneficiaries:  4 vCPU / 8GB  -> WORKERS=2, ODOO_MEMORY=4G, DB_MEMORY=3G
#   50k beneficiaries:  4 vCPU / 16GB -> WORKERS=4, ODOO_MEMORY=8G, DB_MEMORY=6G
#   100k beneficiaries: 8 vCPU / 32GB -> WORKERS=6, ODOO_MEMORY=12G, DB_MEMORY=16G

# Number of Odoo workers (rule: (CPU cores * 2) + 1; ~1 worker per 6 concurrent users)
ODOO_WORKERS=2

# CPU limits (number of cores)
ODOO_CPU_LIMIT=2
DB_CPU_LIMIT=2
QUEUE_CPU_LIMIT=1
NGINX_CPU_LIMIT=1

# Memory limits (Docker format: 512M, 1G, 2G, etc.)
ODOO_MEMORY_LIMIT=4G
ODOO_MEMORY_RESERVATION=2G
DB_MEMORY_LIMIT=4G
DB_MEMORY_RESERVATION=2G
QUEUE_MEMORY_LIMIT=2G
QUEUE_MEMORY_RESERVATION=1G
NGINX_MEMORY_LIMIT=256M
NGINX_MEMORY_RESERVATION=64M

# Per-worker memory limits (in bytes)
# Soft: worker recycled when exceeded
# Hard: worker killed when exceeded
ODOO_MEMORY_SOFT=2147483648
ODOO_MEMORY_HARD=2684354560

# Request timeouts (seconds)
ODOO_TIME_CPU=600
ODOO_TIME_REAL=1200

# =============================================================================
# MODULES - Initial installation
# =============================================================================

# Modules to install on first boot
# Examples:
#   spp_base                  - Minimal installation
#   spp_mis_demo_v2           - Full MIS demo
#   spp_drims_sl_demo         - DRIMS Sierra Leone demo
ODOO_INIT_MODULES=spp_base

# =============================================================================
# EMAIL (Optional)
# =============================================================================

# SMTP server for outgoing emails
# SMTP_SERVER=smtp.example.org
# SMTP_PORT=587
# SMTP_SSL=True
# SMTP_USER=notifications@example.org
# SMTP_PASSWORD=smtp_password_here
# EMAIL_FROM=OpenSPP <notifications@example.org>

# =============================================================================
# LOGGING
# =============================================================================

# Log level: debug, info, warn, error, critical
LOG_LEVEL=warn

# Fluentd log output path (Nginx stack only)
# Host path where Fluentd writes collected logs when using the local/file backend.
# Can be a local directory, an NFS mount, or any writable path on the host.
# Not needed when using cloud backends (S3, GCS, Azure, MinIO).
# Default: ./fluentd/log (relative to docker/ directory)
FLUENTD_LOG_PATH=./fluentd/log

# =============================================================================
# BACKUPS
# =============================================================================

# Backup schedule (cron format)
# Default: daily at 2am
BACKUP_SCHEDULE=0 2 * * *

# =============================================================================
# ANTIVIRUS (enable with COMPOSE_PROFILES=https,clamav)
# =============================================================================

# ClamAV needs ~1GB RAM for virus definitions.
# After enabling, install spp_attachment_av_scan module in Odoo.
CLAMAV_MEMORY_LIMIT=1536M
CLAMAV_MEMORY_RESERVATION=512M

# =============================================================================
# DOCKER IMAGE
# =============================================================================

# Use pre-built image or build locally
# For production, use a specific version tag
# OPENSPP_IMAGE=ghcr.io/openspp/openspp:v2.0.0
OPENSPP_IMAGE=ghcr.io/openspp/openspp:latest
