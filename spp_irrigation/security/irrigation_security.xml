<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Irrigation Groups -->
    <record id="group_irrigation_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_irrigation"/>
        <field name="comment">Full irrigation management including all CRUD operations.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <!-- Link manager group to admin -->
    <record id="spp_security.group_spp_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_irrigation_manager'))]"/>
    </record>
</odoo>
