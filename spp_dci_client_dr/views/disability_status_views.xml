<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_disability_status_tree" model="ir.ui.view">
        <field name="name">spp.dci.disability.status.tree</field>
        <field name="model">spp.dci.disability.status</field>
        <field name="arch" type="xml">
            <list string="Disability Status">
                <field name="partner_id" />
                <field name="has_disability" />
                <field name="disability_types" optional="show" />
                <field name="assessment_date" optional="show" />
                <field name="source_registry" optional="hide" />
                <field
                    name="state"
                    decoration-success="state == 'synced'"
                    decoration-warning="state == 'stale'"
                    decoration-danger="state == 'error'"
                    widget="badge"
                />
                <field name="last_sync_date" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_disability_status_form" model="ir.ui.view">
        <field name="name">spp.dci.disability.status.form</field>
        <field name="model">spp.dci.disability.status</field>
        <field name="arch" type="xml">
            <form string="Disability Status">
                <header>
                    <button
                        name="refresh_from_dr"
                        string="Refresh from DR"
                        type="object"
                        class="oe_highlight"
                        invisible="state == 'error'"
                    />
                    <button
                        name="action_retry_sync"
                        string="Retry Sync"
                        type="object"
                        class="btn-warning"
                        invisible="state != 'error'"
                    />
                    <button
                        name="action_mark_outdated"
                        string="Mark as Stale"
                        type="object"
                        invisible="state != 'synced'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="synced" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="toggle_active"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-archive"
                        >
                            <field
                                name="active"
                                widget="boolean_button"
                                options="{&quot;terminology&quot;: &quot;archive&quot;}"
                            />
                        </button>
                    </div>
                    <group>
                        <group name="person_info">
                            <field
                                name="partner_id"
                                options="{'no_create': True, 'no_open': True}"
                            />
                            <field name="has_disability" />
                            <field name="source_registry" />
                        </group>
                        <group name="sync_info">
                            <field name="last_sync_date" />
                            <field name="synced_by" />
                            <field name="assessment_date" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Disability Information" name="disability_info">
                            <group>
                                <field name="disability_types" />
                                <field name="functional_scores" />
                            </group>
                        </page>
                        <page string="Raw Data" name="raw_data">
                            <field
                                name="raw_data"
                                widget="ace"
                                options="{'mode': 'javascript'}"
                            />
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..." />
                        </page>
                        <page
                            string="Error Details"
                            name="error_details"
                            invisible="not error_message"
                        >
                            <field name="error_message" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_disability_status_search" model="ir.ui.view">
        <field name="name">spp.dci.disability.status.search</field>
        <field name="model">spp.dci.disability.status</field>
        <field name="arch" type="xml">
            <search string="Disability Status">
                <field name="partner_id" />
                <field name="source_registry" />
                <separator />
                <filter
                    string="PWD"
                    name="filter_pwd"
                    domain="[('has_disability', '=', True)]"
                />
                <filter
                    string="Non-PWD"
                    name="filter_non_pwd"
                    domain="[('has_disability', '=', False)]"
                />
                <separator />
                <filter
                    string="Synced"
                    name="filter_synced"
                    domain="[('state', '=', 'synced')]"
                />
                <filter
                    string="Stale"
                    name="filter_stale"
                    domain="[('state', '=', 'stale')]"
                />
                <filter
                    string="Error"
                    name="filter_error"
                    domain="[('state', '=', 'error')]"
                />
                <separator />
                <filter
                    string="Archived"
                    name="filter_inactive"
                    domain="[('active', '=', False)]"
                />
                <separator />
                <filter
                    string="Status"
                    name="group_state"
                    context="{'group_by': 'state'}"
                />
                <filter
                    string="Has Disability"
                    name="group_has_disability"
                    context="{'group_by': 'has_disability'}"
                />
                <filter
                    string="Source Registry"
                    name="group_source_registry"
                    context="{'group_by': 'source_registry'}"
                />
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_disability_status" model="ir.actions.act_window">
        <field name="name">Disability Status</field>
        <field name="res_model">spp.dci.disability.status</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_synced': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No disability status records found
            </p>
            <p>
                Disability status records are created when syncing data from
                Disability Registry (DR) systems via DCI API.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem
        id="menu_disability_status"
        name="Disability Status"
        parent="spp_dci_client.menu_spp_dci_activity"
        action="action_disability_status"
        sequence="30"
    />
</odoo>
