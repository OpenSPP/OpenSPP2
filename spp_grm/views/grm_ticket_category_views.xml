<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_spp_grm_category_form" model="ir.ui.view">
        <field name="name">view.spp_grm_category.form</field>
        <field name="model">spp.grm.ticket.category</field>
        <field name="arch" type="xml">
            <form string="Stages">
                <header />
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" required="1" />
                        </h1>
                    </div>
                    <group name="main">
                        <group name="main_left">
                            <field name="code" />
                            <field name="parent_id" />
                            <field name="default_severity" />
                            <field name="default_sensitivity" />
                        </group>
                        <group name="main_right">
                            <field name="default_sla_hours" />
                            <field name="default_team_id" />
                            <field name="should_auto_escalate" />
                            <field name="auto_create_case" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page name="subcategories" string="Subcategories">
                            <field name="subcategory_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="code" />
                                    <field name="name" />
                                    <field name="default_severity" />
                                    <field name="default_sla_hours" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_spp_grm_category_tree" model="ir.ui.view">
        <field name="name">view.spp_grm_category.tree</field>
        <field name="model">spp.grm.ticket.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="code" />
                <field name="name" />
                <field name="parent_id" />
                <field name="default_severity" />
                <field name="default_team_id" optional="show" />
                <field name="default_sla_hours" optional="show" />
                <field name="should_auto_escalate" optional="hide" />
                <field name="auto_create_case" optional="hide" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company"
                />
            </list>
        </field>
    </record>

    <record id="view_spp_grm_ticket_category_search" model="ir.ui.view">
        <field name="name">spp.grm.ticket.category.search</field>
        <field name="model">spp.grm.ticket.category</field>
        <field name="arch" type="xml">
            <search string="Grievance Redress Mechanism Category Search">
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active','=',False)]"
                />
                <separator />
                <field name="name" filter_domain="[('name', 'ilike', self)]" />
                <field name="company_id" groups="base.group_multi_company" />
                <group>
                    <filter
                        string="Company"
                        name="company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="spp_grm_ticket_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="type">ir.actions.act_window</field>
        <field name="path">grm-categories</field>
        <field name="res_model">spp.grm.ticket.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="spp_grm_ticket_category_menu"
        name="Categories"
        parent="spp_grm_ticket_config_main_menu"
        action="spp_grm_ticket_category_action"
        sequence="15"
    />
</odoo>
