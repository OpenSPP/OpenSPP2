<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="ticket_view_form" model="ir.ui.view">
        <field name="name">spp.grm.ticket.view.form</field>
        <field name="model">spp.grm.ticket</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Ticket">
                <header>
                    <button string="Assign to me" name="assign_to_me" type="object" invisible="user_id" />
                    <field
                        name="stage_id"
                        widget="statusbar"
                        options="{'clickable': '1', 'fold_field': 'fold'}"
                    />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active" />
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <h1 class="oe_title">
                            <field name="number" force_save="1" />
                        </h1>
                        <h2 class="o_row">
                            <field name="name" placeholder="Ticket Title..." />
                        </h2>
                    </div>

                    <!-- Hidden fields for conditional visibility -->
                    <group invisible="1">
                        <field name="active" />
                    </group>

                    <notebook name="ticket_tabs">
                        <!-- Details Tab: Core ticket information -->
                        <page string="Details" name="details">
                            <!-- Description Section -->
                            <separator string="Description" />
                            <field name="description" widget="html" nolabel="1" class="oe_inline"/>

                            <!-- Classification Section -->
                            <separator string="Classification" />
                            <group name="classification_section" col="2">
                                <group>
                                    <field name="category_id" />
                                    <field name="subcategory_id" />
                                    <field
                                        name="tag_ids"
                                        widget="many2many_tags"
                                        options="{'no_create_edit': True, 'color_field': 'color'}"
                                    />
                                </group>
                                <group>
                                    <field name="priority" widget="priority" />
                                    <field name="severity" widget="priority" />
                                    <field name="sensitivity" />
                                </group>
                            </group>

                            <!-- Assignment Section -->
                            <separator string="Assignment" />
                            <group name="assignment_section" col="2">
                                <group>
                                    <field
                                        name="user_id"
                                        options="{'always_reload': True,'no_open':True,'no_create_edit':True,'no_edit':True,'no_create':True}"
                                    />
                                    <field name="team_id" />
                                </group>
                                <group>
                                    <field
                                        name="channel_id"
                                        options="{'no_open':True,'no_create_edit':True,'no_edit':True,'no_create':True}"
                                    />
                                    <field
                                        name="company_id"
                                        options="{'no_create': True}"
                                        groups="base.group_multi_company"
                                    />
                                </group>
                            </group>

                            <!-- SLA Section -->
                            <separator string="SLA Information" />
                            <group name="sla_section" col="2">
                                <group>
                                    <field name="sla_deadline" readonly="1" />
                                    <field
                                        name="sla_status"
                                        widget="badge"
                                        decoration-success="sla_status == 'on_track'"
                                        decoration-warning="sla_status == 'at_risk'"
                                        decoration-danger="sla_status == 'breached'"
                                    />
                                </group>
                                <group>
                                    <field name="days_open" readonly="1" />
                                    <field name="sequence" groups="base.group_no_one" />
                                </group>
                            </group>
                        </page>

                        <!-- Complainant Tab: Extension point for registry integration -->
                        <page string="Complainant" name="complainant">
                            <!-- Complainant Type Section -->
                            <separator string="Complainant Information" />
                            <group name="complainant_type_section" col="2">
                                <group>
                                    <field name="complainant_type" />
                                </group>
                                <group />
                            </group>

                            <!-- Basic Complainant Fields -->
                            <group name="complainant_info_section" col="2">
                                <group>
                                    <field
                                        name="partner_id"
                                        options="{'no_open':True,'no_create_edit':True,'no_edit':True,'no_create':True}"
                                        invisible="complainant_type == 'anonymous'"
                                    />
                                    <field name="partner_email" invisible="complainant_type == 'anonymous'" />
                                </group>
                                <group>
                                    <field name="contact_name" invisible="complainant_type != 'anonymous'" />
                                    <field name="contact_phone" invisible="complainant_type != 'anonymous'" />
                                    <field name="contact_email" invisible="complainant_type != 'anonymous'" />
                                </group>
                            </group>

                            <!-- Extension point for spp_grm_registry to inject registrant details -->
                            <div name="complainant_section" invisible="1">
                                <!-- Injected by spp_grm_registry -->
                            </div>
                        </page>

                        <!-- Resolution Tab: Decision, escalation, and appeals -->
                        <page string="Resolution" name="resolution">
                            <!-- Decision Section -->
                            <separator string="Decision &amp; Resolution" />
                            <group name="decision_section" col="2">
                                <group>
                                    <field name="decision" />
                                </group>
                                <group />
                            </group>
                            <group name="resolution_summary_section">
                                <field name="resolution_summary" widget="html" nolabel="1" colspan="2" />
                            </group>

                            <!-- Escalation Section -->
                            <separator string="Escalation" />
                            <group name="escalation_section" col="2">
                                <group>
                                    <field name="is_escalated" />
                                    <field name="escalated_to_id" invisible="not is_escalated" />
                                </group>
                                <group>
                                    <field name="escalation_date" readonly="1" invisible="not is_escalated" />
                                </group>
                            </group>
                            <group name="escalation_reason_section">
                                <field name="escalation_reason" widget="text" nolabel="1" colspan="2" invisible="not is_escalated" />
                            </group>

                            <!-- Appeal Section -->
                            <separator string="Appeal" />
                            <group name="appeal_section" col="2">
                                <group>
                                    <field name="is_appeal" />
                                    <field name="original_ticket_id" invisible="not is_appeal" />
                                </group>
                                <group />
                            </group>

                            <!-- Extension point for spp_grm_programs to inject program link -->
                            <div name="program_section" invisible="1">
                                <!-- Injected by spp_grm_programs -->
                            </div>

                            <!-- Extension point for spp_grm_case_link to inject case escalation -->
                            <div name="case_section" invisible="1">
                                <!-- Injected by spp_grm_case_link -->
                            </div>
                        </page>

                        <!-- History Tab: Audit and timeline information -->
                        <page string="History" name="history">
                            <!-- Audit Section -->
                            <separator string="Audit Information" />
                            <group name="audit_section" col="2">
                                <group>
                                    <field name="create_date" readonly="1" />
                                    <field
                                        name="create_uid"
                                        readonly="1"
                                        string="Created by"
                                        options="{'no_open':True}"
                                    />
                                </group>
                                <group>
                                    <field name="write_date" readonly="1" />
                                    <field name="write_uid" readonly="1" options="{'no_open':True}" />
                                </group>
                            </group>

                            <!-- Timeline Section -->
                            <separator string="Timeline Information" />
                            <group name="timeline_section" col="2">
                                <group>
                                    <field name="assigned_date" readonly="1" />
                                    <field name="last_stage_update" readonly="1" />
                                </group>
                                <group>
                                    <field name="closed_date" readonly="1" />
                                    <field name="closed_by_id" readonly="1" options="{'no_open':True}" />
                                </group>
                            </group>

                            <!-- Extension point for spp_audit to inject audit log -->
                            <div name="audit_log_section" invisible="1">
                                <!-- Injected by spp_audit -->
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ticket_view_tree" model="ir.ui.view">
        <field name="name">spp.grm.ticket.view.tree</field>
        <field name="model">spp.grm.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="priority" widget="priority" />
                <field name="sequence" widget="handle" />
                <field name="number" decoration-bf="1" />
                <field name="name" />
                <field name="partner_id" widget="many2one_avatar" />
                <field name="user_id" optional="show" widget="many2one_avatar_user" />
                <field name="team_id" optional="show" />
                <field name="severity" widget="priority" optional="show" />
                <field name="unattended" column_invisible="1" />
                <field name="is_closed" column_invisible="1" />
                <field
                    name="tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    optional="show"
                />
                <field
                    name="sla_status"
                    widget="badge"
                    decoration-success="sla_status == 'on_track'"
                    decoration-warning="sla_status == 'at_risk'"
                    decoration-danger="sla_status == 'breached'"
                    optional="show"
                />
                <field name="create_date" widget="remaining_days" readonly="1" optional="show" />
                <field name="last_stage_update" widget="remaining_days" optional="show" />
                <field name="activity_ids" widget="list_activity" optional="hide" />
                <field
                    name="stage_id"
                    widget="badge"
                    decoration-success="not unattended and not is_closed"
                    decoration-info="unattended == True"
                    decoration-muted="is_closed == True"
                />
            </list>
        </field>
    </record>

    <record id="spp_grm_ticket_view_search" model="ir.ui.view">
        <field name="name">spp.grm.ticket.view.search</field>
        <field name="model">spp.grm.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field
                    string="Ticket"
                    name="number"
                    filter_domain="['|',('number', 'ilike', self),('name', 'ilike', self)]"
                />
                <field name="partner_id" />
                <field name="user_id" />
                <field name="team_id" />
                <field name="name" />
                <field name="tag_ids" />
                <field name="stage_id" />
                <filter string="Unassigned" name="unassigned" domain="[('user_id','=',False)]" />
                <filter string="Open" name="open" domain="[('is_closed', '=', False)]" />
                <filter string="Unattended" name="unattended" domain="[('unattended', '=', True )]" />
                <filter string="High Priority" name="high_priority" domain="[('priority','=','3')]" />
                <separator />
                <filter string="Critical Severity" name="critical_severity" domain="[('severity','=','3')]" />
                <filter string="High Severity" name="high_severity" domain="[('severity','=','2')]" />
                <filter string="Medium Severity" name="medium_severity" domain="[('severity','=','1')]" />
                <filter string="Low Severity" name="low_severity" domain="[('severity','=','0')]" />
                <separator />
                <filter string="SLA On Track" name="sla_on_track" domain="[('sla_status','=','on_track')]" />
                <filter string="SLA At Risk" name="sla_at_risk" domain="[('sla_status','=','at_risk')]" />
                <filter string="SLA Breached" name="sla_breached" domain="[('sla_status','=','breached')]" />
                <separator />
                <filter string="Escalated" name="escalated" domain="[('is_escalated','=',True)]" />
                <filter string="Appeals" name="appeals" domain="[('is_appeal','=',True)]" />
                <separator />
                <filter string="Archived" name="archived" domain="[('active','=',False)]" />
                <separator />
                <filter string="My Tickets" name="mytickets" domain="[('user_id','=',uid)]" />
                <filter
                    string="My Followed Tickets"
                    name="my_followed_tickets"
                    domain="[('message_is_follower', '=', True)]"
                />
                <separator />
                <filter
                    name="last_week"
                    string="Last Week"
                    domain="[('create_date','&gt;', (context_today() - datetime.timedelta(weeks=1)).strftime('%%Y-%%m-%%d') )]"
                />
                <separator />
                <filter
                    string="My Activities"
                    name="activities_my"
                    domain="[('activity_ids.user_id', '=', uid)]"
                />
                <filter
                    string="Late Activities"
                    name="activities_overdue"
                    domain="[('activity_ids.date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"
                    help="Show all records which has next action date is before today"
                />
                <filter
                    string="Today Activities"
                    name="activities_today"
                    domain="[('activity_ids.date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"
                />
                <filter
                    string="Future Activities"
                    name="activities_upcoming_all"
                    domain="[('activity_ids.date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))
                  ]"
                />
                <group>
                    <filter
                        string="Partner"
                        name="group_partner"
                        domain="[]"
                        context="{'group_by':'partner_id'}"
                    />
                    <filter string="User" name="group_user" domain="[]" context="{'group_by':'user_id'}" />
                    <filter string="Team" name="group_team" domain="[]" context="{'group_by':'team_id'}" />
                    <filter string="Stage" name="group_stage" domain="[]" context="{'group_by':'stage_id'}" />
                    <filter string="Tag" name="group_tag" domain="[]" context="{'group_by':'tag_ids'}" />
                    <filter string="Severity" name="group_severity" domain="[]" context="{'group_by':'severity'}" />
                    <filter string="SLA Status" name="group_sla_status" domain="[]" context="{'group_by':'sla_status'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_spp_grm_ticket_kanban" model="ir.ui.view">
        <field name="name">spp.grm.ticket.kanban</field>
        <field name="model">spp.grm.ticket</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="stage_id">
                <field name="number" />
                <field name="active" />
                <field name="name" />
                <field name="user_id" />
                <field name="sequence" />
                <field name="color" />
                <field name="stage_id" />
                <field name="priority" widget="priority" />
                <field name="assigned_date" />
                <progressbar
                    field="activity_state"
                    colors="{&quot;planned&quot;: &quot;success&quot;, &quot;today&quot;: &quot;warning&quot;, &quot;overdue&quot;: &quot;danger&quot;}"
                />
                <templates>
                    <t t-name="card">
                        <div
                            t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_content oe_kanban_global_click"
                        >
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <field name="name" />
                                    <field
                                        name="tag_ids"
                                        widget="many2many_tags"
                                        options="{'color_field': 'color'}"
                                    />
                                    <field name="number" />
                                    <small class="o_kanban_record_subtitle text-muted">
                                        <field name="partner_id" />
                                    </small>
                                </div>
                                <div
                                    class="o_dropdown_kanban dropdown"
                                    t-if="!selection_mode"
                                    groups="base.group_user"
                                >
                                    <a
                                        role="button"
                                        class="dropdown-toggle o-no-caret btn"
                                        data-bs-toggle="dropdown"
                                        data-bs-display="static"
                                        href="#"
                                        aria-label="Dropdown menu"
                                        title="Dropdown menu"
                                    >
                                        <span class="fa fa-ellipsis-v" />
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <a
                                            role="menuitem"
                                            type="edit"
                                            class="dropdown-item"
                                        >Edit</a>
                                        <a
                                            role="menuitem"
                                            type="delete"
                                            class="dropdown-item"
                                        >Delete</a>
                                        <div role="separator" class="dropdown-divider" />
                                        <ul class="oe_kanban_colorpicker" data-field="color" />
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body" />
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="priority" widget="priority" />
                                    <field
                                        name="activity_ids"
                                        widget="kanban_activity"
                                        related="activity_state"
                                    />
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="kanban_state" widget="state_selection" />
                                    <field name="activity_state" invisible="1" />
                                    <img
                                        t-att-src="kanban_image('res.users', 'image_128', record.user_id.raw_value)"
                                        t-att-title="record.user_id.value"
                                        width="24"
                                        height="24"
                                        class="oe_kanban_avatar o_image_24_cover float-end"
                                        t-att-alt="record.user_id.value"
                                    />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="spp_grm_ticket_action" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="type">ir.actions.act_window</field>
        <field name="path">grm-tickets</field>
        <field name="res_model">spp.grm.ticket</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <menuitem
        id="spp_grm_ticket_menu"
        name="Tickets"
        parent="spp_grm_ticket_main_menu"
        action="spp_grm_ticket_action"
        sequence="10"
    />

</odoo>
