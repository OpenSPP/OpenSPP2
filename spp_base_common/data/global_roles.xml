        <field
            name="implied_ids"
            eval="
            [
                Command.link(ref('base.group_user')),
                Command.link(ref('base.group_partner_manager')),
                Command.link(ref('spp_registry.group_registry_officer')),
            ]"
        />
    </record>
</odoo>
