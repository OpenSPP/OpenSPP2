<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="spp_dci_compliance.SecurityWarning">
        <t t-if="state.loaded and state.hasWarnings">
            <Dropdown>
                <button
                    class="btn btn-link nav-link o_dci_security_warning"
                    title="DCI Security Warnings - Development mode settings are enabled!"
                >
                    <i class="fa fa-exclamation-triangle text-danger fa-lg" />
                    <span
                        class="badge bg-danger rounded-pill ms-1"
                        t-esc="state.warningCount"
                    />
                </button>
                <t t-set-slot="content">
                    <div class="p-3" style="min-width: 350px; max-width: 450px;">
                        <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                            <i class="fa fa-shield text-danger fa-2x me-2" />
                            <div>
                                <h6
                                    class="mb-0 text-danger fw-bold"
                                >DCI Security Warning</h6>
                                <small
                                    class="text-muted"
                                >Development settings are enabled</small>
                            </div>
                        </div>

                        <div class="alert alert-danger mb-3 py-2" role="alert">
                            <i class="fa fa-exclamation-circle me-1" />
                            <strong>Not safe for production!</strong>
                        </div>

                        <ul class="list-unstyled mb-3">
                            <t
                                t-foreach="state.warnings"
                                t-as="warning"
                                t-key="warning.key"
                            >
                                <li class="mb-2 pb-2 border-bottom">
                                    <div class="d-flex align-items-start">
                                        <i
                                            class="fa fa-warning text-warning me-2 mt-1"
                                        />
                                        <div>
                                            <strong t-esc="warning.name" />
                                            <br />
                                            <small
                                                class="text-muted"
                                                t-esc="warning.description"
                                            />
                                        </div>
                                    </div>
                                </li>
                            </t>
                        </ul>

                        <div class="text-center">
                            <button
                                class="btn btn-sm btn-outline-primary"
                                t-on-click="openSettings"
                            >
                                <i class="fa fa-cog me-1" />
                                View DCI Settings
                            </button>
                        </div>

                        <div class="mt-3 pt-2 border-top">
                            <small class="text-muted">
                                <i class="fa fa-info-circle me-1" />
                                To disable these warnings, set the corresponding
                                <code>dci.*</code> parameters to <code>false</code>
                                or uninstall <code>spp_dci_compliance</code>.
                            </small>
                        </div>
                    </div>
                </t>
            </Dropdown>
        </t>
    </t>
</templates>
