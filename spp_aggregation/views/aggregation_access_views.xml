<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access Rule Form View -->
    <record id="view_aggregation_access_rule_form" model="ir.ui.view">
        <field name="name">spp.aggregation.access.rule.form</field>
        <field name="model">spp.aggregation.access.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group string="Rule Identity">
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Applies To">
                            <field name="user_id"/>
                            <field name="group_id"/>
                        </group>
                    </group>

                    <group>
                        <group string="Access Level">
                            <field name="access_level" widget="radio"/>
                        </group>
                        <group string="Privacy Settings">
                            <field name="minimum_k_anonymity"/>
                        </group>
                    </group>

                    <group>
                        <group string="Scope Restrictions">
                            <field name="allowed_scope_types"/>
                            <field name="allow_inline_scopes"/>
                        </group>
                        <group string="Dimension Restrictions">
                            <field name="max_group_by_dimensions"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Allowed Scopes" name="allowed_scopes"
                              invisible="allowed_scope_types != 'predefined'">
                            <field name="allowed_scope_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="scope_type"/>
                                </list>
                            </field>
                        </page>
                        <page string="Allowed Dimensions" name="allowed_dimensions">
                            <field name="allowed_dimension_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="label"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Access Rule List View -->
    <record id="view_aggregation_access_rule_list" model="ir.ui.view">
        <field name="name">spp.aggregation.access.rule.list</field>
        <field name="model">spp.aggregation.access.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="group_id"/>
                <field name="access_level"/>
                <field name="minimum_k_anonymity"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Access Rule Search View -->
    <record id="view_aggregation_access_rule_search" model="ir.ui.view">
        <field name="name">spp.aggregation.access.rule.search</field>
        <field name="model">spp.aggregation.access.rule</field>
        <field name="arch" type="xml">
            <search string="Search Access Rules">
                <field name="name"/>
                <field name="user_id"/>
                <field name="group_id"/>
                <separator/>
                <filter string="Aggregate Only" name="filter_aggregate" domain="[('access_level', '=', 'aggregate')]"/>
                <filter string="Individual Access" name="filter_individual" domain="[('access_level', '=', 'individual')]"/>
                <separator/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Access Level" name="group_by_access" context="{'group_by': 'access_level'}"/>
            </search>
        </field>
    </record>

    <!-- Access Rule Action -->
    <record id="action_aggregation_access_rule" model="ir.actions.act_window">
        <field name="name">Access Rules</field>
        <field name="res_model">spp.aggregation.access.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create access rules for aggregation queries
            </p>
            <p>
                Control who can access aggregation data and what level
                of detail they can see (aggregates only vs individual records).
            </p>
        </field>
    </record>
</odoo>
