<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- HDX COD Source Tree View -->
    <record id="view_hdx_cod_source_tree" model="ir.ui.view">
        <field name="name">spp.hdx.cod.source.tree</field>
        <field name="model">spp.hdx.cod.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="country_id" />
                <field name="country_iso3" />
                <field name="hdx_dataset_id" />
                <field name="last_sync_date" />
                <field name="last_import_date" />
                <field name="areas_updated" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <!-- HDX COD Source Form View -->
    <record id="view_hdx_cod_source_form" model="ir.ui.view">
        <field name="name">spp.hdx.cod.source.form</field>
        <field name="model">spp.hdx.cod.source</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_sync_from_hdx"
                        string="Sync from HDX"
                        type="object"
                        class="oe_highlight"
                        groups="spp_area_hdx.group_hdx_manager"
                    />
                    <button
                        name="action_open_import_wizard"
                        string="Import COD"
                        type="object"
                        class="btn-primary"
                        groups="spp_area_hdx.group_hdx_manager"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="toggle_active"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-archive"
                        >
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}" />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="country_id" />
                            <field name="country_iso3" />
                            <field name="hdx_dataset_id" />
                        </group>
                        <group>
                            <field name="hdx_dataset_url" widget="url" />
                            <field name="last_sync_date" />
                            <field name="last_import_date" />
                            <field name="areas_updated" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Admin Levels" name="resources">
                            <field name="resource_ids">
                                <list>
                                    <field name="name" />
                                    <field name="admin_level" />
                                    <field name="format" />
                                    <field name="pcode_field" />
                                    <field name="name_field" />
                                    <field name="feature_count" />
                                    <field name="last_download_date" />
                                    <button
                                        name="action_detect_field_mappings"
                                        string="Detect Fields"
                                        type="object"
                                        icon="fa-search"
                                        groups="spp_area_hdx.group_hdx_manager"
                                    />
                                    <button
                                        name="action_open_import_wizard"
                                        string="Import"
                                        type="object"
                                        icon="fa-download"
                                        groups="spp_area_hdx.group_hdx_manager"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- HDX COD Source Action -->
    <record id="action_hdx_cod_source" model="ir.actions.act_window">
        <field name="name">HDX COD Sources</field>
        <field name="res_model">spp.hdx.cod.source</field>
        <field name="view_mode">list,form</field>
        <field name="path">hdx-cod-sources</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first HDX COD Source
            </p>
            <p>
                HDX COD Sources represent Common Operational Datasets for
                administrative boundaries available from the Humanitarian Data Exchange.
            </p>
        </field>
    </record>
</odoo>
