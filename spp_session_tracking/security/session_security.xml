<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Security Groups -->
    <record id="group_session_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_session_user" />
        <field
            name="comment"
        >Can view all sessions and edit own facilitated sessions.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <record id="group_session_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_session_manager" />
        <field
            name="comment"
        >Full session management including all CRUD operations.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_session_user'))]" />
    </record>

    <!-- Link manager group to admin -->
    <record id="spp_security.group_spp_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_session_manager'))]" />
    </record>
</odoo>
