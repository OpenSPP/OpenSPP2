<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Extend GRM Ticket Form View -->
    <record id="view_spp_grm_ticket_form_programs" model="ir.ui.view">
        <field name="name">spp.grm.ticket.form.programs</field>
        <field name="model">spp.grm.ticket</field>
        <field name="inherit_id" ref="spp_grm.ticket_view_form" />
        <field name="arch" type="xml">

            <!-- Add program stat buttons in button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_program"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-list-alt"
                    invisible="not program_id"
                    string="View Program"
                />
                <button
                    name="action_view_entitlement"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    invisible="not entitlement_id"
                    string="View Entitlement"
                />
                <button
                    name="action_view_payment"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-credit-card"
                    invisible="not payment_id"
                    string="View Payment"
                />
            </xpath>

            <!-- Inject program information into the dedicated program_section placeholder -->
            <xpath expr="//div[@name='program_section']" position="replace">
                <div name="program_section">
                    <separator string="Program Information" />
                    <group name="program_info" col="2">
                        <group>
                            <field name="program_id" options="{'no_create': True}" />
                            <field name="program_membership_id" options="{'no_create': True}" />
                            <field
                                name="enrollment_status"
                                readonly="1"
                                invisible="not program_membership_id"
                            />
                        </group>
                        <group>
                            <field name="cycle_id" options="{'no_create': True}" domain="[('program_id', '=', program_id)]" readonly="not program_id" />
                            <field name="entitlement_id" options="{'no_create': True}" domain="[('cycle_id', '=', cycle_id)]" readonly="not cycle_id" />
                            <field
                                name="entitlement_amount"
                                readonly="1"
                                invisible="not entitlement_id"
                                widget="monetary"
                            />
                            <field name="payment_id" options="{'no_create': True}" domain="[('entitlement_id', '=', entitlement_id)]" readonly="not entitlement_id" />
                            <field
                                name="payment_amount"
                                readonly="1"
                                invisible="not payment_id"
                                widget="monetary"
                            />
                        </group>
                    </group>
                </div>
            </xpath>

        </field>
    </record>

    <!-- Extend GRM Ticket Tree View -->
    <record id="view_spp_grm_ticket_tree_programs" model="ir.ui.view">
        <field name="name">spp.grm.ticket.tree.programs</field>
        <field name="model">spp.grm.ticket</field>
        <field name="inherit_id" ref="spp_grm.ticket_view_tree" />
        <field name="arch" type="xml">

            <!-- Add program fields to tree view -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="program_id" optional="hide" />
                <field name="cycle_id" optional="hide" />
                <field name="entitlement_id" optional="hide" />
                <field name="payment_id" optional="hide" />
            </xpath>

        </field>
    </record>

    <!-- Extend GRM Ticket Search View -->
    <record id="view_spp_grm_ticket_search_programs" model="ir.ui.view">
        <field name="name">spp.grm.ticket.search.programs</field>
        <field name="model">spp.grm.ticket</field>
        <field name="inherit_id" ref="spp_grm.spp_grm_ticket_view_search" />
        <field name="arch" type="xml">

            <!-- Add program search fields -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="program_id" />
                <field name="program_membership_id" />
                <field name="cycle_id" />
                <field name="entitlement_id" />
                <field name="payment_id" />
            </xpath>

            <!-- Add program filters -->
            <xpath expr="//filter[@name='mytickets']" position="after">
                <separator />
                <filter
                    name="filter_has_program"
                    string="Has Program"
                    domain="[('program_id', '!=', False)]"
                    help="Tickets linked to a program"
                />
                <filter
                    name="filter_has_entitlement"
                    string="Has Entitlement"
                    domain="[('entitlement_id', '!=', False)]"
                    help="Tickets linked to an entitlement"
                />
                <filter
                    name="filter_has_payment"
                    string="Has Payment"
                    domain="[('payment_id', '!=', False)]"
                    help="Tickets linked to a payment"
                />
            </xpath>

            <!-- Add program group by options -->
            <xpath expr="//search/group" position="inside">
                <filter
                    name="group_by_program"
                    string="Program"
                    context="{'group_by': 'program_id'}"
                />
                <filter
                    name="group_by_cycle"
                    string="Cycle"
                    context="{'group_by': 'cycle_id'}"
                />
                <filter
                    name="group_by_enrollment_status"
                    string="Enrollment Status"
                    context="{'group_by': 'enrollment_status'}"
                />
            </xpath>

        </field>
    </record>

    <!-- Extend GRM Ticket Kanban View -->
    <record id="view_spp_grm_ticket_kanban_programs" model="ir.ui.view">
        <field name="name">spp.grm.ticket.kanban.programs</field>
        <field name="model">spp.grm.ticket</field>
        <field name="inherit_id" ref="spp_grm.view_spp_grm_ticket_kanban" />
        <field name="arch" type="xml">

            <!-- Declare fields for kanban data loading -->
            <xpath expr="//kanban/field[@name='number']" position="before">
                <field name="program_id" />
                <field name="entitlement_id" />
                <field name="payment_id" />
            </xpath>

            <!-- Add program info before footer -->
            <xpath expr="//footer" position="before">
                <t t-if="record.program_id.raw_value">
                    <div>
                        <strong>Program:</strong>
                        <field name="program_id" />
                    </div>
                </t>
                <t t-if="record.entitlement_id.raw_value">
                    <div>
                        <strong>Entitlement:</strong>
                        <field name="entitlement_id" />
                    </div>
                </t>
                <t t-if="record.payment_id.raw_value">
                    <div>
                        <strong>Payment:</strong>
                        <field name="payment_id" />
                    </div>
                </t>
            </xpath>

        </field>
    </record>

</odoo>
