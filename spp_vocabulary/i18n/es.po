msgid "Economic Activity Status (ILO)"
msgstr "Situación de actividad económica (OIT)"

#. module: spp_vocabulary
#: model:spp.vocabulary,description:spp_vocabulary.vocab_economic_activity
msgid ""
"Economic activity and employment status classification based on ILO "
"standards including ICSE-18. Combines labour force status (19th ICLS) and "
"status in employment (ICSE-18)."
msgstr ""
"Clasificación de actividad económica y situación en el empleo basada en norm"
"as de la OIT, incluida la ICSE-18. Combina la situación respecto a la fuerza"
" de trabajo (19th ICLS) y la situación en el empleo (ICSE-18)."

#. module: spp_vocabulary
#: model:spp.vocabulary.code,definition:spp_vocabulary.econ_unknown
msgid "Economic activity status is unknown or was not collected."
msgstr "La situación de actividad económica es desconocida o no fue recopilada."

#. module: spp_vocabulary
#: model:ir.model.fields.selection,name:spp_vocabulary.selection__spp_vocabulary__domain__education
