#. module: spp_vocabulary
#: model:spp.vocabulary.code,display:spp_vocabulary.isco_44
msgid "Other Clerical Support Workers"
msgstr "Otros trabajadores de apoyo administrativo"

#. module: spp_vocabulary
#: model:spp.vocabulary.code,display:spp_vocabulary.econ_other_inactive
msgid "Other Inactive"
msgstr "Otros inactivos"

#. module: spp_vocabulary
#: model:spp.vocabulary.code,display:spp_vocabulary.code_rel_other
msgid "Other Relative"
msgstr "Otro pariente"

#. module: spp_vocabulary
#: model:spp.vocabulary.code,definition:spp_vocabulary.isco_44
msgid ""
"Other clerical support workers file, copy and circulate documents; sort and "
"distribute mail; prepare mailings; perform proof-reading tasks; encode and "
"code data and proof-read copy; and undertake a number of clerical duties "
"related to library operations and duties of a general clerical nature."
msgstr ""
"Otros empleados de apoyo administrativo archivan, copian y distribuyen docum"
"entos; clasifican y reparten correo; preparan envíos postales; realizan tare"
"as de corrección de pruebas; codifican datos y revisan copias; y realizan di"
"versas tareas administrativas relacionadas con operaciones de biblioteca y d"
"e carácter administrativo general."

