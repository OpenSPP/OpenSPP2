<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vocabulary Domain Groups -->
    <!-- Following ADR-004 three-tier architecture -->

    <!-- Tier 3: Technical base groups -->
    <record id="group_vocabulary_read" model="res.groups">
        <field name="name">Vocabulary: Read</field>
        <field name="comment">Technical group for read access to vocabulary models.</field>
    </record>

    <record id="group_vocabulary_write" model="res.groups">
        <field name="name">Vocabulary: Write</field>
        <field name="comment">Technical group for write access to vocabulary models.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_vocabulary_read'))]"/>
    </record>

    <record id="group_vocabulary_create" model="res.groups">
        <field name="name">Vocabulary: Create</field>
        <field name="comment">Technical group for vocabulary create access. Grants permission to create new vocabulary records.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_vocabulary_read'))]"/>
    </record>

    <!-- Tier 2: User-facing groups -->
    <!-- All groups share the same privilege for unified UI presentation -->
    <!-- Groups are mutually exclusive - each only implies technical groups, not each other -->
    <record id="group_vocabulary_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_vocabulary"/>
        <field name="comment">Can view vocabularies and codes. Cannot modify data.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_vocabulary_read'))]"/>
    </record>

    <record id="group_vocabulary_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="privilege_id" ref="privilege_vocabulary"/>
        <field name="comment">Can view and edit vocabularies and codes. Cannot delete.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_vocabulary_read')), Command.link(ref('group_vocabulary_write')), Command.link(ref('group_vocabulary_create'))]"/>
    </record>

    <record id="group_vocabulary_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_vocabulary"/>
        <field name="comment">Full vocabulary management including delete operations.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_vocabulary_read')), Command.link(ref('group_vocabulary_write')), Command.link(ref('group_vocabulary_create'))]"/>
    </record>

    <!-- Link manager to admin (IMPORTANT!) -->
    <record id="spp_security.group_spp_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_vocabulary_manager'))]"/>
    </record>
</odoo>
