<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Vocabulary Code List View -->
    <record id="view_vocabulary_code_list" model="ir.ui.view">
        <field name="name">spp.vocabulary.code.list</field>
        <field name="model">spp.vocabulary.code</field>
        <field name="arch" type="xml">
            <list
                string="Vocabulary Codes"
                default_order="vocabulary_id,sequence,code"
                decoration-muted="not active"
                decoration-warning="deprecated"
            >
                <field name="sequence" widget="handle" />
                <field name="code" />
                <field name="display" />
                <field name="target_type" />
                <field
                    name="vocabulary_id"
                    column_invisible="context.get('default_vocabulary_id')"
                />
                <field name="namespace_uri" optional="hide" />
                <field name="level" optional="hide" />
                <field name="parent_id" optional="hide" />
                <field name="deprecated" widget="boolean_toggle" optional="hide" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <!-- Vocabulary Code Form View -->
    <record id="view_vocabulary_code_form" model="ir.ui.view">
        <field name="name">spp.vocabulary.code.form</field>
        <field name="model">spp.vocabulary.code</field>
        <field name="arch" type="xml">
            <form string="Vocabulary Code">
                <header>
                    <!-- Extension point for workflow buttons -->
                    <div name="header_buttons" invisible="1" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Extension point for stat buttons -->
                        <div name="stat_buttons_extension" invisible="1" />
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <widget
                        name="web_ribbon"
                        title="Deprecated"
                        bg_color="text-bg-warning"
                        invisible="not deprecated"
                    />
                    <div class="oe_title">
                        <h1>
                            <field
                                name="display"
                                placeholder="Display Name"
                                required="1"
                            />
                        </h1>
                        <h2>
                            <field name="code" placeholder="Code" required="1" />
                        </h2>
                    </div>

                    <notebook>
                        <page string="Details" name="details">
                            <group name="details_section">
                                <group name="basic" string="Basic Information">
                                    <field
                                        name="vocabulary_id"
                                        required="1"
                                        domain="[('is_system', '=', False)]"
                                    />
                                    <field name="namespace_uri" readonly="1" />
                                    <field
                                        name="sequence"
                                        help="Drag rows in list view to reorder"
                                    />
                                    <field name="active" />
                                    <field name="target_type" />
                                </group>
                                <group
                                    name="hierarchy"
                                    string="Hierarchy"
                                    invisible="not vocabulary_id or not vocabulary_id.is_hierarchical"
                                >
                                    <field
                                        name="parent_id"
                                        domain="[('vocabulary_id', '=', vocabulary_id)]"
                                    />
                                    <field name="level" readonly="1" />
                                </group>
                            </group>
                            <group name="definition_section" string="Definition">
                                <field
                                    name="definition"
                                    nolabel="1"
                                    colspan="2"
                                    placeholder="Formal definition of what this code means..."
                                />
                            </group>
                            <group name="lifecycle_section" string="Lifecycle">
                                <group name="deprecation">
                                    <field name="deprecated" />
                                    <field
                                        name="deprecated_date"
                                        invisible="not deprecated"
                                    />
                                </group>
                                <group name="replacement">
                                    <field
                                        name="replaced_by_id"
                                        invisible="not deprecated"
                                        domain="[('vocabulary_id', '=', vocabulary_id)]"
                                    />
                                </group>
                            </group>
                            <!-- Extension point for additional details -->
                            <group name="details_extension" invisible="1" />
                        </page>

                        <page
                            string="Children"
                            name="children"
                            invisible="not vocabulary_id or not vocabulary_id.is_hierarchical"
                        >
                            <field name="child_ids" nolabel="1">
                                <list>
                                    <field name="sequence" widget="handle" />
                                    <field name="code" />
                                    <field name="display" />
                                    <field name="level" />
                                    <field name="active" widget="boolean_toggle" />
                                </list>
                            </field>
                        </page>

                        <page string="Mappings" name="mappings">
                            <field name="mapping_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="target_id" string="Target Code" />
                                    <field name="equivalence" />
                                    <field name="comment" optional="hide" />
                                </list>
                            </field>
                        </page>

                        <page
                            string="Technical"
                            name="technical"
                            groups="base.group_no_one"
                        >
                            <group name="technical_section" col="4">
                                <group>
                                    <field name="create_uid" readonly="1" />
                                    <field name="create_date" readonly="1" />
                                </group>
                                <group>
                                    <field name="write_uid" readonly="1" />
                                    <field name="write_date" readonly="1" />
                                </group>
                            </group>
                            <!-- Extension point for technical info -->
                            <group name="technical_extension" invisible="1" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Vocabulary Code Search View -->
    <record id="view_vocabulary_code_search" model="ir.ui.view">
        <field name="name">spp.vocabulary.code.search</field>
        <field name="model">spp.vocabulary.code</field>
        <field name="arch" type="xml">
            <search string="Search Vocabulary Codes">
                <field name="code" />
                <field name="display" />
                <field
                    name="definition"
                    filter_domain="[('definition', 'ilike', self)]"
                />
                <field name="vocabulary_id" />
                <field name="namespace_uri" />
                <separator />
                <filter
                    string="Active Only"
                    name="filter_active_only"
                    domain="[('deprecated', '=', False), ('active', '=', True)]"
                />
                <filter
                    string="Deprecated"
                    name="filter_deprecated"
                    domain="[('deprecated', '=', True)]"
                />
                <separator />
                <filter
                    string="Archived"
                    name="filter_archived"
                    domain="[('active', '=', False)]"
                />
                <group>
                    <filter
                        string="Vocabulary"
                        name="group_vocabulary"
                        context="{'group_by': 'vocabulary_id'}"
                    />
                    <filter
                        string="Parent"
                        name="group_parent"
                        context="{'group_by': 'parent_id'}"
                    />
                    <filter
                        string="Level"
                        name="group_level"
                        context="{'group_by': 'level'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Vocabulary Code Action -->
    <record id="action_vocabulary_code" model="ir.actions.act_window">
        <field name="name">Vocabulary Codes</field>
        <field name="res_model">spp.vocabulary.code</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active_only': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new vocabulary code
            </p>
            <p>
                Vocabulary codes are individual values within a vocabulary.
                They can be organized hierarchically and mapped to codes in other vocabularies
                for interoperability and reporting across different standards.
            </p>
        </field>
    </record>
</odoo>
