<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Deployment Profile List View -->
    <record id="view_deployment_profile_list" model="ir.ui.view">
        <field name="name">spp.deployment.profile.list</field>
        <field name="model">spp.deployment.profile</field>
        <field name="arch" type="xml">
            <list string="Deployment Profiles" default_order="name">
                <field name="name"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="vocabulary_count" string="Vocabularies"/>
                <field name="total_code_count" string="Total Codes"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
                <button name="action_activate"
                        type="object"
                        string="Activate"
                        icon="fa-check-circle"
                        invisible="is_active"
                        class="btn-primary"/>
            </list>
        </field>
    </record>

    <!-- Deployment Profile Form View -->
    <record id="view_deployment_profile_form" model="ir.ui.view">
        <field name="name">spp.deployment.profile.form</field>
        <field name="model">spp.deployment.profile</field>
        <field name="arch" type="xml">
            <form string="Deployment Profile">
                <header>
                    <button name="action_activate"
                            type="object"
                            string="Activate Profile"
                            class="oe_highlight"
                            invisible="is_active"/>
                    <field name="is_active" widget="status" statusbar_visible=""/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                                name="action_view_vocabulary_selections"
                                class="oe_stat_button"
                                icon="fa-list">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="vocabulary_count"/>
                                </span>
                                <span class="o_stat_text">Vocabularies</span>
                            </div>
                        </button>
                        <button type="object"
                                name="action_view_vocabulary_selections"
                                class="oe_stat_button"
                                icon="fa-code">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_code_count"/>
                                </span>
                                <span class="o_stat_text">Total Codes</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Active Profile" bg_color="text-bg-success" invisible="not is_active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Deployment Profile Name" required="1"/>
                        </h1>
                    </div>

                    <notebook>
                        <page string="Details" name="details">
                            <group name="details_section">
                                <group name="basic_info" string="Basic Information">
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="active"/>
                                </group>
                                <group name="status_info" string="Status">
                                    <field name="is_active" readonly="1"/>
                                </group>
                            </group>
                            <separator string="Description"/>
                            <field name="description"
                                   nolabel="1"
                                   placeholder="Description of this deployment profile..."
                                   class="oe_inline"/>
                        </page>

                        <page string="Vocabulary Selections" name="vocabulary_selections">
                            <field name="vocabulary_selection_ids"
                                   nolabel="1"
                                   context="{'default_deployment_profile_id': id}">
                                <list editable="bottom" default_order="vocabulary_id">
                                    <field name="vocabulary_id"/>
                                    <field name="vocabulary_namespace" optional="show"/>
                                    <field name="parent_selection_id" optional="hide"/>
                                    <field name="effective_code_count" string="Codes"/>
                                    <button name="action_add_all_codes"
                                            type="object"
                                            string="Add All"
                                            icon="fa-plus-circle"/>
                                    <button name="action_clear_codes"
                                            type="object"
                                            string="Clear"
                                            icon="fa-times-circle"/>
                                </list>
                            </field>
                        </page>

                        <page string="Technical" name="technical" groups="base.group_no_one">
                            <group name="technical_section" col="4">
                                <group>
                                    <field name="create_uid" readonly="1"/>
                                    <field name="create_date" readonly="1"/>
                                </group>
                                <group>
                                    <field name="write_uid" readonly="1"/>
                                    <field name="write_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Deployment Profile Search View -->
    <record id="view_deployment_profile_search" model="ir.ui.view">
        <field name="name">spp.deployment.profile.search</field>
        <field name="model">spp.deployment.profile</field>
        <field name="arch" type="xml">
            <search string="Search Deployment Profiles">
                <field name="name"/>
                <field name="description" filter_domain="[('description', 'ilike', self)]"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter string="Active Profile" name="filter_active_profile" domain="[('is_active', '=', True)]"/>
                <filter string="Inactive Profile" name="filter_inactive_profile" domain="[('is_active', '=', False)]"/>
                <separator/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'is_active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Deployment Profile Action -->
    <record id="action_deployment_profile" model="ir.actions.act_window">
        <field name="name">Deployment Profiles</field>
        <field name="res_model">spp.deployment.profile</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active_profile': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new deployment profile
            </p>
            <p>
                Deployment profiles define which vocabulary codes are active/selectable
                in your deployment. This enables the same vocabulary definitions to be
                reused across deployments while allowing each to configure their own
                subset of applicable codes.
            </p>
            <p>
                For example, one deployment might show only Male/Female for gender,
                while another might include additional gender identity options.
            </p>
        </field>
    </record>
    <!-- Menu item is in views/menu.xml to ensure proper loading order -->
</odoo>
