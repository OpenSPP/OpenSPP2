<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Extend relationship list view to show vocabulary code -->
    <record id="view_relationship_tree_vocabulary" model="ir.ui.view">
        <field name="name">spp.relationship.list.vocabulary</field>
        <field name="model">spp.relationship</field>
        <field name="inherit_id" ref="spp_registry.view_relationship_tree" />
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field
                    name="vocabulary_code_id"
                    optional="show"
                    options="{'no_create': True, 'no_create_edit': True}"
                />
                <field name="vocabulary_code" optional="hide" />
            </field>
        </field>
    </record>

    <!-- Add form view for relationship with vocabulary code -->
    <record id="view_relationship_form" model="ir.ui.view">
        <field name="name">spp.relationship.form</field>
        <field name="model">spp.relationship</field>
        <field name="arch" type="xml">
            <form string="Relationship Type">
                <header>
                    <!-- Extension point for workflow buttons -->
                    <div name="header_buttons" invisible="1" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                placeholder="Relationship Name"
                                required="1"
                            />
                        </h1>
                    </div>

                    <notebook>
                        <page string="Details" name="details">
                            <group name="details_section">
                                <group name="basic_info" string="Basic Information">
                                    <field
                                        name="name_inverse"
                                        required="1"
                                        help="The inverse name shown from the other side of the relationship"
                                    />
                                    <field
                                        name="bidirectional"
                                        widget="boolean_toggle"
                                        help="If enabled, the relationship works in both directions (e.g., Sibling-Sibling)"
                                    />
                                </group>
                                <group
                                    name="constraints"
                                    string="Partner Type Constraints"
                                >
                                    <field
                                        name="source_type"
                                        help="Type of source partner: Individual (i) or Group (g)"
                                    />
                                    <field
                                        name="destination_type"
                                        help="Type of destination partner: Individual (i) or Group (g)"
                                    />
                                </group>
                            </group>
                            <group
                                name="vocabulary_section"
                                string="Vocabulary Mapping"
                            >
                                <group>
                                    <field
                                        name="vocabulary_code_id"
                                        options="{'no_create': True, 'no_create_edit': True}"
                                        help="Link to a standardized vocabulary code for interoperability"
                                    />
                                    <field
                                        name="vocabulary_code"
                                        readonly="1"
                                        help="The machine-readable code value from the linked vocabulary"
                                    />
                                </group>
                                <group>
                                    <!-- Extension point for additional vocabulary info -->
                                    <div name="vocabulary_extension" invisible="1" />
                                </group>
                            </group>
                            <!-- Extension point for additional details -->
                            <group name="details_extension" invisible="1" />
                        </page>

                        <page
                            string="Technical"
                            name="technical"
                            groups="base.group_no_one"
                        >
                            <group name="technical_section" col="4">
                                <group>
                                    <field name="create_uid" readonly="1" />
                                    <field name="create_date" readonly="1" />
                                </group>
                                <group>
                                    <field name="write_uid" readonly="1" />
                                    <field name="write_date" readonly="1" />
                                </group>
                            </group>
                            <!-- Extension point for technical info -->
                            <group name="technical_extension" invisible="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view for relationship types -->
    <record id="view_relationship_search" model="ir.ui.view">
        <field name="name">spp.relationship.search</field>
        <field name="model">spp.relationship</field>
        <field name="arch" type="xml">
            <search string="Search Relationship Types">
                <field name="name" />
                <field name="name_inverse" />
                <field name="vocabulary_code" />
                <separator />
                <filter
                    string="Bidirectional"
                    name="filter_bidirectional"
                    domain="[('bidirectional', '=', True)]"
                />
                <filter
                    string="Unidirectional"
                    name="filter_unidirectional"
                    domain="[('bidirectional', '=', False)]"
                />
                <separator />
                <filter
                    string="Has Vocabulary Code"
                    name="filter_has_vocab"
                    domain="[('vocabulary_code_id', '!=', False)]"
                />
                <filter
                    string="No Vocabulary Code"
                    name="filter_no_vocab"
                    domain="[('vocabulary_code_id', '=', False)]"
                />
                <separator />
                <filter
                    string="Individual to Individual"
                    name="filter_i2i"
                    domain="[('source_type', '=', 'i'), ('destination_type', '=', 'i')]"
                />
                <filter
                    string="Individual to Group"
                    name="filter_i2g"
                    domain="[('source_type', '=', 'i'), ('destination_type', '=', 'g')]"
                />
                <filter
                    string="Group to Group"
                    name="filter_g2g"
                    domain="[('source_type', '=', 'g'), ('destination_type', '=', 'g')]"
                />
                <group>
                    <filter
                        string="Source Type"
                        name="group_source"
                        context="{'group_by': 'source_type'}"
                    />
                    <filter
                        string="Destination Type"
                        name="group_dest"
                        context="{'group_by': 'destination_type'}"
                    />
                    <filter
                        string="Bidirectional"
                        name="group_bidirectional"
                        context="{'group_by': 'bidirectional'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Update action to include form view and search -->
    <record id="spp_registry.action_relationship" model="ir.actions.act_window">
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_relationship_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new relationship type
            </p>
            <p>
                Relationship types define how registrants relate to each other
                (e.g., spouse, parent-child, head of household). Link them to
                vocabulary codes for standardized terminology across deployments.
            </p>
        </field>
    </record>
</odoo>
