<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
    Pre-configured relationship types linked to vocabulary codes.
    These provide standardized relationship types for interoperability.
    -->

    <record id="rel_head_of_household" model="spp.relationship">
        <field name="name">Head of Household</field>
        <field name="name_inverse">Household Member</field>
        <field name="bidirectional">False</field>
        <field name="source_type">i</field>
        <field name="destination_type">g</field>
        <field name="vocabulary_code_id" ref="code_rel_head"/>
    </record>

    <record id="rel_spouse" model="spp.relationship">
        <field name="name">Spouse/Partner</field>
        <field name="name_inverse">Spouse/Partner</field>
        <field name="bidirectional">True</field>
        <field name="source_type">i</field>
        <field name="destination_type">i</field>
        <field name="vocabulary_code_id" ref="code_rel_spouse"/>
    </record>

    <record id="rel_child" model="spp.relationship">
        <field name="name">Child</field>
        <field name="name_inverse">Parent</field>
        <field name="bidirectional">False</field>
        <field name="source_type">i</field>
        <field name="destination_type">i</field>
        <field name="vocabulary_code_id" ref="code_rel_child"/>
    </record>

    <record id="rel_parent" model="spp.relationship">
        <field name="name">Parent</field>
        <field name="name_inverse">Child</field>
        <field name="bidirectional">False</field>
        <field name="source_type">i</field>
        <field name="destination_type">i</field>
        <field name="vocabulary_code_id" ref="code_rel_parent"/>
    </record>

    <record id="rel_sibling" model="spp.relationship">
        <field name="name">Sibling</field>
        <field name="name_inverse">Sibling</field>
        <field name="bidirectional">True</field>
        <field name="source_type">i</field>
        <field name="destination_type">i</field>
        <field name="vocabulary_code_id" ref="code_rel_sibling"/>
    </record>

    <record id="rel_grandparent" model="spp.relationship">
        <field name="name">Grandparent</field>
        <field name="name_inverse">Grandchild</field>
        <field name="bidirectional">False</field>
        <field name="source_type">i</field>
        <field name="destination_type">i</field>
        <field name="vocabulary_code_id" ref="code_rel_grandparent"/>
    </record>

    <record id="rel_grandchild" model="spp.relationship">
        <field name="name">Grandchild</field>
        <field name="name_inverse">Grandparent</field>
        <field name="bidirectional">False</field>
        <field name="source_type">i</field>
        <field name="destination_type">i</field>
        <field name="vocabulary_code_id" ref="code_rel_grandchild"/>
    </record>

    <record id="rel_other_relative" model="spp.relationship">
        <field name="name">Other Relative</field>
        <field name="name_inverse">Other Relative</field>
        <field name="bidirectional">True</field>
        <field name="source_type">i</field>
        <field name="destination_type">i</field>
        <field name="vocabulary_code_id" ref="code_rel_other"/>
    </record>

    <record id="rel_non_relative" model="spp.relationship">
        <field name="name">Non-Relative</field>
        <field name="name_inverse">Non-Relative</field>
        <field name="bidirectional">True</field>
        <field name="source_type">i</field>
        <field name="destination_type">i</field>
        <field name="vocabulary_code_id" ref="code_rel_non_relative"/>
    </record>
</odoo>
