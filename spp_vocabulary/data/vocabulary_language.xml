    <!--
        Language Vocabulary - Full ISO 639-1 (184 codes)

        Reference: https://www.loc.gov/standards/iso639-2/php/code_list.php
        Data source: https://github.com/datasets/language-codes

        ISO 639-1 defines 184 two-letter codes for major world languages.
        For languages without ISO 639-1 codes, use ISO 639-2/3 codes.

        Special codes:
        - sgn: Sign language (ISO 639-2)
        - und: Undetermined
        - zxx: No linguistic content

        Generated: 2025-01
    -->
    <record id="vocab_language" model="spp.vocabulary">
        <field name="name">Language (ISO 639)</field>
        <field name="namespace_uri">urn:iso:std:iso:639</field>
        <field name="version">2024</field>
        <field name="description">Complete ISO 639-1 language codes (184 codes). Two-letter codes for major world languages. For languages without ISO 639-1 codes, deployments may extend with ISO 639-2/3 codes.</field>
        <field name="reference_url">https://www.loc.gov/standards/iso639-2/php/code_list.php</field>
        <field name="is_system">True</field>
        <field name="is_hierarchical">False</field>
        <field name="domain">core</field>
    </record>

