<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
        <!-- Users can only see their own view history -->
        <record id="rule_view_history_own" model="ir.rule">
            <field name="name">View History: Own Records Only</field>
            <field name="model_id" ref="model_spp_registry_view_history" />
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="global">True</field>
        </record>
</odoo>
