<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="spp_registry_search.SearchPortal">
        <div class="o_registry_search_portal o_action">
            <div class="container-fluid py-4">
                <!-- Header with Create Buttons -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="mb-0">
                        <i class="fa fa-search me-2" aria-hidden="true" />Registry
                    </h2>
                    <t t-if="state.canCreate">
                        <div class="btn-group">
                            <button
                                class="btn btn-primary"
                                t-on-click="createNewIndividual"
                                type="button"
                            >
                                <i
                                class="fa fa-user-plus me-1"
                                aria-hidden="true"
                            />New Individual
                            </button>
                            <button
                                class="btn btn-primary"
                                t-on-click="createNewGroup"
                                type="button"
                            >
                                <i
                                class="fa fa-users me-1"
                                aria-hidden="true"
                            />New Group
                            </button>
                        </div>
                    </t>
                </div>

                <!-- Search Section -->
                <div class="card mb-4 shadow-sm">
                    <div class="card-body">
                        <div class="row g-3">
                            <!-- Main Search Input -->
                            <div
                                t-att-class="'col-md-' + (state.searchMode === 'targeted' ? '6' : '8')"
                            >
                                <label
                                    for="registrySearchInput"
                                    class="visually-hidden"
                                >Search registrants</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-white">
                                        <i
                                            class="fa fa-search text-muted"
                                            aria-hidden="true"
                                        />
                                    </span>
                                    <input
                                        type="text"
                                        id="registrySearchInput"
                                        class="form-control"
                                        t-att-placeholder="searchPlaceholder"
                                        t-att-aria-label="searchPlaceholder"
                                        aria-describedby="searchHelpText"
                                        t-att-value="state.searchTerm"
                                        t-on-input="onSearchInput"
                                        t-on-keydown="onSearchKeydown"
                                    />
                                    <button
                                        class="btn btn-primary"
                                        type="button"
                                        t-on-click="performSearch"
                                        t-att-disabled="state.searchTerm.length &lt; minSearchChars"
                                        aria-label="Search"
                                    >
                                        <i class="fa fa-search" aria-hidden="true" />
                                    </button>
                                    <button
                                        class="btn btn-outline-secondary"
                                        type="button"
                                        t-on-click="toggleAdvanced"
                                        t-att-aria-expanded="state.showAdvanced"
                                        aria-controls="advancedFilters"
                                    >
                                        <i
                                        t-att-class="state.showAdvanced ? 'fa fa-chevron-up' : 'fa fa-chevron-down'"
                                        aria-hidden="true"
                                    />
                                        Advanced
                                    </button>
                                </div>
                                <small id="searchHelpText" class="text-muted">
                                    Enter at least <t
                                    t-esc="minSearchChars"
                                /> characters to search, or press Enter
                                </small>
                            </div>

                            <!-- Search Field Selector (targeted mode) -->
                            <div
                                class="col-md-2"
                                t-if="state.searchMode === 'targeted'"
                            >
                                <label
                                    for="registryFieldFilter"
                                    class="visually-hidden"
                                >Search field</label>
                                <select
                                    id="registryFieldFilter"
                                    class="form-select form-select-lg"
                                    aria-label="Select search field"
                                    t-on-change="onSearchFieldChange"
                                >
                                    <option
                                        value="name"
                                        t-att-selected="state.searchField === 'name'"
                                    >Name</option>
                                    <option
                                        value="id_number"
                                        t-att-selected="state.searchField === 'id_number'"
                                    >ID Number</option>
                                    <option
                                        value="phone"
                                        t-att-selected="state.searchField === 'phone'"
                                    >Phone</option>
                                    <option
                                        value="email"
                                        t-att-selected="state.searchField === 'email'"
                                    >Email</option>
                                </select>
                            </div>

                            <!-- Search Type Filter -->
                            <div
                                t-att-class="'col-md-' + (state.searchMode === 'targeted' ? '2' : '4')"
                            >
                                <label
                                    for="registryTypeFilter"
                                    class="visually-hidden"
                                >Filter by registrant type</label>
                                <select
                                    id="registryTypeFilter"
                                    class="form-select form-select-lg"
                                    aria-label="Filter by registrant type"
                                    t-on-change="onSearchTypeChange"
                                >
                                    <option
                                        value="all"
                                        t-att-selected="state.searchType === 'all'"
                                    >
                                        All Registrants
                                    </option>
                                    <option
                                        value="individuals"
                                        t-att-selected="state.searchType === 'individuals'"
                                    >
                                        Individuals Only
                                    </option>
                                    <option
                                        value="groups"
                                        t-att-selected="state.searchType === 'groups'"
                                    >
                                        Groups Only
                                    </option>
                                </select>
                            </div>
                        </div>

                        <!-- Advanced Filters (collapsible) -->
                        <div
                            t-if="state.showAdvanced"
                            id="advancedFilters"
                            class="mt-3 pt-3 border-top"
                        >
                            <div
                                class="d-flex justify-content-between align-items-center mb-2"
                            >
                                <span class="fw-semibold">Advanced Filters</span>
                                <button
                                    class="btn btn-sm btn-link text-decoration-none"
                                    type="button"
                                    t-on-click="clearAdvancedFilters"
                                >
                                    <i
                                    class="fa fa-times me-1"
                                    aria-hidden="true"
                                />Clear Filters
                                </button>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label
                                        class="form-label small text-muted"
                                        for="filterDateFrom"
                                    >Registered From</label>
                                    <input
                                        type="date"
                                        id="filterDateFrom"
                                        class="form-control"
                                        t-att-value="state.advancedFilters.registrationDateFrom"
                                        t-on-change="(ev) => this.onAdvancedFilterChange('registrationDateFrom', ev)"
                                    />
                                </div>
                                <div class="col-md-6">
                                    <label
                                        class="form-label small text-muted"
                                        for="filterDateTo"
                                    >Registered To</label>
                                    <input
                                        type="date"
                                        id="filterDateTo"
                                        class="form-control"
                                        t-att-value="state.advancedFilters.registrationDateTo"
                                        t-on-change="(ev) => this.onAdvancedFilterChange('registrationDateTo', ev)"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Loading State with aria-live for screen readers -->
                <div
                    t-if="state.isSearching"
                    class="text-center py-5"
                    role="status"
                    aria-live="polite"
                >
                    <i
                        class="fa fa-spinner fa-spin fa-3x text-primary"
                        aria-hidden="true"
                    />
                    <p class="mt-3 text-muted">Searching...</p>
                </div>

                <!-- Search Results -->
                <t t-elif="state.hasSearched">
                    <div class="mb-4" role="region" aria-label="Search results">
                        <div
                            class="d-flex justify-content-between align-items-center mb-3"
                        >
                            <h5 class="mb-0" aria-live="polite">
                                <t t-if="state.hasMoreResults">
                                    <t t-esc="state.totalCount" />+ Result(s) Found
                                </t>
                                <t t-else="">
                                    <t t-esc="state.totalCount" /> Result(s) Found
                                </t>
                            </h5>
                            <button
                                class="btn btn-sm btn-outline-secondary"
                                t-on-click="clearSearch"
                                type="button"
                            >
                                <i
                                class="fa fa-times me-1"
                                aria-hidden="true"
                            />Clear Search
                            </button>
                        </div>

                        <div
                            t-if="state.results.length === 0"
                            class="alert alert-info"
                            role="alert"
                        >
                            <i class="fa fa-info-circle me-2" aria-hidden="true" />
                            No registrants found matching your search criteria.
                        </div>

                        <div t-else="" class="list-group shadow-sm" role="list">
                            <t
                                t-foreach="state.results"
                                t-as="result"
                                t-key="result.id"
                            >
                                <button
                                    type="button"
                                    class="list-group-item list-group-item-action d-flex align-items-center text-start"
                                    t-attf-class="list-group-item list-group-item-action d-flex align-items-center text-start {{ result.disabled ? 'text-muted opacity-75' : '' }}"
                                    t-on-click="() => this.openRegistrant(result.id, result.is_group)"
                                    role="listitem"
                                >
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between">
                                            <h6 class="mb-1">
                                                <t t-esc="result.name" />
                                                <span
                                                    t-if="result.disabled"
                                                    class="badge bg-warning ms-2"
                                                >Disabled</span>
                                            </h6>
                                            <small class="text-muted">
                                                <t
                                                    t-esc="formatDate(result.registration_date)"
                                                />
                                            </small>
                                        </div>
                                        <small class="text-muted">
                                            <span class="badge bg-light text-dark me-2">
                                                <i
                                                    t-att-class="'fa me-1 ' + getRegistrantIcon(result.is_group)"
                                                    aria-hidden="true"
                                                />
                                                <t
                                                    t-esc="getRegistrantTypeLabel(result.is_group)"
                                                />
                                            </span>
                                            <t t-if="result.phone">
                                                <i
                                                    class="fa fa-phone me-1"
                                                    aria-hidden="true"
                                                />
                                                <t t-esc="result.phone" />
                                            </t>
                                            <t t-if="result.email">
                                                <span
                                                    t-if="result.phone"
                                                    class="mx-2"
                                                >|</span>
                                                <i
                                                    class="fa fa-envelope me-1"
                                                    aria-hidden="true"
                                                />
                                                <t t-esc="result.email" />
                                            </t>
                                        </small>
                                    </div>
                                    <i
                                        class="fa fa-chevron-right text-muted"
                                        aria-hidden="true"
                                    />
                                </button>
                            </t>
                        </div>
                    </div>
                </t>

                <!-- Recently Viewed Section (shown when no search) -->
                <t t-elif="state.recentlyViewed.length > 0">
                    <div
                        class="mb-4"
                        role="region"
                        aria-label="Recently viewed registrants"
                    >
                        <div
                            class="d-flex justify-content-between align-items-center mb-3"
                        >
                            <h5 class="mb-0">
                                <i
                                class="fa fa-clock-o me-2"
                                aria-hidden="true"
                            />Recently Viewed
                            </h5>
                            <button
                                class="btn btn-sm btn-outline-secondary"
                                t-on-click="clearHistory"
                                type="button"
                            >
                                <i
                                class="fa fa-trash me-1"
                                aria-hidden="true"
                            />Clear History
                            </button>
                        </div>
                        <div class="row g-3">
                            <t
                                t-foreach="state.recentlyViewed"
                                t-as="recent"
                                t-key="recent.id"
                            >
                                <div class="col-md-4 col-lg-3">
                                    <button
                                        type="button"
                                        class="card h-100 shadow-sm o_recent_card w-100 border-0 text-start"
                                        t-on-click="() => this.openRegistrant(recent.id, recent.is_group)"
                                        t-on-keydown="(ev) => this.onRecentCardKeydown(ev, recent.id, recent.is_group)"
                                        t-att-aria-label="'View ' + recent.name"
                                    >
                                        <div class="card-body text-center">
                                            <h6
                                                class="card-title mb-1 text-truncate"
                                                t-att-title="recent.name"
                                            >
                                                <t t-esc="recent.name" />
                                            </h6>
                                            <small class="text-muted d-block">
                                                <i
                                                    t-att-class="'fa me-1 ' + getRegistrantIcon(recent.is_group)"
                                                    aria-hidden="true"
                                                />
                                                <t
                                                    t-esc="getRegistrantTypeLabel(recent.is_group)"
                                                />
                                            </small>
                                            <small class="text-muted">
                                                <t
                                                    t-esc="formatRelativeTime(recent.view_date)"
                                                />
                                            </small>
                                        </div>
                                    </button>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>

                <!-- Empty State (no recent, no search) -->
                <t t-else="">
                    <div class="text-center py-5" role="status">
                        <i
                            class="fa fa-search fa-4x text-muted mb-3"
                            aria-hidden="true"
                        />
                        <h4 class="text-muted">Search for Registrants</h4>
                        <p class="text-muted">
                            Enter your search criteria to find registrants.
                        </p>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
