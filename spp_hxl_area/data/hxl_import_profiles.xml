<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Sri Lanka Damage Assessment Profile -->
    <record id="profile_sl_damage" model="spp.hxl.import.profile">
        <field name="name">Sri Lanka Damage Assessment</field>
        <field name="code">sl_damage_assessment</field>
        <field
            name="description"
        >Import damage assessment data from Sri Lanka field surveys. Matches areas by name and aggregates damaged households by severity.</field>
        <field name="area_matching_strategy">name</field>
        <field name="area_column_tag">#adm4+name</field>
        <field name="area_level">4</field>
        <field name="sequence">10</field>
    </record>

    <!-- Sri Lanka Damage Assessment Rules -->
    <record id="rule_sl_severe" model="spp.hxl.aggregation.rule">
        <field name="profile_id" ref="profile_sl_damage" />
        <field name="name">Severely Damaged Households</field>
        <field name="aggregation_type">count</field>
        <field
            name="filter_expression"
        >row.get('#impact+type') in ['severe', 'destroyed', 'completely_damaged']</field>
        <field name="output_hxl_tag">#affected+hh+severe</field>
        <field name="sequence">10</field>
    </record>

    <record id="rule_sl_partial" model="spp.hxl.aggregation.rule">
        <field name="profile_id" ref="profile_sl_damage" />
        <field name="name">Partially Damaged Households</field>
        <field name="aggregation_type">count</field>
        <field
            name="filter_expression"
        >row.get('#impact+type') in ['partial', 'minor_damage', 'moderate']</field>
        <field name="output_hxl_tag">#affected+hh+partial</field>
        <field name="sequence">20</field>
    </record>

    <record id="rule_sl_total" model="spp.hxl.aggregation.rule">
        <field name="profile_id" ref="profile_sl_damage" />
        <field name="name">Total Affected Households</field>
        <field name="aggregation_type">count</field>
        <field name="output_hxl_tag">#affected+hh</field>
        <field name="sequence">30</field>
    </record>

    <!-- Philippines Beneficiary Coverage Profile -->
    <record id="profile_ph_coverage" model="spp.hxl.import.profile">
        <field name="name">Philippines Beneficiary Coverage</field>
        <field name="code">ph_beneficiary_coverage</field>
        <field
            name="description"
        >Import beneficiary coverage data using P-codes. Tracks reached individuals with demographic disaggregation.</field>
        <field name="area_matching_strategy">pcode</field>
        <field name="area_column_tag">#adm4+pcode</field>
        <field name="area_level">4</field>
        <field name="sequence">20</field>
    </record>

    <!-- Philippines Coverage Rules -->
    <record id="rule_ph_beneficiaries" model="spp.hxl.aggregation.rule">
        <field name="profile_id" ref="profile_ph_coverage" />
        <field name="name">Total Beneficiaries</field>
        <field name="aggregation_type">count</field>
        <field name="output_hxl_tag">#reached+ind</field>
        <field name="disaggregate_by_tags">+f,+m,+children,+elderly</field>
        <field name="sequence">10</field>
    </record>

    <record id="rule_ph_households" model="spp.hxl.aggregation.rule">
        <field name="profile_id" ref="profile_ph_coverage" />
        <field name="name">Beneficiary Households</field>
        <field name="aggregation_type">count_distinct</field>
        <field name="source_column_tag">#household+id</field>
        <field name="output_hxl_tag">#reached+hh</field>
        <field name="sequence">20</field>
    </record>

    <!-- OCHA 3W Import Profile -->
    <record id="profile_ocha_3w" model="spp.hxl.import.profile">
        <field name="name">OCHA 3W Import</field>
        <field name="code">ocha_3w</field>
        <field
            name="description"
        >Import Who does What Where (3W) data from humanitarian coordination. Aggregates people reached by sector at district level.</field>
        <field name="area_matching_strategy">pcode</field>
        <field name="area_column_tag">#adm2+pcode</field>
        <field name="area_level">2</field>
        <field name="sequence">30</field>
    </record>

    <!-- OCHA 3W Rules -->
    <record id="rule_ocha_reached" model="spp.hxl.aggregation.rule">
        <field name="profile_id" ref="profile_ocha_3w" />
        <field name="name">People Reached</field>
        <field name="aggregation_type">sum</field>
        <field name="source_column_tag">#reached+ind</field>
        <field name="output_hxl_tag">#reached+ind</field>
        <field name="sequence">10</field>
    </record>

    <record id="rule_ocha_organizations" model="spp.hxl.aggregation.rule">
        <field name="profile_id" ref="profile_ocha_3w" />
        <field name="name">Number of Organizations</field>
        <field name="aggregation_type">count_distinct</field>
        <field name="source_column_tag">#org+name</field>
        <field name="output_hxl_tag">#org+count</field>
        <field name="sequence">20</field>
    </record>

    <!-- Generic P-code Import Profile -->
    <record id="profile_generic_pcode" model="spp.hxl.import.profile">
        <field name="name">Generic P-code Import</field>
        <field name="code">generic_pcode</field>
        <field
            name="description"
        >Generic template for importing HXL data using P-code matching. Customize aggregation rules as needed.</field>
        <field name="area_matching_strategy">pcode</field>
        <field name="area_column_tag">#adm2+pcode</field>
        <field name="area_level">2</field>
        <field name="sequence">100</field>
    </record>

    <record id="rule_generic_count" model="spp.hxl.aggregation.rule">
        <field name="profile_id" ref="profile_generic_pcode" />
        <field name="name">Total Records</field>
        <field name="aggregation_type">count</field>
        <field name="output_hxl_tag">#meta+count</field>
        <field name="sequence">10</field>
    </record>

    <!-- GPS-based Import Profile -->
    <record id="profile_gps_survey" model="spp.hxl.import.profile">
        <field name="name">GPS Survey Import</field>
        <field name="code">gps_survey</field>
        <field
            name="description"
        >Import field survey data using GPS coordinates. Automatically matches to areas based on geographic location.</field>
        <field name="area_matching_strategy">gps</field>
        <field name="area_column_tag">#geo+lat</field>
        <field name="latitude_tag">#geo+lat</field>
        <field name="longitude_tag">#geo+lon</field>
        <field name="area_level">3</field>
        <field name="sequence">40</field>
    </record>

    <record id="rule_gps_observations" model="spp.hxl.aggregation.rule">
        <field name="profile_id" ref="profile_gps_survey" />
        <field name="name">Survey Observations</field>
        <field name="aggregation_type">count</field>
        <field name="output_hxl_tag">#meta+count</field>
        <field name="sequence">10</field>
    </record>
</odoo>
