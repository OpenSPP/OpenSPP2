<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_hxl_import_profile_tree" model="ir.ui.view">
        <field name="name">spp.hxl.import.profile.tree</field>
        <field name="model">spp.hxl.import.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="area_matching_strategy" />
                <field name="area_level" />
                <field name="batch_count" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hxl_import_profile_form" model="ir.ui.view">
        <field name="name">spp.hxl.import.profile.form</field>
        <field name="model">spp.hxl.import.profile</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="validate_configuration"
                        type="object"
                        string="Validate Configuration"
                        class="btn-secondary"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_batches"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-upload"
                        >
                            <field name="batch_count" widget="statinfo" string="Imports" />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="sequence" />
                            <field name="active" invisible="1" />
                        </group>
                        <group>
                            <field name="incident_id" />
                            <field name="description" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Area Matching" name="area_matching">
                            <group>
                                <group>
                                    <field name="area_matching_strategy" />
                                    <field name="area_column_tag" />
                                    <field name="area_level" />
                                </group>
                                <group>
                                    <field
                                        name="latitude_tag"
                                        invisible="area_matching_strategy != 'gps'"
                                    />
                                    <field
                                        name="longitude_tag"
                                        invisible="area_matching_strategy != 'gps'"
                                    />
                                </group>
                            </group>
                        </page>
                        <page string="Aggregation Rules" name="aggregation_rules">
                            <field name="aggregation_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="aggregation_type" />
                                    <field name="source_column_tag" />
                                    <field name="variable_id" />
                                    <field name="output_hxl_tag" />
                                    <field name="active" widget="boolean_toggle" />
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name" />
                                                <field name="sequence" />
                                                <field name="variable_id" />
                                                <field name="active" />
                                            </group>
                                            <group>
                                                <field name="aggregation_type" />
                                                <field name="source_column_tag" />
                                                <field name="output_hxl_tag" />
                                            </group>
                                        </group>
                                        <group>
                                            <field name="filter_expression" />
                                            <field name="disaggregate_by_tags" />
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hxl_import_profile_search" model="ir.ui.view">
        <field name="name">spp.hxl.import.profile.search</field>
        <field name="model">spp.hxl.import.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <field name="area_matching_strategy" />
                <separator />
                <filter
                    name="filter_active"
                    string="Active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    name="filter_archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group>
                    <filter
                        name="group_strategy"
                        string="Matching Strategy"
                        context="{'group_by': 'area_matching_strategy'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hxl_import_profile" model="ir.actions.act_window">
        <field name="name">HXL Import Profiles</field>
        <field name="res_model">spp.hxl.import.profile</field>
        <field name="view_mode">list,form</field>
        <field name="path">hxl-import-profiles</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first HXL Import Profile
            </p>
            <p>
                Import profiles define how to match HXL data to areas and which aggregation rules to apply.
            </p>
        </field>
    </record>
</odoo>
