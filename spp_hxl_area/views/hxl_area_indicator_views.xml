<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_hxl_area_indicator_tree" model="ir.ui.view">
        <field name="name">spp.hxl.area.indicator.tree</field>
        <field name="model">spp.hxl.area.indicator</field>
        <field name="arch" type="xml">
            <list>
                <field name="area_name" />
                <field name="variable_name" />
                <field name="period_key" />
                <field name="value" />
                <field name="value_count" />
                <field name="hxl_tag" />
                <field name="batch_id" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hxl_area_indicator_form" model="ir.ui.view">
        <field name="name">spp.hxl.area.indicator.form</field>
        <field name="model">spp.hxl.area.indicator</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="sync_to_data_value"
                        type="object"
                        string="Sync to Data Values"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="area_id" />
                            <field name="variable_id" />
                            <field name="rule_id" />
                        </group>
                        <group>
                            <field name="batch_id" />
                            <field name="period_key" />
                            <field name="incident_id" />
                        </group>
                    </group>
                    <group>
                        <group string="Values">
                            <field name="value" />
                            <field name="value_count" />
                            <field name="hxl_tag" />
                        </group>
                        <group string="Metadata">
                            <field name="source_type" />
                        </group>
                    </group>
                    <group string="Disaggregation" invisible="not disaggregation_json">
                        <field
                            name="disaggregation_json"
                            widget="ace"
                            options="{'mode': 'javascript'}"
                        />
                    </group>
                    <group string="Notes">
                        <field name="notes" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hxl_area_indicator_search" model="ir.ui.view">
        <field name="name">spp.hxl.area.indicator.search</field>
        <field name="model">spp.hxl.area.indicator</field>
        <field name="arch" type="xml">
            <search>
                <field name="area_id" />
                <field name="variable_id" />
                <field name="period_key" />
                <field name="batch_id" />
                <separator />
                <group>
                    <filter
                        name="group_area"
                        string="Area"
                        context="{'group_by': 'area_id'}"
                    />
                    <filter
                        name="group_variable"
                        string="Variable"
                        context="{'group_by': 'variable_id'}"
                    />
                    <filter
                        name="group_period"
                        string="Period"
                        context="{'group_by': 'period_key'}"
                    />
                    <filter
                        name="group_batch"
                        string="Batch"
                        context="{'group_by': 'batch_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hxl_area_indicator" model="ir.actions.act_window">
        <field name="name">HXL Area Indicators</field>
        <field name="res_model">spp.hxl.area.indicator</field>
        <field name="view_mode">list,form</field>
        <field name="path">hxl-area-indicators</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No indicators yet
            </p>
            <p>
                Area indicators are generated from HXL import batches.
            </p>
        </field>
    </record>
</odoo>
