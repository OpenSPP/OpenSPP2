<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Cron job to check escalation rules periodically -->
    <record id="cron_check_grm_escalations" model="ir.cron">
        <field name="name">GRM: Check Escalation Rules</field>
        <field name="model_id" ref="model_spp_grm_escalation_rule" />
        <field name="state">code</field>
        <field name="code">model.check_escalations()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True" />
    </record>
</odoo>
