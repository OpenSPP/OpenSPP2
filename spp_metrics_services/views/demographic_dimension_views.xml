<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Demographic Dimension Form View -->
    <record id="view_demographic_dimension_form" model="ir.ui.view">
        <field name="name">spp.demographic.dimension.form</field>
        <field name="model">spp.demographic.dimension</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="label"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="dimension_type" widget="radio"/>
                            <field name="applies_to"/>
                        </group>
                    </group>

                    <group invisible="dimension_type != 'field'">
                        <field name="field_path" placeholder="gender_id.code"/>
                    </group>

                    <group invisible="dimension_type != 'expression'">
                        <field name="cel_expression" widget="ace"
                               placeholder="r.disability_id != null ? 'pwd' : 'non_pwd'"/>
                    </group>

                    <group string="Value Configuration">
                        <field name="value_labels_json" widget="ace" options="{'mode': 'json'}"
                               placeholder='{"M": "Male", "F": "Female"}'/>
                        <field name="default_value"/>
                    </group>

                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Demographic Dimension List View -->
    <record id="view_demographic_dimension_list" model="ir.ui.view">
        <field name="name">spp.demographic.dimension.list</field>
        <field name="model">spp.demographic.dimension</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="label"/>
                <field name="dimension_type"/>
                <field name="applies_to"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Demographic Dimension Search View -->
    <record id="view_demographic_dimension_search" model="ir.ui.view">
        <field name="name">spp.demographic.dimension.search</field>
        <field name="model">spp.demographic.dimension</field>
        <field name="arch" type="xml">
            <search string="Search Dimensions">
                <field name="name"/>
                <field name="label"/>
                <separator/>
                <filter string="Field-based" name="filter_field" domain="[('dimension_type', '=', 'field')]"/>
                <filter string="Expression-based" name="filter_expression" domain="[('dimension_type', '=', 'expression')]"/>
                <separator/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Type" name="group_by_type" context="{'group_by': 'dimension_type'}"/>
                <filter string="Applies To" name="group_by_applies" context="{'group_by': 'applies_to'}"/>
            </search>
        </field>
    </record>

    <!-- Demographic Dimension Action -->
    <record id="action_demographic_dimension" model="ir.actions.act_window">
        <field name="name">Demographic Dimensions</field>
        <field name="res_model">spp.demographic.dimension</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure demographic dimensions
            </p>
            <p>
                Dimensions define how to categorize registrants for breakdowns
                (e.g., by gender, disability status, area, age group).
            </p>
        </field>
    </record>
</odoo>
