<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Event Type for CR Audit Trail (ADR-002) -->
    <record id="event_type_cr_audit" model="spp.event.type">
        <field name="name">Change Request Audit</field>
        <field name="code">cr_audit</field>
        <field name="category">manual</field>
        <field name="target_type">both</field>
        <field
            name="description"
        >Audit trail events for change request state transitions</field>
    </record>

    <!-- Event Type for CR Conflict Detection -->
    <record id="event_type_cr_conflict" model="spp.event.type">
        <field name="name">Change Request Conflict</field>
        <field name="code">cr_conflict</field>
        <field name="category">manual</field>
        <field name="target_type">both</field>
        <field
            name="description"
        >Audit trail events for conflict detection and resolution</field>
    </record>
</odoo>
