<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Change Request Record Rules -->

    <!-- Users can see their own CRs and CRs for registrants they have access to -->
    <record id="rule_cr_user" model="ir.rule">
        <field name="name">Change Request: User Access</field>
        <field name="model_id" ref="model_spp_change_request"/>
        <field name="domain_force">[
            '|',
            ('create_uid', '=', user.id),
            ('registrant_id', 'in', user.partner_id.ids)
        ]</field>
        <field name="groups" eval="[Command.link(ref('group_cr_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Validators can see all CRs -->
    <record id="rule_cr_validator" model="ir.rule">
        <field name="name">Change Request: Validator Access</field>
        <field name="model_id" ref="model_spp_change_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_cr_validator'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- HQ Validators can see all CRs -->
    <record id="rule_cr_validator_hq" model="ir.rule">
        <field name="name">Change Request: HQ Validator Access</field>
        <field name="model_id" ref="model_spp_change_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_cr_validator_hq'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Managers have full access -->
    <record id="rule_cr_manager" model="ir.rule">
        <field name="name">Change Request: Manager Access</field>
        <field name="model_id" ref="model_spp_change_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_cr_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    </data>
</odoo>
