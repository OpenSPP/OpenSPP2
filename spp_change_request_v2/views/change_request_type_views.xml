<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Change Request Type Form View -->
    <record id="spp_change_request_type_form" model="ir.ui.view">
        <field name="name">spp.change.request.type.form</field>
        <field name="model">spp.change.request.type</field>
        <field name="arch" type="xml">
            <form>
                <!-- Locking Banner for non-editable types -->
                <div
                    class="alert alert-warning mb-0"
                    role="alert"
                    invisible="is_studio_editable"
                >
                    <div class="d-flex align-items-center">
                        <span class="fa fa-lock me-2 fs-4" title="Locked" />
                        <div>
                            <strong>This change request type is locked</strong>
                            <p class="mb-0 mt-1" invisible="not locked_reason">
                                <field name="locked_reason" readonly="1" nolabel="1" />
                            </p>
                            <p class="mb-0 mt-1" invisible="locked_reason">
                                This type requires custom Python code and cannot be modified via the UI.
                            </p>
                        </div>
                    </div>
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_change_requests"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list"
                        >
                            <field
                                name="change_request_count"
                                widget="statinfo"
                                string="Requests"
                            />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Type Name" />
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Info">
                            <field name="code" />
                            <field name="sequence" />
                            <field name="active" invisible="1" />
                            <field name="icon" />
                            <field name="color" widget="color_picker" />
                        </group>
                        <group string="Target">
                            <field name="target_type" />
                            <field name="is_requires_registrant" />
                            <field name="is_requires_applicant" />
                        </group>
                        <group
                            string="Group Membership"
                            invisible="target_type == 'individual'"
                        >
                            <field name="allow_empty_members" />
                            <field name="requires_head" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Customization" name="customization">
                            <group>
                                <group string="Editability">
                                    <field name="is_studio_editable" />
                                    <field name="is_studio_cloneable" />
                                    <field name="is_system_type" readonly="1" />
                                </group>
                                <group string="Source">
                                    <field name="source_module" readonly="1" />
                                    <field name="cloned_from_id" readonly="1" />
                                </group>
                            </group>
                            <group
                                string="Lock Information"
                                invisible="is_studio_editable"
                            >
                                <field name="locked_reason" nolabel="1" colspan="2" />
                            </group>
                        </page>
                        <page string="Detail Model" name="detail">
                            <group>
                                <group>
                                    <field name="detail_model" />
                                    <field name="detail_form_view_id" />
                                    <field
                                        name="is_detail_model_exists"
                                        invisible="1"
                                    />
                                    <field name="available_field_ids" invisible="1" />
                                </group>
                            </group>
                            <group
                                string="Required Fields"
                                invisible="not is_detail_model_exists"
                            >
                                <p class="text-muted" colspan="2">
                                    Select which fields must be filled before the change request can be submitted for approval.
                                </p>
                                <field
                                    name="required_field_ids"
                                    nolabel="1"
                                    colspan="2"
                                    widget="many2many_tags"
                                    domain="[('id', 'in', available_field_ids)]"
                                />
                            </group>
                        </page>
                        <page
                            string="ID Operations"
                            name="id_operations"
                            invisible="detail_model != 'spp.cr.detail.update_id'"
                        >
                            <group string="Allowed ID Operations">
                                <field name="allow_id_add" readonly="1" />
                                <field name="allow_id_edit" />
                                <field name="allow_id_remove" />
                            </group>
                            <div class="alert alert-info" role="status">
                                <p class="mb-0">
                                    <strong>Add ID</strong> is always enabled.
                                    Toggle <strong>Edit ID</strong> and <strong
                                >Remove ID</strong>
                                    to control which operations are available to users.
                                </p>
                            </div>
                        </page>
                        <page string="Apply Configuration" name="apply">
                            <group>
                                <group>
                                    <field name="apply_strategy" />
                                    <field name="auto_apply_on_approve" />
                                </group>
                            </group>
                            <group
                                string="Custom Apply"
                                invisible="apply_strategy != 'custom'"
                            >
                                <field name="apply_model" />
                                <field name="apply_method" />
                            </group>
                            <group
                                string="Field Mappings"
                                invisible="apply_strategy != 'field_mapping'"
                            >
                                <field name="apply_mapping_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle" />
                                        <field name="source_field" />
                                        <field name="routing_field" optional="hide" />
                                        <field name="target_field" />
                                        <field name="transform" />
                                        <field
                                            name="transform_expression"
                                            invisible="transform != 'expression'"
                                        />
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Approval" name="approval">
                            <group>
                                <field name="approval_definition_id" />
                                <field name="auto_approve_from_event" />
                            </group>
                            <separator string="Dynamic Approval" />
                            <field name="use_dynamic_approval" />
                            <group invisible="not use_dynamic_approval">
                                <group colspan="2">
                                    <field
                                        name="candidate_definition_ids"
                                        widget="many2many_tags"
                                    />
                                </group>
                                <div class="alert alert-info" role="status" colspan="2">
                                    <p>
                                        <strong>How it works:</strong>
                                    </p>
                                    <p>
                                        When dynamic approval is enabled, the user selects a
                                        single field to modify on the detail form. Each
                                        candidate definition should have a CEL condition.
                                    </p>
                                    <p>
                                        <strong>Available CEL variables:</strong>
                                    </p>
                                    <ul>
                                        <li>
                                            <code>record.selected_field_name</code>
                                            — the selected field name
                                        </li>
                                        <li>
                                            <code>old_value</code>
                                            — typed old value from registrant
                                        </li>
                                        <li>
                                            <code>new_value</code>
                                            — typed new value from detail record
                                        </li>
                                    </ul>
                                    <p>
                                        Definitions are evaluated in sequence order. First
                                        match wins. If none match, the default Approval
                                        Workflow above is used.
                                    </p>
                                </div>
                            </group>
                        </page>
                        <page string="Documents" name="documents">
                            <field name="supports_reason_documents" invisible="1" />
                            <group>
                                <field name="document_validation_mode" />
                                <field name="allow_document_download" />
                            </group>
                            <group string="Document Type Configuration">
                                <field
                                    name="available_document_ids"
                                    widget="many2many_tags"
                                    placeholder="Select which document types can be uploaded..."
                                    options="{'no_create': True, 'no_quick_create': True}"
                                />
                                <field
                                    name="required_document_ids"
                                    widget="many2many_tags"
                                    placeholder="Select which documents are required..."
                                    options="{'no_create': True, 'no_quick_create': True}"
                                />
                            </group>
                            <div invisible="not supports_reason_documents">
                                <separator string="Required Documents by Reason" />
                                <div class="text-muted mb-2">
                                    Optional. When set, the request's
                                    <strong>Reason for Change</strong> determines which
                                    documents are required (overriding the flat
                                    "Required Documents" list above for that reason).
                                </div>
                                <field name="reason_document_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="reason" />
                                        <field
                                            name="required_document_ids"
                                            widget="many2many_tags"
                                            options="{'no_create': True, 'no_quick_create': True}"
                                        />
                                    </list>
                                </field>
                            </div>
                            <group
                                string="Legacy Configuration (Deprecated)"
                                invisible="not required_document_type_ids"
                            >
                                <field
                                    name="required_document_type_ids"
                                    widget="many2many_tags"
                                    readonly="1"
                                />
                            </group>
                        </page>
                    </notebook>
                    <field name="description" placeholder="Description..." />
                </sheet>
            </form>
        </field>
    </record>

    <!-- Change Request Type List View -->
    <record id="spp_change_request_type_list" model="ir.ui.view">
        <field name="name">spp.change.request.type.list</field>
        <field name="model">spp.change.request.type</field>
        <field name="arch" type="xml">
            <list decoration-muted="not is_studio_editable">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="target_type" />
                <field name="apply_strategy" />
                <field
                    name="is_studio_editable"
                    string="Editable"
                    widget="boolean_toggle"
                />
                <field
                    name="is_studio_cloneable"
                    string="Cloneable"
                    widget="boolean_toggle"
                />
                <field name="is_system_type" string="System" />
                <field name="change_request_count" />
            </list>
        </field>
    </record>

    <!-- Change Request Type Action -->
    <record id="action_change_request_type" model="ir.actions.act_window">
        <field name="name">Change Request Types</field>
        <field name="res_model">spp.change.request.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first change request type
            </p>
            <p>
                Change request types define what information is collected
                and how changes are applied to registrants.
            </p>
        </field>
    </record>
</odoo>
