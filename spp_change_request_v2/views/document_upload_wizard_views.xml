<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Document Upload Wizard Form -->
    <record id="view_spp_cr_document_upload_wizard_form" model="ir.ui.view">
        <field name="name">spp.cr.document.upload.wizard.form</field>
        <field name="model">spp.cr.document.upload.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="change_request_id" invisible="1" />
                    <field name="document_type_domain" invisible="1" />
                    <field name="show_required_categories" invisible="1" />

                    <group>
                        <field
                            name="directory_id"
                            readonly="1"
                            string="Storage Location"
                        />
                    </group>

                    <!-- Show available document types -->
                    <field
                        name="required_categories_text"
                        nolabel="1"
                        widget="html"
                        invisible="required_categories_text == ''"
                        readonly="1"
                    />

                    <group>
                        <group string="Document Information">
                            <field
                                name="document_type_id"
                                string="Document Type"
                                domain="document_type_domain"
                                options="{'no_create': True, 'no_open': True}"
                            />
                            <field
                                name="filename"
                                placeholder="e.g., birth_certificate.pdf"
                            />
                        </group>
                        <group string="File Upload">
                            <field
                                name="content"
                                filename="filename"
                                widget="binary"
                                nolabel="1"
                            />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_upload"
                        string="Upload"
                        type="object"
                        class="btn-primary"
                        data-hotkey="s"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="z"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
