<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!--
        Protection concern vocabularies.

        The codes are Primero's stock ``lookup-protection-concerns`` and ``lookup-risk-level`` ids
        so that the OpenFn mapping to Primero is the identity. A Primero deployment may customise
        its lookups; any deployment-specific mapping belongs in the OpenFn job, not here.
        ``domain`` has no child-protection value; ``social_assistance`` is the nearest fit.
    -->
    <record id="vocab_protection_concern" model="spp.vocabulary">
        <field name="name">Protection Concern</field>
        <field name="namespace_uri">urn:openspp:vocab:protection-concern</field>
        <field name="version">1.0</field>
        <field
            name="description"
        >Child protection concern types, aligned with Primero's lookup-protection-concerns.</field>
        <field name="is_system">True</field>
        <field name="domain">social_assistance</field>
    </record>

    <record id="code_concern_sexually_exploited" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_protection_concern" />
        <field name="code">sexually_exploited</field>
        <field name="display">Sexually Exploited</field>
        <field name="sequence">10</field>
    </record>
    <record id="code_concern_gbv_survivor" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_protection_concern" />
        <field name="code">gbv_survivor</field>
        <field name="display">GBV Survivor</field>
        <field name="sequence">20</field>
    </record>
    <record id="code_concern_trafficked_smuggled" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_protection_concern" />
        <field name="code">trafficked_smuggled</field>
        <field name="display">Trafficked / Smuggled</field>
        <field name="sequence">30</field>
    </record>
    <record id="code_concern_statelessness" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_protection_concern" />
