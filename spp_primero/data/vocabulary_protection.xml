    <record id="vocab_protection_risk_level" model="spp.vocabulary">
        <field name="name">Protection Risk Level</field>
        <field name="namespace_uri">urn:openspp:vocab:protection-risk-level</field>
        <field name="version">1.0</field>
        <field
            name="description"
