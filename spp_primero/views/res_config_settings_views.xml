<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_res_config_settings_form_inherit_spp_primero" model="ir.ui.view">
        <field name="name">res.config.settings.form.primero</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="999" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    string="Primero Referral"
                    name="spp_primero_settings"
                    logo="/spp_primero/static/description/icon.png"
                >
                    <block title="OpenFn Webhook" name="spp_primero_webhook_block">
                        <setting
                            string="Webhook URL"
                            help="The webhook trigger URL of the OpenFn workflow that refers a child to Primero. It must be reachable from this server and use https (plain http only for an OpenFn on this machine)."
                        >
                            <field
                                name="primero_webhook_url"
                                placeholder="https://lightning.example.org/i/..."
                            />
                        </setting>
                        <setting
                            string="Webhook API Key"
                            help="The API key attached to the webhook trigger in OpenFn, sent as the x-api-key header. Leave empty if the trigger has no key."
                        >
                            <field name="primero_webhook_api_key" password="true" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
