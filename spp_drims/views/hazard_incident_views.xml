<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Extend Hazard Incident Form View with DRIMS Alert Thresholds -->
    <record id="view_hazard_incident_form_drims" model="ir.ui.view">
        <field name="name">view.hazard.incident.form.drims</field>
        <field name="model">spp.hazard.incident</field>
        <field name="inherit_id" ref="spp_hazard.view_hazard_incident_form" />
        <field name="arch" type="xml">
            <!--
                OP#1159: temporarily hide the "Impacts" tab on incidents,
                pending the full impact-tracking implementation in #1155.
                Done in the DRIMS-inherited view so it only applies where DRIMS
                is installed and is trivial to revert once #1155 lands.
            -->
            <xpath expr="//page[@name='impacts']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Add Alert Thresholds page to notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Alert Thresholds" name="alert_thresholds">
                    <group name="alert_thresholds_info">
                        <p class="text-muted">
                            Configure incident-specific alert thresholds. When set, these values override
                            the global DRIMS configuration for this incident only. Leave empty to use
                            global settings from DRIMS Configuration.
                        </p>
                    </group>
                    <group name="alert_thresholds_main">
                        <group name="stock_thresholds" string="Stock Thresholds">
                            <field
                                name="drims_low_stock_threshold_override"
                                placeholder="Leave empty for global setting"
                            />
                        </group>
                        <group name="expiry_thresholds" string="Expiry Thresholds">
                            <field
                                name="drims_expiry_warning_override"
                                placeholder="Leave empty for global setting"
                            />
                            <field
                                name="drims_expiry_critical_override"
                                placeholder="Leave empty for global setting"
                            />
                        </group>
                    </group>
                    <group name="alert_thresholds_sla">
                        <group name="sla_thresholds" string="SLA Thresholds">
                            <field
                                name="drims_sla_warning_override"
                                placeholder="Leave empty for global setting"
                            />
                        </group>
                        <group />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
