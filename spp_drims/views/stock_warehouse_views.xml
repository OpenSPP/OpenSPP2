<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Stock Warehouse Form View - Add DRIMS Fields -->
    <record id="view_warehouse_form_drims" model="ir.ui.view">
        <field name="name">stock.warehouse.form.drims</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse" />
        <field name="arch" type="xml">
            <!-- Add smart buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="%(spp_drims.action_drims_donation)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-gift"
                    invisible="drims_donation_count == 0 or not is_drims_warehouse"
                    context="{'search_default_warehouse_id': id}"
                >
                    <field
                        name="drims_donation_count"
                        widget="statinfo"
                        string="Donations"
                    />
                </button>
                <button
                    name="%(spp_drims.action_drims_dispatch)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-truck"
                    invisible="drims_dispatch_count == 0 or not is_drims_warehouse"
                    context="{'search_default_warehouse_id': id, 'search_default_drims_type': 'request_dispatch'}"
                >
                    <field
                        name="drims_dispatch_count"
                        widget="statinfo"
                        string="Dispatches"
                    />
                </button>
                <button
                    name="action_view_active_alerts"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-exclamation-triangle"
                    invisible="drims_active_alert_count == 0 or not is_drims_warehouse"
                >
                    <field
                        name="drims_active_alert_count"
                        widget="statinfo"
                        string="Alerts"
                    />
                </button>
                <button
                    name="action_view_expired_stock"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-clock-o"
                    invisible="not is_drims_warehouse"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Expired Stock</span>
                    </div>
                </button>
                <button
                    name="action_dispose_expired_stock"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-trash"
                    invisible="not is_drims_warehouse"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Dispose Expired</span>
                    </div>
                </button>
            </xpath>

            <!--
                OP#959 round-2: the standard `stock.view_warehouse` notebook
                is gated by `groups="stock.group_adv_location,
                stock.group_stock_multi_warehouses"` (advanced inventory
                roles), so attaching the DRIMS Configuration page inside
                that notebook hides it for admins that don't carry those
                groups. Wrap it in our own un-gated notebook anchored
                just before the standard one — page is always reachable
                when is_drims_warehouse is on, regardless of inventory
                role membership.
            -->
            <xpath expr="//sheet/notebook" position="before">
                <notebook>
                    <page
                        string="DRIMS Configuration"
                        name="drims_config"
                        invisible="not is_drims_warehouse"
                    >
                        <!--
                            Active Response at the top, full-width, so the
                            incidents this warehouse is responding to are
                            the first thing the user sees on the tab. The
                            field carries colspan="2" so it spans both
                            sub-columns of the group (default col=2);
                            colspan on the group itself is a no-op here
                            since the parent <page> has no column grid.
                        -->
                        <group string="Active Response" name="active_response">
                            <field
                                name="incident_ids"
                                widget="many2many_tags"
                                nolabel="1"
                                colspan="2"
                                invisible="not is_drims_warehouse"
                            />
                        </group>

                        <group>
                            <group
                                string="Disaster Response Configuration"
                                name="drims_settings"
                            >
                                <field name="is_drims_warehouse" />
                                <field name="tier" invisible="not is_drims_warehouse" />
                                <field
                                    name="drims_capacity"
                                    invisible="not is_drims_warehouse"
                                />
                                <field
                                    name="area_id"
                                    invisible="not is_drims_warehouse"
                                />
                                <field
                                    name="gis_location"
                                    widget="geo_point"
                                    invisible="not is_drims_warehouse"
                                />
                            </group>
                            <group string="Emergency Contact" name="emergency_contact">
                                <field
                                    name="emergency_contact"
                                    invisible="not is_drims_warehouse"
                                />
                                <field
                                    name="emergency_phone"
                                    invisible="not is_drims_warehouse"
                                />
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>

            <!-- Add DRIMS checkbox in general info -->
            <xpath expr="//field[@name='code']" position="after">
                <field name="is_drims_warehouse" />
            </xpath>
        </field>
    </record>

    <!-- Stock Warehouse Tree View - Add DRIMS Fields -->
    <record id="view_warehouse_tree_drims" model="ir.ui.view">
        <field name="name">stock.warehouse.tree.drims</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_drims_warehouse" optional="show" />
                <!-- OP#959: surface tier on the list, optional by default -->
                <field name="tier" optional="show" widget="badge" />
                <field
                    name="drims_stock_health"
                    widget="badge"
                    optional="show"
                    decoration-danger="drims_stock_health == 'critical'"
                    decoration-warning="drims_stock_health == 'warning'"
                    decoration-success="drims_stock_health == 'good'"
                />
                <field name="drims_active_alert_count" optional="hide" />
                <field name="drims_capacity" optional="hide" />
                <field name="area_id" optional="hide" />
            </xpath>
        </field>
    </record>

    <!-- Stock Warehouse Search View - DRIMS Extension -->
    <record id="view_warehouse_search_drims" model="ir.ui.view">
        <field name="name">stock.warehouse.search.drims</field>
        <field name="model">stock.warehouse</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <search string="Warehouses">
                <field name="name" />
                <field name="code" />
                <field name="area_id" />
                <field name="tier" />
                <separator />
                <filter
                    string="DRIMS Warehouses"
                    name="drims_warehouses"
                    domain="[('is_drims_warehouse', '=', True)]"
                />
                <separator />
                <!-- OP#959: tier filters for quick triage of central / regional / mobile -->
                <filter
                    string="Central"
                    name="tier_central"
                    domain="[('tier', '=', 'central')]"
                />
                <filter
                    string="Regional"
                    name="tier_regional"
                    domain="[('tier', '=', 'regional')]"
                />
                <filter
                    string="Mobile"
                    name="tier_mobile"
                    domain="[('tier', '=', 'mobile')]"
                />
                <separator />
                <group>
                    <filter
                        string="Coverage Area"
                        name="group_area"
                        context="{'group_by': 'area_id'}"
                    />
                    <filter
                        string="Tier"
                        name="group_tier"
                        context="{'group_by': 'tier'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!--
        OP#959: GIS view for stock.warehouse. The `geo_point` widget on
        the form's gis_location field requires a `<gis>` view to exist
        for the model — without one, opening a warehouse throws "No GIS
        view defined for the model stock.warehouse".
    -->
    <record id="view_warehouse_gis_drims" model="ir.ui.view">
        <field name="name">stock.warehouse.gis.drims</field>
        <field name="model">stock.warehouse</field>
        <field eval="16" name="priority" />
        <field name="arch" type="xml">
            <gis editable="1">
                <field name="id" />
                <field name="name" select="1" />
                <field name="code" />
                <field name="tier" />
                <field name="is_drims_warehouse" />
                <field name="gis_location" />
            </gis>
        </field>
    </record>

    <!--
        Vector + raster layers for the warehouse GIS view. The data
        layer renders each warehouse's gis_location point; the OSM
        raster layer provides the base map (without it the GIS view
        crashes with "No raster layer for view stock.warehouse.gis.drims").
    -->
    <record id="gis_data_layer_warehouse_location" model="spp.gis.data.layer">
        <field
            name="geo_field_id"
            ref="spp_drims.field_stock_warehouse__gis_location"
        />
        <field name="name">Warehouse Location</field>
        <field eval="1" name="sequence" />
        <field name="view_id" ref="view_warehouse_gis_drims" />
        <field name="geo_repr">basic</field>
        <field name="active_on_startup" eval="True" />
        <field name="layer_opacity">0.9</field>
        <field name="begin_color">#1F78B4</field>
    </record>

    <record id="gis_raster_layer_warehouse_osm" model="spp.gis.raster.layer">
        <field name="raster_type">osm</field>
        <field name="name">Default</field>
        <field name="view_id" ref="view_warehouse_gis_drims" />
    </record>

    <!-- DRIMS Warehouse Action -->
    <record id="action_drims_warehouse" model="ir.actions.act_window">
        <field name="name">DRIMS Warehouses</field>
        <field name="res_model">stock.warehouse</field>
        <field name="view_mode">list,form</field>
        <field name="path">drims-warehouses</field>
        <field name="context">{'search_default_drims_warehouses': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a DRIMS Warehouse
            </p>
            <p>
                DRIMS warehouses are designated for disaster relief inventory management.
                Enable the 'DRIMS Warehouse' checkbox on any warehouse to use it for disaster response.
            </p>
        </field>
    </record>
</odoo>
