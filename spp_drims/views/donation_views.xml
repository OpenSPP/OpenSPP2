<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Donation List View -->
    <record id="view_drims_donation_list" model="ir.ui.view">
        <field name="name">spp.drims.donation.list</field>
        <field name="model">spp.drims.donation</field>
        <field name="arch" type="xml">
            <list
                decoration-info="state == 'announced'"
                decoration-success="state == 'stocked'"
                decoration-warning="state == 'inspected'"
            >
                <field name="reference" />
                <field name="name" optional="hide" />
                <field name="incident_id" />
                <field name="donor_id" />
                <field name="donor_name" optional="hide" />
                <field name="source_type_id" optional="hide" />
                <field name="warehouse_id" />
                <field name="date_announced" optional="hide" />
                <field name="date_expected" optional="hide" />
                <field name="date_received" optional="show" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'announced'"
                    decoration-success="state == 'stocked'"
                    decoration-warning="state == 'inspected'"
                    decoration-muted="state == 'rejected'"
                />
                <field name="line_count" string="Items" optional="hide" />
                <field name="total_value" sum="Total Value" />
            </list>
        </field>
    </record>

    <!-- Donation Form View -->
    <record id="view_drims_donation_form" model="ir.ui.view">
        <field name="name">spp.drims.donation.form</field>
        <field name="model">spp.drims.donation</field>
        <field name="arch" type="xml">
            <form string="Donation">
                <header>
                    <button
                        name="action_mark_announced"
                        string="Mark Announced"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <!-- OP#1163: open a wizard to enter received quantities
                         instead of erroring when they aren't filled in yet. -->
                    <button
                        name="action_open_receive_wizard"
                        string="Mark Received"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'announced'"
                    />
                    <button
                        name="action_open_inspection_wizard"
                        string="Inspect Items"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'received'"
                    />
                    <button
                        name="action_stock"
                        string="Stock Items"
                        type="object"
                        class="btn-success"
                        invisible="state != 'inspected' or not has_acceptable_items"
                        confirm="This will add items to warehouse inventory. Continue?"
                    />
                    <button
                        name="action_reject"
                        string="Reject"
                        type="object"
                        class="btn-outline-danger"
                        invisible="state != 'inspected'"
                        confirm="Reject this donation? Items will not be added to inventory."
                    />
                    <field name="has_acceptable_items" invisible="1" />
                    <field name="product_expiry_installed" invisible="1" />
                    <button
                        name="action_cancel"
                        string="Cancel Donation"
                        type="object"
                        class="btn-secondary"
                        invisible="state in ('stocked', 'rejected', 'cancelled')"
                        confirm="Cancel this donation? Any pending transfers will be cancelled."
                    />
                    <!--
                        OP#960: render state as a read-only indicator.
                        All transitions go through the header buttons
                        (Mark Received / Inspect Items / Stock Items /
                        Reject / Cancel) which run the proper validation;
                        a clickable statusbar would let users bypass that.
                    -->
                    <field name="state_id" widget="statusbar" />
                </header>
                <sheet>
                    <div
                        class="alert alert-info"
                        role="alert"
                        invisible="state != 'inspected' or has_acceptable_items"
                    >
                        <strong>Nothing to Stock.</strong>
                        Every line on this donation was marked for return, disposal, or quarantine
                        during inspection, so no items will enter inventory.
                        Click <strong>Reject</strong> to close this donation.
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_pickings"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-truck"
                            invisible="picking_count == 0"
                        >
                            <field
                                name="picking_count"
                                widget="statinfo"
                                string="Transfers"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="reference" />
                        <h1>
                            <field name="reference" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group name="donor_info">
                            <field name="incident_id" options="{'no_create': True}" />
                            <field name="donor_id" options="{'no_create_edit': True}" />
                            <field name="donor_name" invisible="donor_id" />
                            <field
                                name="source_type_id"
                                options="{'no_create': True}"
                            />
                        </group>
                        <group name="logistics_info">
                            <field name="warehouse_id" options="{'no_create': True}" />
                            <field name="date_announced" />
                            <field name="date_expected" />
                            <field name="date_received" readonly="1" />
                        </group>
                    </group>
                    <group>
                        <group name="summary_info">
                            <field name="line_count" />
                            <field name="total_value" />
                        </group>
                        <group name="state_info">
                            <field name="state" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Donation Items" name="items">
                            <!--
                                OP#1055: items can be added/edited/removed while
                                the donation is in draft or announced (during
                                receiving a late-announced item can still be added
                                with a selectable product). Making the field
                                read-only from 'received' onward removes the
                                "Add a line" row that otherwise let users create
                                empty, product-less lines on an already-received
                                donation.
                            -->
                            <!--
                                OP#1058: entry table for building the donation
                                (editable in draft/announced, read-only while
                                received). Once inspected it is hidden and
                                replaced by the accepted_line_ids table below, so
                                non-accepted items are not duplicated across both
                                this table and "Items Not Accepted for Stock".
                            -->
                            <field
                                name="line_ids"
                                class="o_drims_donation_list"
                                readonly="state not in ('draft', 'announced')"
                                invisible="state in ('inspected', 'stocked')"
                            >
                                <!--
                                    OP#1076: columns appear progressively with the
                                    donation lifecycle.
                                    - draft: product, Pledged (entered here)
                                    - announced: + Received (manual, mandatory) + Variance
                                    - inspected/stocked: + Condition + Action (from inspection)
                                    "Expiry Date" only when the product_expiry module
                                    is installed.
                                -->
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <!--
                                        OP#1108: a product added inline here must
                                        be a storable Good, otherwise it never
                                        tracks in inventory / shows in Stock on
                                        Hand. The context defaults make any
                                        quick-created product storable.
                                    -->
                                    <field
                                        name="product_id"
                                        options="{'no_create_edit': True}"
                                        context="{'default_type': 'consu', 'default_is_storable': True}"
                                        readonly="parent.state not in ('draft', 'announced')"
                                    />
                                    <field
                                        name="quantity_pledged"
                                        string="Pledged"
                                        readonly="parent.state not in ('draft', 'announced')"
                                    />
                                    <!--
                                        OP#1076: Received is entered MANUALLY on the
                                        announced donation (no auto-copy from Pledged)
                                        and is mandatory before "Mark Received".
                                    -->
                                    <field
                                        name="quantity_received"
                                        string="Received"
                                        column_invisible="parent.state == 'draft'"
                                        readonly="parent.state != 'announced'"
                                        required="parent.state == 'announced'"
                                    />
                                    <field
                                        name="receipt_variance"
                                        string="Variance"
                                        column_invisible="parent.state == 'draft'"
                                        decoration-danger="receipt_variance &lt; 0"
                                    />
                                    <!-- column_invisible, not invisible: inside a
                                         list the latter blanks the cells but
                                         still renders the column, which is why
                                         an empty "Quantity" column was showing
                                         between Pledged and Unit (OP#1076). -->
                                    <field name="quantity" column_invisible="1" />
                                    <field
                                        name="uom_id"
                                        options="{'no_create': True}"
                                    />
                                    <field name="unit_value" />
                                    <field name="value" />
                                    <field
                                        name="condition_id"
                                        string="Condition"
                                        column_invisible="parent.state not in ('inspected', 'stocked')"
                                        readonly="1"
                                    />
                                    <field
                                        name="disposition_id"
                                        string="Action"
                                        column_invisible="parent.state not in ('inspected', 'stocked')"
                                        readonly="1"
                                    />
                                    <field name="lot_number" optional="show" />
                                    <field
                                        name="expiry_date"
                                        column_invisible="not parent.product_expiry_installed or parent.state == 'draft'"
                                    />
                                </list>
                            </field>
                            <!--
                                OP#1058: once inspected, the "Donation Items"
                                table shows the accepted items only; the excluded
                                ones appear solely in "Items Not Accepted for
                                Stock" below (no duplication).
                            -->
                            <field
                                name="accepted_line_ids"
                                readonly="1"
                                class="o_drims_donation_list"
                                invisible="state not in ('inspected', 'stocked')"
                            >
                                <list>
                                    <field name="product_id" />
                                    <field name="quantity_pledged" string="Pledged" />
                                    <field name="quantity_received" string="Received" />
                                    <field
                                        name="receipt_variance"
                                        string="Variance"
                                        decoration-danger="receipt_variance &lt; 0"
                                    />
                                    <field name="uom_id" />
                                    <field name="unit_value" />
                                    <field name="value" />
                                    <field name="condition_id" string="Condition" />
                                    <field name="disposition_id" string="Action" />
                                    <field name="lot_number" optional="show" />
                                </list>
                            </field>
                            <!--
                                OP#1076: once inspected, any items whose
                                disposition excludes them from stock (return /
                                dispose / quarantine) are listed separately so
                                it is clear what will NOT enter inventory.
                            -->
                            <separator
                                string="Items Not Accepted for Stock"
                                invisible="state not in ('inspected', 'stocked') or not non_accepted_line_ids"
                            />
                            <field
                                name="non_accepted_line_ids"
                                readonly="1"
                                class="o_drims_donation_list"
                                invisible="state not in ('inspected', 'stocked') or not non_accepted_line_ids"
                            >
                                <list>
                                    <field name="product_id" />
                                    <field name="quantity_pledged" string="Pledged" />
                                    <field name="quantity_received" string="Received" />
                                    <field
                                        name="receipt_variance"
                                        string="Variance"
                                        decoration-danger="receipt_variance &lt; 0"
                                    />
                                    <field name="uom_id" />
                                    <field name="condition_id" string="Condition" />
                                    <field name="disposition_id" string="Action" />
                                    <!-- OP#1058: follow-up disposal tracking -->
                                    <field
                                        name="disposal_state"
                                        string="Disposal"
                                        widget="badge"
                                        decoration-warning="disposal_state == 'pending'"
                                        decoration-success="disposal_state == 'resolved'"
                                    />
                                    <field name="disposal_date" optional="show" />
                                    <button
                                        name="action_mark_disposal_resolved"
                                        type="object"
                                        string="Mark Resolved"
                                        icon="fa-check"
                                        invisible="disposal_state != 'pending'"
                                    />
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field
                                name="notes"
                                placeholder="Additional notes about this donation..."
                            />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Donation Search View -->
    <record id="view_drims_donation_search" model="ir.ui.view">
        <field name="name">spp.drims.donation.search</field>
        <field name="model">spp.drims.donation</field>
        <field name="arch" type="xml">
            <search>
                <!-- Searchpanel for quick filtering -->
                <searchpanel>
                    <field
                        name="incident_id"
                        icon="fa-exclamation-triangle"
                        enable_counters="1"
                    />
                    <field
                        name="state_id"
                        select="multi"
                        icon="fa-tasks"
                        enable_counters="1"
                    />
                    <field
                        name="warehouse_id"
                        select="multi"
                        icon="fa-warehouse"
                        enable_counters="1"
                    />
                </searchpanel>

                <field name="reference" />
                <field name="name" />
                <field name="incident_id" />
                <field name="donor_id" />
                <field name="donor_name" />
                <field name="warehouse_id" />
                <separator />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="announced"
                    string="Announced"
                    domain="[('state', '=', 'announced')]"
                />
                <filter
                    name="received"
                    string="Received"
                    domain="[('state', '=', 'received')]"
                />
                <filter
                    name="inspected"
                    string="Inspected"
                    domain="[('state', '=', 'inspected')]"
                />
                <filter
                    name="stocked"
                    string="Stocked"
                    domain="[('state', '=', 'stocked')]"
                />
                <filter
                    name="rejected"
                    string="Rejected"
                    domain="[('state', '=', 'rejected')]"
                />
                <filter
                    name="cancelled"
                    string="Cancelled"
                    domain="[('state', '=', 'cancelled')]"
                />
                <separator />
                <filter
                    name="expected_soon"
                    string="Expected This Week"
                    domain="[('date_expected', '&gt;=', (context_today()).strftime('%Y-%m-%d')),
                             ('date_expected', '&lt;=', (context_today() + datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"
                />
                <separator />
                <!-- Date Presets -->
                <filter
                    name="last_24h"
                    string="Last 24 Hours"
                    domain="[('date_announced', '&gt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"
                />
                <filter
                    name="last_7d"
                    string="Last 7 Days"
                    domain="[('date_announced', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"
                />
                <filter
                    name="last_30d"
                    string="Last 30 Days"
                    domain="[('date_announced', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"
                />
                <separator />
                <group>
                    <filter
                        name="grp_incident"
                        string="Incident"
                        context="{'group_by': 'incident_id'}"
                    />
                    <filter
                        name="grp_donor"
                        string="Donor"
                        context="{'group_by': 'donor_id'}"
                    />
                    <filter
                        name="grp_warehouse"
                        string="Warehouse"
                        context="{'group_by': 'warehouse_id'}"
                    />
                    <filter
                        name="grp_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="grp_donor_type"
                        string="Donor Type"
                        context="{'group_by': 'source_type_id'}"
                    />
                    <filter
                        name="grp_date_announced"
                        string="Date Announced"
                        context="{'group_by': 'date_announced:month'}"
                    />
                    <filter
                        name="grp_date_received"
                        string="Date Received"
                        context="{'group_by': 'date_received:month'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Donation Graph View (Line chart for donation trends) -->
    <record id="view_drims_donation_graph" model="ir.ui.view">
        <field name="name">spp.drims.donation.graph</field>
        <field name="model">spp.drims.donation</field>
        <field name="arch" type="xml">
            <graph string="Donation Trend" type="line" sample="1">
                <field name="date_announced" interval="week" />
                <field name="total_value" type="measure" />
            </graph>
        </field>
    </record>

    <!-- Donation Pivot View -->
    <record id="view_drims_donation_pivot" model="ir.ui.view">
        <field name="name">spp.drims.donation.pivot</field>
        <field name="model">spp.drims.donation</field>
        <field name="arch" type="xml">
            <pivot string="Donation Analysis" sample="1">
                <field name="incident_id" type="row" />
                <field name="source_type_id" type="col" />
                <field name="total_value" type="measure" />
                <field name="line_count" type="measure" />
            </pivot>
        </field>
    </record>

    <!-- Donation Kanban View (GAP-DON-004) -->
    <record id="view_drims_donation_kanban" model="ir.ui.view">
        <field name="name">spp.drims.donation.kanban</field>
        <field name="model">spp.drims.donation</field>
        <field name="arch" type="xml">
            <kanban
                default_group_by="state"
                class="o_kanban_small_column"
                quick_create="false"
                sample="1"
            >
                <field name="state" />
                <field name="reference" />
                <field name="donor_name" />
                <field name="warehouse_id" />
                <field name="date_expected" />
                <field name="total_value" />
                <field name="line_count" />
                <progressbar
                    field="state"
                    colors='{"announced": "info", "received": "warning", "inspected": "primary", "stocked": "success", "cancelled": "muted", "rejected": "danger"}'
                />
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="reference" />
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <strong>
                                        <field name="donor_name" />
                                    </strong>
                                </div>
                                <div>
                                    <field name="warehouse_id" />
                                </div>
                                <div
                                    t-if="record.date_expected.raw_value"
                                    t-attf-class="#{(new Date(record.date_expected.raw_value) &lt; new Date()) ? 'text-danger fw-bold' : ''}"
                                >
                                    Expected: <field name="date_expected" />
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge bg-secondary">
                                        <field name="line_count" /> items
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="total_value" widget="monetary" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Donation Action -->
    <record id="action_drims_donation" model="ir.actions.act_window">
        <field name="name">Donations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">spp.drims.donation</field>
        <field name="view_mode">list,kanban,graph,pivot,form</field>
        <field name="path">drims-donations</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record your first donation
            </p>
            <p>
                Track donations from individuals, organizations, and governments.
                Monitor incoming supplies, manage inventory, and distribute aid
                effectively during disaster response operations.
            </p>
        </field>
    </record>

    <!-- Donation Line List View (standalone) -->
    <record id="view_drims_donation_line_list" model="ir.ui.view">
        <field name="name">spp.drims.donation.line.list</field>
        <field name="model">spp.drims.donation.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="donation_id" readonly="1" />
                <field name="sequence" widget="handle" />
                <field
                    name="product_id"
                    context="{'default_type': 'consu', 'default_is_storable': True}"
                />
                <field name="quantity" />
                <field name="uom_id" />
                <field name="unit_value" />
                <field name="value" />
                <field name="condition_id" optional="show" />
                <field name="lot_number" optional="show" />
                <field name="expiry_date" optional="show" />
            </list>
        </field>
    </record>

    <!-- Donation Line Form View (standalone) -->
    <record id="view_drims_donation_line_form" model="ir.ui.view">
        <field name="name">spp.drims.donation.line.form</field>
        <field name="model">spp.drims.donation.line</field>
        <field name="arch" type="xml">
            <form string="Donation Item">
                <sheet>
                    <group>
                        <group name="product_info">
                            <field name="donation_id" />
                            <field
                                name="product_id"
                                context="{'default_type': 'consu', 'default_is_storable': True}"
                            />
                            <field name="sequence" />
                        </group>
                        <group name="quantity_info">
                            <field name="quantity" />
                            <field name="uom_id" />
                            <field name="unit_value" />
                            <field name="value" />
                        </group>
                    </group>
                    <group>
                        <group name="condition_info">
                            <field name="condition_id" />
                            <field name="disposition_id" />
                        </group>
                        <group name="tracking_info">
                            <field name="lot_number" />
                            <field name="expiry_date" />
                        </group>
                    </group>
                    <group>
                        <field
                            name="notes"
                            placeholder="Additional notes about this item..."
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════════
         OP#1058: Non-Accepted Items tracking (Return / Dispose / Quarantine)
         ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_drims_non_accepted_line_list" model="ir.ui.view">
        <field name="name">spp.drims.donation.line.non.accepted.list</field>
        <field name="model">spp.drims.donation.line</field>
        <field name="arch" type="xml">
            <list
                string="Non-Accepted Items"
                editable="bottom"
                create="0"
                delete="0"
                decoration-warning="disposal_state == 'pending'"
                decoration-muted="disposal_state == 'resolved'"
            >
                <field name="donation_id" readonly="1" />
                <field name="product_id" readonly="1" />
                <field name="quantity_received" string="Quantity" readonly="1" />
                <field name="uom_id" readonly="1" groups="uom.group_uom" />
                <field name="condition_id" string="Condition" readonly="1" />
                <field name="disposition_id" string="Action" readonly="1" />
                <field
                    name="disposal_state"
                    string="Status"
                    widget="badge"
                    decoration-warning="disposal_state == 'pending'"
                    decoration-success="disposal_state == 'resolved'"
                />
                <field
                    name="disposal_notes"
                    placeholder="What was done with this item..."
                />
                <field name="disposal_date" readonly="1" optional="show" />
                <field name="disposal_user_id" readonly="1" optional="show" />
                <button
                    name="action_mark_disposal_resolved"
                    type="object"
                    string="Mark Resolved"
                    icon="fa-check"
                    invisible="disposal_state != 'pending'"
                />
            </list>
        </field>
    </record>

    <record id="view_drims_non_accepted_line_search" model="ir.ui.view">
        <field name="name">spp.drims.donation.line.non.accepted.search</field>
        <field name="model">spp.drims.donation.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="donation_id" />
                <field name="product_id" />
                <field name="disposition_id" string="Action" />
                <filter
                    name="pending"
                    string="Pending"
                    domain="[('disposal_state', '=', 'pending')]"
                />
                <filter
                    name="resolved"
                    string="Resolved"
                    domain="[('disposal_state', '=', 'resolved')]"
                />
                <separator />
                <!-- Group By -->
                <group>
                    <filter
                        name="group_action"
                        string="Action"
                        context="{'group_by': 'disposition_id'}"
                    />
                    <filter
                        name="group_status"
                        string="Status"
                        context="{'group_by': 'disposal_state'}"
                    />
                    <filter
                        name="group_donation"
                        string="Donation"
                        context="{'group_by': 'donation_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_drims_non_accepted_items" model="ir.actions.act_window">
        <field name="name">Non-Accepted Items</field>
        <field name="res_model">spp.drims.donation.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_drims_non_accepted_line_list" />
        <field name="search_view_id" ref="view_drims_non_accepted_line_search" />
        <field name="domain">[('disposal_state', '!=', False)]</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to follow up</p>
            <p>
                Items excluded from stock during inspection (Return, Dispose or
                Quarantine) appear here so their handling can be recorded and audited.
            </p>
        </field>
    </record>
</odoo>
