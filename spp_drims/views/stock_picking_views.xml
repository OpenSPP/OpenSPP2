<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Stock Picking Form View - Add DRIMS Fields -->
    <record id="view_picking_form_drims" model="ir.ui.view">
        <field name="name">stock.picking.form.drims</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <!-- Add smart buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="%(spp_drims.action_drims_donation)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-gift"
                    invisible="drims_donation_id == False"
                    context="{'search_default_id': drims_donation_id}"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Donation</span>
                    </div>
                </button>
                <button
                    name="%(spp_drims.action_drims_request)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-handshake-o"
                    invisible="drims_request_id == False"
                    context="{'search_default_id': drims_request_id}"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Request</span>
                    </div>
                </button>
                <button
                    name="%(spp_hazard.action_hazard_incident)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-exclamation-triangle"
                    invisible="incident_id == False"
                    context="{'search_default_id': incident_id}"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Incident</span>
                    </div>
                </button>
                <button
                    name="action_view_drims_return"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-undo"
                    invisible="drims_return_id == False"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Return</span>
                    </div>
                </button>
            </xpath>

            <!-- Add Create Return button in header for completed dispatches -->
            <xpath expr="//header" position="inside">
                <button
                    name="action_create_drims_return"
                    string="Create Return"
                    type="object"
                    class="btn-secondary"
                    invisible="drims_type != 'request_dispatch' or state != 'done' or drims_return_id != False"
                />
                <!-- Print Waybill button (GAP-DIS-002) -->
                <button
                    name="%(spp_drims.action_report_drims_waybill)d"
                    string="Print Waybill"
                    type="action"
                    class="btn-secondary"
                    invisible="not drims_type_id or state == 'draft'"
                    icon="fa-print"
                />
            </xpath>

            <!--
                OP#970: hide the standard Print + Return buttons when this is
                a DRIMS picking. The dispatch already exposes Print Waybill
                (above) and Create Return (above) which route through the
                DRIMS-specific report + return wizard; the standard ones
                produce duplicates that confuse users.

                The action-button names for the standard Print + Return
                buttons use the percent-paren xmlid-resolution sigil and
                get rewritten to numeric IDs at view-parse time, so xpath
                cannot match them by name. We discriminate by `data-hotkey`
                + the button's existing `invisible` expression instead.
                (Avoid writing the literal sigil here — Odoo's parser
                runs the regex over comments too and tries to resolve.)
            -->
            <xpath
                expr="//header/button[@name='do_print_picking']"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >state != 'assigned' or drims_type_id</attribute>
            </xpath>
            <!-- Target the core buttons by their action XML ID rather than by
                 data-hotkey / invisible-text matching, which breaks if core
                 changes a hotkey or modifier. The done-state delivery "Print"
                 and the "Return" buttons are both hidden for DRIMS pickings. -->
            <xpath
                expr="//header/button[@name='%(stock.action_report_delivery)d']"
                position="attributes"
            >
                <attribute name="invisible">state != 'done' or drims_type_id</attribute>
            </xpath>
            <xpath
                expr="//header/button[@name='%(stock.act_stock_return_picking)d']"
                position="attributes"
            >
                <attribute name="invisible">state != 'done' or drims_type_id</attribute>
            </xpath>

            <!--
                OP#1150 round 2: a request dispatch is generated from its
                request — action_create_dispatch sets the operation type, the
                source location and the source document — so none of them is
                the dispatcher's to change. Core only locks them once the
                picking is done or cancelled, which left them editable for the
                whole working life of a dispatch.

                Each condition restates core's own rule and adds the dispatch
                case, because position="attributes" replaces the attribute
                outright rather than extending it. Ordinary transfers, donation
                receipts and returns keep core's behaviour untouched.

                Both header fields need disambiguating. Core declares
                picking_type_id twice — once here and once column_invisible in
                the moves list — and location_id three times: a copy hidden
                behind !stock.group_stock_multi_locations, the visible Source
                Location behind that same group, and another in the list. An
                unqualified //field[@name='...'] takes the first match, which
                for location_id is the invisible copy, so the lock would have
                silently applied to a field nobody can see.
            -->
            <xpath
                expr="//field[@name='picking_type_id'][not(ancestor::list)]"
                position="attributes"
            >
                <attribute
                    name="readonly"
                >state in ('done', 'cancel') or drims_type == 'request_dispatch'</attribute>
            </xpath>
            <!--
                Source Location needs a second copy rather than just going
                read-only. A read-only many2one still renders as a link to the
                location, and ``no_open`` cannot be made conditional because
                ``options`` is parsed as a static dict — the same constraint as
                OP#1158's hazard category. Core sets no_open on
                picking_type_id already, which is why that one is inert; it does
                not on location_id.

                So core's copy is hidden on a dispatch and an inert one shown in
                its place. The replacement repeats the multi-locations group,
                or a single-location installation would start seeing a Source
                Location field it is not meant to have.
            -->
            <xpath
                expr="//field[@name='location_id'][@groups='stock.group_stock_multi_locations']"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >picking_type_code == 'incoming' or drims_type == 'request_dispatch'</attribute>
            </xpath>
            <xpath
                expr="//field[@name='location_id'][@groups='stock.group_stock_multi_locations']"
                position="after"
            >
                <field
                    name="location_id"
                    string="Source Location"
                    groups="stock.group_stock_multi_locations"
                    readonly="1"
                    invisible="drims_type != 'request_dispatch'"
                    options="{'no_create': True, 'no_open': True}"
                />
            </xpath>
            <xpath
                expr="//field[@name='origin'][not(ancestor::list)]"
                position="attributes"
            >
                <attribute
                    name="readonly"
                >state in ['cancel', 'done'] or drims_type == 'request_dispatch'</attribute>
            </xpath>

            <!--
                OP#1150 round 2: the products on a dispatch are whatever the
                request approved, so the line's product must not be swapped for
                another. Quantity deliberately stays editable — entering less
                than Demand is how a partial dispatch and its backorder are
                produced (OP#1087).

                ``parent.`` because the modifier is evaluated against the move
                line, and drims_type belongs to the picking.
            -->
            <xpath
                expr="//page[@name='operations']/field[@name='move_ids']/list/field[@name='product_id']"
                position="attributes"
            >
                <attribute
                    name="readonly"
                >(state != 'draft' and not additional) or move_lines_count &gt; 0 or parent.drims_type == 'request_dispatch'</attribute>
            </xpath>

            <!--
                OP#1075 originally locked the Operations moves list on a dispatch
                by making the whole field readonly, so that users could not add
                products. That attribute has been removed: a readonly list also
                blocks editing Quantity, and entering less than Demand is how a
                partial dispatch and its backorder are produced (OP#1087) — so it
                took the short-shipment flow out with it.

                OP#1057: a request dispatch may only ship what its request
                approved, so its line-up is locked — no "Add a Product" row and
                no deleting lines.

                Quantity stays editable on purpose. OP#1075 first locked this
                list by making the whole field readonly, but a readonly x2many
                also blocks editing Quantity, and entering less than Demand is
                how a partial dispatch and its backorder are produced (OP#1087)
                — so that attribute took the short-shipment flow out with it and
                has since been removed. Hence create/delete domains rather than
                a wholesale readonly.

                These have to go in ``options`` rather than being bare
                ``create``/``delete`` attributes on the field. The x2many field
                passes its ``options`` dict through as ``crudOptions``
                (``x2ManyField.extractProps``), and useActiveActions evaluates
                each entry as a *domain* against the parent record
                (``new Domain(action).contains(evalContext)`` in the web client's
                relational_utils.js) — which is what lets them depend on
                drims_type. Bare create/delete attributes on the field tag are
                ignored; only the inner <list> honours those, and only as static
                booleans. ``drims_type`` is in the DRIMS page below, so it is
                loaded and present in the eval context.

                The model-side guard in _check_drims_dispatch_matches_request is
                what actually enforces this — it refuses at validation anything
                the request never approved, covering RPC and imports too. These
                options only keep the UI from inviting the mistake.
            -->
            <xpath
                expr="//page[@name='operations']/field[@name='move_ids']"
                position="attributes"
            >
                <attribute
                    name="options"
                >{'create': [('drims_type', '!=', 'request_dispatch')], 'delete': [('drims_type', '!=', 'request_dispatch')]}</attribute>
            </xpath>

            <!--
                OP#1150: on a dispatch, "Delivery Address" is dead weight —
                partner_id is left blank because relief goods go to a location,
                not a customer, so the field only invited people to fill in
                something meaningless. Show the destination location instead.

                Core hides location_dest_id for outgoing pickings
                (invisible="picking_type_code == 'outgoing'") and keeps an
                ungated copy at invisible="1", which is why a dispatch had no
                destination on screen at all. Rather than un-hide core's copy —
                which is behind stock.group_stock_multi_locations and so would
                stay invisible wherever that group is off — add a read-only one
                scoped to dispatches. It is populated by
                spp.drims.request.action_create_dispatch, from the request's
                destination warehouse where one is set.
            -->
            <xpath
                expr="//div[hasclass('o_td_label')][label[@for='partner_id']]"
                position="attributes"
            >
                <attribute name="invisible">drims_type == 'request_dispatch'</attribute>
            </xpath>
            <xpath
                expr="//field[@name='partner_id'][@nolabel='1']"
                position="attributes"
            >
                <attribute name="invisible">drims_type == 'request_dispatch'</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id'][@nolabel='1']" position="after">
                <field
                    name="location_dest_id"
                    string="Destination Location"
                    readonly="1"
                    invisible="drims_type != 'request_dispatch'"
                    options="{'no_open': True, 'no_create': True}"
                />
            </xpath>

            <!--
                OP#1150: the DRIMS tab is where the dispatch is actually worked,
                so it sits second, right after Operations, instead of last. Added
                after the Operations page rather than appended to the notebook.
            -->
            <xpath expr="//page[@name='operations']" position="after">
                <page
                    string="Dispatch &amp; Delivery"
                    name="drims"
                    invisible="drims_type_id == False"
                >
                    <group>
                        <!--
                            OP#1150 round 2: on a request dispatch every one of
                            these is set by the system, not the dispatcher —
                            the type, request and incident come from
                            action_create_dispatch and the waybill number from
                            the spp.drims.waybill sequence. They are shown so
                            the dispatch can be identified, not edited.

                            Scoped to dispatches so a donation receipt keeps its
                            editable donation link.
                        -->
                        <group string="DRIMS Information" name="drims_info">
                            <field
                                name="drims_type_id"
                                readonly="drims_type == 'request_dispatch'"
                            />
                            <field name="drims_type" invisible="1" />
                            <field
                                name="waybill_number"
                                readonly="drims_type == 'request_dispatch'"
                            />
                            <field
                                name="drims_donation_id"
                                invisible="drims_type not in ['donation_receipt']"
                            />
                            <field
                                name="drims_request_id"
                                invisible="drims_type not in ['request_dispatch']"
                                readonly="drims_type == 'request_dispatch'"
                            />
                            <field
                                name="incident_id"
                                readonly="drims_type == 'request_dispatch'"
                            />
                        </group>
                        <group string="Transport Details" name="transport">
                            <field name="transport_mode_id" />
                            <field name="vehicle_registration" />
                            <field name="driver_name" />
                            <field name="driver_phone" />
                        </group>
                    </group>

                    <!-- Beneficiary Tracking - Visible for dispatches -->
                    <group invisible="drims_type != 'request_dispatch'">
                        <group string="Distribution Details">
                            <field
                                name="beneficiary_area_id"
                                options="{'no_create': True}"
                                required="drims_type == 'request_dispatch'"
                            />
                            <!--
                                OP#967 round-3: use spp_base_common's
                                integer_positive_required widget so the
                                field reports as empty when value is 0
                                (standard IntegerField considers any int
                                "set", which suppresses the required
                                asterisk + pink-highlight on 0). The
                                model-side button_validate check still
                                rejects beneficiary_count <= 0 — the
                                widget just provides the visual cue.
                            -->
                            <field
                                name="beneficiary_count"
                                widget="integer_positive_required"
                                required="drims_type == 'request_dispatch'"
                            />
                            <field
                                name="distribution_type_id"
                                options="{'no_create': True}"
                            />
                        </group>
                    </group>

                    <!--
                        OP#1088: each button sits on the row of the field it
                        fills, instead of in a separate column beside
                        Distribution Details where it read as unrelated.

                        Confirm Delivery is hidden until departure is recorded
                        rather than greyed out: an Odoo form button has no
                        conditional disabled state (ViewButton's `disabled` is a
                        component prop, never wired to the arch), so hiding is
                        the only declarative option. The order is also enforced
                        server-side in action_open_delivery_confirmation and
                        action_confirm_pod, so no path can log an arrival for
                        goods that never left.
                    -->
                    <!--
                        Each date is hidden while it is still empty so the button
                        starts at the left of the value column rather than after
                        an empty datetime widget (OP#1088 round 2). The field and
                        its button are mutually exclusive: an unset date means
                        there is an action to take, a set one means it is done.
                    -->
                    <group string="Departure &amp; Arrival" name="dates">
                        <label for="date_departed" />
                        <div class="o_row">
                            <field
                                name="date_departed"
                                readonly="1"
                                invisible="not date_departed"
                            />
                            <button
                                name="action_confirm_departure"
                                type="object"
                                string="Confirm Departure"
                                class="btn-primary"
                                invisible="date_departed != False or is_pod_confirmed"
                            />
                        </div>
                        <label for="date_arrived" />
                        <div class="o_row">
                            <field
                                name="date_arrived"
                                readonly="1"
                                invisible="not date_arrived"
                            />
                            <button
                                name="action_open_delivery_confirmation"
                                type="object"
                                string="Confirm Delivery"
                                class="btn-primary"
                                invisible="not date_departed or is_pod_confirmed"
                            />
                            <span
                                class="text-muted"
                                invisible="date_departed != False"
                            >Confirm departure first</span>
                        </div>
                    </group>

                    <!--
                        OP#1088: the Confirm Delivery popup writes this block, so
                        it becomes the delivery record and is locked once
                        confirmed. Before confirmation the fields stay editable,
                        which keeps action_confirm_pod usable for anything
                        driving the picking directly.
                    -->
                    <separator string="Proof of Delivery (POD)" />
                    <div
                        class="alert alert-info"
                        role="status"
                        invisible="is_pod_confirmed or not date_departed"
                    >
                        Departed but not yet delivered. Use
                        <b>Confirm Delivery</b> above to record the handover.
                    </div>
                    <group>
                        <group string="Receiver Information" name="receiver">
                            <field name="pod_status_id" readonly="is_pod_confirmed" />
                            <field name="is_pod_confirmed" readonly="1" />
                            <field name="pod_received_by" readonly="is_pod_confirmed" />
                            <field
                                name="pod_receiver_title"
                                readonly="is_pod_confirmed"
                            />
                            <field
                                name="pod_receiver_id_number"
                                readonly="is_pod_confirmed"
                            />
                        </group>
                        <group string="Location" name="location">
                            <label for="pod_gps_latitude" string="GPS Coordinates" />
                            <div class="o_row">
                                <field
                                    name="pod_gps_latitude"
                                    placeholder="Latitude"
                                    readonly="is_pod_confirmed"
                                />
                                <field
                                    name="pod_gps_longitude"
                                    placeholder="Longitude"
                                    readonly="is_pod_confirmed"
                                />
                            </div>
                        </group>
                    </group>

                    <group>
                        <field
                            name="pod_signature"
                            widget="image"
                            class="oe_avatar"
                            readonly="is_pod_confirmed"
                        />
                    </group>

                    <group string="Delivery Photos" name="photos">
                        <field
                            name="pod_photo_ids"
                            widget="many2many_binary"
                            nolabel="1"
                            readonly="is_pod_confirmed"
                        />
                    </group>

                    <group string="Notes" name="notes">
                        <field
                            name="pod_notes"
                            nolabel="1"
                            placeholder="Additional delivery notes..."
                            readonly="is_pod_confirmed"
                        />
                        <field
                            name="discrepancy_notes"
                            nolabel="1"
                            placeholder="Any discrepancies or issues..."
                            readonly="is_pod_confirmed"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Stock Picking Tree View - Add DRIMS Fields -->
    <record id="view_picking_tree_drims" model="ir.ui.view">
        <field name="name">stock.picking.tree.drims</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="waybill_number" optional="hide" />
                <field name="drims_type_id" optional="hide" />
                <field name="incident_id" optional="hide" />
            </xpath>
        </field>
    </record>

    <!-- Stock Picking Search View - Add DRIMS Filters -->
    <record id="view_picking_search_drims" model="ir.ui.view">
        <field name="name">stock.picking.search.drims</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="waybill_number" />
                <field name="drims_donation_id" />
                <field name="drims_request_id" />
                <field name="incident_id" />
                <separator />
                <filter
                    string="DRIMS Transfers"
                    name="drims_transfers"
                    domain="[('drims_type_id', '!=', False)]"
                />
                <filter
                    string="Donation Receipts"
                    name="donation_receipts"
                    domain="[('drims_type', '=', 'donation_receipt')]"
                />
                <filter
                    string="Request Dispatches"
                    name="request_dispatches"
                    domain="[('drims_type', '=', 'request_dispatch')]"
                />
                <filter
                    string="POD Pending"
                    name="pod_pending"
                    domain="[('is_pod_confirmed', '=', False), ('drims_type_id', '!=', False)]"
                />
                <filter
                    string="POD Confirmed"
                    name="is_pod_confirmed"
                    domain="[('is_pod_confirmed', '=', True)]"
                />
                <separator />
                <group>
                    <filter
                        string="DRIMS Type"
                        name="group_drims_type"
                        context="{'group_by': 'drims_type_id'}"
                    />
                    <filter
                        string="Incident"
                        name="group_incident"
                        context="{'group_by': 'incident_id'}"
                    />
                    <filter
                        string="POD Status"
                        name="group_pod_status"
                        context="{'group_by': 'pod_status_id'}"
                    />
                </group>
            </xpath>
        </field>
    </record>

    <!-- DRIMS Dispatch Pivot View - Distribution Analysis -->
    <record id="view_picking_pivot_drims" model="ir.ui.view">
        <field name="name">stock.picking.pivot.drims</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <pivot string="Distribution Analysis" sample="1">
                <field name="incident_id" type="row" />
                <field name="beneficiary_area_id" type="row" />
                <field name="scheduled_date" interval="month" type="col" />
                <field name="beneficiary_count" type="measure" />
            </pivot>
        </field>
    </record>

    <!-- DRIMS Dispatch Graph View - Distribution Trend -->
    <record id="view_picking_graph_drims" model="ir.ui.view">
        <field name="name">stock.picking.graph.drims</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <graph string="Distribution Trend" type="bar" sample="1">
                <field name="beneficiary_area_id" />
                <field name="beneficiary_count" type="measure" />
            </graph>
        </field>
    </record>

    <!--
        DRIMS Dispatch List View (OP#968): primary-mode inherited list view
        used only by the DRIMS Dispatches action. Disables Create + Delete on
        the list so users can't manually spawn a picking that bypasses the
        approved-request → dispatch pathway (which leaves the DRIMS tab
        hidden and strands the user). The standard stock.picking list view
        on Inventory > Operations is unaffected.
    -->
    <record id="view_picking_list_drims_dispatch" model="ir.ui.view">
        <field name="name">stock.picking.list.drims.dispatch</field>
        <field name="model">stock.picking</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="delete">0</attribute>
            </list>
            <xpath expr="//field[@name='name']" position="after">
                <field name="waybill_number" optional="hide" />
                <field name="drims_type_id" optional="hide" />
                <field name="incident_id" optional="hide" />
            </xpath>
        </field>
    </record>

    <!-- DRIMS Dispatch Action -->
    <record id="action_drims_dispatch" model="ir.actions.act_window">
        <field name="name">DRIMS Dispatches</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
                   (0, 0, {'view_mode': 'list', 'view_id': ref('view_picking_list_drims_dispatch')}),
                   (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_picking_pivot_drims')}),
                   (0, 0, {'view_mode': 'graph', 'view_id': ref('view_picking_graph_drims')})]"
        />
        <field name="path">drims-dispatches</field>
        <field name="domain">[('drims_type', '=', 'request_dispatch')]</field>
        <field name="context">{
            'search_default_request_dispatches': 1,
            'default_drims_type': 'request_dispatch'
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No DRIMS Dispatches yet
            </p>
            <p>
                Dispatches are auto-generated when stock is allocated from an approved
                request. They include waybill tracking, transport details, and proof
                of delivery.
            </p>
        </field>
    </record>
</odoo>
