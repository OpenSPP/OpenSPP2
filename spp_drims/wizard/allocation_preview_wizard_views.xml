<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Allocation Preview Wizard Form -->
    <record id="spp_drims_allocation_preview_wizard_form" model="ir.ui.view">
        <field name="name">spp.drims.allocation.preview.wizard.form</field>
        <field name="model">spp.drims.allocation.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Allocation Preview">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field
                                name="request_id"
                                readonly="1"
                                options="{'no_open': True}"
                            />
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field
                                name="warehouse_id"
                                options="{'no_create': True}"
                                placeholder="Pick a warehouse to allocate from..."
                            />
                        </group>
                        <group>
                            <field name="total_requested" />
                            <field name="total_available" />
                            <field name="total_to_allocate" />
                        </group>
                    </group>

                    <!-- No warehouse picked yet: prompt to choose one. The
                         warehouses that hold stock are listed below (OP#1079
                         scenario 1). -->
                    <div
                        class="alert alert-info"
                        role="status"
                        invisible="warehouse_id"
                    >
                        <strong
                    >Select a source warehouse</strong> to preview availability.
                        The warehouses that currently hold stock for the requested items
                        are listed below.
                    </div>

                    <!-- Warning for shortfall -->
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not has_shortfall"
                    >
                        <strong>Warning:</strong> Some items have insufficient stock.
                        Consider using an alternative warehouse or accepting partial allocation.
                    </div>

                    <!-- Warehouses with stock: shown when no warehouse is
                         selected (where to allocate from) or when the selected
                         warehouse is short (where else to look) — OP#1079. -->
                    <group invisible="warehouse_id and not has_shortfall">
                        <field
                            name="alternative_warehouse_ids"
                            widget="many2many_tags"
                            string="Warehouses with Stock"
                            readonly="1"
                        />
                    </group>

                    <notebook>
                        <page string="Allocation Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="product_id" readonly="1" />
                                    <field name="uom_id" readonly="1" />
                                    <field name="quantity_requested" />
                                    <field name="available_qty" />
                                    <field name="quantity_to_allocate" />
                                    <field
                                        name="shortfall"
                                        decoration-danger="shortfall > 0"
                                    />
                                    <field
                                        name="allocation_status"
                                        widget="badge"
                                        decoration-success="allocation_status == 'full'"
                                        decoration-warning="allocation_status == 'partial'"
                                        decoration-danger="allocation_status == 'none'"
                                    />
                                    <field
                                        name="request_line_id"
                                        column_invisible="True"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <footer>
                    <button
                        name="action_confirm_allocation"
                        string="Confirm Allocation"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_allocation_preview_wizard" model="ir.actions.act_window">
        <field name="name">Allocation Preview</field>
        <field name="res_model">spp.drims.allocation.preview.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_request_id': active_id}</field>
    </record>
</odoo>
