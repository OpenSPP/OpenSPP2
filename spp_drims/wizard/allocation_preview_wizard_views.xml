<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Allocation Preview Wizard Form -->
    <record id="spp_drims_allocation_preview_wizard_form" model="ir.ui.view">
        <field name="name">spp.drims.allocation.preview.wizard.form</field>
        <field name="model">spp.drims.allocation.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Allocation Preview">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field
                                name="request_id"
                                readonly="1"
                                options="{'no_open': True}"
                            />
                        </h1>
                    </div>

                    <!-- Total Requested (from the request) and Total Available
                         (recomputed on open / warehouse change) sit on top, both
                         read-only. The live "To Allocate" total is the list-footer
                         sum below — a header aggregate can't track the
                         constantly-edited To Allocate in sync (OP#1079 r4). -->
                    <group>
                        <group />
                        <group>
                            <field name="total_requested" />
                            <field name="total_available" readonly="1" />
                        </group>
                    </group>

                    <!-- Info: the split proposal below is filled automatically
                         from where stock is available; the user can adjust the
                         quantities or warehouses before confirming (OP#1079).
                         Hidden when nothing could be proposed (no stock) so the
                         message doesn't contradict an empty list. -->
                    <div
                        class="alert alert-info"
                        role="status"
                        invisible="not line_ids"
                    >
                        Stock has been split automatically across the warehouses that hold it.
                        Adjust the quantities or warehouses per row — or add a row to pull from
                        another warehouse — then confirm.
                    </div>

                    <!-- No stock anywhere: nothing can be allocated yet. -->
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not no_stock_available"
                    >
                        <strong
                    >No stock available.</strong> No DRIMS warehouse currently
                        holds stock for the requested items, so there is nothing to allocate
                        yet. Once stock is received you can allocate this request.
                    </div>

                    <!-- Genuine stock shortfall: some stock, but less than requested. -->
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not has_shortfall"
                    >
                        <strong>Warning:</strong> There is not enough stock across DRIMS
                        warehouses to fully allocate every item. You can confirm a partial
                        allocation and allocate the balance later once stock arrives.
                    </div>

                    <!-- Note: the "deliberate partial" and "over-allocated"
                         states are NOT shown as live banners — they depend on the
                         editable To Allocate, which a form header/banner can't
                         track in sync. Compare the To Allocate column footer with
                         Total Requested instead. Over-allocation is blocked at
                         confirm with a precise per-item message. -->

                    <notebook>
                        <page string="Allocation Lines" name="lines">
                            <field name="line_ids">
                                <!-- OP#1079: rows start from the auto-built
                                     availability split, but the user can also
                                     add a warehouse to cover the balance (e.g.
                                     pull from a nearer warehouse). The Source
                                     Warehouse picker is scoped to
                                     candidate_warehouse_ids — DRIMS warehouses
                                     that hold stock for the row's item and
                                     aren't already used — so adding a warehouse
                                     scales to any number of warehouses. Per-row
                                     and confirm-time caps keep a line from being
                                     allocated beyond what was requested. -->
                                <list editable="bottom">
                                    <field
                                        name="candidate_warehouse_ids"
                                        column_invisible="True"
                                    />
                                    <field
                                        name="request_line_id"
                                        string="Item"
                                        domain="[('request_id', '=', parent.request_id)]"
                                        options="{'no_create': True, 'no_open': True}"
                                        required="1"
                                    />
                                    <field
                                        name="uom_id"
                                        readonly="1"
                                        groups="uom.group_uom"
                                    />
                                    <field
                                        name="warehouse_id"
                                        domain="[('id', 'in', candidate_warehouse_ids)]"
                                        options="{'no_create': True}"
                                        required="1"
                                    />
                                    <field name="available_qty" />
                                    <field
                                        name="quantity_to_allocate"
                                        sum="To Allocate"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <footer>
                    <button
                        name="action_confirm_allocation"
                        string="Confirm Allocation"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_allocation_preview_wizard" model="ir.actions.act_window">
        <field name="name">Allocation Preview</field>
        <field name="res_model">spp.drims.allocation.preview.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_request_id': active_id}</field>
    </record>
</odoo>
