<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Allocation Preview Wizard Form -->
    <record id="spp_drims_allocation_preview_wizard_form" model="ir.ui.view">
        <field name="name">spp.drims.allocation.preview.wizard.form</field>
        <field name="model">spp.drims.allocation.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Allocation Preview">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field
                                name="request_id"
                                readonly="1"
                                options="{'no_open': True}"
                            />
                        </h1>
                    </div>

                    <group>
                        <group />
                        <group>
                            <field name="total_requested" />
                            <field name="total_available" />
                            <field name="total_to_allocate" />
                        </group>
                    </group>

                    <!-- Info: the split proposal below is filled automatically
                         from where stock is available; the user can adjust the
                         quantities or warehouses before confirming (OP#1079).
                         Hidden when nothing could be proposed (no stock) so the
                         message doesn't contradict an empty list. -->
                    <div
                        class="alert alert-info"
                        role="status"
                        invisible="not line_ids"
                    >
                        Stock has been split automatically across the warehouses that hold it.
                        Adjust the quantities or warehouses per row, then confirm.
                    </div>

                    <!-- Warning for shortfall -->
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not has_shortfall"
                    >
                        <strong>Warning:</strong> There is not enough stock across DRIMS
                        warehouses to fully allocate every item. You can confirm a partial
                        allocation and allocate the balance later once stock arrives.
                    </div>

                    <notebook>
                        <page string="Allocation Lines" name="lines">
                            <field name="line_ids">
                                <!-- Proposal-driven: rows are auto-built from
                                     availability (OP#1079). Manual "Add a line"
                                     is disabled because a new row can't set its
                                     required request_line_id from the UI. Users
                                     adjust the warehouse / quantity on the
                                     proposed rows instead. -->
                                <list editable="bottom" create="false">
                                    <field name="product_id" readonly="1" />
                                    <field
                                        name="uom_id"
                                        readonly="1"
                                        groups="uom.group_uom"
                                    />
                                    <field name="quantity_requested" />
                                    <field
                                        name="request_line_id"
                                        domain="[('request_id', '=', parent.request_id)]"
                                        column_invisible="True"
                                    />
                                    <field
                                        name="warehouse_id"
                                        options="{'no_create': True}"
                                        required="1"
                                    />
                                    <field name="available_qty" />
                                    <field name="quantity_to_allocate" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <footer>
                    <button
                        name="action_confirm_allocation"
                        string="Confirm Allocation"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_allocation_preview_wizard" model="ir.actions.act_window">
        <field name="name">Allocation Preview</field>
        <field name="res_model">spp.drims.allocation.preview.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_request_id': active_id}</field>
    </record>
</odoo>
