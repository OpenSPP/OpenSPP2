<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Main Inspection Wizard Form (DON-002) -->
    <record id="spp_drims_inspection_wizard_form" model="ir.ui.view">
        <field name="name">spp.drims.inspection.wizard.form</field>
        <field name="model">spp.drims.inspection.wizard</field>
        <field name="arch" type="xml">
            <form string="Inspect Donation">
                <sheet>
                    <div class="oe_title">
                        <h1>Inspecting: <field
                            name="donation_reference"
                            readonly="1"
                            class="oe_inline"
                        /></h1>
                    </div>

                    <field name="donation_id" invisible="1" />

                    <div class="alert alert-info" role="alert">
                        Set <strong>Condition</strong> and <strong
                    >Action</strong> on each row, then click <strong
                    >Confirm Inspection</strong>. Use <strong
                    >+ Add split</strong> when a single product needs to be split
                        across multiple conditions.
                    </div>

                    <!-- Items List (inline-editable) -->
                    <group string="Items to Inspect">
                        <field name="line_ids" nolabel="1">
                            <list
                                create="false"
                                delete="false"
                                editable="bottom"
                                class="o_drims_inspection_list"
                            >
                                <field
                                    name="product_id"
                                    string="Product"
                                    readonly="1"
                                    decoration-muted="is_split"
                                />
                                <field
                                    name="uom_id"
                                    string="Unit"
                                    optional="show"
                                    readonly="1"
                                />
                                <field
                                    name="quantity_expected"
                                    string="Expected"
                                    readonly="1"
                                />
                                <field
                                    name="quantity"
                                    string="Qty"
                                    readonly="not is_split"
                                />
                                <field
                                    name="condition_id"
                                    string="Condition"
                                    options="{'no_create': True}"
                                    invisible="has_splits"
                                />
                                <field
                                    name="disposition_id"
                                    string="Action"
                                    options="{'no_create': True}"
                                    invisible="has_splits"
                                />
                                <field
                                    name="can_mark_all_units"
                                    column_invisible="True"
                                />
                                <field name="is_inspected" column_invisible="True" />
                                <field name="is_split" column_invisible="True" />
                                <field name="has_splits" column_invisible="True" />
                                <field name="parent_line_id" column_invisible="True" />
                                <field
                                    name="donation_line_id"
                                    column_invisible="True"
                                />
                                <!-- "All units" — visual badge only.
                                     Active when both Condition and Action are
                                     set; greyed otherwise. Hidden on split
                                     parent rows. -->
                                <button
                                    string="All units"
                                    type="object"
                                    name="action_all_units"
                                    class="btn btn-secondary btn-sm"
                                    invisible="not can_mark_all_units or has_splits"
                                />
                                <button
                                    string="All units"
                                    type="object"
                                    name="action_all_units"
                                    class="btn btn-secondary btn-sm o_drims_btn_disabled"
                                    invisible="can_mark_all_units or has_splits"
                                />
                                <!-- "+ Add split" — hidden on split children. -->
                                <button
                                    name="action_add_split"
                                    string="+ Add split"
                                    type="object"
                                    class="btn btn-secondary btn-sm"
                                    invisible="is_split"
                                />
                                <!-- Remove split — only on split children. -->
                                <button
                                    name="action_remove_split"
                                    string="✕"
                                    type="object"
                                    class="btn btn-sm text-danger"
                                    invisible="not is_split"
                                    confirm="Remove this split?"
                                />
                            </list>
                        </field>
                    </group>

                    <!-- Inspection Notes -->
                    <group string="Inspection Notes">
                        <field
                            name="notes"
                            nolabel="1"
                            placeholder="General notes about this inspection (optional)..."
                        />
                    </group>
                </sheet>

                <footer>
                    <button
                        name="action_confirm_inspection"
                        string="Confirm Inspection"
                        type="object"
                        class="btn-primary"
                        confirm="This will update the donation and mark it as inspected. Continue?"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard (kept for compatibility, but not used by button) -->
    <record id="action_inspection_wizard" model="ir.actions.act_window">
        <field name="name">Inspect Donation</field>
        <field name="res_model">spp.drims.inspection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
