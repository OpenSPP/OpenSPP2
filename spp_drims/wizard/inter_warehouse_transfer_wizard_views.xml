<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inter-Warehouse Transfer Wizard Form View -->
    <record id="spp_drims_inter_warehouse_transfer_form" model="ir.ui.view">
        <field name="name">spp.drims.inter.warehouse.transfer.form</field>
        <field name="model">spp.drims.inter.warehouse.transfer</field>
        <field name="arch" type="xml">
            <form string="Inter-Warehouse Transfer">
                <group>
                    <group>
                        <field name="incident_id" options="{'no_create': True}" />
                        <field
                            name="source_warehouse_id"
                            options="{'no_create': True}"
                        />
                        <field name="dest_warehouse_id" options="{'no_create': True}" />
                    </group>
                    <group>
                        <field name="scheduled_date" />
                        <field
                            name="reason"
                            placeholder="Reason for this transfer..."
                        />
                    </group>
                </group>
                <separator string="Products to Transfer" />
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="product_id" options="{'no_create': True}" />
                        <field name="available_qty" readonly="1" />
                        <field name="quantity" />
                        <field name="uom_id" readonly="1" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_create_transfer"
                        string="Create Transfer"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open Inter-Warehouse Transfer Wizard -->
    <record id="action_drims_inter_warehouse_transfer" model="ir.actions.act_window">
        <field name="name">Inter-Warehouse Transfer</field>
        <field name="res_model">spp.drims.inter.warehouse.transfer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
