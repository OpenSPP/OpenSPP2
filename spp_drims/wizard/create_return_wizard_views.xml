<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Create Return Wizard Form (GAP-RET-001) -->
    <record id="spp_drims_create_return_wizard_form" model="ir.ui.view">
        <field name="name">spp.drims.create.return.wizard.form</field>
        <field name="model">spp.drims.create.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Return">
                <sheet>
                    <group>
                        <group string="Dispatch Details">
                            <field name="picking_id" readonly="1"/>
                            <field name="incident_id" readonly="1"/>
                        </group>
                        <group string="Return Details">
                            <field name="warehouse_id" options="{'no_create': True}"/>
                            <field name="returned_by"/>
                        </group>
                    </group>

                    <group>
                        <field name="return_reason" placeholder="Explain why items are being returned..."
                               nolabel="1" colspan="2"/>
                    </group>

                    <notebook>
                        <page string="Items" name="items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id" readonly="1"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="quantity_dispatched"/>
                                    <field name="quantity_to_return"/>
                                    <field name="condition_id" options="{'no_create': True}"/>
                                    <field name="is_return_this" widget="boolean_toggle" readonly="1"/>
                                    <field name="move_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <footer>
                    <button name="action_create_return"
                            string="Create Return"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_create_return_wizard" model="ir.actions.act_window">
        <field name="name">Create Return</field>
        <field name="res_model">spp.drims.create.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
