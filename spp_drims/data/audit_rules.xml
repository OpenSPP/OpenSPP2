<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Audit Rules for DRIMS Models
            ============================
            Tracks operations on all DRIMS models for compliance,
            accountability, and activity feed purposes.
        -->

        <!-- Return Audit -->
        <function model="spp.audit.rule" name="create_rules">
            <value name="rule_name">DRIMS Return Audit</value>
            <value name="model">spp.drims.return</value>
            <value name="fields_to_log" eval="[
                'state',
                'incident_id',
                'warehouse_id',
                'return_date',
                'returned_by',
                'total_quantity',
                'total_value',
            ]"/>
            <value name="log_create" eval="True"/>
            <value name="log_write" eval="True"/>
            <value name="log_unlink" eval="True"/>
            <value name="view_logs" eval="True"/>
        </function>

        <!-- Donation Audit -->
        <function model="spp.audit.rule" name="create_rules">
            <value name="rule_name">DRIMS Donation Audit</value>
            <value name="model">spp.drims.donation</value>
            <value name="fields_to_log" eval="[
                'state',
                'incident_id',
                'warehouse_id',
                'donor_id',
                'donor_name',
                'total_value',
                'date_announced',
                'date_received',
            ]"/>
            <value name="log_create" eval="True"/>
            <value name="log_write" eval="True"/>
            <value name="log_unlink" eval="True"/>
            <value name="view_logs" eval="True"/>
        </function>

        <!-- Request Audit -->
        <function model="spp.audit.rule" name="create_rules">
            <value name="rule_name">DRIMS Request Audit</value>
            <value name="model">spp.drims.request</value>
            <value name="fields_to_log" eval="[
                'state',
                'approval_state',
                'incident_id',
                'destination_area_id',
                'priority_id',
                'date_needed',
                'total_value',
                'affected_population',
            ]"/>
            <value name="log_create" eval="True"/>
            <value name="log_write" eval="True"/>
            <value name="log_unlink" eval="True"/>
            <value name="view_logs" eval="True"/>
        </function>

        <!-- Alert Audit -->
        <function model="spp.audit.rule" name="create_rules">
            <value name="rule_name">DRIMS Alert Audit</value>
            <value name="model">spp.drims.alert</value>
            <value name="fields_to_log" eval="[
                'state',
                'priority',
                'title',
                'incident_id',
                'warehouse_id',
                'product_id',
                'request_id',
            ]"/>
            <value name="log_create" eval="True"/>
            <value name="log_write" eval="True"/>
            <value name="log_unlink" eval="False"/>
            <value name="view_logs" eval="True"/>
        </function>

        <!-- Stock Picking Audit (DRIMS operations) -->
        <function model="spp.audit.rule" name="create_rules">
            <value name="rule_name">DRIMS Stock Movement Audit</value>
            <value name="model">stock.picking</value>
            <value name="fields_to_log" eval="[
                'state',
                'drims_type_id',
                'incident_id',
                'drims_donation_id',
                'drims_request_id',
                'beneficiary_count',
                'beneficiary_area_id',
                'is_pod_confirmed',
            ]"/>
            <value name="log_create" eval="True"/>
            <value name="log_write" eval="True"/>
            <value name="log_unlink" eval="False"/>
            <value name="view_logs" eval="True"/>
        </function>
    </data>
</odoo>
