<odoo>
    <!-- DRIMS-specific GIS Report Templates -->

    <record id="template_incident_area_severity" model="spp.gis.report.template">
        <field name="name">Incident Area Severity Map</field>
        <field name="code">incident_area_severity</field>
        <field name="description">Shows severity levels of incident impact areas.
Displays area-specific severity overrides where available,
otherwise uses the incident's default severity.
Higher severity areas are shown in warmer colors (red).</field>
        <field name="category_id" ref="spp_gis_report.category_disaster_response" />
        <field name="icon">fa-exclamation-triangle</field>
        <field name="sequence">5</field>
        <field name="requires_incident" eval="True" />
        <field name="config">{
    "source_model": "spp.hazard.incident.area",
    "area_field_path": "area_id",
    "filter_template": "[]",
    "aggregation_method": "max",
    "aggregation_field": "severity_numeric",
    "normalization_method": "raw",
    "color_scheme": "traffic_light",
    "threshold_mode": "manual",
    "bucket_count": 5,
    "rollup_method": "max",
    "rollup_weight_source": "count"
}</field>
    </record>
</odoo>
