<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Privileges (TIER 2 functional) -->
    <record id="privilege_disability_viewer" model="res.groups.privilege">
        <field name="name">Disability Viewer</field>
        <field name="category_id" ref="spp_security.category_spp_disability" />
        <field name="sequence">10</field>
    </record>

    <record id="privilege_disability_assessor" model="res.groups.privilege">
        <field name="name">Disability Assessor</field>
        <field name="category_id" ref="spp_security.category_spp_disability" />
        <field name="sequence">20</field>
    </record>

    <record id="privilege_disability_approver" model="res.groups.privilege">
        <field name="name">Disability Approver</field>
        <field name="category_id" ref="spp_security.category_spp_disability" />
        <field name="sequence">30</field>
    </record>

    <!-- Groups (TIER 2) -->
    <record id="group_disability_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_disability_viewer" />
        <field
            name="comment"
        >Can view disability assessments and registrant disability status.</field>
    </record>

    <record id="group_disability_assessor" model="res.groups">
        <field name="name">Assessor</field>
        <field name="privilege_id" ref="privilege_disability_assessor" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_disability_viewer'))]"
        />
        <field
            name="comment"
        >Can create and edit disability assessments. Can submit for validation.</field>
    </record>

    <record id="group_disability_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="privilege_id" ref="privilege_disability_approver" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_disability_assessor'))]"
        />
        <field
            name="comment"
        >Can approve or reject submitted disability assessments, on top of everything an Assessor can do. Also reaches the module's configuration.</field>
    </record>

    <!-- Link to admin (TIER 1) -->
    <record id="spp_security.group_spp_admin" model="res.groups">
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_disability_approver'))]"
        />
    </record>
</odoo>
