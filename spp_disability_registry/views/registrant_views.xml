<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Extend Partner Form - Add Disability Smart Buttons -->
    <record id="view_res_partner_form_disability_buttons" model="ir.ui.view">
        <field name="name">res.partner.form.disability.buttons</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_individuals_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <!-- Disability Status Smart Button -->
                <button
                    name="action_view_disability_assessments"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-wheelchair"
                    invisible="not is_registrant or is_group"
                >
                    <div class="o_stat_info">
                        <field
                            name="disability_severity_id"
                            class="o_stat_text"
                            invisible="not has_disability"
                        />
                        <span
                            class="o_stat_text"
                            invisible="not has_disability"
                        >Disability</span>
                        <span
                            class="o_stat_text text-muted"
                            invisible="has_disability"
                        >No Disability</span>
                    </div>
                </button>
                <!-- Assessment Count Button -->
                <button
                    name="action_view_disability_assessments"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-clipboard"
                    invisible="not is_registrant or is_group or disability_assessment_count == 0"
                >
                    <field
                        name="disability_assessment_count"
                        widget="statinfo"
                        string="Assessments"
                    />
                </button>
                <!-- Assistive Devices Button -->
                <button
                    name="action_view_assistive_devices"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-medkit"
                    invisible="not is_registrant or is_group or assistive_device_count == 0"
                >
                    <field
                        name="assistive_device_count"
                        widget="statinfo"
                        string="Devices"
                    />
                </button>
            </xpath>
        </field>
    </record>

    <!-- Extend Partner Form - Add Disability Tab -->
    <record id="view_res_partner_form_disability_tab" model="ir.ui.view">
        <field name="name">res.partner.form.disability.tab</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_individuals_form" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook[@name='individual_detail']" position="inside">
                <page
                    name="disability"
                    string="Disability"
                    invisible="not is_registrant or is_group"
                >
                    <!-- Current Disability Status Card -->
                    <div class="mb-3" invisible="not has_disability">
                        <div class="card border-start border-4 border-primary">
                            <div class="card-body py-3">
                                <div class="row align-items-center">
                                    <div class="col-md-2 text-center">
                                        <i
                                            class="fa fa-wheelchair fa-3x text-primary"
                                            aria-hidden="true"
                                        />
                                    </div>
                                    <div class="col-md-4">
                                        <div class="fw-bold">Disability Status</div>
                                        <field
                                            name="disability_severity_id"
                                            widget="badge"
                                            decoration-info="disability_severity_id.code == 'mild'"
                                            decoration-warning="disability_severity_id.code == 'moderate'"
                                            decoration-danger="disability_severity_id.code in ('severe', 'profound')"
                                        />
                                    </div>
                                    <div class="col-md-3">
                                        <div
                                            class="small text-muted"
                                        >Review Category</div>
                                        <field name="disability_review_category" />
                                    </div>
                                    <div class="col-md-3">
                                        <div class="small text-muted">Next Review</div>
                                        <field
                                            name="disability_next_review"
                                            decoration-danger="disability_next_review and disability_next_review &lt; context_today()"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Review Due Warning -->
                    <div
                        class="alert alert-warning mb-3"
                        role="alert"
                        invisible="not disability_next_review or disability_next_review &gt; context_today()"
                    >
                        <div class="d-flex align-items-center">
                            <i
                                class="fa fa-exclamation-triangle fa-lg me-3"
                                aria-hidden="true"
                            />
                            <div>
                                <strong>Reassessment Required</strong>
                                <p class="mb-0">
                                    The disability assessment is due for review.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- No Disability Status -->
                    <div class="text-center text-muted py-4" invisible="has_disability">
                        <i
                            class="fa fa-wheelchair fa-3x mb-3 opacity-50"
                            aria-hidden="true"
                        />
                        <h5>No Disability Status Recorded</h5>
                        <p>No approved disability assessment exists for this person.</p>
                        <button
                            name="action_create_disability_assessment"
                            type="object"
                            class="btn btn-primary mt-2"
                            groups="spp_disability_registry.group_disability_assessor"
                        >
                            <i class="fa fa-plus me-1" /> Create Assessment
                        </button>
                    </div>

                    <!-- Assessment History -->
                    <div invisible="disability_assessment_count == 0">
                        <div
                            class="d-flex justify-content-between align-items-center mb-2"
                        >
                            <h5 class="mb-0">Assessment History</h5>
                            <button
                                name="action_create_disability_assessment"
                                type="object"
                                class="btn btn-sm btn-primary"
                                groups="spp_disability_registry.group_disability_assessor"
                            >
                                <i class="fa fa-plus me-1" /> New Assessment
                            </button>
                        </div>
                        <field
                            name="disability_assessment_ids"
                            readonly="1"
                            nolabel="1"
                        >
                            <list
                                limit="10"
                                decoration-muted="approval_state == 'rejected'"
                                decoration-success="approval_state == 'approved'"
                            >
                                <field name="assessment_date" />
                                <field name="assessment_type" />
                                <field
                                    name="impairment_type_ids"
                                    widget="many2many_tags"
                                />
                                <field name="severity_level_id" widget="badge" />
                                <field
                                    name="approval_state"
                                    widget="badge"
                                    decoration-info="approval_state == 'draft'"
                                    decoration-warning="approval_state == 'pending'"
                                    decoration-success="approval_state == 'approved'"
                                    decoration-danger="approval_state == 'rejected'"
                                />
                                <field name="next_review_date" optional="hide" />
                            </list>
                        </field>
                    </div>

                    <!-- Assistive Devices Section -->
                    <div class="mt-4" invisible="not has_disability">
                        <separator string="Assistive Devices" />
                        <div invisible="assistive_device_count == 0" class="mb-3">
                            <span
                                class="badge bg-warning"
                                invisible="not has_unmet_device_need"
                            >
                                <i class="fa fa-exclamation-triangle me-1" />
                                Unmet Device Need
                            </span>
                        </div>
                        <field name="assistive_device_ids" nolabel="1">
                            <list editable="bottom">
                                <field
                                    name="device_type_id"
                                    options="{'no_create': True}"
                                />
                                <field
                                    name="status"
                                    widget="badge"
                                    decoration-info="status == 'needed'"
                                    decoration-warning="status == 'requested'"
                                    decoration-success="status == 'provided'"
                                />
                                <field
                                    name="provision_date"
                                    invisible="status != 'provided'"
                                />
                                <field name="notes" optional="hide" />
                            </list>
                        </field>
                    </div>

                    <!-- Hidden fields for visibility conditions -->
                    <field name="has_disability" invisible="1" />
                    <field name="has_unmet_device_need" invisible="1" />
                    <field name="current_disability_assessment_id" invisible="1" />
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extend Partner List - Add Disability Columns -->
    <record id="view_res_partner_list_disability" model="ir.ui.view">
        <field name="name">res.partner.list.disability</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_individuals_list_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="has_disability" string="PWD" optional="show" />
                <field
                    name="disability_severity_id"
                    string="Severity"
                    widget="badge"
                    decoration-info="disability_severity_id.code == 'mild'"
                    decoration-warning="disability_severity_id.code == 'moderate'"
                    decoration-danger="disability_severity_id.code in ('severe', 'profound')"
                    optional="hide"
                />
            </xpath>
        </field>
    </record>

    <!-- Extend Partner Search - Add Disability Filters -->
    <record id="view_res_partner_search_disability" model="ir.ui.view">
        <field name="name">res.partner.search.disability</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_registry_individuals_filter" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator />
                <filter
                    name="filter_has_disability"
                    string="Has Disability"
                    domain="[('has_disability', '=', True)]"
                />
                <filter
                    name="filter_review_due"
                    string="Review Due"
                    domain="[('disability_next_review', '&lt;=', context_today())]"
                />
                <filter
                    name="filter_unmet_device_need"
                    string="Unmet Device Need"
                    domain="[('has_unmet_device_need', '=', True)]"
                />
                <separator />
                <filter
                    name="group_disability_severity"
                    string="Disability Severity"
                    context="{'group_by': 'disability_severity_id'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
