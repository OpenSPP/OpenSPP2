def cmd_doctor(_args):
    """Check prerequisites and environment health."""
    print("Checking prerequisites...\n")
    all_ok = True

    # Check Docker
    docker_path = shutil.which("docker")
    if docker_path:
        result = run(["docker", "--version"], capture=True, check=False)
        if result.returncode == 0:
            success(f"Docker: {result.stdout.strip()}")
        else:
            error("Docker: installed but not working")
            all_ok = False
    else:
        error("Docker: not found")
        all_ok = False

    # Check Docker Compose
    result = run(["docker", "compose", "version"], capture=True, check=False)
    if result.returncode == 0:
        success(f"Docker Compose: {result.stdout.strip()}")
    else:
        error("Docker Compose: not found or not working")
        all_ok = False

    # Check Docker daemon
    result = run(["docker", "info"], capture=True, check=False)
    if result.returncode == 0:
        success("Docker daemon: running")
    else:
        error("Docker daemon: not running (start Docker Desktop?)")
        all_ok = False

    # Check Git
    git_path = shutil.which("git")
    if git_path:
        result = run(["git", "--version"], capture=True, check=False)
        success(f"Git: {result.stdout.strip()}")
    else:
        warn("Git: not found (optional)")

    # Check pre-commit
    precommit_path = shutil.which("pre-commit")
    if precommit_path:
        result = run(["pre-commit", "--version"], capture=True, check=False)
        success(f"pre-commit: {result.stdout.strip()}")
    else:
        warn("pre-commit: not found (optional, for linting)")

    # Check argcomplete
    if HAS_ARGCOMPLETE:
        success("argcomplete: installed (tab completion available)")
    else:
        warn("argcomplete: not installed (optional, for tab completion)")
        info("  Install with: pip install argcomplete")

    # Check config file
    print("")
    if CONFIG_PATH.exists():
        success(f"Config file: {CONFIG_PATH}")
    else:
        info(f"Config file: {CONFIG_PATH} (not found, using defaults)")
        info("  Create one with your preferences:")
        info("    echo 'default_demo = \"mis\"' > ~/.spp.toml")

    # Check port availability (8069)
    print("")
    import socket

    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    port_available = sock.connect_ex(("localhost", 8069)) != 0
    sock.close()
    if port_available:
        success("Port 8069: available")
    else:
        warn("Port 8069: in use (Odoo may already be running)")

    # Summary
    print("")
    if all_ok:
        success("All prerequisites met!")
    else:
        error("Some prerequisites are missing. Please install them and try again.")


