def cmd_lint(args):
    """Run linters on files."""
    files = args.files

    if not files:
        # Default to changed files
        result = run(["git", "diff", "--name-only", "HEAD"], capture=True, check=False)
        files = [f for f in result.stdout.strip().split("\n") if f]

    if not files:
        print("No files to lint")
        return

    print(f"Linting {len(files)} files...")

    # Run pre-commit hooks (use list form to avoid shell injection)
    run(["pre-commit", "run", "ruff", "--files", *files], check=False)
    run(["pre-commit", "run", "ruff-format", "--files", *files], check=False)
    run(["pre-commit", "run", "prettier", "--files", *files], check=False)


