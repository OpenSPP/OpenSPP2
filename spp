def _run_demo_generator(profile: str, demo_key: str, timeout: int = 600):
    """Run the MIS demo generator wizard via Odoo shell.

    Args:
        profile: Docker compose profile (dev or ui)
        demo_key: Demo profile key (e.g., 'mis', 'drims')
        timeout: Max seconds to wait for generator to complete
    """
    service = "openspp-dev" if profile == "dev" else "openspp"
    generator_mode = DEMO_GENERATOR_MODES.get(demo_key, "complete")

    print("\n" + _color("1;34", "Phase 3: Generating demo data..."))
    print(f"Running demo generator (mode: {generator_mode})...")

    # Python code to run in Odoo shell (passed via stdin, not -c which is for config file)
    generator_code = f"""
generator = env['spp.mis.demo.generator'].create({{'name': 'CLI Demo', 'demo_mode': '{generator_mode}'}})
generator._onchange_demo_mode()
generator.action_generate()
print('DEMO_GENERATION_COMPLETE')
"""

    result = run(
        docker_compose(
            "exec",
            "-T",
            service,
            "odoo",
            "shell",
            "-d",
            "openspp",
            "--no-http",
            profile=profile,
        ),
        check=False,
        capture=True,
        input=generator_code,
        text=True,
        timeout=timeout,
    )

    if "DEMO_GENERATION_COMPLETE" in result.stdout:
        success("Demo data generated successfully!")
        return True
    else:
        warn("Demo generation may have failed. Check logs with './spp logs'")
        if result.stderr:
            print(result.stderr[:500])  # Show first 500 chars of error
        return False


def cmd_start(args):
    """Start Odoo development server."""
    if IS_REMOTE:
        print("Error: 'start' not supported in Claude Code web environment")
        print("Use './spp test <module>' to run tests instead")
        sys.exit(1)

    env = os.environ.copy()
    demo_modules = None

    # Set demo modules if specified
    if args.demo:
        demo_key = args.demo.lower().replace("-", "").replace("_", "")
        demo_modules = DEMO_PROFILES.get(demo_key, args.demo)
        print(f"Starting with demo: {demo_modules}")

    # Determine profile: dev (dynamic port) vs ui (fixed 8069)
    profile = args.profile

    # --prism requires the ui profile (fixed port 8069) so PRISM can reach Odoo
    extra_profiles = []
    if getattr(args, "prism", False):
        if profile == "dev":
            info("--prism requires fixed port, switching to ui profile")
            profile = "ui"
        extra_profiles.append("prism")

    # Check if Docker image needs rebuilding (unless --no-build)
    if not getattr(args, "no_build", False):
        _check_image_freshness(profile, auto_rebuild=args.yes)

    # Enable auto-reload for dev profile by default (disable with --no-watch)
    if profile == "dev" and not args.no_watch:
        env["ODOO_EXTRA_ARGS"] = "--dev=reload,qweb,xml"
        print("Auto-reload enabled (use --no-watch to disable)")

    # Wipe volumes if requested (removes DB data, filestore, everything)
    is_fresh_start = False
    if args.wipe:
        if not args.yes and not _confirm("This will DELETE all data (database, filestore). Continue?"):
            print("Cancelled.")
            sys.exit(0)
        print("Wiping all data (volumes)...")
        run(docker_compose("down", "-v", profile=profile), check=False)
        is_fresh_start = True

    # Two-phase initialization for fresh starts with demo modules
    # Phase 1: Install job_worker first, then restart so it can listen to job events
    if is_fresh_start and demo_modules:
        print("\n" + _color("1;34", "Phase 1: Installing job_worker..."))
        phase1_env = env.copy()
        phase1_env["ODOO_INIT_MODULES"] = "job_worker"
        run(docker_compose("up", "-d", profiles=[profile] + extra_profiles), env=phase1_env)

        if not _wait_for_odoo_ready(profile):
            warn("Odoo did not become ready in time, continuing anyway...")

        print("Restarting Odoo so job_worker can listen to events...")
        service = "openspp-dev" if profile == "dev" else "openspp"
        run(docker_compose("restart", service, profile=profile))

        # Brief wait for restart
        time.sleep(3)

        print("\n" + _color("1;34", f"Phase 2: Installing {demo_modules}..."))
        env["ODOO_INIT_MODULES"] = demo_modules
        run(docker_compose("up", "-d", profiles=[profile] + extra_profiles), env=env)

        # Wait for Odoo to be ready first
        if not _wait_for_odoo_ready(profile, timeout=120):
            error("Odoo did not start")
            _show_recent_logs(profile, lines=50)
            sys.exit(1)

        # Wait for module installation to complete (monitors logs)
        installed, err_msg = _wait_for_module_installed(profile, demo_modules, timeout=600)
        if not installed:
            error(f"Module '{demo_modules}' failed to install!")
            if err_msg:
                error(f"Reason: {err_msg}")
            _show_recent_logs(profile, lines=100)
            sys.exit(1)

        success(f"Module '{demo_modules}' installed successfully")

        # Phase 3: Generate demo data if requested
        if args.generate:
            demo_key = args.demo.lower().replace("-", "").replace("_", "")
            _run_demo_generator(profile, demo_key)
    else:
        # Normal start (not a fresh wipe with demo)
        if demo_modules:
            env["ODOO_INIT_MODULES"] = demo_modules

        # Start services
        print(f"Starting Odoo ({profile} profile)...")
        run(docker_compose("up", "-d", profiles=[profile] + extra_profiles), env=env)

        # Warn if --generate used without --wipe
        if args.generate:
            warn("--generate requires --wipe to ensure clean data generation")

    # Show URL
    if profile == "dev":
        print("\nGetting dynamic port...")
        _show_url()
    else:
        print("\nOdoo available at: http://localhost:8069")
        print("Credentials: admin / admin")

    if extra_profiles and "prism" in extra_profiles:
        print("\nPRISM frontend: http://localhost:3000")


def cmd_stop(args):
    """Stop all services."""
    if IS_REMOTE:
        print("Nothing to stop in Claude Code web environment")
        return

    # Confirm if removing volumes (destructive)
    if args.volumes and not args.yes:
        if not _confirm("This will DELETE all data (database, filestore). Continue?"):
            print("Cancelled.")
            sys.exit(0)

    print("Stopping all containers...")
    # Stop all profiles
    for profile in ["dev", "ui", "e2e", "prism"]:
        run(docker_compose("down", profile=profile), check=False)

    # Also stop standalone db if running
    run(docker_compose("down"), check=False)

    if args.volumes:
        print("Removing volumes...")
        run(docker_compose("down", "-v"), check=False)

    print("Done.")


def cmd_restart(args):
    """Restart Odoo container."""
    if IS_REMOTE:
        print("Error: 'restart' not supported in Claude Code web environment")
        sys.exit(1)

    # Auto-detect running profile if not specified
    service, profile = _find_running_odoo()
    if not service:
        print("Error: No Odoo container running. Start with './spp start' first.")
        sys.exit(1)

    print(f"Restarting {service}...")
    run(docker_compose("restart", service, profile=profile))
    print("Done.")

    _show_url()


def cmd_resetdb(args):
    """Reset database with optional demo data."""
    if IS_REMOTE:
        print("Error: 'resetdb' not supported in Claude Code web environment")
        sys.exit(1)

    db_name = args.db or "openspp"
    modules = "spp_base"

    # Validate database name to prevent SQL injection
    if not _validate_db_name(db_name):
        print(f"Error: Invalid database name '{db_name}'")
        print("Database names must start with a letter or underscore,")
        print("contain only alphanumeric characters and underscores,")
        print("and be at most 63 characters.")
        sys.exit(1)

    if args.demo:
        demo_key = args.demo.lower().replace("-", "").replace("_", "")
        modules = DEMO_PROFILES.get(demo_key, args.demo)

    # Confirm destructive operation
    if not args.yes and not _confirm(f"This will DROP database '{db_name}'. Continue?"):
        print("Cancelled.")
        sys.exit(0)

    print(f"Resetting database '{db_name}' with modules: {modules}")

    # Ensure db is running
    run(docker_compose("up", "-d", "db"))

    # Stop Odoo and job worker but keep db
    run(docker_compose("stop", "openspp", "openspp-dev", "jobworker"), check=False)

    # Wait for db to be ready
    print("Waiting for database...")
    for _ in range(30):
        result = run(
            docker_compose("exec", "-T", "db", "pg_isready", "-U", "odoo"),
            check=False,
            capture=True,
        )
        if result.returncode == 0:
            break
        time.sleep(1)

    # Drop and recreate database (db_name is validated above)
    run(
        docker_compose(
            "exec",
            "-T",
            "db",
            "psql",
            "-U",
            "odoo",
            "-d",
            "postgres",
            "-c",
            f"DROP DATABASE IF EXISTS {db_name};",
        ),
        check=False,
    )
    run(
        docker_compose(
            "exec",
            "-T",
            "db",
            "psql",
            "-U",
            "odoo",
            "-d",
            "postgres",
            "-c",
            f"CREATE DATABASE {db_name};",
        )
    )

    # Store modules for start command to pick up
    os.environ["ODOO_INIT_MODULES"] = modules
    os.environ["ODOO_DB_NAME"] = db_name

    print(f"Database '{db_name}' reset. Run './spp start' to initialize with {modules}")


def cmd_update(args):
    """Update (upgrade) modules in running Odoo.

    Uses click-odoo-update to auto-detect changed modules based on file checksums.
    This is smarter than plain 'odoo -u' and handles migrations more gracefully.
    """
    if IS_REMOTE:
        print("Error: 'update' not supported in Claude Code web environment")
        sys.exit(1)

    db_name = args.db or "openspp"

    # Find running Odoo service
    service, profile = _find_running_odoo()
    if not service:
        print("Error: No Odoo container running. Start with './spp start' first.")
        sys.exit(1)

    # Warn if modules specified (click-odoo-update auto-detects)
    if args.modules:
        print(f"Note: Ignoring specified modules {args.modules}")
        print("      click-odoo-update auto-detects changed modules based on checksums")
        print()

    print("Detecting and updating changed modules...")
    run(
        docker_compose(
            "exec",
            service,
            "click-odoo-update",
            "-d",
            db_name,
            "--watcher-max-seconds",
            "600",
            profile=profile,
        )
    )

    print("Update complete. Restarting Odoo...")
    run(docker_compose("restart", service, profile=profile))

    if profile == "dev":
        _show_url()
    else:
        print("Odoo available at: http://localhost:8069")


def cmd_logs(args):
    """View container logs."""
    if IS_REMOTE:
        print("Error: 'logs' not supported in Claude Code web environment")
        sys.exit(1)

    # Find running Odoo to determine profile
    service, profile = _find_running_odoo()
    if not profile:
