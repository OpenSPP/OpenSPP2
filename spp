def cmd_test(args):
    """Run tests for a module (isolated from dev instance)."""
    if not args.module:
        print("Usage: ./spp test <module> [--tags=...] [--local|--docker]")
        print("\nExamples:")
        print("  ./spp test spp_base")
        print("  ./spp test spp_programs --tags=post_install")
        sys.exit(1)

    cmd = ["./scripts/test_single_module.sh", args.module]

    if args.tags:
        cmd.append(f"--test-tags={args.tags}")
    if args.local:
        cmd.append("--local")
    elif args.docker:
        cmd.append("--docker")

    run(cmd, check=False)


def _wait_for_odoo_ready(profile: str, timeout: int = 300):
    """Wait for Odoo to be ready (health check passes).

    Also monitors logs for CRITICAL errors that indicate initialization failure.
    Returns True if ready, False if timeout, raises SystemExit on fatal errors.
    """
    service = "openspp-dev" if profile == "dev" else "openspp"
    print("Waiting for Odoo to be ready...")

    for i in range(timeout):
        # Check for CRITICAL errors in logs (initialization failures)
        logs_result = run(
            docker_compose("logs", "--tail=50", service, profile=profile),
            check=False,
            capture=True,
        )
        if logs_result.returncode == 0:
            logs = logs_result.stdout + logs_result.stderr
            if "CRITICAL" in logs and "Failed to initialize database" in logs:
                error("Database initialization failed!")
                # Extract and show the error
                for line in logs.split("\n"):
                    if "CRITICAL" in line or "ParseError" in line or "ValueError" in line:
                        print(f"  {line.strip()}")
                print("\nCheck full logs with: ./spp logs")
                sys.exit(1)

        # Check health endpoint
        result = run(
            docker_compose(
                "exec",
                "-T",
                service,
                "curl",
                "-sf",
                "http://localhost:8069/web/health",
                profile=profile,
            ),
            check=False,
            capture=True,
        )
        if result.returncode == 0:
            return True
        if i % 10 == 0 and i > 0:
            print(f"  Still waiting... ({i}s)")
        time.sleep(1)

    return False


def _is_fresh_database(profile: str) -> bool:
    """Check if this is a fresh database (no installed modules beyond base)."""
    service = "openspp-dev" if profile == "dev" else "openspp"
    code = "print(len(env['ir.module.module'].search([('state', '=', 'installed')])))"
    result = run(
        docker_compose(
            "exec",
            "-T",
            service,
            "odoo",
            "shell",
            "-d",
            "openspp",
            "--no-http",
            profile=profile,
        ),
        check=False,
        capture=True,
        input=code,
        text=True,
    )
    try:
        # Fresh DB typically has ~10-15 base modules
        count = int(result.stdout.strip().split("\n")[-1])
        return count < 20
    except (ValueError, IndexError):
        return False


def _get_module_state(profile: str, module_name: str) -> str:
    """Get the state of a module ('installed', 'to install', 'uninstalled', etc.)."""
    service = "openspp-dev" if profile == "dev" else "openspp"
    # Pass Python code via stdin (not -c which is for config file)
    code = (
        f"m = env['ir.module.module'].search([('name', '=', '{module_name}')], limit=1); "
        f"print('STATE:' + (m.state if m else 'NOT_FOUND'))"
    )
    result = run(
        docker_compose(
            "exec",
            "-T",
            service,
            "odoo",
            "shell",
            "-d",
            "openspp",
            "--no-http",
            profile=profile,
        ),
        check=False,
        capture=True,
        input=code,
        text=True,
    )
    # Look for our STATE: marker in output
    for line in result.stdout.split("\n"):
        if line.startswith("STATE:"):
            return line[6:].strip()
    return "UNKNOWN"


def _wait_for_module_installed(profile: str, module_name: str, timeout: int = 600) -> tuple:
    """Wait for module installation by monitoring logs.

    Returns (success: bool, error_message: str or None)
    """
    service = "openspp-dev" if profile == "dev" else "openspp"
    print(f"Waiting for module '{module_name}' to be installed...")

    start_time = time.time()

    while time.time() - start_time < timeout:
        # Check recent logs for installation completion or errors
        result = run(
            docker_compose("logs", "--tail", "100", service, profile=profile),
            check=False,
            capture=True,
        )
        logs = result.stdout + result.stderr

        # Check for successful completion - "Registry loaded" appears after all modules installed
        # Note: Odoo logs "Modules loaded." (capital M) and "Registry loaded in X.XXXs"
        logs_lower = logs.lower()
        if "registry loaded in" in logs_lower and "modules loaded" in logs_lower:
            # Verify the module is actually installed now
            state = _get_module_state(profile, module_name)
            if state == "installed":
                return True, None
            elif state in ("to install", "to upgrade"):
                # Registry loaded but module not installed = installation failed
                return (
                    False,
                    f"Module state is '{state}' after registry load - installation failed",
                )

        # Check for fatal errors
        if "ParseError:" in logs or "ValueError:" in logs or "odoo.tools.convert.ParseError" in logs:
            # Extract error context
            for line in logs.split("\n"):
                if "ParseError:" in line or "ValueError:" in line:
                    return False, line.strip()

        elapsed = int(time.time() - start_time)
        if elapsed > 0 and elapsed % 30 == 0:
            print(f"  Still waiting... ({elapsed}s)")

        time.sleep(5)

    return False, "Timeout waiting for installation"


def _show_recent_logs(profile: str, lines: int = 50):
    """Show recent Odoo logs to help diagnose failures."""
    service = "openspp-dev" if profile == "dev" else "openspp"
    print("\n" + _color("1;31", f"=== Recent logs (last {lines} lines) ==="))
    run(
        docker_compose("logs", "--tail", str(lines), service, profile=profile),
        check=False,
    )
    print(_color("1;31", "=== End of logs ===") + "\n")


