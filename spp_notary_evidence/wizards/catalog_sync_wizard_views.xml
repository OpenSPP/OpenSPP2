<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_notary_catalog_sync_wizard_form" model="ir.ui.view">
        <field name="name">spp.notary.catalog.sync.wizard.form</field>
        <field name="model">spp.notary.catalog.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync Notary Catalog">
                <group>
                    <field name="provider_id" />
                    <field name="state" readonly="1" />
                </group>
                <field name="summary" nolabel="1" readonly="1" invisible="not summary" />
                <field name="line_ids" readonly="1" invisible="not line_ids">
                    <list create="0" delete="0">
                        <field name="action" widget="badge" />
                        <field name="claim_id" />
                        <field name="title" />
                        <field name="catalog_version" />
                        <field name="pinned_version" />
                        <field name="state_after" />
                        <field name="blocking" />
                        <field name="message" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_load_preview"
                        string="Load Preview"
                        type="object"
                        class="btn-secondary"
                    />
                    <button
                        name="action_sync_catalog"
                        string="Confirm Sync"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'preview'"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_notary_catalog_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sync Notary Catalog</field>
        <field name="res_model">spp.notary.catalog.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
