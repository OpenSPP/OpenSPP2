<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="privilege_notary_evidence" model="res.groups.privilege">
        <field name="name">Notary Evidence</field>
        <field name="category_id" ref="spp_security.category_spp_admin" />
        <field name="sequence">95</field>
    </record>

    <record id="group_notary_evidence_read" model="res.groups">
        <field name="name">Notary Evidence: Read</field>
        <field name="comment">Technical read access to Notary evidence catalog metadata.</field>
    </record>

    <record id="group_notary_evidence_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_notary_evidence" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_notary_evidence_read')), Command.link(ref('spp_cel_domain.group_cel_domain_viewer'))]"
        />
        <field name="comment">Can view Notary providers and claim catalog metadata.</field>
    </record>

    <record id="group_notary_evidence_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_notary_evidence" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_notary_evidence_viewer')), Command.link(ref('spp_cel_domain.group_cel_domain_manager')), Command.link(ref('spp_registry.group_registry_read'))]"
        />
        <field name="comment">Can manage Notary provider catalog metadata and run catalog sync.</field>
    </record>

    <record id="spp_security.group_spp_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_notary_evidence_manager'))]" />
    </record>
</odoo>
