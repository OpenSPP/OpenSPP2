<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_notary_claim_list" model="ir.ui.view">
        <field name="name">spp.notary.claim.list</field>
        <field name="model">spp.notary.claim</field>
        <field name="arch" type="xml">
            <list string="Notary Claims">
                <field name="name" />
                <field name="provider_id" />
                <field name="external_id" />
                <field name="variable_name" />
                <field name="value_type" widget="badge" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_notary_claim_form" model="ir.ui.view">
        <field name="name">spp.notary.claim.form</field>
        <field name="model">spp.notary.claim</field>
        <field name="arch" type="xml">
            <form string="Notary Claim">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" string="Claim Name" />
                        <h1>
                            <field name="name" placeholder="e.g., Birth Registration Status" />
                        </h1>
                    </div>
                    <group>
                        <group string="Catalog">
                            <field name="provider_id" />
                            <field name="external_id" />
                            <field name="value_type" />
                            <field name="active" />
                        </group>
                        <group string="CEL Contract">
                            <field name="variable_name" readonly="1" />
                            <field name="variable_id" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Claim meaning and upstream catalog notes..." />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_notary_claim_search" model="ir.ui.view">
        <field name="name">spp.notary.claim.search</field>
        <field name="model">spp.notary.claim</field>
        <field name="arch" type="xml">
            <search string="Search Notary Claims">
                <field name="name" />
                <field name="provider_id" />
                <field name="external_id" />
                <field name="variable_name" />
                <filter string="Active" name="active" domain="[('active', '=', True)]" />
                <filter string="Archived" name="archived" domain="[('active', '=', False)]" />
                <group>
                    <filter string="Provider" name="group_provider" context="{'group_by': 'provider_id'}" />
                    <filter string="Value Type" name="group_value_type" context="{'group_by': 'value_type'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_notary_claim" model="ir.actions.act_window">
        <field name="name">Notary Claims</field>
        <field name="res_model">spp.notary.claim</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sync a Notary provider catalog to load claim metadata.
            </p>
        </field>
    </record>
</odoo>
