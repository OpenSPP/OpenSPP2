<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_data_provider_form_notary" model="ir.ui.view">
        <field name="name">spp.data.provider.form.notary</field>
        <field name="model">spp.data.provider</field>
        <field name="inherit_id" ref="spp_cel_domain.view_data_provider_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='active']" position="after">
                <field name="provider_kind" />
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                    name="action_sync_notary_claim_catalog"
                    string="Sync Notary Catalog"
                    type="object"
                    class="btn-secondary"
                    invisible="provider_kind != 'notary'"
                    groups="spp_notary_evidence.group_notary_evidence_manager"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_view_notary_claims"
                    icon="fa-certificate"
                    invisible="provider_kind != 'notary'"
                >
                    <field name="notary_claim_count" widget="statinfo" string="Claims" />
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Notary" name="notary" invisible="provider_kind != 'notary'">
                    <group>
                        <group string="Catalog">
                            <field name="notary_catalog_path" />
                            <field name="notary_catalog_synced_at" readonly="1" />
                        </group>
                    </group>
                    <field name="notary_claim_ids" readonly="1">
                        <list>
                            <field name="name" />
                            <field name="external_id" />
                            <field name="variable_name" />
                            <field name="value_type" widget="badge" />
                            <field name="active" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
