<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ========================================================================== -->
        <!-- GLOBAL READ ACCESS RULES                                                  -->
        <!-- Service points are reference data that should be visible to all users    -->
        <!-- ========================================================================== -->

        <record id="rule_service_point_global_read" model="ir.rule">
            <field name="name">Service Point: Global Read Access</field>
            <field name="model_id" ref="spp_service_points.model_spp_service_point"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
