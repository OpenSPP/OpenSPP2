<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Studio Security Groups
        ======================
        Three-tier architecture following OpenSPP conventions.

        Tier 3 (Technical): group_studio_read
        Tier 2 (User-facing): group_studio_viewer, group_studio_editor_officer, group_studio_manager
        Tier 1 (Admin): spp_security.group_spp_admin implies group_studio_manager

        NOTE: Group definitions and implied_ids are NOT in noupdate
        so the hierarchy is properly maintained on module upgrades.
    -->

    <!-- Tier 3: Technical base group -->
    <record id="group_studio_read" model="res.groups">
        <field name="name">Studio: Read</field>
        <field
            name="comment"
        >Technical group for read access to Studio configurations.</field>
    </record>

    <!-- Tier 2: User-facing groups -->
    <record id="group_studio_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_studio" />
        <field
            name="comment"
        >Can view all Studio configurations and audit logs. Cannot create or modify.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_studio_read'))]" />
    </record>

    <record id="group_studio_editor_officer" model="res.groups">
        <field name="name">Editor</field>
        <field name="privilege_id" ref="privilege_studio" />
        <field
            name="comment"
        >Can create and edit draft configurations. Cannot activate or delete.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_studio_viewer'))]" />
    </record>

    <record id="group_studio_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_studio" />
        <field
            name="comment"
        >Full access: can activate, deactivate, delete configurations and manage external connections.</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_studio_editor_officer'))]"
        />
    </record>

    <!-- Tier 1: Admin hook - SPP Admin implies Studio Manager -->
    <record id="spp_security.group_spp_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_studio_manager'))]" />
    </record>

    <!-- Record Rules (noupdate=1 - users may customize these) -->
    <data noupdate="1">
        <!-- Record Rules for CEL Expressions -->

        <!-- Viewers can see active and published expressions -->
        <record id="rule_expression_viewer_read" model="ir.rule">
            <field name="name">CEL Expressions: Viewers see active and published</field>
            <field name="model_id" ref="spp_cel_domain.model_spp_cel_expression" />
            <field
                name="domain_force"
            >[('state', 'in', ['active', 'published'])]</field>
            <field name="groups" eval="[Command.link(ref('group_studio_viewer'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <!-- Editors can see all expressions -->
        <record id="rule_expression_editor_all" model="ir.rule">
            <field name="name">CEL Expressions: Editors see all</field>
            <field name="model_id" ref="spp_cel_domain.model_spp_cel_expression" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('group_studio_editor_officer'))]"
            />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
        </record>

        <!-- Record Rules for CEL Variables -->

        <!-- Viewers can read variables, only managers can write -->
        <record id="rule_variable_viewer_read" model="ir.rule">
            <field name="name">CEL Variables: Viewers read only</field>
            <field name="model_id" ref="spp_cel_domain.model_spp_cel_variable" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_studio_viewer'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="rule_variable_manager_all" model="ir.rule">
            <field name="name">CEL Variables: Managers full access</field>
            <field name="model_id" ref="spp_cel_domain.model_spp_cel_variable" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_studio_manager'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
        </record>
    </data>
</odoo>
