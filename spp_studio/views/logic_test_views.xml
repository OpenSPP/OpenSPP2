<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ============================================== -->
    <!-- Logic Test Views                               -->
    <!-- ============================================== -->

    <!-- Test Tree View (for embedding in Logic form) -->
    <record id="view_logic_test_tree" model="ir.ui.view">
        <field name="name">spp.studio.test.tree</field>
        <field name="model">spp.studio.test</field>
        <field name="arch" type="xml">
            <list
                string="Test Cases"
                editable="bottom"
                decoration-success="passed == True"
                decoration-danger="passed == False and last_run"
            >
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="input_type" widget="badge" />
                <field name="expected_result" />
                <field name="actual_result" optional="show" readonly="1" />
                <field name="passed" widget="boolean_toggle" readonly="1" />
                <field name="last_run" optional="hide" readonly="1" />

                <button
                    name="action_run_test"
                    type="object"
                    string="Run"
                    icon="fa-play"
                    class="btn-primary"
                />
            </list>
        </field>
    </record>

    <!-- Test Tree View (standalone, with logic_id column) -->
    <record id="view_logic_test_tree_standalone" model="ir.ui.view">
        <field name="name">spp.studio.test.tree.standalone</field>
        <field name="model">spp.studio.test</field>
        <field name="arch" type="xml">
            <list
                string="Test Cases"
                decoration-success="passed == True"
                decoration-danger="passed == False and last_run"
            >
                <field name="sequence" widget="handle" />
                <field name="logic_id" />
                <field name="name" />
                <field name="input_type" widget="badge" />
                <field name="expected_result" />
                <field name="actual_result" optional="show" readonly="1" />
                <field name="passed" widget="boolean_toggle" readonly="1" />
                <field name="last_run" optional="hide" readonly="1" />

                <button
                    name="action_run_test"
                    type="object"
                    string="Run"
                    icon="fa-play"
                    class="btn-primary"
                />
            </list>
        </field>
    </record>

    <!-- Test Form View -->
    <record id="view_logic_test_form" model="ir.ui.view">
        <field name="name">spp.studio.test.form</field>
        <field name="model">spp.studio.test</field>
        <field name="arch" type="xml">
            <form string="Test Case">
                <header>
                    <button
                        name="action_run_test"
                        string="Run Test"
                        type="object"
                        class="btn-primary"
                    />
                    <field
                        name="passed"
                        widget="badge"
                        decoration-success="passed == True"
                        decoration-danger="passed == False"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Test Name" />
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g., Test eligible poor household"
                                required="1"
                            />
                        </h1>
                    </div>

                    <group>
                        <group string="Basic Information">
                            <field name="logic_id" options="{'no_create': True}" />
                            <field
                                name="description"
                                placeholder="Detailed description of what this test validates"
                            />
                            <field name="sequence" />
                        </group>

                        <group string="Expected Result">
                            <field
                                name="expected_result"
                                placeholder="e.g., true, false, 1500, 'eligible'"
                                required="1"
                            />
                        </group>
                    </group>

                    <notebook>
                        <page string="Input Configuration" name="input">
                            <group>
                                <group>
                                    <field name="input_type" widget="radio" />
                                </group>
                            </group>

                            <group>
                                <!-- Persona Input -->
                                <group
                                    string="Persona Selection"
                                    invisible="input_type != 'persona'"
                                >
                                    <field
                                        name="persona_id"
                                        invisible="input_type != 'persona'"
                                        required="input_type == 'persona'"
                                        options="{'no_create': True}"
                                        context="{'default_logic_id': logic_id}"
                                    />
                                </group>

                                <!-- Custom Values Input -->
                                <group
                                    string="Custom Values (JSON)"
                                    invisible="input_type != 'values'"
                                >
                                    <field
                                        name="custom_values"
                                        invisible="input_type != 'values'"
                                        required="input_type == 'values'"
                                        widget="ace"
                                        options="{'mode': 'javascript'}"
                                        placeholder="{'income': 2500, 'hh_size': 4, 'is_female': true}"
                                    />
                                </group>

                                <!-- Registrant Input -->
                                <group
                                    string="Registrant Selection"
                                    invisible="input_type != 'registrant'"
                                >
                                    <field
                                        name="registrant_id"
                                        invisible="input_type != 'registrant'"
                                        required="input_type == 'registrant'"
                                        options="{'no_create': True}"
                                    />
                                </group>
                            </group>
                        </page>

                        <page string="Results" name="results">
                            <group>
                                <group string="Test Execution">
                                    <field name="last_run" readonly="1" />
                                    <field name="actual_result" readonly="1" />
                                    <field
                                        name="passed"
                                        widget="boolean_toggle"
                                        readonly="1"
                                    />
                                    <field
                                        name="error_message"
                                        readonly="1"
                                        invisible="not error_message"
                                        class="text-danger"
                                    />
                                </group>
                            </group>

                            <group string="Execution Log">
                                <field
                                    name="execution_log"
                                    readonly="1"
                                    nolabel="1"
                                    widget="text"
                                    class="o_field_text_code"
                                    placeholder="Run the test to see execution details"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Test Search View -->
    <record id="view_logic_test_search" model="ir.ui.view">
        <field name="name">spp.studio.test.search</field>
        <field name="model">spp.studio.test</field>
        <field name="arch" type="xml">
            <search string="Search Tests">
                <field name="name" />
                <field name="logic_id" />
                <field name="description" />

                <separator />
                <filter
                    string="Passed"
                    name="filter_passed"
                    domain="[('passed', '=', True)]"
                />
                <filter
                    string="Failed"
                    name="filter_failed"
                    domain="[('passed', '=', False), ('last_run', '!=', False)]"
                />
                <filter
                    string="Not Run"
                    name="filter_not_run"
                    domain="[('last_run', '=', False)]"
                />

                <separator />
                <filter
                    string="Persona Input"
                    name="filter_persona"
                    domain="[('input_type', '=', 'persona')]"
                />
                <filter
                    string="Custom Values"
                    name="filter_values"
                    domain="[('input_type', '=', 'values')]"
                />
                <filter
                    string="Registrant"
                    name="filter_registrant"
                    domain="[('input_type', '=', 'registrant')]"
                />

                <group>
                    <filter
                        string="Logic"
                        name="group_logic"
                        context="{'group_by': 'logic_id'}"
                    />
                    <filter
                        string="Input Type"
                        name="group_input_type"
                        context="{'group_by': 'input_type'}"
                    />
                    <filter
                        string="Status"
                        name="group_passed"
                        context="{'group_by': 'passed'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- Test Persona Views                             -->
    <!-- ============================================== -->

    <!-- Persona Tree View -->
    <record id="view_logic_test_persona_tree" model="ir.ui.view">
        <field name="name">spp.studio.test.persona.tree</field>
        <field name="model">spp.studio.test.persona</field>
        <field name="arch" type="xml">
            <list string="Test Personas">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field
                    name="category"
                    widget="badge"
                    decoration-success="category == 'eligible'"
                    decoration-danger="category == 'ineligible'"
                    decoration-warning="category == 'edge'"
                />
                <field name="is_global" widget="boolean_toggle" />
                <field name="logic_id" optional="hide" />
                <field name="active" widget="boolean_toggle" />

                <button
                    name="action_duplicate"
                    type="object"
                    string="Duplicate"
                    icon="fa-copy"
                    class="btn-secondary"
                />
            </list>
        </field>
    </record>

    <!-- Persona Form View -->
    <record id="view_logic_test_persona_form" model="ir.ui.view">
        <field name="name">spp.studio.test.persona.form</field>
        <field name="model">spp.studio.test.persona</field>
        <field name="arch" type="xml">
            <form string="Test Persona">
                <header>
                    <button
                        name="action_duplicate"
                        string="Duplicate"
                        type="object"
                        class="btn-secondary"
                    />
                    <field name="category" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="toggle_active"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-archive"
                        >
                            <field
                                name="active"
                                widget="boolean_button"
                                options="{'terminology': 'archive'}"
                            />
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Persona Name" />
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g., Poor Elderly Widow"
                                required="1"
                            />
                        </h1>
                    </div>

                    <group>
                        <group string="Classification">
                            <field name="category" />
                            <field name="sequence" />
                        </group>

                        <group string="Scope">
                            <field name="is_global" />
                            <field
                                name="logic_id"
                                invisible="is_global == True"
                                required="is_global == False"
                                options="{'no_create': True}"
                            />
                        </group>
                    </group>

                    <separator string="Description" />
                    <field
                        name="description"
                        nolabel="1"
                        placeholder="Detailed description of this persona and what scenarios it represents"
                        class="oe_inline"
                    />

                    <notebook>
                        <page string="Values (JSON)" name="values_json">
                            <group>
                                <field
                                    name="values"
                                    nolabel="1"
                                    widget="ace"
                                    options="{'mode': 'javascript'}"
                                    placeholder='{"income": 1000, "hh_size": 5, "is_female": true, "age": 65}'
                                    required="1"
                                />
                            </group>
                        </page>

                        <page string="Values Preview" name="values_preview">
                            <field name="values_display" nolabel="1" readonly="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Persona Kanban View -->
    <record id="view_logic_test_persona_kanban" model="ir.ui.view">
        <field name="name">spp.studio.test.persona.kanban</field>
        <field name="model">spp.studio.test.persona</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="category">
                <field name="name" />
                <field name="category" />
                <field name="is_global" />
                <field name="logic_id" />
                <field name="active" />
                <field name="values" />

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name" />
                                    </strong>
                                </div>
                                <div class="o_kanban_record_body">
                                    <span
                                        t-if="record.category.raw_value"
                                        class="badge rounded-pill"
                                        t-attf-class="badge rounded-pill {{
                                              record.category.raw_value == 'eligible' ? 'text-bg-success' :
                                              record.category.raw_value == 'ineligible' ? 'text-bg-danger' :
                                              'text-bg-warning'
                                          }}"
                                    >
                                        <t t-esc="record.category.value" />
                                    </span>
                                    <span
                                        t-if="record.is_global.raw_value"
                                        class="badge rounded-pill text-bg-info"
                                    >
                                        Global
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <small class="text-muted">
                                        <t t-if="record.logic_id.value">
                                            <i class="fa fa-link" title="Link" />
                                            <t t-esc="record.logic_id.value" />
                                        </t>
                                        <t
                                            t-if="!record.logic_id.value and !record.is_global.raw_value"
                                        >
                                            <i
                                            class="fa fa-exclamation-triangle text-warning"
                                            title="Warning"
                                        /> No logic assigned
                                        </t>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Persona Search View -->
    <record id="view_logic_test_persona_search" model="ir.ui.view">
        <field name="name">spp.studio.test.persona.search</field>
        <field name="model">spp.studio.test.persona</field>
        <field name="arch" type="xml">
            <search string="Search Personas">
                <field name="name" />
                <field name="description" />
                <field name="logic_id" />

                <separator />
                <filter
                    string="Active"
                    name="filter_active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Archived"
                    name="filter_inactive"
                    domain="[('active', '=', False)]"
                />

                <separator />
                <filter
                    string="Global"
                    name="filter_global"
                    domain="[('is_global', '=', True)]"
                />
                <filter
                    string="Logic-Specific"
                    name="filter_specific"
                    domain="[('is_global', '=', False)]"
                />

                <separator />
                <filter
                    string="Eligible"
                    name="filter_eligible"
                    domain="[('category', '=', 'eligible')]"
                />
                <filter
                    string="Ineligible"
                    name="filter_ineligible"
                    domain="[('category', '=', 'ineligible')]"
                />
                <filter
                    string="Edge Cases"
                    name="filter_edge"
                    domain="[('category', '=', 'edge')]"
                />

                <group>
                    <filter
                        string="Category"
                        name="group_category"
                        context="{'group_by': 'category'}"
                    />
                    <filter
                        string="Logic"
                        name="group_logic"
                        context="{'group_by': 'logic_id'}"
                    />
                    <filter
                        string="Scope (Global/Specific)"
                        name="group_global"
                        context="{'group_by': 'is_global'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Test Persona List -->
    <record id="action_logic_test_persona_list" model="ir.actions.act_window">
        <field name="name">Test Personas</field>
        <field name="path">logic-test-personas</field>
        <field name="res_model">spp.studio.test.persona</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Test Persona
            </p>
            <p>
                Test personas are predefined sets of variable values that represent typical scenarios.<br
            />
                They make it easy to test logic against consistent, reusable test cases.
            </p>
        </field>
    </record>
</odoo>
