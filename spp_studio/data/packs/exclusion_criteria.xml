<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Exclusion Criteria Pack: Common exclusion rules -->
    <record id="pack_exclusion_criteria" model="spp.studio.pack">
        <field name="name">Exclusion Criteria</field>
        <field name="code">exclusion_criteria</field>
        <field
            name="description"
        >Common exclusion criteria and categorical filters used across social protection programs. Includes asset-based, employment-based, and administrative exclusions.</field>
        <field name="category">other</field>
        <field name="version">1.0</field>
        <field name="author">OpenSPP</field>
        <field name="state">available</field>
    </record>

    <!-- Exclusion: Government Employment -->
    <record id="pack_excl_item_govt_employee" model="spp.studio.pack.item">
        <field name="pack_id" ref="pack_exclusion_criteria" />
        <field name="name">Government Employee Exclusion</field>
        <field name="context_type">group</field>
        <field
            name="description"
        >Exclude households with government/public sector employees.</field>
        <field name="expression_type">filter</field>
        <field name="logic_data">{"cel_expression": "!has_government_employee"}</field>
        <field name="sequence">10</field>
    </record>

    <!-- Exclusion: Formal Sector Employment -->
    <record id="pack_excl_item_formal_sector" model="spp.studio.pack.item">
        <field name="pack_id" ref="pack_exclusion_criteria" />
        <field name="name">Formal Sector Exclusion</field>
        <field name="context_type">group</field>
        <field
            name="description"
        >Exclude households with formal sector employment (for informal sector targeting).</field>
        <field name="expression_type">filter</field>
        <field
            name="logic_data"
        >{"cel_expression": "!has_formal_employment || formal_income &lt; 5000"}</field>
        <field name="sequence">20</field>
    </record>

    <!-- Exclusion: Vehicle Ownership -->
    <record id="pack_excl_item_vehicle" model="spp.studio.pack.item">
        <field name="pack_id" ref="pack_exclusion_criteria" />
        <field name="name">Vehicle Ownership Exclusion</field>
        <field name="context_type">group</field>
        <field
            name="description"
        >Exclude households owning motorized vehicles (cars, motorcycles above threshold).</field>
        <field name="expression_type">filter</field>
        <field
            name="logic_data"
        >{"cel_expression": "!owns_car &amp;&amp; motorcycle_count &lt;= 1"}</field>
        <field name="sequence">30</field>
    </record>

    <!-- Exclusion: Land Ownership -->
    <record id="pack_excl_item_land" model="spp.studio.pack.item">
        <field name="pack_id" ref="pack_exclusion_criteria" />
        <field name="name">Land Ownership Exclusion</field>
        <field name="context_type">group</field>
        <field
            name="description"
        >Exclude households with agricultural land above threshold.</field>
        <field name="expression_type">filter</field>
        <field name="logic_data">{"cel_expression": "land_hectares &lt;= 2"}</field>
        <field name="sequence">40</field>
    </record>

    <!-- Exclusion: Business Ownership -->
    <record id="pack_excl_item_business" model="spp.studio.pack.item">
        <field name="pack_id" ref="pack_exclusion_criteria" />
        <field name="name">Business Ownership Exclusion</field>
        <field name="context_type">both</field>
        <field
            name="description"
        >Exclude households owning registered businesses above threshold.</field>
        <field name="expression_type">filter</field>
        <field
            name="logic_data"
        >{"cel_expression": "!owns_registered_business || business_revenue &lt; 50000"}</field>
        <field name="sequence">50</field>
    </record>

    <!-- Exclusion: Housing Quality -->
    <record id="pack_excl_item_housing" model="spp.studio.pack.item">
        <field name="pack_id" ref="pack_exclusion_criteria" />
        <field name="name">Housing Quality Exclusion</field>
        <field name="context_type">both</field>
        <field
            name="description"
        >Exclude households with high-quality/permanent housing (proxy for wealth).</field>
        <field name="expression_type">filter</field>
        <field
            name="logic_data"
        >{"cel_expression": "housing_quality_score &lt;= 3 || !has_permanent_structure"}</field>
        <field name="sequence">60</field>
    </record>

    <!-- Exclusion: Pension Receipt -->
    <record id="pack_excl_item_pension" model="spp.studio.pack.item">
        <field name="pack_id" ref="pack_exclusion_criteria" />
        <field name="name">Pension Receipt Exclusion</field>
        <field name="context_type">both</field>
        <field
            name="description"
        >Exclude individuals already receiving contributory pension.</field>
        <field name="expression_type">filter</field>
        <field
            name="logic_data"
        >{"cel_expression": "!receives_contributory_pension || pension_amount &lt; 1000"}</field>
        <field name="sequence">70</field>
    </record>

    <!-- Exclusion: Other Program Participation -->
    <record id="pack_excl_item_other_programs" model="spp.studio.pack.item">
        <field name="pack_id" ref="pack_exclusion_criteria" />
        <field name="name">Duplicate Program Exclusion</field>
        <field name="context_type">both</field>
        <field
            name="description"
        >Exclude beneficiaries already enrolled in similar programs.</field>
        <field name="expression_type">filter</field>
        <field
            name="logic_data"
        >{"cel_expression": "!enrolled_in_similar_program"}</field>
        <field name="sequence">80</field>
    </record>

    <!-- Exclusion: Tax Payment -->
    <record id="pack_excl_item_tax" model="spp.studio.pack.item">
        <field name="pack_id" ref="pack_exclusion_criteria" />
        <field name="name">Income Tax Payer Exclusion</field>
        <field name="context_type">both</field>
        <field
            name="description"
        >Exclude households paying income tax (above tax threshold).</field>
        <field name="expression_type">filter</field>
        <field name="logic_data">{"cel_expression": "!pays_income_tax"}</field>
        <field name="sequence">90</field>
    </record>

    <!-- Exclusion: Bank Account Balance -->
    <record id="pack_excl_item_bank_balance" model="spp.studio.pack.item">
        <field name="pack_id" ref="pack_exclusion_criteria" />
        <field name="name">Bank Balance Exclusion</field>
        <field name="context_type">both</field>
        <field
            name="description"
        >Exclude households with bank balances above threshold.</field>
        <field name="expression_type">filter</field>
        <field
            name="logic_data"
        >{"cel_expression": "total_bank_balance &lt;= 50000"}</field>
        <field name="sequence">100</field>
    </record>

    <!-- Exclusion: Livestock Ownership -->
    <record id="pack_excl_item_livestock" model="spp.studio.pack.item">
        <field name="pack_id" ref="pack_exclusion_criteria" />
        <field name="name">Livestock Ownership Exclusion</field>
        <field name="context_type">both</field>
        <field
            name="description"
        >Exclude households with livestock above threshold (in Tropical Livestock Units).</field>
        <field name="expression_type">filter</field>
        <field name="logic_data">{"cel_expression": "livestock_tlu &lt;= 5"}</field>
        <field name="sequence">110</field>
    </record>

    <!-- Exclusion: Institutional Residence -->
    <record id="pack_excl_item_institutional" model="spp.studio.pack.item">
        <field name="pack_id" ref="pack_exclusion_criteria" />
        <field name="name">Institutional Residence Exclusion</field>
        <field name="context_type">both</field>
        <field
            name="description"
        >Exclude individuals residing in institutions (prisons, care homes with full support).</field>
        <field name="expression_type">filter</field>
        <field name="logic_data">{"cel_expression": "!in_institutional_care"}</field>
        <field name="sequence">120</field>
    </record>
</odoo>
