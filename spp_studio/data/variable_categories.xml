<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!-- Default Variable Categories -->

    <record id="variable_category_demographics" model="spp.cel.variable.category">
        <field name="name">Demographics</field>
        <field name="code">demographics</field>
        <field name="icon">fa-user</field>
        <field name="color">#3498db</field>
        <field name="sequence">10</field>
    </record>

    <record id="variable_category_household" model="spp.cel.variable.category">
        <field name="name">Household</field>
        <field name="code">household</field>
        <field name="icon">fa-home</field>
        <field name="color">#2ecc71</field>
        <field name="sequence">20</field>
    </record>

    <record id="variable_category_characteristics" model="spp.cel.variable.category">
        <field name="name">Characteristics</field>
        <field name="code">characteristics</field>
        <field name="icon">fa-tags</field>
        <field name="color">#9b59b6</field>
        <field name="sequence">30</field>
    </record>

    <record id="variable_category_indicators" model="spp.cel.variable.category">
        <field name="name">Indicators</field>
        <field name="code">indicators</field>
        <field name="icon">fa-chart-line</field>
        <field name="color">#e67e22</field>
        <field name="sequence">40</field>
    </record>

    <!-- NOTE: Scoring category moved to spp_studio_scoring bridge module -->

    <record id="variable_category_program" model="spp.cel.variable.category">
        <field name="name">Program</field>
        <field name="code">program</field>
        <field name="icon">fa-briefcase</field>
        <field name="color">#1abc9c</field>
        <field name="sequence">60</field>
    </record>

    <record id="variable_category_location" model="spp.cel.variable.category">
        <field name="name">Location</field>
        <field name="code">location</field>
        <field name="icon">fa-map-marker</field>
        <field name="color">#34495e</field>
        <field name="sequence">70</field>
    </record>

    <record id="variable_category_economic" model="spp.cel.variable.category">
        <field name="name">Economic</field>
        <field name="code">economic</field>
        <field name="icon">fa-money</field>
        <field name="color">#27ae60</field>
        <field name="sequence">80</field>
    </record>
</odoo>
