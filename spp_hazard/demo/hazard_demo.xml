<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Demo Hazard Categories -->

    <!-- Top-level Natural Disaster Category -->
    <record id="category_natural" model="spp.hazard.category">
        <field name="name">Natural Disaster</field>
        <field name="code">NATURAL</field>
        <field
            name="description"
        >Natural disasters including weather events, geological events, and climate-related hazards</field>
    </record>

    <!-- Storm subcategory -->
    <record id="category_storm" model="spp.hazard.category">
        <field name="name">Storm</field>
        <field name="code">NAT_STORM</field>
        <field name="parent_id" ref="category_natural" />
        <field
            name="description"
        >Storm events including tropical cyclones, typhoons, hurricanes</field>
    </record>

    <record id="category_typhoon" model="spp.hazard.category">
        <field name="name">Typhoon</field>
        <field name="code">NAT_STORM_TYPHOON</field>
        <field name="parent_id" ref="category_storm" />
        <field name="description">Tropical cyclone in the Pacific region</field>
    </record>

    <!-- Geological subcategory -->
    <record id="category_geological" model="spp.hazard.category">
        <field name="name">Geological</field>
        <field name="code">NAT_GEOLOGICAL</field>
        <field name="parent_id" ref="category_natural" />
        <field
            name="description"
        >Geological events including earthquakes, volcanic eruptions, landslides</field>
    </record>

    <record id="category_earthquake" model="spp.hazard.category">
        <field name="name">Earthquake</field>
        <field name="code">NAT_GEO_EARTHQUAKE</field>
        <field name="parent_id" ref="category_geological" />
        <field name="description">Seismic events causing ground shaking</field>
    </record>

    <record id="category_volcanic" model="spp.hazard.category">
        <field name="name">Volcanic Eruption</field>
        <field name="code">NAT_GEO_VOLCANIC</field>
        <field name="parent_id" ref="category_geological" />
        <field
            name="description"
        >Volcanic activity including eruptions and lahars</field>
    </record>

    <!-- Hydrological subcategory -->
    <record id="category_hydrological" model="spp.hazard.category">
        <field name="name">Hydrological</field>
        <field name="code">NAT_HYDRO</field>
        <field name="parent_id" ref="category_natural" />
        <field
            name="description"
        >Water-related hazards including floods and tsunamis</field>
    </record>

    <record id="category_flood" model="spp.hazard.category">
        <field name="name">Flood</field>
        <field name="code">NAT_HYDRO_FLOOD</field>
        <field name="parent_id" ref="category_hydrological" />
        <field
            name="description"
        >Flooding events from rivers, coastal areas, or flash floods</field>
    </record>

    <!-- Climate subcategory -->
    <record id="category_climate" model="spp.hazard.category">
        <field name="name">Climate</field>
        <field name="code">NAT_CLIMATE</field>
        <field name="parent_id" ref="category_natural" />
        <field
            name="description"
        >Climate-related hazards including drought and extreme temperatures</field>
    </record>

    <record id="category_drought" model="spp.hazard.category">
        <field name="name">Drought</field>
        <field name="code">NAT_CLIMATE_DROUGHT</field>
        <field name="parent_id" ref="category_climate" />
        <field name="description">Extended period of below-normal precipitation</field>
    </record>

    <!-- Health Emergency Category -->
    <record id="category_health" model="spp.hazard.category">
        <field name="name">Health Emergency</field>
        <field name="code">HEALTH</field>
        <field
            name="description"
        >Health emergencies including disease outbreaks and pandemics</field>
    </record>

    <record id="category_pandemic" model="spp.hazard.category">
        <field name="name">Pandemic</field>
        <field name="code">HEALTH_PANDEMIC</field>
        <field name="parent_id" ref="category_health" />
        <field
            name="description"
        >Global disease outbreak affecting large populations</field>
    </record>

    <record id="category_outbreak" model="spp.hazard.category">
        <field name="name">Disease Outbreak</field>
        <field name="code">HEALTH_OUTBREAK</field>
        <field name="parent_id" ref="category_health" />
        <field name="description">Localized disease outbreak</field>
    </record>

    <!-- Conflict Category -->
    <record id="category_conflict" model="spp.hazard.category">
        <field name="name">Conflict</field>
        <field name="code">CONFLICT</field>
        <field
            name="description"
        >Armed conflicts, civil unrest, and forced displacement</field>
    </record>

    <record id="category_armed_conflict" model="spp.hazard.category">
        <field name="name">Armed Conflict</field>
        <field name="code">CONFLICT_ARMED</field>
        <field name="parent_id" ref="category_conflict" />
        <field name="description">Armed conflict between parties</field>
    </record>

    <!-- Economic Category -->
    <record id="category_economic" model="spp.hazard.category">
        <field name="name">Economic Shock</field>
        <field name="code">ECONOMIC</field>
        <field
            name="description"
        >Economic shocks including market disruptions and food insecurity</field>
    </record>

    <record id="category_food_crisis" model="spp.hazard.category">
        <field name="name">Food Crisis</field>
        <field name="code">ECONOMIC_FOOD</field>
        <field name="parent_id" ref="category_economic" />
        <field
            name="description"
        >Food insecurity and shortages affecting populations</field>
    </record>

    <!-- Demo Incidents -->
    <record id="incident_typhoon_demo" model="spp.hazard.incident">
        <field name="name">Demo Typhoon Alpha</field>
        <field name="code">2024-DEMO-TYPHOON</field>
        <field name="category_id" ref="category_typhoon" />
        <field name="start_date">2024-11-15</field>
        <field name="status">recovery</field>
        <field name="severity_id" ref="code_cap_severity_extreme" />
        <field
            name="description"
        ><![CDATA[
            <p>Demo typhoon incident for testing purposes.</p>
            <p>This represents a severe typhoon affecting multiple regions.</p>
        ]]></field>
    </record>

    <record id="incident_flood_demo" model="spp.hazard.incident">
        <field name="name">Demo Flooding Event</field>
        <field name="code">2024-DEMO-FLOOD</field>
        <field name="category_id" ref="category_flood" />
        <field name="start_date">2024-10-01</field>
        <field name="end_date">2024-10-15</field>
        <field name="status">closed</field>
        <field name="severity_id" ref="code_cap_severity_severe" />
        <field
            name="description"
        ><![CDATA[
            <p>Demo flooding incident for testing purposes.</p>
            <p>Localized flooding in riverine areas.</p>
        ]]></field>
    </record>

    <record id="incident_drought_demo" model="spp.hazard.incident">
        <field name="name">Demo Drought 2024</field>
        <field name="code">2024-DEMO-DROUGHT</field>
        <field name="category_id" ref="category_drought" />
        <field name="start_date">2024-03-01</field>
        <field name="status">active</field>
        <field name="severity_id" ref="code_cap_severity_severe" />
        <field
            name="description"
        ><![CDATA[
            <p>Ongoing drought affecting agricultural regions.</p>
            <p>Below-normal rainfall for 6+ months.</p>
        ]]></field>
    </record>

    <!-- Demo Areas (spp_area provides no demo data, so minimal records are created here) -->
    <record id="demo_area_northern_province" model="spp.area">
        <field name="draft_name">Northern Province</field>
        <field name="code">DEMO-AREA-NORTH</field>
    </record>

    <record id="demo_area_coastal_district" model="spp.area">
        <field name="draft_name">Coastal District</field>
        <field name="code">DEMO-AREA-COAST</field>
    </record>

    <record id="demo_area_inland_valley" model="spp.area">
        <field name="draft_name">Inland Valley</field>
        <field name="code">DEMO-AREA-INLAND</field>
    </record>

    <!-- Demo Incident Area Links (Task 6.1) -->
    <record id="incident_area_typhoon_northern" model="spp.hazard.incident.area">
        <field name="incident_id" ref="incident_typhoon_demo" />
        <field name="area_id" ref="demo_area_northern_province" />
        <field name="severity_override">5</field>
        <field name="affected_population_estimate">12500</field>
        <field
            name="notes"
        >Direct hit from typhoon eye; severe structural damage reported.</field>
    </record>

    <record id="incident_area_typhoon_coastal" model="spp.hazard.incident.area">
        <field name="incident_id" ref="incident_typhoon_demo" />
        <field name="area_id" ref="demo_area_coastal_district" />
        <field name="severity_override">4</field>
        <field name="affected_population_estimate">8200</field>
        <field
            name="notes"
        >Storm surge and coastal flooding; fishing communities heavily impacted.</field>
    </record>

    <record id="incident_area_flood_coastal" model="spp.hazard.incident.area">
        <field name="incident_id" ref="incident_flood_demo" />
        <field name="area_id" ref="demo_area_coastal_district" />
        <field name="severity_override">3</field>
        <field name="affected_population_estimate">3400</field>
        <field
            name="notes"
        >Riverine flooding submerged low-lying settlements for 14 days.</field>
    </record>

    <record id="incident_area_drought_inland" model="spp.hazard.incident.area">
        <field name="incident_id" ref="incident_drought_demo" />
        <field name="area_id" ref="demo_area_inland_valley" />
        <field name="severity_override">3</field>
        <field name="affected_population_estimate">6700</field>
        <field
            name="notes"
        >Agricultural zone with total crop failure reported in two consecutive seasons.</field>
    </record>

    <!-- Demo Registrants (spp_registry provides no demo data, so minimal records are created here) -->
    <record id="demo_registrant_santos" model="res.partner">
        <field name="name">SANTOS, MARIA</field>
        <field name="is_registrant">True</field>
        <field name="is_group">False</field>
        <field name="area_id" ref="demo_area_northern_province" />
    </record>

    <record id="demo_registrant_reyes" model="res.partner">
        <field name="name">REYES, JOSE</field>
        <field name="is_registrant">True</field>
        <field name="is_group">False</field>
        <field name="area_id" ref="demo_area_coastal_district" />
    </record>

    <record id="demo_registrant_cruz" model="res.partner">
        <field name="name">CRUZ, ANA</field>
        <field name="is_registrant">True</field>
        <field name="is_group">False</field>
        <field name="area_id" ref="demo_area_inland_valley" />
    </record>

    <!-- Demo Impact Records (Task 6.2) -->
    <!-- Typhoon impacts - mix of verification statuses and damage levels -->
    <record id="impact_typhoon_santos_displacement" model="spp.hazard.impact">
        <field name="incident_id" ref="incident_typhoon_demo" />
        <field name="registrant_id" ref="demo_registrant_santos" />
        <field name="impact_type_id" ref="spp_hazard.impact_type_displacement" />
        <field name="damage_level">severe</field>
        <field name="impact_date">2024-11-15</field>
        <field name="verification_status">verified</field>
        <field
            name="notes"
        >Family evacuated to barangay hall; home partially submerged.</field>
    </record>

    <record id="impact_typhoon_santos_property" model="spp.hazard.impact">
        <field name="incident_id" ref="incident_typhoon_demo" />
        <field name="registrant_id" ref="demo_registrant_santos" />
        <field name="impact_type_id" ref="spp_hazard.impact_type_property_damage" />
        <field name="damage_level">totally_damaged</field>
        <field name="impact_date">2024-11-16</field>
        <field name="verification_status">verified</field>
        <field name="notes">Roof collapsed; walls structurally compromised.</field>
    </record>

    <record id="impact_typhoon_reyes_livelihood" model="spp.hazard.impact">
        <field name="incident_id" ref="incident_typhoon_demo" />
        <field name="registrant_id" ref="demo_registrant_reyes" />
        <field name="impact_type_id" ref="spp_hazard.impact_type_livelihood_loss" />
        <field name="damage_level">moderate</field>
        <field name="impact_date">2024-11-18</field>
        <field name="verification_status">reported</field>
        <field
            name="notes"
        >Fishing boat damaged; unable to work for several weeks.</field>
    </record>

    <!-- Flood impact -->
    <record id="impact_flood_reyes_property" model="spp.hazard.impact">
        <field name="incident_id" ref="incident_flood_demo" />
        <field name="registrant_id" ref="demo_registrant_reyes" />
        <field name="impact_type_id" ref="spp_hazard.impact_type_property_damage" />
        <field name="damage_level">partially_damaged</field>
        <field name="impact_date">2024-10-03</field>
        <field name="verification_status">closed</field>
        <field
            name="notes"
        >Ground floor flooded; damage assessed and assistance provided.</field>
    </record>

    <!-- Drought impacts -->
    <record id="impact_drought_cruz_crop_loss" model="spp.hazard.impact">
        <field name="incident_id" ref="incident_drought_demo" />
        <field name="registrant_id" ref="demo_registrant_cruz" />
        <field name="impact_type_id" ref="spp_hazard.impact_type_crop_loss" />
        <field name="damage_level">critical</field>
        <field name="impact_date">2024-05-01</field>
        <field name="verification_status">verified</field>
        <field
            name="notes"
        >Total loss of rice crop due to lack of irrigation water.</field>
    </record>
</odoo>
