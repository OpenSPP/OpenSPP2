<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Default Impact Types -->

    <!-- Physical Impacts -->
    <record id="impact_type_displacement" model="spp.hazard.impact.type">
        <field name="name">Displacement</field>
        <field name="code">DISPLACEMENT</field>
        <field name="category">physical</field>
        <field name="sequence">10</field>
        <field
            name="description"
        >Person or household forced to leave their home due to the hazard</field>
    </record>

    <record id="impact_type_property_damage" model="spp.hazard.impact.type">
        <field name="name">Property Damage</field>
        <field name="code">PROPERTY_DAMAGE</field>
        <field name="category">physical</field>
        <field name="sequence">20</field>
        <field
            name="description"
        >Damage to home, building, or other physical property</field>
    </record>

    <record id="impact_type_injury" model="spp.hazard.impact.type">
        <field name="name">Injury</field>
        <field name="code">INJURY</field>
        <field name="category">physical</field>
        <field name="sequence">30</field>
        <field
            name="description"
        >Physical injury sustained as a result of the hazard</field>
    </record>

    <record id="impact_type_death" model="spp.hazard.impact.type">
        <field name="name">Death/Fatality</field>
        <field name="code">DEATH</field>
        <field name="category">physical</field>
        <field name="sequence">40</field>
        <field name="description">Loss of life as a result of the hazard</field>
    </record>

    <!-- Economic Impacts -->
    <record id="impact_type_livelihood_loss" model="spp.hazard.impact.type">
        <field name="name">Livelihood Loss</field>
        <field name="code">LIVELIHOOD_LOSS</field>
        <field name="category">economic</field>
        <field name="sequence">50</field>
        <field name="description">Loss of income source or means of livelihood</field>
    </record>

    <record id="impact_type_asset_destruction" model="spp.hazard.impact.type">
        <field name="name">Asset Destruction</field>
        <field name="code">ASSET_DESTRUCTION</field>
        <field name="category">economic</field>
        <field name="sequence">60</field>
        <field
            name="description"
        >Destruction of productive assets (equipment, livestock, crops)</field>
    </record>

    <record id="impact_type_crop_loss" model="spp.hazard.impact.type">
        <field name="name">Crop Loss</field>
        <field name="code">CROP_LOSS</field>
        <field name="category">economic</field>
        <field name="sequence">70</field>
        <field name="description">Loss of agricultural crops due to the hazard</field>
    </record>

    <record id="impact_type_livestock_loss" model="spp.hazard.impact.type">
        <field name="name">Livestock Loss</field>
        <field name="code">LIVESTOCK_LOSS</field>
        <field name="category">economic</field>
        <field name="sequence">75</field>
        <field
            name="description"
        >Loss of livestock (death, injury, or displacement)</field>
    </record>

    <!-- Health Impacts -->
    <record id="impact_type_illness" model="spp.hazard.impact.type">
        <field name="name">Illness</field>
        <field name="code">ILLNESS</field>
        <field name="category">health</field>
        <field name="sequence">80</field>
        <field
            name="description"
        >Illness contracted as a result of the hazard (e.g., waterborne disease)</field>
    </record>

    <record id="impact_type_disability" model="spp.hazard.impact.type">
        <field name="name">Disability</field>
        <field name="code">DISABILITY</field>
        <field name="category">health</field>
        <field name="sequence">90</field>
        <field
            name="description"
        >Permanent or long-term disability resulting from the hazard</field>
    </record>

    <record id="impact_type_psychological" model="spp.hazard.impact.type">
        <field name="name">Psychological Impact</field>
        <field name="code">PSYCHOLOGICAL</field>
        <field name="category">health</field>
        <field name="sequence">100</field>
        <field
            name="description"
        >Mental health impacts including trauma, stress, anxiety</field>
    </record>

    <!-- Social Impacts -->
    <record id="impact_type_family_separation" model="spp.hazard.impact.type">
        <field name="name">Family Separation</field>
        <field name="code">FAMILY_SEPARATION</field>
        <field name="category">social</field>
        <field name="sequence">110</field>
        <field
            name="description"
        >Separation from family members due to the hazard</field>
    </record>

    <record id="impact_type_community_disruption" model="spp.hazard.impact.type">
        <field name="name">Community Disruption</field>
        <field name="code">COMMUNITY_DISRUPTION</field>
        <field name="category">social</field>
        <field name="sequence">120</field>
        <field
            name="description"
        >Disruption to community structures and social networks</field>
    </record>

    <record id="impact_type_education_disruption" model="spp.hazard.impact.type">
        <field name="name">Education Disruption</field>
        <field name="code">EDUCATION_DISRUPTION</field>
        <field name="category">social</field>
        <field name="sequence">130</field>
        <field
            name="description"
        >Interruption to education (school damage, displacement)</field>
    </record>
</odoo>
