<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Hazard Incident List View -->
    <record id="view_hazard_incident_list" model="ir.ui.view">
        <field name="name">view.hazard.incident.list</field>
        <field name="model">spp.hazard.incident</field>
        <field name="arch" type="xml">
            <list
                decoration-info="status == 'alert'"
                decoration-success="status == 'active'"
                decoration-warning="status == 'recovery'"
                decoration-muted="status == 'closed'"
            >
                <field name="name" />
                <field name="code" />
                <field name="category_id" />
                <field name="start_date" />
                <field name="end_date" optional="show" />
                <field
                    name="status"
                    widget="badge"
                    decoration-info="status == 'alert'"
                    decoration-success="status == 'active'"
                    decoration-warning="status == 'recovery'"
                    decoration-muted="status == 'closed'"
                />
                <field
                    name="severity"
                    widget="badge"
                    decoration-muted="severity in ('1', '2')"
                    decoration-warning="severity in ('3', '4')"
                    decoration-danger="severity == '5'"
                />
                <field name="area_count" string="Areas" />
                <field name="affected_registrant_count" string="Affected" />
            </list>
        </field>
    </record>

    <!-- Hazard Incident Form View -->
    <record id="view_hazard_incident_form" model="ir.ui.view">
        <field name="name">view.hazard.incident.form</field>
        <field name="model">spp.hazard.incident</field>
        <field name="arch" type="xml">
            <form string="Hazard Incident">
                <header>
                    <button
                        name="action_set_active"
                        type="object"
                        string="Set Active"
                        invisible="status not in ('alert', 'recovery')"
                        class="btn-primary"
                    />
                    <button
                        name="action_set_recovery"
                        type="object"
                        string="Start Recovery"
                        invisible="status != 'active'"
                        class="btn-primary"
                    />
                    <button
                        name="action_close"
                        type="object"
                        string="Close Incident"
                        invisible="status in ('closed',)"
                        class="btn-secondary"
                    />
                    <field
                        name="status"
                        widget="statusbar"
                        statusbar_visible="alert,active,recovery,closed"
                    />
                </header>
                <sheet>
                    <field name="is_ongoing" invisible="1" />
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_impacts"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-users"
                        >
                            <field
                                name="affected_registrant_count"
                                widget="statinfo"
                                string="Affected"
                            />
                        </button>
                        <button
                            name="action_view_areas"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-map-marker"
                            invisible="area_count == 0"
                        >
                            <field name="area_count" widget="statinfo" string="Areas" />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Ongoing"
                        bg_color="text-bg-warning"
                        invisible="not is_ongoing"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g., Typhoon Yolanda"
                                readonly="status == 'closed'"
                            />
                        </h1>
                    </div>
                    <div
                        class="alert alert-info mb-3"
                        invisible="status != 'alert'"
                        role="status"
                    >
                        <i class="fa fa-info-circle me-2" title="Alert Phase" />
                        <strong
                    >Alert Phase</strong> - This incident is in alert status. Activate when response begins.
                    </div>
                    <div
                        class="alert alert-warning mb-3"
                        invisible="status != 'recovery'"
                        role="status"
                    >
                        <i
                        class="fa fa-exclamation-triangle me-2"
                        title="Recovery Phase"
                    />
                        <strong
                    >Recovery Phase</strong> - This incident is in recovery. Close when recovery is complete.
                    </div>
                    <group>
                        <group name="main_info">
                            <field
                                name="code"
                                placeholder="e.g., 2013-YOLANDA"
                                readonly="status == 'closed'"
                            />
                            <field
                                name="category_id"
                                options="{'no_create': True}"
                                readonly="status == 'closed'"
                            />
                            <field name="severity" readonly="status == 'closed'" />
                        </group>
                        <group name="dates">
                            <field name="start_date" readonly="status == 'closed'" />
                            <field name="end_date" readonly="status == 'closed'" />
                        </group>
                    </group>
                    <group name="extension_section" invisible="1" />
                    <notebook>
                        <page string="Description" name="description">
                            <field
                                name="description"
                                placeholder="Describe the incident in detail..."
                                readonly="status == 'closed'"
                            />
                        </page>
                        <page string="Affected Areas" name="areas">
                            <p
                                class="text-muted"
                                invisible="status == 'closed'"
                            >Add areas affected by this incident. Specify severity and population estimates for each area.</p>
                            <field
                                name="incident_area_ids"
                                readonly="status == 'closed'"
                            >
                                <list editable="bottom">
                                    <field
                                        name="area_id"
                                        options="{'no_create': True}"
                                    />
                                    <field name="severity_override" />
                                    <field name="affected_population_estimate" />
                                    <field name="notes" />
                                </list>
                            </field>
                        </page>
                        <page string="Impacts" name="impacts">
                            <field name="impact_ids" readonly="status == 'closed'">
                                <list>
                                    <field name="registrant_id" />
                                    <field name="impact_type_id" />
                                    <field
                                        name="damage_level"
                                        widget="badge"
                                        decoration-muted="damage_level in ('minimal', 'moderate')"
                                        decoration-warning="damage_level in ('severe', 'partially_damaged')"
                                        decoration-danger="damage_level in ('critical', 'totally_damaged')"
                                    />
                                    <field name="impact_date" />
                                    <field
                                        name="verification_status"
                                        widget="badge"
                                        decoration-info="verification_status == 'reported'"
                                        decoration-success="verification_status == 'verified'"
                                        decoration-warning="verification_status == 'disputed'"
                                        decoration-muted="verification_status == 'closed'"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Hazard Incident Search View -->
    <record id="view_hazard_incident_search" model="ir.ui.view">
        <field name="name">view.hazard.incident.search</field>
        <field name="model">spp.hazard.incident</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <field name="category_id" />
                <separator />
                <filter
                    name="alert"
                    string="Alert"
                    domain="[('status', '=', 'alert')]"
                />
                <filter
                    name="active"
                    string="Active"
                    domain="[('status', '=', 'active')]"
                />
                <filter
                    name="recovery"
                    string="Recovery"
                    domain="[('status', '=', 'recovery')]"
                />
                <filter
                    name="closed"
                    string="Closed"
                    domain="[('status', '=', 'closed')]"
                />
                <separator />
                <filter
                    name="ongoing"
                    string="Ongoing"
                    domain="[('is_ongoing', '=', True)]"
                />
                <separator />
                <group name="groupby">
                    <filter
                        name="grp_status"
                        string="Status"
                        context="{'group_by': 'status'}"
                    />
                    <filter
                        name="grp_category"
                        string="Category"
                        context="{'group_by': 'category_id'}"
                    />
                    <filter
                        name="grp_severity"
                        string="Severity"
                        context="{'group_by': 'severity'}"
                    />
                    <filter
                        name="grp_start"
                        string="Start Date"
                        context="{'group_by': 'start_date:month'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Hazard Incident Action -->
    <record id="action_hazard_incident" model="ir.actions.act_window">
        <field name="name">Hazard Incidents</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">spp.hazard.incident</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="path">hazard-incidents</field>
        <field
            name="context"
        >{'search_default_alert': 1, 'search_default_active': 1, 'search_default_recovery': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record your first hazard incident
            </p>
            <p>
                Track specific emergency events like typhoons, earthquakes,
                or disease outbreaks. Link affected areas and record impacts
                on registrants.
            </p>
        </field>
    </record>

    <!-- Hazard Incident Area List View -->
    <record id="view_hazard_incident_area_list" model="ir.ui.view">
        <field name="name">view.hazard.incident.area.list</field>
        <field name="model">spp.hazard.incident.area</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="incident_id" />
                <field name="area_id" />
                <field name="severity_override" />
                <field name="affected_population_estimate" />
                <field name="notes" />
            </list>
        </field>
    </record>
</odoo>
