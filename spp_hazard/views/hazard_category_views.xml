<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hazard Category List View -->
    <record id="view_hazard_category_list" model="ir.ui.view">
        <field name="name">view.hazard.category.list</field>
        <field name="model">spp.hazard.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name"/>
                <field name="code"/>
                <field name="parent_id" optional="hide"/>
                <field name="incident_count" string="Incidents"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Hazard Category Form View -->
    <record id="view_hazard_category_form" model="ir.ui.view">
        <field name="name">view.hazard.category.form</field>
        <field name="model">spp.hazard.category</field>
        <field name="arch" type="xml">
            <form string="Hazard Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_incidents"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-bolt"
                            invisible="incident_count == 0">
                            <field name="incident_count" widget="statinfo" string="Incidents"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Typhoon"/>
                        </h1>
                    </div>
                    <group>
                        <group name="main_info">
                            <field name="code" placeholder="e.g., NAT_STORM_TYPHOON"/>
                            <field name="parent_id" options="{'no_create': True}"/>
                            <field name="active"/>
                        </group>
                        <group name="computed_info">
                            <field name="complete_name"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe this hazard category..."/>
                        </page>
                        <page string="Subcategories" name="subcategories" invisible="not child_ids">
                            <field name="child_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Hazard Category Search View -->
    <record id="view_hazard_category_search" model="ir.ui.view">
        <field name="name">view.hazard.category.search</field>
        <field name="model">spp.hazard.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="grp_parent" string="Parent" context="{'group_by': 'parent_id'}"/>
            </search>
        </field>
    </record>

    <!-- Hazard Category Action -->
    <record id="action_hazard_category" model="ir.actions.act_window">
        <field name="name">Hazard Categories</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">spp.hazard.category</field>
        <field name="view_mode">list,form</field>
        <field name="path">hazard-categories</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first hazard category
            </p>
            <p>
                Define categories to classify different types of hazards
                (e.g., Natural, Health, Conflict). Categories can be hierarchical.
            </p>
        </field>
    </record>
</odoo>
