<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Extend Individual Form View to show hazard impacts -->
    <!-- This inherits view_individuals_form which is also used by the groups action
         (see spp_registry.action_groups_list_form_view), so groups get these extensions too. -->
    <record id="view_individual_form_hazard" model="ir.ui.view">
        <field name="name">view.individual.form.hazard</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_individuals_form" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_hazard_impacts"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-bolt"
                    invisible="hazard_impact_count == 0"
                >
                    <field
                        name="hazard_impact_count"
                        widget="statinfo"
                        string="Impacts"
                    />
                </button>
            </xpath>
            <!-- Add Emergency Response tab for hazard impacts -->
            <xpath expr="//page[@name='participation']" position="after">
                <page
                    string="Emergency Response"
                    name="emergency_response"
                    invisible="not is_registrant"
                >
                    <field name="has_active_impact" invisible="1" />
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not has_active_impact"
                    >
                        <i
                            class="fa fa-exclamation-triangle me-2"
                            title="Active hazard impact"
                        />
                        <span class="fw-bold">Active incident impacts recorded.</span>
                        <span
                        >This registrant is affected by one or more ongoing hazard incidents.</span>
                    </div>
                    <p class="text-muted" invisible="hazard_impact_count != 0">
                        No emergency response records yet. Impact records will appear here when this registrant is affected by a hazard incident.
                    </p>
                    <group
                        name="hazard_impacts_section"
                        string="Incident Impacts"
                        invisible="hazard_impact_count == 0"
                    >
                        <field
                            name="hazard_impact_ids"
                            nolabel="1"
                            readonly="1"
                            colspan="2"
                        >
                            <list>
                                <field name="incident_id" />
                                <field name="impact_type_id" />
                                <field
                                    name="damage_level"
                                    widget="badge"
                                    decoration-muted="damage_level in ('minimal', 'moderate')"
                                    decoration-warning="damage_level in ('severe', 'partially_damaged')"
                                    decoration-danger="damage_level in ('critical', 'totally_damaged')"
                                />
                                <field name="impact_date" />
                                <field
                                    name="verification_status"
                                    widget="badge"
                                    decoration-info="verification_status == 'reported'"
                                    decoration-success="verification_status == 'verified'"
                                    decoration-warning="verification_status == 'disputed'"
                                    decoration-muted="verification_status == 'closed'"
                                />
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extend Individual List View -->
    <record id="view_individual_list_hazard" model="ir.ui.view">
        <field name="name">view.individual.list.hazard</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_individuals_list_tree" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="hazard_impact_count" string="Impacts" optional="hide" />
                <field
                    name="has_active_impact"
                    string="Active Impact"
                    optional="hide"
                />
            </xpath>
        </field>
    </record>

    <!-- Extend Individual Search View -->
    <record id="view_individual_search_hazard" model="ir.ui.view">
        <field name="name">view.individual.search.hazard</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_registry_individuals_filter" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator />
                <filter
                    name="has_active_impact"
                    string="Has Active Impact"
                    domain="[('has_active_impact', '=', True)]"
                />
                <filter
                    name="has_impact"
                    string="Has Any Impact"
                    domain="[('hazard_impact_count', '>', 0)]"
                />
            </xpath>
        </field>
    </record>
</odoo>
