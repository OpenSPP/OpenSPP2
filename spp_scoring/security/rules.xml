<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================= -->
        <!-- Scoring Model Rules                           -->
        <!-- ============================================= -->

        <!-- All scoring users can read all scoring models -->
        <record id="rule_scoring_model_read_all" model="ir.rule">
            <field name="name">Scoring Model: Read All</field>
            <field name="model_id" ref="model_spp_scoring_model"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                Command.link(ref('group_scoring_viewer')),
            ]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Managers can do everything with scoring models -->
        <record id="rule_scoring_model_manager" model="ir.rule">
            <field name="name">Scoring Model: Manager Full Access</field>
            <field name="model_id" ref="model_spp_scoring_model"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                Command.link(ref('group_scoring_manager')),
            ]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- ============================================= -->
        <!-- Scoring Result Rules                          -->
        <!-- ============================================= -->

        <!-- All scoring users can read all results -->
        <record id="rule_scoring_result_read_all" model="ir.rule">
            <field name="name">Scoring Result: Read All</field>
            <field name="model_id" ref="model_spp_scoring_result"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                Command.link(ref('group_scoring_viewer')),
            ]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Officers can create/write their own results -->
        <record id="rule_scoring_result_officer" model="ir.rule">
            <field name="name">Scoring Result: Officer Access</field>
            <field name="model_id" ref="model_spp_scoring_result"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                Command.link(ref('group_scoring_officer')),
            ]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Managers can delete results -->
        <record id="rule_scoring_result_manager" model="ir.rule">
            <field name="name">Scoring Result: Manager Full Access</field>
            <field name="model_id" ref="model_spp_scoring_result"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                Command.link(ref('group_scoring_manager')),
            ]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

    </data>
</odoo>
