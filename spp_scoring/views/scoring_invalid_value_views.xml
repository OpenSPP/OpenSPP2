<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Invalid Value List -->
    <record id="view_spp_scoring_invalid_value_list" model="ir.ui.view">
        <field name="name">spp.scoring.invalid.value.list</field>
        <field name="model">spp.scoring.invalid.value</field>
        <field name="arch" type="xml">
            <list string="Invalid Values" editable="bottom">
                <field name="name" />
                <field name="description" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <!-- Invalid Value Form -->
    <record id="view_spp_scoring_invalid_value_form" model="ir.ui.view">
        <field name="name">spp.scoring.invalid.value.form</field>
        <field name="model">spp.scoring.invalid.value</field>
        <field name="arch" type="xml">
            <form string="Invalid Value">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <field name="name" placeholder="e.g., No Birthdate!" />
                        <field name="description" />
                        <field name="active" widget="boolean_toggle" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_spp_scoring_invalid_value_search" model="ir.ui.view">
        <field name="name">spp.scoring.invalid.value.search</field>
        <field name="model">spp.scoring.invalid.value</field>
        <field name="arch" type="xml">
            <search string="Search Invalid Values">
                <field name="name" />
                <field name="description" />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_spp_scoring_invalid_value" model="ir.actions.act_window">
        <field name="name">Invalid Values</field>
        <field name="res_model">spp.scoring.invalid.value</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a curated invalid value
            </p>
            <p>
                These string values (e.g. <em>No Birthdate!</em>,
                <em>Unknown</em>, <em>N/A</em>) are treated as
                <strong>missing</strong> by every scoring indicator.
                Untick <em>Active</em> to retire an entry without losing it.
            </p>
        </field>
    </record>
</odoo>
