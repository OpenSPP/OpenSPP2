<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Scoring Model Form View -->
    <record id="view_spp_scoring_model_form" model="ir.ui.view">
        <field name="name">spp.scoring.model.form</field>
        <field name="model">spp.scoring.model</field>
        <field name="arch" type="xml">
            <form string="Scoring Model">
                <header>
                    <button
                        name="action_activate"
                        string="Activate"
                        type="object"
                        class="btn-primary"
                        invisible="is_active"
                    />
                    <button
                        name="action_deactivate"
                        string="Deactivate"
                        type="object"
                        invisible="not is_active"
                    />
                    <field name="is_active" widget="boolean_toggle" readonly="1" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_results"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list-alt"
                        >
                            <field
                                name="result_count"
                                widget="statinfo"
                                string="Results"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Model Name" />
                        </h1>
                    </div>

                    <group col="2">
                        <group name="basic_info" string="Basic Information">
                            <field name="code" />
                            <field name="version" />
                            <field name="category" />
                            <field name="sequence" />
                        </group>
                        <group name="calculation" string="Calculation">
                            <field name="calculation_method" />
                            <field name="expected_total_weight" />
                            <field name="total_weight" readonly="1" />
                            <field name="is_strict_mode" />
                        </group>
                    </group>

                    <group col="2">
                        <group name="validity" string="Validity Period">
                            <field name="effective_date" />
                            <field name="end_date" />
                        </group>
                        <group
                            name="cel_config"
                            string="CEL Configuration"
                            invisible="calculation_method != 'cel_formula'"
                        >
                            <field name="cel_profile" />
                        </group>
                    </group>

                    <group invisible="calculation_method != 'cel_formula'" col="1">
                        <field
                            name="cel_expression"
                            widget="cel_expression"
                            cel_profile="registry_groups"
                            show_symbol_browser="true"
                            show_validation_count="false"
                            placeholder="e.g., indicators.roof * 0.5 + indicators.assets * 0.3"
                        />
                    </group>

                    <field
                        name="description"
                        placeholder="Description of this scoring model..."
                    />

                    <notebook>
                        <page string="Indicators" name="indicators">
                            <field
                                name="indicator_ids"
                                context="{'default_model_id': id}"
                            >
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="code" />
                                    <field name="name" />
                                    <field name="field_path" />
                                    <field name="calculation_type" />
                                    <field name="weight" />
                                    <field name="is_required" />
                                    <field name="default_score" />
                                </list>
                            </field>
                        </page>
                        <page string="Thresholds" name="thresholds">
                            <field
                                name="threshold_ids"
                                context="{'default_model_id': id}"
                            >
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="min_score" />
                                    <field name="max_score" />
                                    <field name="classification_code" />
                                    <field name="classification_label" />
                                    <field name="display_color" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Scoring Model List View -->
    <record id="view_spp_scoring_model_list" model="ir.ui.view">
        <field name="name">spp.scoring.model.list</field>
        <field name="model">spp.scoring.model</field>
        <field name="arch" type="xml">
            <list string="Scoring Models" decoration-muted="not is_active">
                <field name="sequence" widget="handle" />
                <field name="code" />
                <field name="name" />
                <field name="version" />
                <field name="category" />
                <field name="calculation_method" />
                <field name="is_active" />
                <field name="effective_date" optional="show" />
                <field name="end_date" optional="show" />
                <field name="indicator_count" />
                <field name="result_count" />
            </list>
        </field>
    </record>

    <!-- Scoring Model Search View -->
    <record id="view_spp_scoring_model_search" model="ir.ui.view">
        <field name="name">spp.scoring.model.search</field>
        <field name="model">spp.scoring.model</field>
        <field name="arch" type="xml">
            <search string="Search Scoring Models">
                <field name="name" />
                <field name="code" />
                <field name="category" />
                <separator />
                <filter
                    name="active"
                    string="Active"
                    domain="[('is_active', '=', True)]"
                />
                <filter
                    name="inactive"
                    string="Inactive"
                    domain="[('is_active', '=', False)]"
                />
                <separator />
                <filter
                    name="poverty"
                    string="Poverty"
                    domain="[('category', '=', 'poverty')]"
                />
                <filter
                    name="vulnerability"
                    string="Vulnerability"
                    domain="[('category', '=', 'vulnerability')]"
                />
                <filter
                    name="eligibility"
                    string="Eligibility"
                    domain="[('category', '=', 'eligibility')]"
                />
                <separator />
                <filter
                    name="group_category"
                    string="Category"
                    context="{'group_by': 'category'}"
                />
                <filter
                    name="group_method"
                    string="Calculation Method"
                    context="{'group_by': 'calculation_method'}"
                />
                <filter
                    name="group_active"
                    string="Status"
                    context="{'group_by': 'is_active'}"
                />
            </search>
        </field>
    </record>

    <!-- Scoring Model Action -->
    <record id="action_spp_scoring_model" model="ir.actions.act_window">
        <field name="name">Scoring Models</field>
        <field name="res_model">spp.scoring.model</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Scoring Model
            </p>
            <p>
                Define scoring models for poverty targeting, vulnerability assessment,
                or custom eligibility criteria.
            </p>
        </field>
    </record>
</odoo>
