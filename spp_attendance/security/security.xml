<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Attendance Groups -->
    <record id="group_attendance_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_attendance_viewer" />
        <field name="comment">Can view attendance records.</field>
    </record>

    <record id="group_attendance_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_attendance_manager" />
        <field
            name="comment"
        >Full attendance management including all CRUD operations.</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_attendance_viewer'))]"
        />
    </record>

    <!-- Link manager group to admin -->
    <record id="spp_security.group_spp_admin" model="res.groups">
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_attendance_manager'))]"
        />
    </record>

    <!-- Backward compatibility (keep until all dependent modules migrated) -->
    <record id="attendance_viewer" model="res.groups">
        <field name="name">Attendance Viewer (Deprecated)</field>
        <field name="comment">Deprecated: Use group_attendance_viewer instead.</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_attendance_viewer'))]"
        />
    </record>

    <record id="attendance_manager" model="res.groups">
        <field name="name">Attendance Manager (Deprecated)</field>
        <field name="comment">Deprecated: Use group_attendance_manager instead.</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_attendance_manager'))]"
        />
    </record>
</odoo>
