    <!-- Manage Farm Activity (Add/Edit/Remove) -->
    <record id="cr_type_manage_farm_activity" model="spp.change.request.type">
        <field name="name">Manage Farm Activity</field>
        <field name="code">manage_farm_activity</field>
        <field
            name="description"
        >Add, edit, or remove crop, livestock, or aquaculture activities</field>
        <field name="target_type">group</field>
        <field name="detail_model">spp.cr.detail.manage_farm_activity</field>
        <field
            name="detail_form_view_id"
            ref="spp_farmer_registry_cr.spp_cr_detail_manage_farm_activity_form"
        />
        <field name="apply_strategy">custom</field>
        <field name="apply_model">spp.cr.apply.manage_farm_activity</field>
        <field name="icon">fa-leaf</field>
        <field name="sequence">110</field>
        <!-- Activity operation availability -->
        <field name="allow_activity_add">True</field>
        <field name="allow_activity_update">True</field>
        <field name="allow_activity_remove">True</field>
        <!-- Editability flags -->
        <field name="is_studio_editable">True</field>
        <field name="is_studio_cloneable">True</field>
        <field name="is_system_type">True</field>
        <field name="source_module">spp_farmer_registry_cr</field>
    </record>

    <!-- Manage Farm Assets (Add/Edit/Remove) -->
    <record id="cr_type_manage_farm_asset" model="spp.change.request.type">
        <field name="name">Manage Farm Assets</field>
        <field name="code">manage_farm_asset</field>
        <field name="description">Add, edit, or remove farm assets and machinery</field>
        <field name="target_type">group</field>
        <field name="detail_model">spp.cr.detail.manage_farm_asset</field>
        <field
            name="detail_form_view_id"
            ref="spp_farmer_registry_cr.spp_cr_detail_manage_farm_asset_form"
        />
        <field name="apply_strategy">custom</field>
        <field name="apply_model">spp.cr.apply.manage_farm_asset</field>
        <field name="icon">fa-wrench</field>
        <field name="sequence">130</field>
        <field name="allow_asset_add">True</field>
        <field name="allow_asset_update">True</field>
        <field name="allow_asset_remove">True</field>
        <field name="is_studio_editable">True</field>
        <field name="is_studio_cloneable">True</field>
        <field name="is_system_type">True</field>
        <field name="source_module">spp_farmer_registry_cr</field>
    </record>

