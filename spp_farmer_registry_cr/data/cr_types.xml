    <!-- FARMER REGISTRY CHANGE REQUEST TYPES -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->

    <!-- Update Farm Details -->
    <record id="cr_type_update_farm_details" model="spp.change.request.type">
        <field name="name">Update Farm Details</field>
        <field name="code">update_farm_details</field>
        <field
            name="description"
        >Update farm classification, size, and land tenure information</field>
        <field name="target_type">group</field>
        <field name="detail_model">spp.cr.detail.farm_details</field>
        <field
            name="detail_form_view_id"
            ref="spp_farmer_registry_cr.spp_cr_detail_farm_details_form"
        />
        <field name="apply_strategy">custom</field>
        <field name="apply_model">spp.cr.apply.update_farm_details</field>
        <field name="icon">fa-tractor</field>
        <field name="sequence">100</field>
        <!-- Editability flags -->
        <field name="is_studio_editable">True</field>
        <field name="is_studio_cloneable">True</field>
        <field name="is_system_type">True</field>
        <field name="source_module">spp_farmer_registry_cr</field>
    </record>

    <!-- Field mappings for Update Farm Details -->
    <record
        id="cr_type_farm_details_mapping_farm_type"
        model="spp.change.request.type.mapping"
    >
        <field name="type_id" ref="cr_type_update_farm_details" />
