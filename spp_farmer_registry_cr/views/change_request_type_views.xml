<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════════
         EXTEND CR TYPE FORM: ACTIVITY OPERATIONS TAB
         ═══════════════════════════════════════════════════════════════════════ -->

    <record id="spp_change_request_type_form_activity_ops" model="ir.ui.view">
        <field name="name">spp.change.request.type.form.activity.ops</field>
        <field name="model">spp.change.request.type</field>
        <field name="inherit_id" ref="spp_change_request_v2.spp_change_request_type_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='approval']" position="before">
                <page
                    string="Activity Operations"
                    name="activity_operations"
                    invisible="detail_model != 'spp.cr.detail.manage_farm_activity'"
                >
                    <group string="Allowed Activity Operations">
                        <field name="allow_activity_add" readonly="1" />
                        <field name="allow_activity_update" />
                        <field name="allow_activity_remove" />
                    </group>
                    <div class="alert alert-info" role="status">
                        <p class="mb-0">
                            <strong>Add Activity</strong> is always enabled.
                            Toggle <strong>Edit Activity</strong> and <strong>Remove Activity</strong>
                            to control which operations are available to users.
                        </p>
                    </div>
                </page>
                <page
                    string="Land Parcel Operations"
                    name="parcel_operations"
                    invisible="detail_model != 'spp.cr.detail.manage_land_parcel'"
                >
                    <group string="Allowed Land Parcel Operations">
                        <field name="allow_parcel_add" readonly="1" />
                        <field name="allow_parcel_update" />
                        <field name="allow_parcel_remove" />
                    </group>
                    <div class="alert alert-info" role="status">
                        <p class="mb-0">
                            <strong>Add Land Parcel</strong> is always enabled.
                            Toggle <strong>Edit</strong> and <strong>Remove</strong>
                            to control which operations are available to users.
                        </p>
                    </div>
                </page>
                <page
                    string="Asset Operations"
                    name="asset_operations"
                    invisible="detail_model != 'spp.cr.detail.manage_farm_asset'"
                >
                    <group string="Allowed Asset Operations">
                        <field name="allow_asset_add" readonly="1" />
                        <field name="allow_asset_update" />
                        <field name="allow_asset_remove" />
                    </group>
                    <div class="alert alert-info" role="status">
                        <p class="mb-0">
                            <strong>Add Asset</strong> is always enabled.
                            Toggle <strong>Edit</strong> and <strong>Remove</strong>
                            to control which operations are available to users.
                        </p>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
