<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_av_scanner_backend_tree" model="ir.ui.view">
        <field name="name">spp.av.scanner.backend.tree</field>
        <field name="model">spp.av.scanner.backend</field>
        <field name="arch" type="xml">
            <list string="Antivirus Scanner Backends">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="backend_type" optional="show"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="last_connection_test_date" optional="show"/>
                <field name="last_connection_test_result" widget="boolean" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_av_scanner_backend_form" model="ir.ui.view">
        <field name="name">spp.av.scanner.backend.form</field>
        <field name="model">spp.av.scanner.backend</field>
        <field name="arch" type="xml">
            <form string="Antivirus Scanner Backend">
                <header>
                    <button
                        name="test_connection"
                        type="object"
                        string="Test Connection"
                        class="btn-primary"
                        groups="spp_attachment_av_scan.group_av_admin"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="is_active" widget="boolean_button"
                               options="{'terminology': 'active'}"/>
                    </div>
                    <group name="main_section">
                        <group name="general_info">
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="backend_type" widget="radio"/>
                        </group>
                        <group name="scan_settings">
                            <field name="max_file_size_mb"/>
                            <field name="scan_timeout_seconds"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Connection Settings" name="connection">
                            <group name="connection_section">
                                <group name="unix_socket_settings" string="Unix Socket" invisible="backend_type != 'clamd_socket'">
                                    <field name="clamd_socket_path"/>
                                </group>
                                <group name="network_settings" string="Network" invisible="backend_type != 'clamd_network'">
                                    <field name="clamd_host"/>
                                    <field name="clamd_port"/>
                                </group>
                            </group>
                        </page>
                        <page string="Connection Status" name="status">
                            <group name="status_section">
                                <group name="status_info">
                                    <field name="last_connection_test_date"/>
                                    <field name="last_connection_test_result"/>
                                </group>
                                <group name="status_error">
                                    <field name="last_connection_error" widget="text"
                                           invisible="last_connection_test_result == True"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_av_scanner_backend" model="ir.actions.act_window">
        <field name="name">Antivirus Scanner Backends</field>
        <field name="res_model">spp.av.scanner.backend</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first antivirus scanner backend
            </p>
            <p>
                Configure ClamAV or other antivirus scanners to automatically
                scan uploaded files for malware.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_av_scanner_backend"
        name="Antivirus Scanners"
        parent="base.menu_administration"
        action="action_av_scanner_backend"
        groups="spp_attachment_av_scan.group_av_admin"
        sequence="100"
    />

</odoo>
