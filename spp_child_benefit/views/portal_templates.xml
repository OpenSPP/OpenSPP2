<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Home card -->
    <template
        id="portal_my_home_benefits"
        name="Show Benefits"
        inherit_id="portal.portal_my_home"
        customize_show="True"
        priority="10"
    >
        <xpath expr="//div[@id='portal_common_category']" position="before">
            <div class="o_portal_category row g-2 mt-3" id="portal_benefit_category">
                <t t-call="portal.portal_docs_entry">
                    <t
                        t-set="icon"
                        t-value="'/spp_child_benefit/static/src/img/benefit.svg'"
                    />
                    <t t-set="title">Benefits</t>
                    <t t-set="url" t-value="'/my/benefits'" />
                    <t t-set="text">Follow your children's benefit payments</t>
                    <t t-set="config_card" t-value="True" />
                </t>
            </div>
        </xpath>
    </template>

    <!-- Breadcrumbs -->
    <template
        id="portal_my_home_menu_benefits"
        name="Portal layout : benefits menu entries"
        inherit_id="portal.portal_breadcrumbs"
        priority="35"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li
                t-if="page_name == 'benefits'"
                t-attf-class="breadcrumb-item #{'active ' if not child else ''}"
            >
                <a t-if="child" t-attf-href="/my/benefits">Benefits</a>
                <t t-else="">Benefits</t>
            </li>
            <li t-if="child" class="breadcrumb-item active">
                <span t-out="child.name" />
            </li>
        </xpath>
    </template>

    <!-- Family overview -->
    <template id="portal_my_benefits" name="My Benefits">
        <t t-call="portal.portal_layout">
            <t t-set="child" t-value="False" />
            <h3 class="mb-3">Benefits</h3>
            <t t-if="not children">
                <p class="alert alert-warning" role="alert">
                    No enrolled children are linked to your account.
                </p>
            </t>
            <t t-if="children" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Child</th>
                        <th>Programme</th>
                        <th>Benefit ends</th>
                        <th class="text-end">Monthly amount</th>
                        <th />
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="children" t-as="kid">
                        <t t-set="schedule" t-value="schedules_by_child.get(kid.id)" />
                        <tr>
                            <td>
                                <strong t-out="kid.name" />
                            </td>
                            <td>
                                <t t-if="schedule">
                                    <span t-out="schedule.program_id.name" />
                                </t>
                                <em t-else="">Not enrolled</em>
                            </td>
                            <td>
                                <t t-if="schedule">
                                    <span t-field="schedule.benefit_end_date" />
                                </t>
                                <em t-else="">-</em>
                            </td>
                            <td class="text-end">
                                <t t-if="schedule">
                                    <span
                                        t-out="'{:,.2f}'.format(schedule.monthly_amount)"
                                    />
                                </t>
                                <em t-else="">-</em>
                            </td>
                            <td class="text-end">
                                <a
                                    t-if="schedule"
                                    t-attf-href="/my/benefits/child/#{kid.id}"
                                    class="btn btn-sm btn-secondary"
                                >View payments</a>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <!-- Per-child schedule -->
    <template id="portal_benefit_child" name="Child Benefit Payments">
        <t t-call="portal.portal_layout">
            <h3 class="mb-1">
                Benefit Schedule — <span t-out="child.name" />
            </h3>
            <p class="text-muted">
                This is the full monthly benefit plan for the child, from the first
                benefit month until the benefit ends at the age limit. Each month is
                disbursed in its own payment cycle; the <strong>Status</strong> column
                shows where that month is in the payment process.
            </p>
            <t t-if="not schedule">
                <p
                    class="alert alert-warning"
                    role="alert"
                >No active benefit schedule.</p>
            </t>
            <t t-if="schedule">
                <ul class="small text-muted mb-3">
                    <li><strong
                    >Scheduled</strong> — planned; its payment cycle has not run yet.</li>
                    <li><strong
                    >Pending</strong> — the cycle has created this month's entitlement; the payment is not yet generated.</li>
                    <li><strong
                    >In Payment</strong> — the payment has been generated and sent to the bank, awaiting confirmation.</li>
                    <li><strong>Paid</strong> — the bank has confirmed the payment.</li>
                    <li><strong
                    >Failed</strong> — the payment failed and will be reprocessed.</li>
                </ul>
            </t>
            <t t-if="schedule" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Benefit month</th>
                        <th>Period</th>
                        <th class="text-end">Amount</th>
                        <th>Cycle</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="schedule.line_ids" t-as="line">
                        <tr>
                            <td>
                                <span t-out="line.benefit_month.strftime('%B %Y')" />
                            </td>
                            <td>
                                <span t-field="line.payable_from" /> - <span
                                t-field="line.payable_to"
                            />
                            </td>
                            <td class="text-end">
                                <span t-out="'{:,.2f}'.format(line.amount)" />
                            </td>
                            <td>
                                <span t-if="line.cycle_id" t-out="line.cycle_id.name" />
                                <span t-else="" class="text-muted">—</span>
                            </td>
                            <td>
                                <span t-out="line.payment_status" />
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>
</odoo>
