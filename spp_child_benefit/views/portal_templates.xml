<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Shared components: one page-header and one empty-state pattern for
         every portal page (also called from dependent modules). -->
    <template id="portal_page_header" name="Portal page header">
        <div class="o_spp_page_header">
            <div>
                <h1 t-out="page_title" />
                <p t-if="page_subtitle" t-out="page_subtitle" />
            </div>
            <div class="o_spp_header_actions">
                <t t-out="0" />
            </div>
        </div>
    </template>

    <template id="portal_empty_state" name="Portal empty state">
        <div class="o_spp_empty">
            <strong t-out="empty_title" />
            <div t-out="empty_text" />
            <div class="mt-3">
                <t t-out="0" />
            </div>
        </div>
    </template>

    <!-- Home card -->
    <template
        id="portal_my_home_benefits"
        name="Show Benefits"
        inherit_id="portal.portal_my_home"
        customize_show="True"
        priority="10"
    >
        <xpath expr="//div[@id='portal_common_category']" position="before">
            <div class="o_portal_category row g-2 mt-3" id="portal_benefit_category">
                <t t-call="portal.portal_docs_entry">
                    <t
                        t-set="icon"
                        t-value="'/spp_child_benefit/static/src/img/benefit.svg'"
                    />
                    <t t-set="title">Benefits</t>
                    <t t-set="url" t-value="'/my/benefits'" />
                    <t t-set="text">Follow your children's benefit payments</t>
                    <t t-set="config_card" t-value="True" />
                </t>
            </div>
        </xpath>
    </template>

    <!-- Breadcrumbs -->
    <template
        id="portal_my_home_menu_benefits"
        name="Portal layout : benefits menu entries"
        inherit_id="portal.portal_breadcrumbs"
        priority="35"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li
                t-if="page_name == 'benefits'"
                t-attf-class="breadcrumb-item #{'active ' if not child else ''}"
            >
                <a t-if="child" t-attf-href="/my/benefits">Benefits</a>
                <t t-else="">Benefits</t>
            </li>
            <li t-if="child" class="breadcrumb-item active">
                <span t-out="child.name" />
            </li>
        </xpath>
    </template>

    <!-- Family overview -->
    <template id="portal_my_benefits" name="My Benefits">
        <t t-call="portal.portal_layout">
            <t t-set="child" t-value="False" />
            <t t-call="spp_child_benefit.portal_page_header">
                <t t-set="page_title">Benefits</t>
                <t
                    t-set="page_subtitle"
                >Monthly benefit payments for the children in your family.</t>
            </t>
            <t t-if="not children" t-call="spp_child_benefit.portal_empty_state">
                <t t-set="empty_title">No children enrolled yet</t>
                <t
                    t-set="empty_text"
                >Children appear here once they are enrolled in a benefit programme.</t>
            </t>
            <t t-if="children" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Child</th>
                        <th>Programme</th>
                        <th>Benefit ends</th>
                        <th class="o_spp_num">Monthly amount (<t
                            t-out="request.env.company.currency_id.name"
                        />)</th>
                        <th />
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="children" t-as="kid">
                        <t t-set="schedule" t-value="schedules_by_child.get(kid.id)" />
                        <tr>
                            <td>
                                <strong t-out="kid.name" />
                            </td>
                            <td>
                                <t t-if="schedule">
                                    <span t-out="schedule.program_id.name" />
                                </t>
                                <em t-else="">Not enrolled</em>
                            </td>
                            <td>
                                <t t-if="schedule">
                                    <span t-field="schedule.benefit_end_date" />
                                </t>
                                <em t-else="">-</em>
                            </td>
                            <td class="o_spp_num">
                                <t t-if="schedule">
                                    <span
                                        t-out="'{:,.2f}'.format(schedule.monthly_amount)"
                                    />
                                </t>
                                <em t-else="">-</em>
                            </td>
                            <td class="text-end">
                                <a
                                    t-if="schedule"
                                    t-attf-href="/my/benefits/child/#{kid.id}"
                                    class="btn btn-sm btn-primary"
                                >View payments</a>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <!-- Per-child schedule -->
    <template id="portal_benefit_child" name="Child Benefit Payments">
        <t t-call="portal.portal_layout">
            <t t-call="spp_child_benefit.portal_page_header">
                <t t-set="page_title">Benefit Schedule</t>
                <t t-set="page_subtitle"><t
                    t-out="child.name"
                /> — every benefit month from the first payment to the age limit.</t>
            </t>
            <t t-if="not schedule" t-call="spp_child_benefit.portal_empty_state">
                <t t-set="empty_title">No active benefit schedule</t>
                <t
                    t-set="empty_text"
                >A schedule appears here once the child is enrolled in a benefit programme.</t>
            </t>
            <div class="o_spp_panel" t-if="schedule">
                <h2>Benefit summary</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Programme</dt>
                    <dd class="col-sm-8" t-out="schedule.program_id.name" />
                    <dt class="col-sm-4">Monthly amount</dt>
                    <dd class="col-sm-8">
                        <t t-out="'{:,.2f}'.format(schedule.monthly_amount)" />
                        <t t-out="request.env.company.currency_id.name" />
                    </dd>
                    <dt class="col-sm-4">Benefit ends</dt>
                    <dd class="col-sm-8">
                        <span t-field="schedule.benefit_end_date" />
                    </dd>
                </dl>
            </div>
            <t t-if="schedule" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Benefit month</th>
                        <th>Period</th>
                        <th class="o_spp_num">Amount (<t
                            t-out="request.env.company.currency_id.name"
                        />)</th>
                        <th>Cycle</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="schedule.line_ids" t-as="line">
                        <tr>
                            <td>
                                <span t-out="line.benefit_month.strftime('%B %Y')" />
                            </td>
                            <td>
                                <span t-field="line.payable_from" /> - <span
                                t-field="line.payable_to"
                            />
                            </td>
                            <td class="o_spp_num">
                                <span t-out="'{:,.2f}'.format(line.amount)" />
                            </td>
                            <td>
                                <span t-if="line.cycle_id" t-out="line.cycle_id.name" />
                                <span t-else="" class="text-muted">—</span>
                            </td>
                            <td>
                                <span
                                    t-attf-class="badge o_spp_badge--#{line.payment_status_tone}"
                                    t-out="line.payment_status"
                                />
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
            <div class="o_spp_legend" t-if="schedule">
                <div><span
                    class="badge o_spp_badge--neutral"
                >Scheduled</span> planned; its payment cycle has not run yet</div>
                <div><span
                    class="badge o_spp_badge--warn"
                >Pending</span> entitlement created; payment not yet generated</div>
                <div><span
                    class="badge o_spp_badge--info"
                >In Payment</span> sent to the bank, awaiting confirmation</div>
                <div><span
                    class="badge o_spp_badge--ok"
                >Paid</span> confirmed by the bank</div>
                <div><span
                    class="badge o_spp_badge--danger"
                >Failed</span> failed and will be reprocessed</div>
            </div>
        </t>
    </template>
</odoo>
