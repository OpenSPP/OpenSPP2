<odoo>
    <!-- Tree View for File Versions -->
    <record id="view_spp_dms_file_version_tree" model="ir.ui.view">
        <field name="name">view_spp_dms_file_version_tree</field>
        <field name="model">spp.dms.file.version</field>
        <field name="arch" type="xml">
            <list string="File Versions" create="0" edit="0" delete="0">
                <field name="version_number" string="#" />
                <field name="is_current" widget="boolean" />
                <field name="created_date" widget="datetime" />
                <field name="created_by_id" />
                <field name="size" string="Size (bytes)" />
                <field name="mimetype" />
                <field name="comment" />
                <field name="checksum" optional="hide" />
            </list>
        </field>
    </record>

    <!-- Form View for File Version Details -->
    <record id="view_spp_dms_file_version_form" model="ir.ui.view">
        <field name="name">view_spp_dms_file_version_form</field>
        <field name="model">spp.dms.file.version</field>
        <field name="arch" type="xml">
            <form string="File Version" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="%(action_restore_version_wizard)d"
                            type="action"
                            string="Restore This Version"
                            class="oe_stat_button"
                            icon="fa-undo"
                            invisible="is_current"
                        />
                    </div>

                    <div class="oe_title">
                        <label for="version_number" />
                        <h1>
                            <field name="version_number" readonly="1" />
                            <span
                                invisible="not is_current"
                                class="badge text-bg-success ms-2"
                            >Current</span>
                        </h1>
                    </div>

                    <group name="version_info_section">
                        <group string="Version Information" name="version_info_left">
                            <field name="file_id" readonly="1" />
                            <field name="is_current" readonly="1" />
                            <field name="created_by_id" readonly="1" />
                            <field name="created_date" widget="datetime" readonly="1" />
                        </group>
                        <group string="File Details" name="file_details_right">
                            <field name="size" string="Size (bytes)" readonly="1" />
                            <field name="mimetype" readonly="1" />
                            <field name="checksum" readonly="1" />
                        </group>
                    </group>

                    <group string="Version Comment" name="comment_section">
                        <field name="comment" nolabel="1" readonly="1" />
                    </group>

                    <group string="Content" name="content_section">
                        <field name="content" widget="binary" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for File Versions -->
    <record id="action_spp_dms_file_version" model="ir.actions.act_window">
        <field name="name">File Versions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">spp.dms.file.version</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>
</odoo>
