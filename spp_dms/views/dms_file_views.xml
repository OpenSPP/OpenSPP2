<odoo>

    <record id="view_spp_dms_file_search" model="ir.ui.view">
        <field name="name">search_spp_dms_file</field>
        <field name="model">spp.dms.file</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="[('name','ilike',self)]" />
                <filter string="My Files" name="filter_user" domain="[('create_uid', '=', uid)]" />
                <separator />
                <filter string="Creation Date" name="filter_create" date="create_date" />
                <filter string="Modification Date" name="filter_write" date="write_date" />
                <group>
                    <filter
                        name="group_directory"
                        string="Directories"
                        domain="[]"
                        context="{'group_by':'directory_id'}"
                    />
                    <filter
                        name="group_category"
                        string="Category"
                        domain="[]"
                        context="{'group_by':'category_id'}"
                    />
                </group>
                <searchpanel>
                    <field name="directory_id" icon="fa-folder" limit="0" enable_counters="1" />
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="view_spp_dms_file_tree" model="ir.ui.view">
        <field name="name">view_spp_dms_file_tree</field>
        <field name="model">spp.dms.file</field>
        <field name="arch" type="xml">
            <list>
                <field name="content" widget="preview_widget" />
                <field name="name" />
                <field name="write_date" />
                <field name="human_size" />
                <field name="mimetype" />
                <field name="directory_id" />
                <field name="category_id" />
                <field name="create_date" column_invisible="1" />

            </list>
        </field>
    </record>

    <record id="view_spp_dms_file_form" model="ir.ui.view">
        <field name="name">view_spp_dms_file_form</field>
        <field name="model">spp.dms.file</field>
        <field name="arch" type="xml">
            <form string="File">
                <header>
                    <button name="action_enable_versioning"
                            type="object"
                            string="Enable Versioning"
                            class="btn-primary"
                            invisible="is_versioned"/>
                    <button name="action_disable_versioning"
                            type="object"
                            string="Disable Versioning"
                            class="btn-secondary"
                            invisible="not is_versioned"
                            confirm="Are you sure you want to disable versioning? Existing versions will be preserved."/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_versions"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-history"
                                invisible="not is_versioned">
                            <field name="version_count" widget="statinfo" string="Versions"/>
                        </button>
                    </div>
                    <!-- File Preview/Avatar -->
                    <field
                        name="image_1920"
                        widget="image"
                        class="oe_avatar"
                        nolabel="1"
                        options="{'image_preview': 'image_128'}"/>

                    <!-- Title Section -->
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1 class="d-flex align-items-center">
                            <field name="content_file" widget="preview_widget" class="me-2"/>
                            <field name="name" readonly="1" force_save="1" class="o_text_overflow"/>
                        </h1>
                    </div>

                    <!-- File Upload -->
                    <group string="File Content">
                        <field name="content" filename="name" mimetype="mimetype"/>
                    </group>

                    <!-- File Information -->
                    <group>
                        <group string="File Details">
                            <field name="extension" force_save="1" readonly="1"/>
                            <field name="mimetype" force_save="1" readonly="1"/>
                            <field name="human_size" string="File Size" readonly="1"/>
                        </group>
                        <group string="Organization">
                            <field name="directory_id"
                                   options="{'no_quick_create': True}"/>
                            <field name="category_id"
                                   options="{'no_open': True, 'no_create': True}"/>
                        </group>
                    </group>

                    <!-- Metadata -->
                    <group string="Metadata">
                        <group>
                            <field name="create_uid" string="Created By" readonly="1"/>
                            <field name="create_date" string="Created On" readonly="1" widget="datetime"/>
                        </group>
                        <group>
                            <field name="write_uid" string="Last Updated By" readonly="1"/>
                            <field name="write_date" string="Last Updated On" readonly="1" widget="datetime"/>
                        </group>
                    </group>

                    <!-- Versioning Information -->
                    <notebook invisible="not is_versioned">
                        <page string="Version History" name="version_history">
                            <group>
                                <group>
                                    <field name="is_versioned" readonly="1"/>
                                    <field name="current_version_number" readonly="1"/>
                                </group>
                            </group>
                            <field name="version_ids" nolabel="1" readonly="1">
                                <list create="0" edit="0" delete="0" decoration-success="is_current">
                                    <field name="version_number" string="#"/>
                                    <field name="is_current" widget="boolean"/>
                                    <field name="created_date" widget="datetime"/>
                                    <field name="created_by_id"/>
                                    <field name="size" string="Size (bytes)"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_spp_dms_file" model="ir.actions.act_window">
        <field name="name">Files</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">spp.dms.file</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new File.
            </p>
            <p>
                Files are used to save content directly in OpenSPP.
            </p>
        </field>
    </record>

    <record id="action_spp_dms_file_tree_view" model="ir.actions.act_window.view">
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_spp_dms_file_tree" />
        <field name="act_window_id" ref="action_spp_dms_file" />
        <field name="sequence" eval="0" />
    </record>

    <record id="action_spp_dms_file_form_view" model="ir.actions.act_window.view">
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_spp_dms_file_form" />
        <field name="act_window_id" ref="action_spp_dms_file" />
        <field name="sequence" eval="0" />
    </record>

    <menuitem
        id="menu_spp_dms_file"
        name="Files"
        sequence="20"
        parent="main_menu_spp_dms"
        action="action_spp_dms_file"
    />

    <record id="view_spp_dms_file_new_form" model="ir.ui.view">
        <field name="name">view_spp_dms_file_new_form</field>
        <field name="model">spp.dms.file</field>
        <field name="inherit_id" ref="view_spp_dms_file_form" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//sheet//div[hasclass('oe_button_box')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <form position="inside">
                <footer>
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_spp_dms_file_new" model="ir.actions.act_window">
        <field name="name">New Root Directory</field>
        <field name="res_model">spp.dms.file</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_spp_dms_file_new_form" />
    </record>

</odoo>
