<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════════
         FARM (RES.PARTNER) VIEW EXTENSIONS
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Extend Group Form View to include Farm Details Tab -->
    <record id="view_res_partner_group_farm_form" model="ir.ui.view">
        <field name="name">res.partner.group.farm.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_individuals_form" />
        <field name="arch" type="xml">
            <!-- Add Farm Details tabs inside group notebook (visible only for groups) -->
            <xpath expr="//notebook[@name='group_detail']" position="inside">
                <page string="Farm Details" name="farm_details">
                    <group>
                        <group string="Farm Classification">
                            <field
                                name="farm_type_id"
                                domain="[('namespace_uri', '=', 'urn:openspp:vocab:farm-type')]"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field
                                name="holder_type_id"
                                domain="[('namespace_uri', '=', 'urn:openspp:vocab:holder-type')]"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field
                                name="land_tenure_id"
                                domain="[('namespace_uri', '=', 'urn:openspp:vocab:land-tenure')]"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field
                                name="data_source_id"
                                domain="[('namespace_uri', '=', 'urn:openspp:vocab:data-source')]"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field name="last_field_visit" />
                        </group>
                        <group string="Farm Size">
                            <field name="farm_total_size" />
                            <field name="is_smallholder" readonly="1" />
                            <field name="has_productive_land" readonly="1" />
                            <field name="experience_years" />
                        </group>
                    </group>
                    <group string="Acreage Breakdown">
                        <group>
                            <field name="farm_size_under_crops" />
                            <field name="farm_size_under_livestock" />
                            <field name="farm_size_under_aquaculture" />
                        </group>
                        <group>
                            <field name="farm_size_leased_out" />
                            <field name="farm_size_idle" />
                        </group>
                    </group>
                </page>

                <page string="Crop Activities" name="crop_activities">
                    <field
                        name="farm_crop_act_ids"
                        context="{'default_activity_type': 'crop'}"
                        widget="x2many_no_padding"
                    >
                        <list editable="bottom">
                            <field name="activity_type" column_invisible="1" />
                            <field name="species_namespace" column_invisible="1" />
                            <field
                                name="species_id"
                                domain="[('namespace_uri', '=', 'urn:fao:icc:1.1')]"
                                options="{'no_create': True}"
                            />
                            <field name="purpose_id" options="{'no_create': True}" />
                            <field
                                name="cultivation_method_id"
                                options="{'no_create': True}"
                            />
                            <field name="land_id" />
                            <field name="area_planted" />
                            <field name="expected_yield" />
                            <field name="actual_yield" />
                            <field name="season_id" />
                        </list>
                    </field>
                </page>

                <page string="Livestock Activities" name="livestock_activities">
                    <field
                        name="farm_livestock_act_ids"
                        context="{'default_activity_type': 'livestock'}"
                        widget="x2many_no_padding"
                    >
                        <list editable="bottom">
                            <field name="activity_type" column_invisible="1" />
                            <field name="species_namespace" column_invisible="1" />
                            <field
                                name="species_id"
                                domain="[('namespace_uri', '=', 'urn:fao:livestock:2020')]"
                                options="{'no_create': True}"
                            />
                            <field name="purpose_id" options="{'no_create': True}" />
                            <field name="quantity" string="Heads" />
                            <field name="season_id" />
                        </list>
                    </field>
                    <group>
                        <group>
                            <field name="total_livestock_heads" readonly="1" />
                        </group>
                    </group>
                </page>

                <page string="Aquaculture Activities" name="aquaculture_activities">
                    <field
                        name="farm_aquaculture_act_ids"
                        context="{'default_activity_type': 'aquaculture'}"
                        widget="x2many_no_padding"
                    >
                        <list editable="bottom">
                            <field name="activity_type" column_invisible="1" />
                            <field name="species_namespace" column_invisible="1" />
                            <field
                                name="species_id"
                                domain="[('namespace_uri', '=', 'urn:fao:asfis:2024')]"
                                options="{'no_create': True}"
                            />
                            <field name="purpose_id" options="{'no_create': True}" />
                            <field name="quantity" />
                            <field name="quantity_unit" />
                            <field name="season_id" />
                        </list>
                    </field>
                </page>

                <page string="Land Parcels" name="land_parcels">
                    <field name="farm_land_rec_ids" widget="x2many_no_padding">
                        <list>
                            <field name="land_name" />
                            <field name="land_acreage" />
                            <field name="land_use" />
                        </list>
                    </field>
                </page>

                <page string="Farm Assets" name="farm_assets">
                    <separator string="Assets" />
                    <field name="farm_asset_ids" nolabel="1" widget="x2many_no_padding">
                        <list editable="bottom">
                            <field name="asset_type_id" />
                            <field name="technology_used" />
                            <field name="quantity" />
                        </list>
                    </field>
                    <separator string="Machinery" />
                    <field
                        name="farm_machinery_ids"
                        nolabel="1"
                        widget="x2many_no_padding"
                    >
                        <list editable="bottom">
                            <field name="machinery_type_id" />
                            <field name="machine_working_status" />
                            <field name="quantity" />
                        </list>
                    </field>
                </page>

                <page string="Extension Services" name="extension_services">
                    <field name="farm_extension_ids" widget="x2many_no_padding">
                        <list>
                            <field name="service_type" />
                            <field name="provider" />
                            <field name="date" />
                        </list>
                    </field>
                </page>
            </xpath>

            <!-- Add farm statistics to button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    type="object"
                    name="action_view_crop_activities"
                    class="oe_stat_button"
                    icon="fa-leaf"
                    invisible="crop_activity_count == 0"
                >
                    <field
                        name="crop_activity_count"
                        widget="statinfo"
                        string="Crops"
                    />
                </button>
                <button
                    type="object"
                    name="action_view_livestock_activities"
                    class="oe_stat_button"
                    icon="fa-paw"
                    invisible="livestock_activity_count == 0"
                >
                    <field
                        name="livestock_activity_count"
                        widget="statinfo"
                        string="Livestock"
                    />
                </button>
                <button
                    type="object"
                    name="action_view_land_parcels"
                    class="oe_stat_button"
                    icon="fa-map"
                    invisible="land_parcel_count == 0"
                >
                    <field
                        name="land_parcel_count"
                        widget="statinfo"
                        string="Land Parcels"
                    />
                </button>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Farm membership-completeness UX (#939)
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Search filters: surface farms with no members or no head member -->
    <record id="view_registry_groups_filter_farm" model="ir.ui.view">
        <field name="name">res.partner.search.farm.member_completeness</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_registry_groups_filter" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='has_phone']" position="after">
                <separator />
                <filter
                    string="No Members"
                    name="no_members"
                    domain="[('member_count', '=', 0)]"
                />
            </xpath>
        </field>
    </record>

    <!-- List view: warning decoration + optional column for member count.
         The decoration scopes to farm records (those with farm_type_id set)
         so it doesn't fire on plain group registrants. -->
    <record id="view_groups_list_tree_farm" model="ir.ui.view">
        <field name="name">res.partner.list.farm.member_completeness</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_groups_list_tree" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="member_count" optional="hide" />
            </xpath>
        </field>
    </record>

    <!-- Form-top banner: warn when a group has no members. Scoped to is_group
         so it doesn't appear on individuals. (The "no head member" banner was
         removed in #1113 — see below.) -->
    <record id="view_individuals_form_farm_no_members" model="ir.ui.view">
        <field name="name">res.partner.form.farm.member_completeness_banners</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_individuals_form" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="before">
                <div
                    class="alert alert-warning text-center"
                    role="alert"
                    invisible="not is_group or member_count != 0"
                >
                    <i class="fa fa-exclamation-triangle me-2" title="Warning" />
                    No members linked to this group yet.
                </div>
            </xpath>
        </field>
    </record>

    <!-- Add view activity actions to res.partner -->
    <record id="res_partner_view_crop_activities" model="ir.actions.server">
        <field name="name">View Crop Activities</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="state">code</field>
        <field name="code">action = model.action_view_crop_activities()</field>
    </record>
</odoo>
