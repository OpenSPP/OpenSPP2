<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════════
         FARM DETAILS VIEWS
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Tree View -->
    <record id="view_farm_details_tree" model="ir.ui.view">
        <field name="name">spp.farm.details.tree</field>
        <field name="model">spp.farm.details</field>
        <field name="arch" type="xml">
            <list>
                <field name="farm_type_id" />
                <field name="farm_total_size" />
                <field name="land_tenure_id" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_farm_details_form" model="ir.ui.view">
        <field name="name">spp.farm.details.form</field>
        <field name="model">spp.farm.details</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Classification">
                            <field
                                name="farm_type_id"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field
                                name="holder_type_id"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field
                                name="land_tenure_id"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field
                                name="data_source_id"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                        </group>
                        <group string="Size">
                            <field name="farm_total_size" />
                        </group>
                    </group>
                    <group string="Acreage Breakdown">
                        <group>
                            <field name="farm_size_under_crops" />
                            <field name="farm_size_under_livestock" />
                            <field name="farm_size_under_aquaculture" />
                        </group>
                        <group>
                            <field name="farm_size_leased_out" />
                            <field name="farm_size_idle" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
