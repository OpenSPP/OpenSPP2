<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Default Attribute Mappings for Claim 169 -->

    <!-- Claim 1: ID (inactive by default - configure external ID source field) -->
    <record id="mapping_claim_1_id" model="spp.claim169.attribute.mapping">
        <field name="name">ID (Claim 1)</field>
        <field name="claim_number">1</field>
        <field name="claim_name">id</field>
        <field name="source_field">name</field>
        <field name="transform_type">direct</field>
        <field name="sequence">10</field>
        <field name="is_active">False</field>
    </record>

    <!-- Claim 2: Version -->
    <record id="mapping_claim_2_version" model="spp.claim169.attribute.mapping">
