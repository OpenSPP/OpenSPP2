    <!-- IR Sequence for Credentials -->
    <record id="seq_claim169_credential" model="ir.sequence">
        <field name="name">Claim 169 Credential Sequence</field>
        <field name="code">spp.claim169.credential</field>
        <field name="prefix">C169-</field>
        <field name="padding">6</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
    </record>
</odoo>
