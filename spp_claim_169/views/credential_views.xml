<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Credential Tree View with Optional Columns -->
    <record id="view_claim169_credential_tree" model="ir.ui.view">
        <field name="name">spp.claim169.credential.tree</field>
        <field name="model">spp.claim169.credential</field>
        <field name="arch" type="xml">
            <list
                string="QR Credentials"
                decoration-muted="status == 'revoked'"
                decoration-warning="status == 'expired'"
                sample="1"
            >
                <field name="name" />
                <field name="partner_id" />
                <field name="issuer_config_id" optional="show" />
                <field name="issued_at" />
                <field name="expires_at" optional="show" />
                <field
                    name="status"
                    widget="badge"
                    decoration-success="status == 'active'"
                    decoration-warning="status == 'expired'"
                    decoration-danger="status == 'revoked'"
                />
                <field name="credential_hash" optional="hide" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="hide"
                />
            </list>
        </field>
    </record>

    <!-- Credential Form View - Redesigned for usability -->
    <record id="view_claim169_credential_form" model="ir.ui.view">
        <field name="name">spp.claim169.credential.form</field>
        <field name="model">spp.claim169.credential</field>
        <field name="arch" type="xml">
            <form string="QR Credential">
                <header>
                    <button
                        name="action_download_qr"
                        type="object"
                        string="Download QR"
                        icon="fa-download"
                        class="btn-secondary"
                        invisible="not qr_image"
                    />
                    <button
                        name="action_revoke"
                        type="object"
                        string="Revoke"
                        class="oe_highlight"
                        invisible="status != 'active'"
                        groups="spp_claim_169.group_claim169_manager"
                        confirm="Are you sure you want to revoke this credential? This action cannot be undone."
                    />
                    <button
                        name="action_regenerate"
                        type="object"
                        string="Regenerate"
                        invisible="status == 'revoked'"
                        groups="spp_claim_169.group_claim169_manager"
                    />
                    <field
                        name="status"
                        widget="statusbar"
                        statusbar_visible="active,expired,revoked"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Revoked"
                        bg_color="text-bg-danger"
                        invisible="status != 'revoked'"
                    />
                    <widget
                        name="web_ribbon"
                        title="Expired"
                        bg_color="text-bg-warning"
                        invisible="status != 'expired'"
                    />

                    <div class="oe_title">
                        <label for="name" string="Credential" />
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>

                    <notebook>
                        <!-- Tab 1: Credential - Main view for everyone -->
                        <page string="Credential" name="credential">
                            <group col="2">
                                <group name="qr_display">
                                    <div class="text-center p-3">
                                        <field
                                            name="qr_image"
                                            widget="image"
                                            options="{'size': [280, 280]}"
                                            class="img-fluid border rounded"
                                            nolabel="1"
                                        />
                                    </div>
                                    <div class="text-center mt-2">
                                        <button
                                            name="action_download_qr"
                                            type="object"
                                            string="Download QR Image"
                                            icon="fa-download"
                                            class="btn btn-outline-primary"
                                            invisible="not qr_image"
                                        />
                                    </div>
                                </group>
                                <group name="credential_info">
                                    <field
                                        name="partner_id"
                                        string="Registrant"
                                        readonly="1"
                                        options="{'no_create': True}"
                                    />
                                    <field
                                        name="issuer_config_id"
                                        string="Issued By"
                                        readonly="1"
                                        options="{'no_create': True, 'no_open': True}"
                                    />
                                    <separator />
                                    <field
                                        name="issued_at"
                                        string="Valid From"
                                        readonly="1"
                                    />
                                    <field
                                        name="expires_at"
                                        string="Valid Until"
                                        readonly="1"
                                    />
                                    <field
                                        name="status"
                                        widget="badge"
                                        readonly="1"
                                        decoration-success="status == 'active'"
                                        decoration-warning="status == 'expired'"
                                        decoration-danger="status == 'revoked'"
                                    />
                                    <field
                                        name="company_id"
                                        groups="base.group_multi_company"
                                        readonly="1"
                                    />
                                </group>
                            </group>

                            <!-- Credential Data - What's in the QR -->
                            <group string="Credential Data" name="credential_data">
                                <field
                                    name="decoded_claims_display"
                                    nolabel="1"
                                    colspan="2"
                                />
                            </group>
                        </page>

                        <!-- Tab 2: Verification - For verifiers needing public key -->
                        <page string="Verification" name="verification">
                            <div class="alert alert-info mb-3" role="alert">
                                <i class="fa fa-info-circle me-2" title="Info" />
                                Use these values to verify this credential in external tools or configure trust anchors.
                            </div>

                            <group string="Public Key" name="public_key_section">
                                <div class="mb-3">
                                    <label
                                        for="public_key_pem"
                                        string="Public Key (PEM format)"
                                    />
                                    <field
                                        name="public_key_pem"
                                        readonly="1"
                                        widget="CopyClipboardText"
                                        nolabel="1"
                                        class="font-monospace bg-light p-2 rounded small"
                                        placeholder="Public key not available"
                                    />
                                </div>
                                <div>
                                    <button
                                        name="action_download_public_key"
                                        type="object"
                                        string="Download Public Key (JWK)"
                                        icon="fa-download"
                                        class="btn btn-outline-secondary"
                                        invisible="not public_key_jwk"
                                    />
                                </div>
                            </group>

                            <group
                                col="2"
                                string="Key Information"
                                name="key_info_section"
                            >
                                <group>
                                    <field
                                        name="signing_key_type"
                                        string="Key Type"
                                        readonly="1"
                                    />
                                    <field
                                        name="signing_key_curve"
                                        string="Curve"
                                        readonly="1"
                                        invisible="signing_key_type != 'ec'"
                                    />
                                </group>
                                <group>
                                    <field
                                        name="signing_key_id"
                                        string="Key Record"
                                        readonly="1"
                                    />
                                </group>
                            </group>

                            <group
                                string="Credential Fingerprint"
                                name="fingerprint_section"
                            >
                                <div>
                                    <field
                                        name="credential_hash"
                                        readonly="1"
                                        widget="CopyClipboardChar"
                                        string="Fingerprint (SHA-256)"
                                        class="font-monospace"
                                        help="Use this to verify the credential has not been tampered with"
                                    />
                                </div>
                            </group>
                        </page>

                        <!-- Tab 3: Technical - Admin/debug info -->
                        <page
                            string="Technical"
                            name="technical"
                            groups="spp_claim_169.group_claim169_manager"
                        >
                            <div class="alert alert-secondary mb-3" role="status">
                                <i class="fa fa-wrench me-2" title="Settings" />
                                Technical details for debugging and integration.
                            </div>

                            <group string="Raw QR Data">
                                <field
                                    name="qr_data"
                                    readonly="1"
                                    widget="CopyClipboardText"
                                    string="QR Data (Base45 encoded)"
                                    class="font-monospace small"
                                />
                            </group>

                            <group string="Raw Claims (JSON)">
                                <field
                                    name="decoded_claims"
                                    readonly="1"
                                    widget="CopyClipboardText"
                                    nolabel="1"
                                    class="font-monospace small"
                                />
                            </group>
                        </page>

                        <!-- Tab 4: Revocation - Only when revoked -->
                        <page
                            string="Revocation"
                            name="revocation"
                            invisible="status != 'revoked'"
                        >
                            <group>
                                <field
                                    name="revoked_at"
                                    string="Revoked On"
                                    readonly="1"
                                />
                                <field
                                    name="revoked_by_id"
                                    string="Revoked By"
                                    readonly="1"
                                />
                                <field
                                    name="revocation_reason"
                                    string="Reason"
                                    readonly="1"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Credential Search View -->
    <record id="view_claim169_credential_search" model="ir.ui.view">
        <field name="name">spp.claim169.credential.search</field>
        <field name="model">spp.claim169.credential</field>
        <field name="arch" type="xml">
            <search string="QR Credentials">
                <field name="name" />
                <field name="partner_id" />
                <field name="issuer_config_id" />
                <field name="credential_hash" />
                <filter
                    string="Active"
                    name="filter_active"
                    domain="[('status', '=', 'active')]"
                />
                <filter
                    string="Expiring Soon"
                    name="filter_expiring_soon"
                    domain="[('status', '=', 'active'), ('expires_at', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"
                    help="Active credentials expiring within 30 days"
                />
                <filter
                    string="Expired"
                    name="filter_expired"
                    domain="[('status', '=', 'expired')]"
                />
                <filter
                    string="Revoked"
                    name="filter_revoked"
                    domain="[('status', '=', 'revoked')]"
                />
                <separator />
                <filter
                    string="Issuer"
                    name="group_by_issuer"
                    context="{'group_by': 'issuer_config_id'}"
                />
                <filter
                    string="Status"
                    name="group_by_status"
                    context="{'group_by': 'status'}"
                />
            </search>
        </field>
    </record>

    <!-- Credential Kanban View -->
    <record id="view_claim169_credential_kanban" model="ir.ui.view">
        <field name="name">spp.claim169.credential.kanban</field>
        <field name="model">spp.claim169.credential</field>
        <field name="arch" type="xml">
            <kanban string="QR Credentials">
                <field name="name" />
                <field name="partner_id" />
                <field name="status" />
                <field name="qr_image" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img
                                    t-att-src="kanban_image('spp.claim169.credential', 'qr_image', record.id.raw_value)"
                                    alt="QR Code"
                                />
                            </div>
                            <div class="oe_kanban_details">
                                <strong>
                                    <field name="name" />
                                </strong>
                                <div>
                                    <field name="partner_id" />
                                </div>
                                <div>
                                    <field
                                        name="status"
                                        widget="badge"
                                        decoration-success="status == 'active'"
                                        decoration-warning="status == 'expired'"
                                        decoration-danger="status == 'revoked'"
                                    />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Credential Action (accessed from registrant page, not menu) -->
    <record id="action_claim169_credential" model="ir.actions.act_window">
        <field name="name">QR Credentials</field>
        <field name="res_model">spp.claim169.credential</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No QR credentials found
            </p>
            <p>
                Use the Generate QR wizard to create credentials for registrants,
                or generate directly from an individual's Identity tab.
            </p>
        </field>
    </record>
</odoo>
