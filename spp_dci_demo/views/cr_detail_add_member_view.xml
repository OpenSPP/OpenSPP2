<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Extend Add Member Detail Form with Birth Verification -->
    <record id="spp_cr_detail_add_member_form_dci" model="ir.ui.view">
        <field name="name">spp.cr.detail.add_member.form.dci</field>
        <field name="model">spp.cr.detail.add_member</field>
        <field
            name="inherit_id"
            ref="spp_change_request_v2.spp_cr_detail_add_member_form"
        />
        <field name="arch" type="xml">
            <!-- Hide Contact Information section for demo -->
            <xpath
                expr="//field[@name='phone']/parent::group/parent::group"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide Relationship to Head for demo -->
            <xpath expr="//field[@name='relationship_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Add Birth Verification section before the Result group -->
            <xpath expr="//field[@name='created_individual_id']/.." position="before">
                <group string="Birth Verification" name="birth_verification">
                    <group>
                        <field name="single_dci_data_source" invisible="1" />
                        <field
                            name="dci_data_source_id"
                            placeholder="Select CRVS registry..."
                            options="{'no_create': True, 'no_open': True}"
                            invisible="single_dci_data_source"
                        />
                        <field
                            name="birth_registration_number"
                            placeholder="e.g., UP7D57VSEAZM"
                        />
                    </group>
                    <group>
                        <field
                            name="birth_verification_status"
                            widget="badge"
                            decoration-success="birth_verification_status == 'verified'"
                            decoration-warning="birth_verification_status == 'not_found'"
                            decoration-danger="birth_verification_status == 'error'"
                            decoration-muted="birth_verification_status == 'unverified'"
                        />
                        <field
                            name="dci_data_match"
                            invisible="birth_verification_status != 'verified'"
                            widget="boolean"
                        />
                        <field
                            name="birth_verification_date"
                            invisible="not birth_verification_date"
                        />
                    </group>
                    <div class="text-center mt-2 mb-3" colspan="2">
                        <button
                            name="action_verify_birth"
                            type="object"
                            string="Verify Birth"
                            class="btn-primary"
                            icon="fa-check-circle"
                            invisible="birth_verification_status == 'verified'"
                        />
                        <button
                            name="action_verify_birth"
                            type="object"
                            string="Re-verify"
                            class="btn-secondary"
                            icon="fa-refresh"
                            invisible="birth_verification_status != 'verified'"
                        />
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
