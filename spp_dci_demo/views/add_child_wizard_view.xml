<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Add Child Wizard Form View -->
    <record id="spp_dci_demo_add_child_wizard_form" model="ir.ui.view">
        <field name="name">spp.dci.demo.add.child.wizard.form</field>
        <field name="model">spp.dci.demo.add.child.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Child (DCI Demo)">
                <header>
                    <field
                        name="stage"
                        widget="statusbar"
                        clickable="0"
                        statusbar_visible="registrant,details,review"
                    />
                </header>
                <sheet>
                    <div class="oe_title mb-3">
                        <h2>Add Child to Household</h2>
                    </div>

                    <field name="request_type_id" invisible="1" />

                    <!-- ============================================ -->
                    <!-- Step 1: Select Household                     -->
                    <!-- ============================================ -->
                    <div invisible="stage != 'registrant'">
                        <group string="Household">
                            <group>
                                <field
                                    name="registrant_id"
                                    string="Select Household"
                                    options="{'no_create': True}"
                                    required="stage == 'registrant'"
                                />
                            </group>
                        </group>

                        <div
                            class="alert alert-info py-2 mx-3"
                            role="status"
                            invisible="not registrant_id"
                        >
                            <field
                                name="registrant_info_html"
                                class="mb-0"
                                nolabel="1"
                            />
                        </div>

                        <group
                            string="Applicant (Optional)"
                            invisible="not registrant_id"
                        >
                            <group>
                                <field
                                    name="applicant_id"
                                    options="{'no_create': True}"
                                />
                                <field
                                    name="applicant_phone"
                                    invisible="not applicant_id"
                                />
                            </group>
                        </group>
                    </div>

                    <!-- ============================================ -->
                    <!-- Step 2: Child Information                    -->
                    <!-- ============================================ -->
                    <div invisible="stage != 'details'">
                        <group string="Child Details">
                            <group>
                                <field
                                    name="given_name"
                                    required="stage == 'details'"
                                />
                                <field name="family_name" />
                                <field
                                    name="member_name"
                                    readonly="1"
                                    class="fw-bold"
                                />
                            </group>
                            <group>
                                <field name="birthdate" required="stage == 'details'" />
                                <field name="gender_id" />
                                <field name="relationship_id" />
                            </group>
                        </group>

                        <group string="Birth Verification">
                            <group>
                                <field
                                    name="dci_data_source_id"
                                    placeholder="Select CRVS registry..."
                                    options="{'no_create': True, 'no_open': True}"
                                />
                                <field
                                    name="birth_registration_number"
                                    placeholder="e.g., UP7D57VSEAZM"
                                />
                            </group>
                            <group>
                                <field
                                    name="birth_verification_status"
                                    widget="badge"
                                    decoration-success="birth_verification_status == 'verified'"
                                    decoration-warning="birth_verification_status == 'not_found'"
                                    decoration-danger="birth_verification_status == 'error'"
                                    decoration-muted="birth_verification_status == 'unverified'"
                                />
                                <field
                                    name="dci_data_match"
                                    invisible="birth_verification_status != 'verified'"
                                    widget="boolean"
                                />
                                <field
                                    name="birth_verification_date"
                                    invisible="not birth_verification_date"
                                />
                            </group>
                            <div class="text-center mt-2 mb-3" colspan="2">
                                <button
                                    name="action_verify_birth"
                                    type="object"
                                    string="Verify Birth"
                                    class="btn-primary"
                                    icon="fa-check-circle"
                                    invisible="birth_verification_status == 'verified'"
                                />
                                <button
                                    name="action_verify_birth"
                                    type="object"
                                    string="Re-verify"
                                    class="btn-secondary"
                                    icon="fa-refresh"
                                    invisible="birth_verification_status != 'verified'"
                                />
                            </div>
                        </group>
                    </div>

                    <!-- ============================================ -->
                    <!-- Step 3: Review & Submit                      -->
                    <!-- ============================================ -->
                    <div invisible="stage != 'review'">
                        <group string="Review Summary">
                            <field name="preview_html" nolabel="1" colspan="2" />
                        </group>
                    </div>

                    <!-- ============================================ -->
                    <!-- Hidden fields for ORM                        -->
                    <!-- ============================================ -->
                    <field name="birth_verification_response" invisible="1" />

                    <!-- ============================================ -->
                    <!-- Navigation Buttons                           -->
                    <!-- ============================================ -->
                    <div class="text-center mt-4 mb-2">
                        <button
                            name="action_previous"
                            type="object"
                            string="Back"
                            class="btn-secondary me-2"
                            icon="fa-arrow-left"
                            invisible="stage == 'registrant'"
                        />
                        <button
                            name="action_next"
                            type="object"
                            string="Next"
                            class="btn-primary me-2"
                            icon="fa-arrow-right"
                            invisible="stage == 'review'"
                        />
                        <button
                            name="action_create_and_submit"
                            type="object"
                            string="Create &amp; Submit"
                            class="btn-success"
                            icon="fa-paper-plane"
                            invisible="stage != 'review'"
                        />
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_spp_dci_demo_add_child_wizard" model="ir.actions.act_window">
        <field name="name">Add Child (DCI Demo)</field>
        <field name="res_model">spp.dci.demo.add.child.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="spp_dci_demo_add_child_wizard_form" />
        <field name="target">current</field>
    </record>

    <!-- Menu Item alongside existing "New Request" -->
    <menuitem
        id="menu_dci_demo_add_child"
        name="Add Child (DCI Demo)"
        parent="spp_change_request_v2.menu_change_request_root"
        action="action_spp_dci_demo_add_child_wizard"
        sequence="9"
    />
</odoo>
