<odoo>
    <!-- ========================================== -->
    <!-- GIS REPORT LIST VIEW                       -->
    <!-- ========================================== -->
    <record id="view_gis_report_list" model="ir.ui.view">
        <field name="name">spp.gis.report.list</field>
        <field name="model">spp.gis.report</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <list
                sample="1"
                default_order="sequence, name"
                decoration-warning="is_stale"
            >
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="category_id" />
                <field name="source_model_id" />
                <field name="base_area_level" />
                <field name="data_count" string="Areas with Data" />
                <field name="last_refresh" widget="timeago" optional="show" />
                <field name="is_stale" column_invisible="1" />
                <field name="refresh_mode" optional="hide" />
                <field name="active" column_invisible="1" />
            </list>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- GIS REPORT SEARCH VIEW                     -->
    <!-- ========================================== -->
    <record id="view_gis_report_search" model="ir.ui.view">
        <field name="name">spp.gis.report.search</field>
        <field name="model">spp.gis.report</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <field name="category_id" />

                <separator />

                <filter
                    name="refresh_scheduled"
                    string="Scheduled Refresh"
                    domain="[('refresh_mode', '=', 'scheduled')]"
                />
                <filter
                    name="refresh_manual"
                    string="Manual Refresh"
                    domain="[('refresh_mode', '=', 'manual')]"
                />

                <separator />

                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />

                <separator />

                <filter
                    name="group_category"
                    string="Category"
                    context="{'group_by': 'category_id'}"
                />
                <filter
                    name="group_refresh_mode"
                    string="Refresh Mode"
                    context="{'group_by': 'refresh_mode'}"
                />
            </search>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- GIS REPORT FORM VIEW                       -->
    <!-- ========================================== -->
    <record id="view_gis_report_form" model="ir.ui.view">
        <field name="name">spp.gis.report.form</field>
        <field name="model">spp.gis.report</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Primary Actions -->
                    <button
                        name="action_refresh_now"
                        type="object"
                        string="Re-sync Data"
                        icon="fa-refresh"
                        class="btn-primary"
                        invisible="is_syncing"
                    />
                    <button
                        name="action_view_map"
                        type="object"
                        string="View Map"
                        icon="fa-map"
                        class="btn-secondary"
                    />
                </header>

                <sheet>
                    <!-- Stat Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button
                            type="object"
                            class="oe_stat_button"
                            icon="fa-map-marker"
                            name="action_view_data"
                        >
                            <field name="data_count" widget="statinfo" string="Areas" />
                        </button>
                    </div>

                    <!-- Ribbons -->
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <widget
                        name="web_ribbon"
                        title="Stale Data"
                        bg_color="bg-warning"
                        invisible="not is_stale"
                    />

                    <!-- Title Section -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Report Name" required="1" />
                        </h1>
                    </div>

                    <!-- Status Indicators -->
                    <div
                        class="alert alert-primary mb-3"
                        role="alert"
                        invisible="not is_syncing"
                    >
                        <i class="fa fa-spinner fa-spin me-2" title="Loading" />
                        <strong>Sync In Progress</strong>
                        <p class="mb-0">
                            Data is being re-synced in the background. This may take a moment.
                            <button
                            name="action_reload_page"
                            type="object"
                            class="btn btn-sm btn-primary ms-2"
                        >
                                <i class="fa fa-refresh me-1" />Check Status
                            </button>
                        </p>
                    </div>
                    <div
                        class="alert alert-warning mb-3"
                        role="alert"
                        invisible="is_syncing or not is_stale"
                    >
                        <i class="fa fa-clock-o me-2" title="Outdated" />
                        <strong>Data May Be Outdated</strong>
                        <p class="mb-0">
                            Last refreshed <field
                            name="last_refresh"
                            widget="timeago"
                        /> -
                            <button
                            name="action_refresh_now"
                            type="object"
                            class="btn btn-sm btn-warning"
                        >
                                Re-sync Data
                            </button>
                        </p>
                    </div>
                    <div
                        class="alert alert-info mb-3"
                        role="alert"
                        invisible="is_syncing or is_stale or not last_refresh"
                    >
                        <i class="fa fa-check-circle me-2" />
                        Last refreshed <field name="last_refresh" widget="timeago" />
                    </div>

                    <!-- Hidden Fields -->
                    <field name="active" invisible="1" />
                    <field name="is_stale" invisible="1" />
                    <field name="is_syncing" invisible="1" />

                    <!-- Main Content - Tabs -->
                    <notebook>
                        <!-- ==================== GENERAL TAB ==================== -->
                        <page name="general" string="General">
                            <group name="general_info_section" col="2">
                                <group name="main_info">
                                    <field name="code" />
                                    <field name="category_id" />
                                    <field name="sequence" />
                                </group>
                                <group name="status_info">
                                    <field name="template_id" readonly="1" />
                                    <field name="active" widget="boolean_toggle" />
                                </group>
                            </group>
                            <separator string="Description" />
                            <field
                                name="description"
                                nolabel="1"
                                placeholder="Describe what this report shows..."
                            />

                            <group name="additional_general" invisible="1" />
                        </page>

                        <!-- ==================== DATA SOURCE TAB ==================== -->
                        <page name="data_source" string="Data Source">
                            <group name="source_section" col="2">
                                <group name="source_model_group">
                                    <field
                                        name="source_model_id"
                                        options="{'no_create': True, 'no_open': True}"
                                        context="{'gis_report_source_models': True}"
                                    />
                                    <field name="source_model" invisible="1" />
                                    <field name="area_field_path" />
                                </group>
                                <!-- Context filters - extended by other modules -->
                                <group name="context_group" invisible="1">
                                    <!-- spp_programs adds program_id here -->
                                    <!-- spp_hazard adds incident_id here -->
                                </group>
                            </group>

                            <separator string="Filters" />
                            <group name="filter_section">
                                <field name="filter_mode" widget="radio" />
                                <field
                                    name="filter_domain"
                                    invisible="filter_mode != 'domain'"
                                />
                                <field
                                    name="filter_cel_id"
                                    invisible="filter_mode != 'cel'"
                                    domain="[('output_type', '=', 'boolean')]"
                                />
                            </group>

                            <group name="additional_data_source" invisible="1" />
                        </page>

                        <!-- ==================== AGGREGATION TAB ==================== -->
                        <page name="aggregation" string="Aggregation">
                            <group name="aggregation_section" col="2">
                                <group name="aggregation_method_group">
                                    <field name="aggregation_method" widget="radio" />
                                    <field
                                        name="aggregation_field"
                                        invisible="aggregation_method not in ('sum', 'avg', 'min', 'max')"
                                    />
                                    <field
                                        name="aggregation_cel_id"
                                        invisible="aggregation_method != 'cel'"
                                    />
                                </group>
                                <group name="area_level_group">
                                    <field name="base_area_level" />
                                </group>
                            </group>

                            <group name="additional_aggregation" invisible="1" />
                        </page>

                        <!-- ==================== NORMALIZATION TAB ==================== -->
                        <page name="normalization" string="Normalization">
                            <group name="normalization_section" col="2">
                                <group name="normalization_method_group">
                                    <field name="normalization_method" />
                                </group>
                                <group name="reference_group">
                                    <field
                                        name="reference_indicator_id"
                                        invisible="normalization_method != 'per_reference'"
                                    />
                                    <field
                                        name="reference_area_field"
                                        invisible="normalization_method not in ('per_area_sqkm', 'per_population', 'per_household')"
                                    />
                                </group>
                            </group>

                            <group name="additional_normalization" invisible="1" />
                        </page>

                        <!-- ==================== VISUALIZATION TAB ==================== -->
                        <page name="visualization" string="Visualization">
                            <group name="geometry_section" col="2">
                                <group name="geometry_type_group">
                                    <field name="geometry_type" widget="radio" />
                                </group>
                                <group name="color_scheme_group">
                                    <field
                                        name="color_scheme_id"
                                        options="{'no_create': True}"
                                    />
                                    <field name="threshold_mode" />
                                    <field
                                        name="bucket_count"
                                        invisible="threshold_mode == 'manual'"
                                    />
                                </group>
                            </group>

                            <group
                                name="disaggregation_section"
                                string="Disaggregation"
                                col="2"
                            >
                                <group name="disaggregation_group">
                                    <field
                                        name="disaggregate_by_gender"
                                        string="By Gender"
                                    />
                                    <field
                                        name="disaggregate_by_age"
                                        string="By Age Group"
                                    />
                                    <field
                                        name="disaggregate_by_disability"
                                        string="By Disability Status"
                                    />
                                </group>
                                <group name="disaggregation_tags_group">
                                    <field
                                        name="disaggregate_by_tag_ids"
                                        widget="many2many_tags"
                                        string="By Tags"
                                    />
                                </group>
                            </group>

                            <separator string="Color Thresholds" />
                            <field name="threshold_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="label" />
                                    <field name="min_value" />
                                    <field name="max_value" />
                                    <field name="color" widget="color" />
                                    <field name="description" />
                                </list>
                            </field>

                            <group name="additional_visualization" invisible="1" />
                        </page>

                        <!-- ==================== ROLLUP TAB ==================== -->
                        <page name="rollup" string="Rollup">
                            <group name="rollup_section" col="2">
                                <group name="rollup_enable_group">
                                    <field
                                        name="enable_rollup"
                                        widget="boolean_toggle"
                                    />
                                </group>
                                <group
                                    name="rollup_method_group"
                                    invisible="not enable_rollup"
                                >
                                    <field name="rollup_method" />
                                    <field
                                        name="rollup_weight_source"
                                        invisible="rollup_method != 'weighted_avg'"
                                    />
                                    <field
                                        name="rollup_weight_field"
                                        invisible="rollup_weight_source != 'custom' or rollup_method != 'weighted_avg'"
                                    />
                                </group>
                            </group>

                            <group name="additional_rollup" invisible="1" />
                        </page>

                        <!-- ==================== SCHEDULE TAB ==================== -->
                        <page name="schedule" string="Schedule">
                            <group name="schedule_section" col="2">
                                <group name="refresh_settings_group">
                                    <field name="refresh_mode" widget="radio" />
                                    <field
                                        name="refresh_interval"
                                        invisible="refresh_mode != 'scheduled'"
                                    />
                                </group>
                                <group name="refresh_status_group">
                                    <field name="last_refresh" readonly="1" />
                                    <field
                                        name="next_refresh"
                                        invisible="refresh_mode != 'scheduled'"
                                    />
                                    <field
                                        name="cron_id"
                                        readonly="1"
                                        invisible="refresh_mode != 'scheduled'"
                                    />
                                </group>
                            </group>

                            <group name="additional_schedule" invisible="1" />
                        </page>

                        <!-- ==================== ACCESS TAB ==================== -->
                        <page name="access" string="Access">
                            <group string="Viewer Groups">
                                <field
                                    name="access_group_ids"
                                    widget="many2many_tags"
                                    nolabel="1"
                                    colspan="2"
                                    placeholder="Leave empty to allow all users to view this report"
                                />
                            </group>
                            <group string="Editor Groups">
                                <field
                                    name="editor_group_ids"
                                    widget="many2many_tags"
                                    nolabel="1"
                                    colspan="2"
                                    placeholder="Groups that can modify this report configuration"
                                />
                            </group>

                            <group name="additional_access" invisible="1" />
                        </page>

                        <!-- ==================== MAP LAYER TAB ==================== -->
                        <page name="map_layer" string="Map Layer">
                            <group name="layer_section" col="2">
                                <group name="layer_settings_group">
                                    <field
                                        name="auto_create_layer"
                                        widget="boolean_toggle"
                                    />
                                    <field
                                        name="layer_active_on_startup"
                                        invisible="not auto_create_layer"
                                    />
                                </group>
                                <group
                                    name="layer_info_group"
                                    invisible="not auto_create_layer"
                                >
                                    <field name="layer_id" readonly="1" />
                                </group>
                            </group>

                            <div
                                class="alert alert-info"
                                role="alert"
                                invisible="not auto_create_layer"
                            >
                                <i class="fa fa-info-circle me-2" title="Info" />
                                <strong>Auto-Sync Enabled</strong><br />
                                A map layer will be automatically created and kept in sync with this report.
                                The layer will use the report's color scheme and geometry type settings.
                            </div>

                            <div invisible="auto_create_layer or not layer_id">
                                <button
                                    name="action_sync_layer"
                                    type="object"
                                    string="Sync Layer Now"
                                    class="btn-primary"
                                    icon="fa-refresh"
                                />
                            </div>

                            <group name="additional_map_layer" invisible="1" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- GIS REPORT ACTION                          -->
    <!-- ========================================== -->
    <record id="action_gis_report" model="ir.actions.act_window">
        <field name="name">GIS Reports</field>
        <field name="res_model">spp.gis.report</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <div class="text-center text-muted py-5">
                <i class="fa fa-map-o fa-3x mb-3 opacity-50" />
                <h5>No GIS Reports Yet</h5>
                <p>GIS reports help you visualize program data on a map.</p>
                <p class="small mb-3">
                    Popular reports: Beneficiary density, Coverage rates, Gap analysis
                </p>
            </div>
        </field>
    </record>
</odoo>
