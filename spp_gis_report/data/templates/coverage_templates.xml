<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Coverage Analysis Templates -->

        <record id="template_beneficiary_density" model="spp.gis.report.template">
            <field name="name">Beneficiary Density</field>
            <field name="code">beneficiary_density</field>
            <field name="description">Shows where beneficiaries are concentrated geographically. Displays the count of beneficiaries per square kilometer for each administrative area.</field>
            <field name="category_id" ref="category_coverage" />
            <field name="icon">fa-users</field>
            <field name="sequence">10</field>
            <field name="requires_program">True</field>
            <field name="config">{
    "source_model": "res.partner",
    "area_field_path": "area_id",
    "filter_template": "[('is_registrant', '=', True), ('is_group', '=', True)]",
    "aggregation_method": "count",
    "normalization_method": "per_area_sqkm",
    "color_scheme": "blues",
    "threshold_mode": "auto_quartile",
    "bucket_count": 5,
    "rollup_method": "sum",
    "rollup_weight_source": "count"
}</field>
        </record>

        <record id="template_coverage_rate" model="spp.gis.report.template">
            <field name="name">Program Coverage Rate</field>
            <field name="code">coverage_rate</field>
            <field name="description">Percentage of eligible population enrolled in the program. Compares enrolled beneficiaries to the total eligible population in each area.</field>
            <field name="category_id" ref="category_coverage" />
            <field name="icon">fa-percent</field>
            <field name="sequence">20</field>
            <field name="requires_program">True</field>
            <field name="requires_reference_data">eligible_count</field>
            <field name="config">{
    "source_model": "res.partner",
    "area_field_path": "area_id",
    "filter_template": "[('is_registrant', '=', True), ('is_group', '=', True)]",
    "aggregation_method": "count",
    "normalization_method": "per_reference",
    "reference_area_field": "eligible_count",
    "color_scheme": "traffic_light_reverse",
    "threshold_mode": "manual",
    "rollup_method": "weighted_avg",
    "rollup_weight_source": "custom",
    "rollup_weight_field": "eligible_count"
}</field>
        </record>

        <record id="template_coverage_gap" model="spp.gis.report.template">
            <field name="name">Coverage Gap Analysis</field>
            <field name="code">coverage_gap</field>
            <field name="description">Identifies areas with low program coverage that need expansion. Shows the gap between eligible and enrolled populations.</field>
            <field name="category_id" ref="category_coverage" />
            <field name="icon">fa-exclamation-triangle</field>
            <field name="sequence">30</field>
            <field name="requires_program">True</field>
            <field name="requires_reference_data">eligible_count</field>
            <field name="config">{
    "source_model": "res.partner",
    "area_field_path": "area_id",
    "filter_template": "[('is_registrant', '=', True), ('is_group', '=', True)]",
    "aggregation_method": "count",
    "normalization_method": "raw",
    "color_scheme": "traffic_light",
    "threshold_mode": "auto_quartile",
    "bucket_count": 4,
    "rollup_method": "sum",
    "rollup_weight_source": "count"
}</field>
        </record>

        <record id="template_enrollment_distribution" model="spp.gis.report.template">
            <field name="name">Enrollment Distribution</field>
            <field name="code">enrollment_distribution</field>
            <field name="description">Visual representation of how program enrollment is distributed across regions. Useful for identifying underserved areas.</field>
            <field name="category_id" ref="category_coverage" />
            <field name="icon">fa-map-marker</field>
            <field name="sequence">40</field>
            <field name="requires_program">True</field>
            <field name="config">{
    "source_model": "res.partner",
    "area_field_path": "area_id",
    "filter_template": "[('is_registrant', '=', True), ('is_group', '=', True)]",
    "aggregation_method": "count",
    "normalization_method": "percentile",
    "color_scheme": "blues",
    "threshold_mode": "auto_quartile",
    "bucket_count": 5,
    "rollup_method": "sum",
    "rollup_weight_source": "count"
}</field>
        </record>

        <record id="template_active_beneficiaries" model="spp.gis.report.template">
            <field name="name">Active Beneficiaries Map</field>
            <field name="code">active_beneficiaries</field>
            <field name="description">Geographic distribution of currently active program beneficiaries. Excludes suspended, graduated, or inactive enrollments.</field>
            <field name="category_id" ref="category_coverage" />
            <field name="icon">fa-check-circle</field>
            <field name="sequence">50</field>
            <field name="requires_program">True</field>
            <field name="config">{
    "source_model": "res.partner",
    "area_field_path": "area_id",
    "filter_template": "[('is_registrant', '=', True), ('is_group', '=', True)]",
    "aggregation_method": "count",
    "normalization_method": "per_population",
    "color_scheme": "blues",
    "threshold_mode": "auto_quartile",
    "bucket_count": 4,
    "rollup_method": "sum",
    "rollup_weight_source": "population"
}</field>
        </record>
</odoo>
