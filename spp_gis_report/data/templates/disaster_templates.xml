<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Disaster Response Templates -->

    <record id="template_affected_population" model="spp.gis.report.template">
        <field name="name">Affected Population Map</field>
        <field name="code">affected_population</field>
        <field
            name="description"
        >Shows the geographic distribution of population affected by a disaster or incident. Displays density of affected individuals per area.</field>
        <field name="category_id" ref="category_disaster_response" />
        <field name="icon">fa-warning</field>
        <field name="sequence">10</field>
        <field name="requires_incident">True</field>
        <field name="config">{
    "source_model": "spp.drims.request",
    "area_field_path": "destination_area_id",
    "filter_template": "[('state', '!=', 'cancelled')]",
    "aggregation_method": "sum",
    "aggregation_field": "affected_count",
    "normalization_method": "per_area_sqkm",
    "color_scheme": "blues",
    "threshold_mode": "auto_jenks",
    "bucket_count": 5,
    "rollup_method": "sum",
    "rollup_weight_source": "count"
}</field>
    </record>

    <record id="template_request_status" model="spp.gis.report.template">
        <field name="name">Request Status by Area</field>
        <field name="code">request_status</field>
        <field
            name="description"
        >Geographic distribution of disaster assistance request statuses. Shows which areas have pending, approved, or fulfilled requests.</field>
        <field name="category_id" ref="category_disaster_response" />
        <field name="icon">fa-tasks</field>
        <field name="sequence">20</field>
        <field name="requires_incident">True</field>
        <field name="config">{
    "source_model": "spp.drims.request",
    "area_field_path": "destination_area_id",
    "filter_template": "[('state', 'in', ['pending', 'approved'])]",
    "aggregation_method": "count",
    "normalization_method": "raw",
    "color_scheme": "blues",
    "threshold_mode": "auto_quartile",
    "bucket_count": 4,
    "rollup_method": "sum",
    "rollup_weight_source": "count"
}</field>
    </record>

    <record id="template_fulfillment_rate" model="spp.gis.report.template">
        <field name="name">Assistance Fulfillment Rate</field>
        <field name="code">fulfillment_rate</field>
        <field
            name="description"
        >Percentage of disaster assistance requests that have been fulfilled. Helps identify areas where response is lagging.</field>
        <field name="category_id" ref="category_disaster_response" />
        <field name="icon">fa-check</field>
        <field name="sequence">30</field>
        <field name="requires_incident">True</field>
        <field name="config">{
    "source_model": "spp.drims.request",
    "area_field_path": "destination_area_id",
    "filter_template": "[('state', '=', 'fulfilled')]",
    "aggregation_method": "count",
    "normalization_method": "per_reference",
    "color_scheme": "traffic_light_reverse",
    "threshold_mode": "manual",
    "rollup_method": "weighted_avg",
    "rollup_weight_source": "count"
}</field>
    </record>

    <record id="template_incident_density" model="spp.gis.report.template">
        <field name="name">Incident Density Heatmap</field>
        <field name="code">incident_density</field>
        <field
            name="description"
        >Heatmap showing concentration of hazard incidents across geographic areas. Useful for identifying high-risk zones.</field>
        <field name="category_id" ref="category_disaster_response" />
        <field name="icon">fa-fire</field>
        <field name="sequence">40</field>
        <field name="config">{
    "source_model": "spp.hazard.incident",
    "area_field_path": "area_id",
    "filter_template": "[('state', '!=', 'draft')]",
    "aggregation_method": "count",
    "normalization_method": "per_area_sqkm",
    "color_scheme": "blues",
    "threshold_mode": "auto_jenks",
    "bucket_count": 5,
    "rollup_method": "sum",
    "rollup_weight_source": "area_sqkm"
}</field>
    </record>

    <record id="template_response_time" model="spp.gis.report.template">
        <field name="name">Average Response Time</field>
        <field name="code">response_time</field>
        <field
            name="description"
        >Average time to fulfill disaster assistance requests by area. Identifies regions where response is slower.</field>
        <field name="category_id" ref="category_disaster_response" />
        <field name="icon">fa-clock-o</field>
        <field name="sequence">50</field>
        <field name="requires_incident">True</field>
        <field name="config">{
    "source_model": "spp.drims.request",
    "area_field_path": "destination_area_id",
    "filter_template": "[('state', '=', 'fulfilled')]",
    "aggregation_method": "avg",
    "aggregation_field": "response_time_hours",
    "normalization_method": "raw",
    "color_scheme": "traffic_light",
    "threshold_mode": "auto_stddev",
    "bucket_count": 5,
    "rollup_method": "weighted_avg",
    "rollup_weight_source": "count"
}</field>
    </record>
</odoo>
