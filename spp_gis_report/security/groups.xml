<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- GIS Report Domain Groups -->
    <!-- Following ADR-004 three-tier architecture -->

    <!-- Tier 3: Technical base groups -->
    <record id="group_gis_report_read" model="res.groups">
        <field name="name">GIS Report: Read</field>
        <field name="comment">Technical group for read access to GIS report models.</field>
    </record>

    <record id="group_gis_report_write" model="res.groups">
        <field name="name">GIS Report: Write</field>
        <field name="comment">Technical group for write access to GIS report models.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_gis_report_read'))]" />
    </record>

    <record id="group_gis_report_create" model="res.groups">
        <field name="name">GIS Report: Create</field>
        <field name="comment">Technical group for GIS report create access. Grants permission to create new GIS report records.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_gis_report_read'))]" />
    </record>

    <!-- Tier 2: User-facing groups -->
    <!-- All groups share the same privilege for unified UI presentation -->
    <record id="group_gis_report_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_gis_report" />
        <field name="comment">Can view GIS reports and refresh data. Cannot create or edit report configurations.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_gis_report_read'))]" />
    </record>

    <record id="group_gis_report_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="privilege_id" ref="privilege_gis_report" />
        <field name="comment">Can view and edit GIS reports, templates, and configurations. Cannot delete.</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_gis_report_user')), Command.link(ref('group_gis_report_write')), Command.link(ref('group_gis_report_create'))]"
        />
    </record>

    <record id="group_gis_report_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_gis_report" />
        <field name="comment">Full GIS report management including delete operations, template creation, and category management.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_gis_report_officer'))]" />
    </record>

    <!-- Cross-module implications -->

    <!-- Registry managers can view GIS reports for spatial analysis -->
    <record id="spp_registry.group_registry_manager" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_gis_report_user'))]" />
    </record>

    <!-- Link manager to admin (IMPORTANT!) -->
    <record id="spp_security.group_spp_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_gis_report_manager'))]" />
    </record>

    <!-- Cross-module implications for spp_programs are in spp_gis_report_programs -->
</odoo>
