<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ================================================================ -->
    <!-- Tier 3: Technical Base Groups (Hidden)                          -->
    <!-- ================================================================ -->

    <record id="group_crypto_read" model="res.groups">
        <field name="name">Crypto: Read Access</field>
        <field
            name="comment"
        >Technical group for read access to encryption models.</field>
    </record>

    <record id="group_crypto_write" model="res.groups">
        <field name="name">Crypto: Write Access</field>
        <field name="implied_ids" eval="[Command.link(ref('group_crypto_read'))]" />
        <field
            name="comment"
        >Technical group for write access to encryption models.</field>
    </record>

    <record id="group_crypto_create" model="res.groups">
        <field name="name">Crypto: Create Access</field>
        <field name="implied_ids" eval="[Command.link(ref('group_crypto_read'))]" />
        <field
            name="comment"
        >Technical group for create access to encryption models.</field>
    </record>

    <!-- ================================================================ -->
    <!-- Tier 2: User-Facing Groups (Visible)                            -->
    <!-- ================================================================ -->

    <!-- All groups share the same privilege for unified UI presentation -->
    <record id="group_crypto_viewer" model="res.groups">
        <field name="name">Crypto Viewer</field>
        <field name="privilege_id" ref="privilege_encryption" />
        <field name="implied_ids" eval="[Command.link(ref('group_crypto_read'))]" />
        <field
            name="comment"
        >Can view encryption provider configuration for audit purposes. Cannot modify.</field>
    </record>

    <record id="group_crypto_officer" model="res.groups">
        <field name="name">Crypto Officer</field>
        <field name="privilege_id" ref="privilege_encryption" />
        <field
            name="implied_ids"
            eval="[
            Command.link(ref('group_crypto_viewer')),
            Command.link(ref('group_crypto_write')),
            Command.link(ref('group_crypto_create'))
        ]"
        />
        <field
            name="comment"
        >Can configure encryption providers and algorithms. Cannot generate or delete keys.</field>
    </record>

    <record id="group_crypto_manager" model="res.groups">
        <field name="name">Crypto Manager</field>
        <field name="privilege_id" ref="privilege_encryption" />
        <field name="implied_ids" eval="[Command.link(ref('group_crypto_officer'))]" />
        <field
            name="comment"
        >Full cryptographic administration including key generation and deletion. HIGHEST RISK.</field>
    </record>

    <!-- Legacy admin group - kept for backward compatibility -->
    <record id="group_crypto_admin" model="res.groups">
        <field name="name">Crypto Admin</field>
        <field name="privilege_id" ref="privilege_encryption" />
        <field name="implied_ids" eval="[Command.link(ref('group_crypto_manager'))]" />
        <field
            name="comment"
        >Legacy admin group. Maps to Crypto Manager. Use group_crypto_manager for new code.</field>
    </record>

    <!-- ================================================================ -->
    <!-- Admin Linkage - Manager group links to spp_admin                -->
    <!-- ================================================================ -->

    <record id="spp_security.group_spp_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_crypto_manager'))]" />
    </record>

    <!-- ================================================================ -->
    <!-- Backward Compatibility (Deprecated)                             -->
    <!-- ================================================================ -->

    <record id="crypto_admin" model="res.groups">
        <field name="name">Crypto Admin (Deprecated)</field>
        <field name="comment">Deprecated: Use group_crypto_admin instead.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_crypto_admin'))]" />
    </record>
</odoo>
