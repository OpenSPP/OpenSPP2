<odoo>
    <!-- individuals view-->

    <record id="view_registrant_consent_form" model="ir.ui.view">
        <field name="name">view_registrant_consent_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_individuals_form" />
        <field name="arch" type="xml">
            <!-- Make verification section visible -->
            <xpath expr="//group[@name='verification_section']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>

            <!-- Add consent field to verification section -->
            <xpath expr="//group[@name='verification_section']" position="inside">
                <field name="consent_ids" nolabel="1" readonly="1">
                    <list>
                        <field name="name" />
                        <field name="signatory_id" column_invisible="1" />
                        <field name="expiry" />
                    </list>
                </field>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
              <button
                    type="object"
                    class="oe_stat_button"
                    icon="fa-sticky-note-o"
                    name="open_record_consent_wizard"
                    invisible="is_group"
                    groups="spp_registry.group_registry_officer,spp_registry.group_registry_manager"
                >
                      <div class="o_form_field o_stat_info">
                          <span class="o_stat_text">Record</span>
                          <span class="o_stat_text">Consent</span>
                      </div>
              </button>
            </xpath>

        </field>
    </record>

    <record id="view_registrant_consent_group_form" model="ir.ui.view">
        <field name="name">view_registrant_consent_group_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_individuals_form" />
        <field name="arch" type="xml">
            <!-- Make verification section visible -->
            <xpath expr="//group[@name='group_verification_section']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>

            <!-- Add consent field to verification section -->
            <xpath expr="//group[@name='group_verification_section']" position="inside">
                <field name="consent_ids" nolabel="1" readonly="1">
                    <list>
                        <field name="name" />
                        <field name="signatory_id" />
                        <field name="expiry" />
                    </list>
                </field>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
              <button
                    type="object"
                    class="oe_stat_button"
                    icon="fa-sticky-note-o"
                    name="open_record_consent_wizard"
                    invisible="not is_group"
                    groups="spp_registry.group_registry_officer,spp_registry.group_registry_manager"
                >
                      <div class="o_form_field o_stat_info">
                          <span class="o_stat_text">Record</span>
                          <span class="o_stat_text">Consent</span>
                      </div>
              </button>
            </xpath>

        </field>
    </record>

</odoo>
