    <record id="view_spp_consent_org_type_form" model="ir.ui.view">
        <field name="name">spp.consent.org.type.form</field>
        <field name="model">spp.consent.org.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="name" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field name="color" widget="color_picker" />
                            <field name="active" />
                        </group>
                    </group>
                    <separator string="Description" />
                    <field name="description" nolabel="1" class="oe_inline" />
                </sheet>
            </form>
        </field>
