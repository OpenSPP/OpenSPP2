    <record id="action_spp_consent_org_type" model="ir.actions.act_window">
        <field name="name">Organization Types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">spp.consent.org.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_neutral">
                <strong>No Organization Types Defined</strong>
            </p>
            <p>
                Click <strong
            >Create</strong> to define organization categories for data sharing consent.
            </p>
            <p class="text-muted">
                Organization types allow beneficiaries to consent to data sharing with categories of organizations
                (e.g., "all NGOs" or "government agencies only") rather than listing specific organizations.
                Examples: Government Agency, NGO, UN Agency, Private Service Provider.
            </p>
        </field>
    </record>

