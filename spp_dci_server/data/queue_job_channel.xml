<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- DCI Queue Job Channel -->
    <record id="channel_dci" model="queue.job.channel">
        <field name="name">dci</field>
        <field name="parent_id" ref="queue_job.channel_root" />
    </record>

    <!-- Cron job to check expired subscriptions -->
    <record id="ir_cron_check_expired_subscriptions" model="ir.cron">
        <field name="name">DCI: Check Expired Subscriptions</field>
        <field name="model_id" ref="model_spp_dci_subscription" />
        <field name="state">code</field>
        <field name="code">model.check_expired_subscriptions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>
