<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Default Case Stages for Demo -->
    <record id="case_stage_intake" model="spp.case.stage">
        <field name="name">Intake</field>
        <field name="phase">intake</field>
        <field name="sequence">10</field>
    </record>

    <record id="case_stage_assessment" model="spp.case.stage">
        <field name="name">Assessment</field>
        <field name="phase">assessment</field>
        <field name="sequence">20</field>
    </record>

    <record id="case_stage_planning" model="spp.case.stage">
        <field name="name">Planning</field>
        <field name="phase">planning</field>
        <field name="sequence">30</field>
    </record>

    <record id="case_stage_implementation" model="spp.case.stage">
        <field name="name">Implementation</field>
        <field name="phase">implementation</field>
        <field name="sequence">40</field>
    </record>

    <record id="case_stage_monitoring" model="spp.case.stage">
        <field name="name">Monitoring</field>
        <field name="phase">monitoring</field>
        <field name="sequence">50</field>
    </record>

    <record id="case_stage_closure" model="spp.case.stage">
        <field name="name">Closed</field>
        <field name="phase">closure</field>
        <field name="sequence">60</field>
    </record>
</odoo>
