<?xml version="1.0" encoding="utf-8" ?>
<!--
    Group + Individual form tweaks requested in OP#915 round-3 QA review.
    All overrides live inside spp_farmer_registry_demo so the upstream
    modules aren't touched. They apply globally to any registrant form
    once the demo module is installed — acceptable because the demo
    install is the only context that pulls this module in.
-->
<odoo>
    <!-- ════════════════════════════════════════════════════════════════
         Individual + Group form: hide Relationships (separator + helper
         div + group), hide Tags section, move History page right of
         Source Tracking. The Location / GIS group is repositioned to the
         end of the Profile tab by a separate inherit on the
         spp_registrant_gis views below.
         ════════════════════════════════════════════════════════════════ -->
    <record id="view_res_partner_form_op915_polish" model="ir.ui.view">
        <field name="name">spp_registry.view_individuals_form.op915_polish</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_individuals_form" />
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <!-- C9 individual: hide Relationships separator, helper div,
                 and the relationships_section group on the Identity tab.
                 Odoo 19 forbids [@string='...'] selectors in view
                 inheritance — use preceding-sibling relative to the
                 named group to reach the separator. -->
            <xpath
                expr="//page[@name='identity']//group[@name='relationships_section']/preceding-sibling::separator[1]"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//page[@name='identity']//group[@name='relationships_section']/preceding-sibling::div[1]"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//page[@name='identity']//group[@name='relationships_section']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- C9 group: same pattern on the Group Identity tab. -->
            <xpath
                expr="//page[@name='group_identity']//group[@name='group_relationships_section']/preceding-sibling::separator[1]"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//page[@name='group_identity']//group[@name='group_relationships_section']/preceding-sibling::div[1]"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//page[@name='group_identity']//group[@name='group_relationships_section']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- C13 individual: hide Tags separator + tags_section group. -->
            <xpath
                expr="//page[@name='profile']//group[@name='tags_section']/preceding-sibling::separator[1]"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//page[@name='profile']//group[@name='tags_section']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- C13 group: hide Tags separator + group_tags_section. -->
            <xpath
                expr="//page[@name='group_profile']//group[@name='group_tags_section']/preceding-sibling::separator[1]"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//page[@name='group_profile']//group[@name='group_tags_section']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- C11: move History tab right of Source Tracking. The
                 individual and group forms use different page names
                 (`history` / `source_tracking` vs `group_history` /
                 `source_tracking_group`) so we need both moves. The
                 nested xpath is Odoo's idiom for `position="move"`:
                 outer anchors the target sibling, inner identifies the
                 page to move. -->
            <xpath expr="//page[@name='source_tracking_group']" position="after">
                <xpath expr="//page[@name='group_history']" position="move" />
            </xpath>
            <xpath expr="//page[@name='source_tracking']" position="after">
                <xpath expr="//page[@name='history']" position="move" />
            </xpath>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         C12: relocate the GIS / Location group provided by
         spp_registrant_gis so it sits at the END of each Profile tab
         (after financial section), rather than sandwiched between
         phone numbers and finance. Adds the dep on spp_registrant_gis
         in the manifest so it's guaranteed loaded before us.
         ════════════════════════════════════════════════════════════════ -->
    <record id="view_individuals_form_gis_move" model="ir.ui.view">
        <field name="name">spp_registrant_gis.view_individuals_form_gis.move</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registrant_gis.view_individuals_form_gis" />
        <field name="priority">300</field>
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='profile']//group[@name='financial_section']"
                position="after"
            >
                <xpath
                    expr="//page[@name='profile']//group[@name='gis_section']/preceding-sibling::separator[1]"
                    position="move"
                />
                <xpath
                    expr="//page[@name='profile']//group[@name='gis_section']"
                    position="move"
                />
            </xpath>
        </field>
    </record>

    <record id="view_groups_form_gis_move" model="ir.ui.view">
        <field name="name">spp_registrant_gis.view_groups_form_gis.move</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registrant_gis.view_groups_form_gis" />
        <field name="priority">300</field>
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='group_profile']//group[@name='group_financial_section']"
                position="after"
            >
                <xpath
                    expr="//page[@name='group_profile']//group[@name='group_gis_section']/preceding-sibling::separator[1]"
                    position="move"
                />
                <xpath
                    expr="//page[@name='group_profile']//group[@name='group_gis_section']"
                    position="move"
                />
            </xpath>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         C14: hide the Event Data smart button on both Group and
         Individual forms. spp_event_data adds TWO buttons with the same
         `name="open_create_event_wizard"` to the same button_box (one
         visible per `is_group` value), so a plain
         `//button[@name='open_create_event_wizard']` xpath only matches
         the first occurrence and leaves the other visible. Distinguish
         the two via their original `invisible` expressions: the group
         button's expression contains "not is_group", the individual
         button's does not.
         ════════════════════════════════════════════════════════════════ -->
    <record id="view_res_partner_form_hide_event_btn" model="ir.ui.view">
        <field name="name">spp_registry.view_individuals_form.hide_event_btn</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_individuals_form" />
        <field name="priority">300</field>
        <field name="arch" type="xml">
            <xpath
                expr="//button[@name='open_create_event_wizard'][contains(@invisible, 'not is_group')]"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//button[@name='open_create_event_wizard'][not(contains(@invisible, 'not is_group'))]"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         OP#915 round-3 item: drop the Extension Services tab on the farm
         group form unless additional context is provided (currently the
         tab exists but is empty for demo data).
         ════════════════════════════════════════════════════════════════ -->
    <record id="view_res_partner_form_hide_extension_services" model="ir.ui.view">
        <field
            name="name"
        >spp_farmer_registry.view_res_partner_group_farm_form.hide_ext</field>
        <field name="model">res.partner</field>
        <field
            name="inherit_id"
            ref="spp_farmer_registry.view_res_partner_group_farm_form"
        />
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='extension_services']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
