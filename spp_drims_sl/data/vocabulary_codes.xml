<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sri Lanka-Specific Vocabulary Codes -->

    <!-- Life-Threatening Priority (SL-specific) -->
    <record id="code_priority_life_threatening" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="spp_drims.vocab_drims_priority"/>
        <field name="code">life_threatening</field>
        <field name="display">Life-Threatening</field>
        <field name="sequence">1</field>
        <field name="is_local">True</field>
    </record>

    <!-- SL-specific transport: Rail -->
    <record id="code_transport_rail" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="spp_drims.vocab_drims_transport_mode"/>
        <field name="code">rail</field>
        <field name="display">Rail (Sri Lanka Railways)</field>
        <field name="sequence">25</field>
        <field name="is_local">True</field>
    </record>

    <!-- SL Monsoon hazard types -->
    <record id="code_hazard_sw_monsoon" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="spp_drims.vocab_drims_hazard_type"/>
        <field name="code">sw_monsoon</field>
        <field name="display">Southwest Monsoon</field>
        <field name="sequence">50</field>
        <field name="is_local">True</field>
        <field name="reference_uri">urn:openspp:vocab:hazard-types#monsoon</field>
        <field name="equivalence">equivalent</field>
    </record>
    <record id="code_hazard_ne_monsoon" model="spp.vocabulary.code">
