<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
    DRIMS Demo Users - Sri Lanka

    Roles mapped to Odoo groups:
    - Super Admin: base.group_system + spp_drims.group_drims_manager
    - Warehouse Manager: spp_drims.group_drims_manager + stock.group_stock_manager (full admin)
    - Warehouse Staff: spp_drims.group_drims_warehouse_worker (receive donations, manage inventory)
    - Field Officer: spp_drims.group_drims_field_officer (create requests, confirm deliveries)
    - Approver: spp_drims.group_drims_approver (approve/reject requests)
    - Viewer/Leadership: spp_drims.group_drims_viewer (read-only dashboard access)

    User emails:
    - admin.dmc@drims.gov.lk          - DMC Administrator (Super Admin)
    - staff.colombo@drims.gov.lk      - Warehouse Staff (for donations tutorial)
    - staff.kandy@drims.gov.lk        - Warehouse Staff
    - wh.colombo@drims.gov.lk         - Warehouse Manager (full admin)
    - wh.kandy@drims.gov.lk           - Warehouse Manager (full admin)
    - approver.national@drims.gov.lk  - National Approver
    - approver.western@drims.gov.lk   - Western Province Approver
    - approver.central@drims.gov.lk   - Central Province Approver
    - officer.colombo@drims.gov.lk    - Field Officer (for requests tutorial)
    - officer.gampaha@drims.gov.lk    - Field Officer
    - officer.kandy@drims.gov.lk      - Field Officer
    - officer.galle@drims.gov.lk      - Field Officer
    - secretary@drims.gov.lk          - Secretary (Viewer, for dashboard tutorial)
    - director@drims.gov.lk           - Director (Viewer)
    -->

    <!-- ==================== SUPER ADMIN ==================== -->

    <record id="user_admin_dmc" model="res.users" context="{'no_reset_password': True}">
        <field name="name">DMC Administrator</field>
        <field name="login">admin.dmc@drims.gov.lk</field>
        <field name="password">demo</field>
        <field
            name="group_ids"
            eval="[Command.set([
            ref('base.group_user'),
            ref('base.group_system'),
            ref('spp_drims.group_drims_manager'),
            ref('stock.group_stock_manager'),
        ])]"
        />
        <field name="company_id" ref="base.main_company" />
    </record>

    <!-- ==================== WAREHOUSE STAFF ==================== -->
    <!-- These users can receive donations, manage inventory, and process dispatches -->
    <!-- They do NOT have manager/admin access -->

    <record id="user_wh_staff_colombo" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Warehouse Staff - Colombo</field>
        <field name="login">staff.colombo@drims.gov.lk</field>
        <field name="password">demo</field>
        <field
            name="group_ids"
            eval="[Command.set([
            ref('base.group_user'),
            ref('spp_drims.group_drims_warehouse_worker'),
        ])]"
        />
        <field name="company_id" ref="base.main_company" />
    </record>

    <record id="user_wh_staff_kandy" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Warehouse Staff - Kandy</field>
        <field name="login">staff.kandy@drims.gov.lk</field>
        <field name="password">demo</field>
        <field
            name="group_ids"
            eval="[Command.set([
            ref('base.group_user'),
            ref('spp_drims.group_drims_warehouse_worker'),
        ])]"
        />
        <field name="company_id" ref="base.main_company" />
    </record>

    <!-- ==================== WAREHOUSE MANAGERS ==================== -->
    <!-- These users have full admin access to manage warehouse operations -->

    <record id="user_wh_colombo" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Warehouse Manager - Colombo</field>
        <field name="login">wh.colombo@drims.gov.lk</field>
        <field name="password">demo</field>
