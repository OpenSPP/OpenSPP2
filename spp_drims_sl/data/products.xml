    <!--
    DRIMS Sample Relief Products - Sri Lanka

    Product tracking:
    - 'lot': Batch tracking with optional expiry (for perishables)
    - 'none': No tracking (for non-perishables)

    type='product' means storable (tracked in inventory)
    -->

    <!-- ==================== FOOD - DRY RATIONS ==================== -->

    <record id="product_rice_5kg" model="product.product">
        <field name="name">Rice - 5kg Bag</field>
        <field name="default_code">FOOD-RICE-5KG</field>
        <field name="type">consu</field>
        <field name="is_storable" eval="True"/>
        <field name="categ_id" ref="categ_food_dry"/>
        <field name="tracking">none</field>
        <field name="use_expiration_date" eval="True"/>
        <field name="expiration_time">180</field><!-- 180 days shelf life -->
        <field name="uom_id" ref="uom.product_uom_unit"/>
        <field name="standard_price">850</field><!-- LKR -->
        <field name="description">White rice, 5kg family pack. Staple relief food item.</field>
    </record>

