        <field name="code">ANUR</field>
        <field name="is_drims_warehouse">True</field>
        <field name="drims_capacity">5000</field>
        <!-- 5,000 m³ -->
        <field name="emergency_contact">DMC North Central</field>
        <field name="emergency_phone">+94 25 2222561</field>
        <field name="partner_id" ref="agency_dmc" />
    </record>

