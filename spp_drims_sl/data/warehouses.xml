<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
    Sri Lanka Warehouse Network: 11 Warehouses

    Note: area_id should be linked after importing areas from
    lka_adminboundaries_tabulardata.xlsx via spp.area.import
    -->

    <!-- National Level Warehouses (2) -->

    <!-- 1. Central Warehouse - Colombo (Main Hub) -->
    <record id="warehouse_colombo_central" model="stock.warehouse">
        <field name="name">Central Warehouse - Colombo</field>
        <field name="code">CMBC</field>
        <field name="is_drims_warehouse">True</field>
        <field name="drims_capacity">10000</field>
        <!-- 10,000 m³ -->
        <field name="emergency_contact">DMC Logistics Division</field>
        <field name="emergency_phone">+94 11 2136136</field>
        <field name="partner_id" ref="agency_dmc" />
    </record>

    <!-- 2. National Reserve - Anuradhapura (Backup) -->
    <record id="warehouse_anuradhapura_reserve" model="stock.warehouse">
