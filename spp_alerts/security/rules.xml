<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
        <!-- Alert Record Rules -->

        <!-- Multi-company isolation for alerts -->
        <record id="rule_alert_multi_company" model="ir.rule">
            <field name="name">Alert: Multi-Company</field>
            <field name="model_id" ref="model_spp_alert"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Multi-company isolation for alert rules -->
        <record id="rule_alert_rule_multi_company" model="ir.rule">
            <field name="name">Alert Rule: Multi-Company</field>
            <field name="model_id" ref="model_spp_alert_rule"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="global" eval="True"/>
        </record>
</odoo>
