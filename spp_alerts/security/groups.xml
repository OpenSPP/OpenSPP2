<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Alert Security Groups -->

    <!-- Technical Groups (Tier 3) -->
    <record id="group_alerts_read" model="res.groups">
        <field name="name">Alerts: Read</field>
        <field name="comment">Technical group for read access to alert models.</field>
    </record>

    <record id="group_alerts_write" model="res.groups">
        <field name="name">Alerts: Write</field>
        <field name="comment">Technical group for write access to alert models.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_alerts_read'))]" />
    </record>

    <record id="group_alerts_create" model="res.groups">
        <field name="name">Alerts: Create</field>
        <field name="comment">Technical group for create access to alert models.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_alerts_write'))]" />
    </record>

    <!-- User-Facing Groups (Tier 2) -->

    <!-- Viewer: Read-only access -->
    <record id="privilege_alerts_viewer" model="res.groups.privilege">
        <field name="name">Viewer</field>
        <field name="category_id" ref="spp_security.category_spp_admin" />
        <field name="sequence">200</field>
    </record>

    <record id="group_alerts_viewer" model="res.groups">
        <field name="name">Alerts Viewer</field>
        <field name="privilege_id" ref="privilege_alerts_viewer" />
        <field name="comment">Can view alerts but cannot modify or resolve them.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_alerts_read'))]" />
    </record>

    <!-- Officer: Can acknowledge and resolve alerts -->
    <record id="privilege_alerts_officer" model="res.groups.privilege">
        <field name="name">Officer</field>
        <field name="category_id" ref="spp_security.category_spp_admin" />
        <field name="sequence">210</field>
    </record>

    <record id="group_alerts_officer" model="res.groups">
        <field name="name">Alerts Officer</field>
        <field name="privilege_id" ref="privilege_alerts_officer" />
        <field
            name="comment"
        >Can acknowledge, resolve, and manually create alerts.</field>
        <field
            name="implied_ids"
            eval="[
            Command.link(ref('group_alerts_create')),
            Command.link(ref('group_alerts_viewer')),
        ]"
        />
    </record>

    <!-- Manager: Full access including alert rules -->
    <record id="privilege_alerts_manager" model="res.groups.privilege">
        <field name="name">Manager</field>
        <field name="category_id" ref="spp_security.category_spp_admin" />
        <field name="sequence">220</field>
    </record>

    <record id="group_alerts_manager" model="res.groups">
        <field name="name">Alerts Manager</field>
        <field name="privilege_id" ref="privilege_alerts_manager" />
        <field
            name="comment"
        >Full access to alerts and alert rule configuration.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_alerts_officer'))]" />
    </record>

    <!-- Link Manager to SPP Admin -->
    <record id="spp_security.group_spp_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_alerts_manager'))]" />
    </record>
</odoo>
