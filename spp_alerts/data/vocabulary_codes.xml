<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Generic Alert Type Codes -->

    <!-- Threshold Alert: For monitoring values against thresholds -->
    <record id="code_alert_threshold" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_alert_types" />
        <field name="code">threshold</field>
        <field name="display">Threshold Alert</field>
        <field name="sequence">10</field>
        <field
            name="definition"
        >Alert triggered when a monitored value crosses a threshold (above or below)</field>
    </record>

    <!-- Expiry Alert: For items nearing expiration -->
    <record id="code_alert_expiry" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_alert_types" />
        <field name="code">expiry</field>
        <field name="display">Expiry Alert</field>
        <field name="sequence">20</field>
        <field
            name="definition"
        >Alert for items approaching or past their expiration date</field>
    </record>

    <!-- Deadline Alert: For tasks or events approaching deadlines -->
    <record id="code_alert_deadline" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_alert_types" />
        <field name="code">deadline</field>
        <field name="display">Deadline Alert</field>
        <field name="sequence">30</field>
        <field
            name="definition"
        >Alert for tasks, events, or obligations approaching or past their deadline</field>
    </record>

    <!-- Manual Alert: For user-created alerts -->
    <record id="code_alert_manual" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_alert_types" />
        <field name="code">manual</field>
        <field name="display">Manual Alert</field>
        <field name="sequence">40</field>
        <field
            name="definition"
        >Alert manually created by a user for tracking purposes</field>
    </record>

    <!-- System Alert: For system-generated notifications -->
    <record id="code_alert_system" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_alert_types" />
        <field name="code">system</field>
        <field name="display">System Alert</field>
        <field name="sequence">50</field>
        <field
            name="definition"
        >Alert generated by system processes or background jobs</field>
    </record>
</odoo>
