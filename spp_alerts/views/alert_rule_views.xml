<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Alert Rule List View -->
    <record id="spp_alert_rule_view_list" model="ir.ui.view">
        <field name="name">spp.alert.rule.list</field>
        <field name="model">spp.alert.rule</field>
        <field name="arch" type="xml">
            <list string="Alert Rules" sample="1">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="alert_type_id" />
                <field name="model_id" />
                <field name="rule_type" optional="show" />
                <field name="priority" />
                <field name="threshold_value" optional="show" />
                <field name="days_before" optional="show" />
                <field name="active" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company"
                />
            </list>
        </field>
    </record>

    <!-- Alert Rule Form View -->
    <record id="spp_alert_rule_view_form" model="ir.ui.view">
        <field name="name">spp.alert.rule.form</field>
        <field name="model">spp.alert.rule</field>
        <field name="arch" type="xml">
            <form string="Alert Rule">
                <header>
                    <button
                        name="action_evaluate"
                        type="object"
                        string="Run Now"
                        class="btn-primary"
                        invisible="not rule_type or not model_id"
                        groups="spp_alerts.group_alerts_manager,base.group_system"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_view_alerts"
                            icon="fa-bell"
                        >
                            <field
                                name="alert_count"
                                widget="statinfo"
                                string="Alerts"
                            />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group name="rule_main">
                        <group name="rule_basic">
                            <field name="name" placeholder="e.g., Low Stock Warning" />
                            <field name="alert_type_id" options="{'no_create': True}" />
                            <field name="priority" />
                        </group>
                        <group name="rule_config">
                            <field name="model_id" />
                            <field name="rule_type" />
                            <field name="sequence" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <separator string="Description" />
                    <field
                        name="description"
                        nolabel="1"
                        placeholder="Describe when this rule triggers and what it monitors..."
                    />
                    <group name="additional_description" invisible="1" />
                    <notebook>
                        <page
                            string="Evaluation"
                            name="evaluation"
                            invisible="not rule_type"
                        >
                            <group
                                string="Threshold Settings"
                                invisible="rule_type != 'threshold'"
                            >
                                <group>
                                    <field
                                        name="monitored_field_id"
                                        required="rule_type == 'threshold'"
                                    />
                                    <field name="comparison" />
                                    <field name="threshold_value" />
                                </group>
                            </group>
                            <group
                                string="Date Settings"
                                invisible="rule_type != 'date'"
                            >
                                <group>
                                    <field
                                        name="date_field_id"
                                        required="rule_type == 'date'"
                                    />
                                    <field name="days_before" />
                                </group>
                            </group>
                            <group name="additional_evaluation" invisible="1" />
                            <separator string="Record Filter" />
                            <field name="model_name" invisible="1" />
                            <field
                                name="domain_filter"
                                widget="domain"
                                options="{'model': 'model_name'}"
                            />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Alert Rule Search View -->
    <record id="spp_alert_rule_view_search" model="ir.ui.view">
        <field name="name">spp.alert.rule.search</field>
        <field name="model">spp.alert.rule</field>
        <field name="arch" type="xml">
            <search string="Search Alert Rules">
                <field name="name" />
                <field name="alert_type_id" />
                <field name="model_id" />
                <separator />
                <filter
                    name="filter_active"
                    string="Active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    name="filter_inactive"
                    string="Inactive"
                    domain="[('active', '=', False)]"
                />
                <separator />
                <filter
                    name="filter_critical"
                    string="Critical Priority"
                    domain="[('priority', '=', 'critical')]"
                />
                <filter
                    name="filter_high"
                    string="High Priority"
                    domain="[('priority', '=', 'high')]"
                />
                <group name="groupby">
                    <filter
                        name="groupby_type"
                        string="Alert Type"
                        context="{'group_by': 'alert_type_id'}"
                    />
                    <filter
                        name="groupby_model"
                        string="Model"
                        context="{'group_by': 'model_id'}"
                    />
                    <filter
                        name="groupby_priority"
                        string="Priority"
                        context="{'group_by': 'priority'}"
                    />
                    <filter
                        name="groupby_rule_type"
                        string="Rule Type"
                        context="{'group_by': 'rule_type'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Alert Rule Action -->
    <record id="action_spp_alert_rule" model="ir.actions.act_window">
        <field name="name">Alert Rules</field>
        <field name="res_model">spp.alert.rule</field>
        <field name="view_mode">list,form</field>
        <field name="path">alert-rules</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No alert rules configured
            </p>
            <p>
                Alert rules define the conditions and thresholds for automatically
                creating alerts. Configure rules to monitor thresholds, expiry dates,
                and deadlines across your OpenSPP modules.
            </p>
        </field>
    </record>
</odoo>
