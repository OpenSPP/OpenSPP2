<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Alert Rule List View -->
    <record id="spp_alert_rule_view_list" model="ir.ui.view">
        <field name="name">spp.alert.rule.list</field>
        <field name="model">spp.alert.rule</field>
        <field name="arch" type="xml">
            <list string="Alert Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="alert_type_id"/>
                <field name="model_id"/>
                <field name="priority"/>
                <field name="threshold_value" optional="show"/>
                <field name="days_before" optional="show"/>
                <field name="active"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Alert Rule Form View -->
    <record id="spp_alert_rule_view_form" model="ir.ui.view">
        <field name="name">spp.alert.rule.form</field>
        <field name="model">spp.alert.rule</field>
        <field name="arch" type="xml">
            <form string="Alert Rule">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g., Low Stock Warning"/>
                            <field name="alert_type_id"/>
                            <field name="model_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Thresholds" name="thresholds">
                            <group>
                                <group>
                                    <field name="threshold_value"/>
                                </group>
                                <group>
                                    <field name="days_before"/>
                                </group>
                            </group>
                            <separator string="Description"/>
                            <field name="description" placeholder="Describe when this rule triggers and what it monitors..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Alert Rule Search View -->
    <record id="spp_alert_rule_view_search" model="ir.ui.view">
        <field name="name">spp.alert.rule.search</field>
        <field name="model">spp.alert.rule</field>
        <field name="arch" type="xml">
            <search string="Search Alert Rules">
                <field name="name"/>
                <field name="alert_type_id"/>
                <field name="model_id"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="filter_critical" string="Critical Priority" domain="[('priority', '=', 'critical')]"/>
                <filter name="filter_high" string="High Priority" domain="[('priority', '=', 'high')]"/>
                <separator/>
                <filter name="groupby_type" string="Alert Type" context="{'group_by': 'alert_type_id'}"/>
                <filter name="groupby_model" string="Model" context="{'group_by': 'model_id'}"/>
                <filter name="groupby_priority" string="Priority" context="{'group_by': 'priority'}"/>
            </search>
        </field>
    </record>

    <!-- Alert Rule Action -->
    <record id="action_spp_alert_rule" model="ir.actions.act_window">
        <field name="name">Alert Rules</field>
        <field name="res_model">spp.alert.rule</field>
        <field name="view_mode">list,form</field>
        <field name="path">alert-rules</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No alert rules configured
            </p>
            <p>
                Alert rules define the conditions and thresholds for automatically
                creating alerts. Configure rules to monitor thresholds, expiry dates,
                and deadlines across your OpenSPP modules.
            </p>
        </field>
    </record>
</odoo>
