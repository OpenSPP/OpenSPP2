<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

<!-- Add area field to Group registrant form view -->
    <record id="view_area_groups_form" model="ir.ui.view">
        <field name="name">view_area_groups_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_individuals_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_contact_section']//field[@name='address']" position="before">
                <field
                    name="area_id"
                    placeholder="Area"
                    options="{'no_create': True}"
                    readonly="disabled"
                />
            </xpath>
        </field>
    </record>

</odoo>
