<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_spp_area_tag_tree" model="ir.ui.view">
        <field name="name">spp.area.tag.tree</field>
        <field name="model">spp.area.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="code" />
                <field name="active" />
                <field name="color" widget="color_picker" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_spp_area_tag_form" model="ir.ui.view">
        <field name="name">spp.area.tag.form</field>
        <field name="model">spp.area.tag</field>
        <field name="arch" type="xml">
            <form string="Area Tag">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                        <field name="active" invisible="1"/>
                        <field name="color" widget="color_picker" />
                    </group>
                    <separator string="Description"/>
                    <field name="description" nolabel="1" class="oe_inline"/>
                    <notebook>
                        <page string="Areas">
                            <field name="area_ids" readonly="1">
                                <list>
                                    <field name="complete_name" />
                                    <field name="code" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="spp_area_tag_search" model="ir.ui.view">
        <field name="name">spp.area.tag.search</field>
        <field name="model">spp.area.tag</field>
        <field name="arch" type="xml">
            <search string="Search Area Tags">
                <field name="name" />
                <field name="code" />
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]" />
            </search>
        </field>
    </record>

    <record id="action_spp_area_tag" model="ir.actions.act_window">
        <field name="name">Area Tags</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">spp.area.tag</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Area Tag!
            </p>
            <p>
                Use tags to classify areas (for example urban, remote, priority)
                and reference them in CEL expressions and reports.
            </p>
        </field>
    </record>

    <record id="action_spp_area_tag_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_spp_area_tag_tree" />
        <field name="act_window_id" ref="action_spp_area_tag" />
    </record>

    <record id="action_spp_area_tag_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_spp_area_tag_form" />
        <field name="act_window_id" ref="action_spp_area_tag" />
    </record>

    <menuitem
        id="menu_spp_area_tag"
        name="Area Tags"
        action="action_spp_area_tag"
        parent="spp_area.area_main_top_menu"
        sequence="115"
        groups="base.group_system,spp_security.group_spp_admin,spp_area.group_area_officer"
    />

</odoo>
