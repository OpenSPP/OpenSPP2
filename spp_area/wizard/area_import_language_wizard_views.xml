<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_area_import_language_wizard_form" model="ir.ui.view">
        <field name="name">spp.area.import.language.wizard.form</field>
        <field name="model">spp.area.import.language.wizard</field>
        <field name="arch" type="xml">
            <form string="Activate Languages for Import">
                <field name="area_import_id" invisible="1" />
                <field name="language_ids" invisible="1" />
                <group>
                    <div class="alert alert-info" role="alert">
                        <p>
                            <strong>Languages Required</strong>
                        </p>
                        <p>
                            The import file contains translations in languages that are not currently
                            activated in your system:
                        </p>
                        <field name="languages_display" nolabel="1" readonly="1" />
                        <p class="mt-2">
                            Would you like to activate these languages?
                        </p>
                    </div>
                </group>
                <footer>
                    <button
                        name="action_activate_and_continue"
                        type="object"
                        string="Activate &amp; Continue Import"
                        class="btn-primary"
                    />
                    <button
                        name="action_skip_and_continue"
                        type="object"
                        string="Skip (Import without these translations)"
                        class="btn-secondary"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        class="btn-link"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
