<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template List View -->
    <record id="view_simulation_scenario_template_list" model="ir.ui.view">
        <field name="name">spp.simulation.scenario.template.list</field>
        <field name="model">spp.simulation.scenario.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="target_type"/>
                <field name="default_amount"/>
                <field name="default_amount_mode"/>
            </list>
        </field>
    </record>

    <!-- Template Form View -->
    <record id="view_simulation_scenario_template_form" model="ir.ui.view">
        <field name="name">spp.simulation.scenario.template.form</field>
        <field name="model">spp.simulation.scenario.template</field>
        <field name="arch" type="xml">
            <form string="Scenario Template">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Template Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="target_type" widget="radio"/>
                            <field name="icon"/>
                        </group>
                        <group>
                            <field name="default_amount"/>
                            <field name="default_amount_mode"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <separator string="Targeting Expression"/>
                    <field name="cel_profile" invisible="1"/>
                    <field name="targeting_expression" widget="cel_expression"
                           options="{'profile_field': 'cel_profile'}"/>
                    <separator string="Description"/>
                    <field name="description"/>
                    <group string="Advanced" name="advanced">
                        <field name="ideal_population_expression"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Template Search View -->
    <record id="view_simulation_scenario_template_search" model="ir.ui.view">
        <field name="name">spp.simulation.scenario.template.search</field>
        <field name="model">spp.simulation.scenario.template</field>
        <field name="arch" type="xml">
            <search string="Search Templates">
                <field name="name"/>
                <field name="category"/>
                <separator/>
                <filter string="Age-Based" name="age" domain="[('category', '=', 'age')]"/>
                <filter string="Geographic" name="geographic" domain="[('category', '=', 'geographic')]"/>
                <filter string="Vulnerability" name="vulnerability" domain="[('category', '=', 'vulnerability')]"/>
                <filter string="Economic" name="economic" domain="[('category', '=', 'economic')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Category" name="group_by_category" context="{'group_by': 'category'}"/>
                <filter string="Target Type" name="group_by_target" context="{'group_by': 'target_type'}"/>
            </search>
        </field>
    </record>

    <!-- Template Action -->
    <record id="action_simulation_scenario_template" model="ir.actions.act_window">
        <field name="name">Scenario Templates</field>
        <field name="res_model">spp.simulation.scenario.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_simulation_scenario_template_search"/>
        <field name="path">simulation-templates</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first scenario template
            </p>
            <p>
                Templates provide pre-built starting points for common targeting scenarios.
            </p>
        </field>
    </record>
</odoo>
