<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Scenario List View -->
    <record id="view_simulation_scenario_list" model="ir.ui.view">
        <field name="name">spp.simulation.scenario.list</field>
        <field name="model">spp.simulation.scenario</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'archived'">
                <field name="name"/>
                <field name="category" optional="show"/>
                <field name="target_type"/>
                <field name="targeting_preview_count" string="Preview Count"/>
                <field name="run_count" string="Runs"/>
                <field name="latest_beneficiary_count" string="Latest Beneficiaries"/>
                <field name="latest_equity_score" string="Parity Score"/>
                <field
                    name="state"
                    decoration-success="state == 'ready'"
                    decoration-info="state == 'draft'"
                    decoration-muted="state == 'archived'"
                    widget="badge"
                />
            </list>
        </field>
    </record>

    <!-- Scenario Form View -->
    <record id="view_simulation_scenario_form" model="ir.ui.view">
        <field name="name">spp.simulation.scenario.form</field>
        <field name="model">spp.simulation.scenario</field>
        <field name="arch" type="xml">
            <form string="Simulation Scenario">
                <header>
                    <button
                        name="action_run_simulation"
                        type="object"
                        string="Run Simulation"
                        class="btn-primary"
                        invisible="state != 'ready'"
                        groups="spp_simulation.group_simulation_officer"
                    />
                    <button
                        name="action_duplicate_for_comparison"
                        type="object"
                        string="Duplicate for Comparison"
                        class="btn-secondary"
                        invisible="run_count == 0"
                    />
                    <button
                        name="action_set_ready"
                        type="object"
                        string="Mark as Ready"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_set_draft"
                        type="object"
                        string="Reset to Draft"
                        invisible="state != 'ready'"
                    />
                    <button
                        name="action_archive"
                        type="object"
                        string="Archive"
                        invisible="state == 'archived'"
                        groups="spp_simulation.group_simulation_manager"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready"/>
                </header>
                <sheet>
                    <!-- Stat Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button type="object" class="oe_stat_button" icon="fa-bar-chart"
                                name="action_view_runs">
                            <field name="run_count" widget="statinfo" string="Runs"/>
                        </button>
                        <button type="object" class="oe_stat_button" icon="fa-users"
                                name="action_view_runs"
                                invisible="latest_beneficiary_count == 0">
                            <field name="latest_beneficiary_count" widget="statinfo"
                                   string="Latest Beneficiaries"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Scenario Name"/>
                        </h1>
                        <field name="category" placeholder="Category (e.g., Child Grant Variations)"/>
                    </div>
                    <!-- Alert for expression errors -->
                    <div class="alert alert-danger" role="alert"
                         invisible="not targeting_preview_error">
                        <strong>Expression Error: </strong>
                        <field name="targeting_preview_error"/>
                    </div>
                    <notebook>
                        <!-- Setup Tab -->
                        <page name="setup" string="Setup">
                            <group>
                                <group>
                                    <field name="template_id" readonly="state != 'draft'"/>
                                    <field name="target_type" widget="radio" readonly="state == 'archived'"/>
                                </group>
                                <group>
                                    <field name="targeting_preview_count"
                                           string="Matching Registrants"/>
                                </group>
                            </group>
                            <separator string="Targeting Expression"/>
                            <field name="cel_profile" invisible="1"/>
                            <field name="targeting_expression" widget="cel_expression"
                                   options="{'profile_field': 'cel_profile'}"
                                   readonly="state == 'archived'"/>
                            <field name="targeting_expression_explanation"
                                   placeholder="Describe what this expression targets in plain language..."
                                   readonly="state == 'archived'"/>

                            <separator string="Entitlement Rules"/>
                            <field name="entitlement_rule_ids" readonly="state == 'archived'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="amount_mode"/>
                                    <field name="amount" invisible="amount_mode == 'cel'"/>
                                    <field name="multiplier_field"
                                           invisible="amount_mode != 'multiplier'"/>
                                    <field name="max_multiplier"
                                           invisible="amount_mode != 'multiplier'"/>
                                    <field name="amount_cel_expression"
                                           invisible="amount_mode != 'cel'"/>
                                    <field name="condition_cel_expression" optional="hide"/>
                                </list>
                            </field>

                            <separator string="Budget"/>
                            <group>
                                <group>
                                    <field name="budget_amount" readonly="state == 'archived'"/>
                                </group>
                                <group>
                                    <field name="budget_strategy" readonly="state == 'archived'"/>
                                </group>
                            </group>

                            <separator string="Advanced Options"/>
                            <group name="advanced">
                                <group>
                                    <field name="ideal_population_expression"
                                           readonly="state == 'archived'"
                                           placeholder="e.g., metric('pmt_score') &lt; 2.0"/>
                                </group>
                                <group>
                                    <field name="metric_ids" widget="many2many_tags"
                                           readonly="state == 'archived'"/>
                                    <field name="program_id" readonly="state == 'archived'"/>
                                </group>
                            </group>
                        </page>

                        <!-- Run History Tab -->
                        <page name="history" string="Run History">
                            <field name="run_ids" readonly="1">
                                <list>
                                    <field name="executed_at"/>
                                    <field name="beneficiary_count"/>
                                    <field name="total_cost"/>
                                    <field name="equity_score"/>
                                    <field name="coverage_rate" string="Coverage %"/>
                                    <field name="execution_duration_seconds" string="Duration (s)"/>
                                    <field
                                        name="state"
                                        decoration-success="state == 'completed'"
                                        decoration-warning="state == 'running'"
                                        decoration-danger="state == 'failed'"
                                        widget="badge"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="description" placeholder="Optional description..."
                           readonly="state == 'archived'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Scenario Search View -->
    <record id="view_simulation_scenario_search" model="ir.ui.view">
        <field name="name">spp.simulation.scenario.search</field>
        <field name="model">spp.simulation.scenario</field>
        <field name="arch" type="xml">
            <search string="Search Scenarios">
                <field name="name"/>
                <field name="category"/>
                <field name="target_type"/>
                <field name="program_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Ready" name="ready" domain="[('state', '=', 'ready')]"/>
                <filter string="Archived" name="archived" domain="[('state', '=', 'archived')]"/>
                <separator/>
                <filter string="Category" name="group_by_category" context="{'group_by': 'category'}"/>
                <filter string="Target Type" name="group_by_target" context="{'group_by': 'target_type'}"/>
                <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- Scenario Action -->
    <record id="action_simulation_scenario" model="ir.actions.act_window">
        <field name="name">Simulation Scenarios</field>
        <field name="res_model">spp.simulation.scenario</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_simulation_scenario_search"/>
        <field name="path">simulation-scenarios</field>
        <field name="context">{"search_default_ready": 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first simulation scenario
            </p>
            <p>
                Define targeting criteria and simulate their impact before committing.
            </p>
        </field>
    </record>
</odoo>
