<?xml version="1.0" encoding="utf-8" ?>
<!--
    Demo Variables for MIS Demo V2

    Most CEL variables are already defined in spp_studio's standard_variables.xml.
    This file defines demo-specific additions only.

    From spp_studio (referenced, not redefined):
    - poverty_line, retirement_age, child_age_limit (eligibility thresholds)
    - hh_size, child_count, elderly_count (household aggregates)

    Demo-specific constants (defined here):
    - vulnerability_threshold (emergency program threshold)
    - Benefit amounts (base_child_grant, disability_grant_*, emergency_tier_*)

    Demo-specific aggregates (defined here):
    - disabled_count (members with disability status)
-->
<odoo noupdate="1">
    <!-- ═══════════════════════════════════════════════════════════════════════
             CATEGORY
             ═══════════════════════════════════════════════════════════════════════ -->

    <record id="var_category_demo" model="spp.cel.variable.category">
        <field name="name">Demo Variables</field>
        <field name="code">demo</field>
        <field name="sequence">100</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
             CONSTANTS - Eligibility Thresholds
             ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Vulnerability threshold for emergency programs -->
    <record id="var_vulnerability_threshold" model="spp.cel.variable">
        <field name="name">vulnerability_threshold</field>
        <field name="cel_accessor">vulnerability_threshold</field>
        <field name="source_type">constant</field>
        <field name="value_type">number</field>
        <field name="default_value">70</field>
        <field name="category_id" ref="var_category_demo" />
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
             CONSTANTS - Benefit Amounts
             ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Child Support: Per-child grant amount -->
    <record id="var_base_child_grant" model="spp.cel.variable">
        <field name="name">base_child_grant</field>
        <field name="cel_accessor">base_child_grant</field>
        <field name="source_type">constant</field>
        <field name="value_type">number</field>
        <field name="default_value">50</field>
        <field name="category_id" ref="var_category_demo" />
    </record>

    <!-- Benefit Amounts - Disability -->
    <record id="var_disability_grant_base" model="spp.cel.variable">
        <field name="name">disability_grant_base</field>
        <field name="cel_accessor">disability_grant_base</field>
        <field name="source_type">constant</field>
        <field name="value_type">number</field>
        <field name="default_value">100</field>
        <field name="category_id" ref="var_category_demo" />
    </record>

    <record id="var_disability_grant_per_member" model="spp.cel.variable">
        <field name="name">disability_grant_per_member</field>
        <field name="cel_accessor">disability_grant_per_member</field>
        <field name="source_type">constant</field>
        <field name="value_type">number</field>
        <field name="default_value">75</field>
        <field name="category_id" ref="var_category_demo" />
    </record>

    <!-- Benefit Amounts - Emergency (Tiered) -->
    <record id="var_emergency_tier_1" model="spp.cel.variable">
        <field name="name">emergency_tier_1</field>
        <field name="cel_accessor">emergency_tier_1</field>
        <field name="source_type">constant</field>
        <field name="value_type">number</field>
        <field name="default_value">500</field>
        <field name="category_id" ref="var_category_demo" />
    </record>

    <record id="var_emergency_tier_2" model="spp.cel.variable">
        <field name="name">emergency_tier_2</field>
        <field name="cel_accessor">emergency_tier_2</field>
        <field name="source_type">constant</field>
        <field name="value_type">number</field>
        <field name="default_value">400</field>
        <field name="category_id" ref="var_category_demo" />
    </record>

    <record id="var_emergency_tier_3" model="spp.cel.variable">
        <field name="name">emergency_tier_3</field>
        <field name="cel_accessor">emergency_tier_3</field>
        <field name="source_type">constant</field>
        <field name="value_type">number</field>
        <field name="default_value">300</field>
        <field name="category_id" ref="var_category_demo" />
    </record>

    <!-- Benefit Amounts - Fixed Programs -->
    <record id="var_elderly_pension_amount" model="spp.cel.variable">
        <field name="name">elderly_pension_amount</field>
        <field name="cel_accessor">elderly_pension_amount</field>
        <field name="source_type">constant</field>
        <field name="value_type">number</field>
        <field name="default_value">100</field>
        <field name="category_id" ref="var_category_demo" />
    </record>

    <record id="var_cash_transfer_amount" model="spp.cel.variable">
        <field name="name">cash_transfer_amount</field>
        <field name="cel_accessor">cash_transfer_amount</field>
        <field name="source_type">constant</field>
        <field name="value_type">number</field>
        <field name="default_value">150</field>
        <field name="category_id" ref="var_category_demo" />
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
             AGGREGATE VARIABLES - Demo-Specific

             Note: Core aggregate variables (hh_size, child_count, elderly_count)
             are already defined in spp_studio/data/standard_variables.xml.
             Only define demo-specific aggregates here.
             ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Disabled member count: Members with is_person_with_disability flag -->
    <record id="var_disabled_count" model="spp.cel.variable">
        <field name="name">disabled_count</field>
        <field name="cel_accessor">disabled_count</field>
        <field name="source_type">aggregate</field>
        <field name="value_type">number</field>
        <field name="aggregate_type">count</field>
        <field name="aggregate_filter">m.is_person_with_disability</field>
        <field name="category_id" ref="var_category_demo" />
        <field name="cache_strategy">ttl</field>
        <field name="cache_ttl_seconds">86400</field>
    </record>
</odoo>
