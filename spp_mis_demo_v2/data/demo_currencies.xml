<?xml version="1.0" encoding="utf-8"?>
<!--
    Demo Currencies for SP-MIS Demo V2

    Activates specific currencies needed for demo/testing scenarios.
    This ensures that regional currencies like Philippine Peso are available
    for testing financial workflows.
-->
<odoo>
    <data noupdate="0">

        <!-- Activate Philippine Peso (PHP) using function call -->
        <function model="res.currency" name="write">
            <value eval="[ref('base.PHP')]"/>
            <value eval="{'active': True}"/>
        </function>

    </data>
</odoo>
