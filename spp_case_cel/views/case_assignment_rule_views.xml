<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_case_assignment_rule_tree" model="ir.ui.view">
        <field name="name">spp.case.assignment.rule.tree</field>
        <field name="model">spp.case.assignment.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="assign_team_id" />
                <field name="assign_worker_id" />
                <field name="is_consider_workload" />
                <field name="match_count" />
                <field name="active" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_case_assignment_rule_form" model="ir.ui.view">
        <field name="name">spp.case.assignment.rule.form</field>
        <field name="model">spp.case.assignment.rule</field>
        <field name="arch" type="xml">
            <form string="Assignment Rule">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="Rule Name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence" />
                            <field name="active" invisible="1" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group>
                            <field name="match_count" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Condition" name="condition">
                            <separator string="CEL Condition" />
                            <field
                                name="condition_cel"
                                nolabel="1"
                                widget="ace"
                                options="{'mode': 'text'}"
                                placeholder="Enter CEL expression (e.g., case.intensity_level == '3' || case_type.name == 'Emergency')"
                            />
                            <separator string="Available Variables" />
                            <div>
                                <ul>
                                    <li><b
                                    >case</b> - The full case record (spp.case). Example: <code
                                    >case.opened_date > "2026-01-01"</code></li>
                                    <li><b
                                    >case_type</b> - Case type record (spp.case.type via case.case_type_id). Example: <code
                                    >case_type.code == "EMG"</code></li>
                                    <li><b
                                    >intensity</b> - Intensity level (selection: "1" = Low, "2" = Medium, "3" = High). Example: <code
                                    >intensity == "3"</code></li>
                                    <li><b
                                    >priority</b> - Case priority (selection: "low", "medium", "high", "urgent"). Example: <code
                                    >priority == "urgent"</code></li>
                                    <li><b
                                    >client</b> - The beneficiary/client (res.partner via case.partner_id). Example: <code
                                    >client.name == "Maria Santos"</code></li>
                                    <li><b
                                    >client_type</b> - Type of client (selection: "individual", "household", "group"). Example: <code
                                    >client_type == "household"</code></li>
                                    <li><b
                                    >intake_source</b> - How the case was received (selection: "walk_in", "referral", "outreach", "grm", "program", "other"). Example: <code
                                    >intake_source == "grm"</code></li>
                                </ul>
                            </div>
                            <separator string="Common Patterns" />
                            <div>
                                <ul>
                                    <li>Assign urgent cases: <code
                                    >priority == "urgent" || intensity == "3"</code></li>
                                    <li>Assign GRM escalations to specific team: <code
                                    >intake_source == "grm" &amp;&amp; intensity == "2"</code></li>
                                    <li>Assign all low-intensity cases: <code
                                    >intensity == "1"</code></li>
                                </ul>
                            </div>
                        </page>
                        <page string="Assignment" name="assignment">
                            <group col="2">
                                <group string="Team Assignment">
                                    <field name="assign_team_id" />
                                    <field name="assign_supervisor_id" />
                                </group>
                                <group string="Worker Assignment">
                                    <field name="assign_worker_id" />
                                </group>
                            </group>
                            <group string="Workload Balancing">
                                <field name="is_consider_workload" />
                                <field
                                    name="max_cases_per_worker"
                                    invisible="not is_consider_workload"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_case_assignment_rule" model="ir.actions.act_window">
        <field name="name">Assignment Rules</field>
        <field name="res_model">spp.case.assignment.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first assignment rule
            </p>
            <p>
                Assignment rules automatically assign cases to workers or teams
                based on CEL expressions and workload balancing.
            </p>
        </field>
    </record>
</odoo>
