<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_spp_dci_crvs_event_tree" model="ir.ui.view">
        <field name="name">spp.dci.crvs.event.tree</field>
        <field name="model">spp.dci.crvs.event</field>
        <field name="arch" type="xml">
            <list
                decoration-info="state == 'received'"
                decoration-warning="state == 'processing'"
                decoration-success="state == 'processed'"
                decoration-danger="state == 'error'"
            >
                <field name="name" />
                <field name="event_type" />
                <field name="person_id" />
                <field name="identifier_type" />
                <field name="identifier_value" />
                <field name="event_date" />
                <field name="received_date" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'received'"
                    decoration-warning="state == 'processing'"
                    decoration-success="state == 'processed'"
                    decoration-danger="state == 'error'"
                />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_spp_dci_crvs_event_form" model="ir.ui.view">
        <field name="name">spp.dci.crvs.event.form</field>
        <field name="model">spp.dci.crvs.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="received,processing,processed"
                    />
                    <button
                        name="process_event"
                        string="Process Event"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'received'"
                    />
                    <button
                        name="action_retry_processing"
                        string="Retry Processing"
                        type="object"
                        class="btn-warning"
                        invisible="state != 'error'"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="toggle_active"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-archive"
                        >
                            <field
                                name="active"
                                widget="boolean_button"
                                options="{'terminology': 'archive'}"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_type" />
                            <field name="event_date" />
                            <field name="person_id" />
                        </group>
                        <group>
                            <field name="identifier_type" />
                            <field name="identifier_value" />
                            <field name="received_date" />
                        </group>
                    </group>
                    <group string="Processing Information">
                        <group>
                            <field name="processed_date" readonly="1" />
                            <field name="processed_by" readonly="1" />
                        </group>
                        <group>
                            <field
                                name="error_message"
                                widget="text"
                                invisible="state != 'error'"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Raw Data" name="raw_data">
                            <field
                                name="raw_data"
                                widget="ace"
                                options="{'mode': 'javascript'}"
                            />
                        </page>
                        <page string="Notes" name="notes">
                            <field
                                name="notes"
                                placeholder="Additional notes about this event..."
                            />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_spp_dci_crvs_event_search" model="ir.ui.view">
        <field name="name">spp.dci.crvs.event.search</field>
        <field name="model">spp.dci.crvs.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="person_id" />
                <field name="identifier_type" />
                <field name="identifier_value" />
                <filter
                    string="Received"
                    name="filter_received"
                    domain="[('state', '=', 'received')]"
                />
                <filter
                    string="Processing"
                    name="filter_processing"
                    domain="[('state', '=', 'processing')]"
                />
                <filter
                    string="Processed"
                    name="filter_processed"
                    domain="[('state', '=', 'processed')]"
                />
                <filter
                    string="Error"
                    name="filter_error"
                    domain="[('state', '=', 'error')]"
                />
                <separator />
                <filter
                    string="Birth"
                    name="filter_birth"
                    domain="[('event_type', '=', 'birth')]"
                />
                <filter
                    string="Death"
                    name="filter_death"
                    domain="[('event_type', '=', 'death')]"
                />
                <filter
                    string="Marriage"
                    name="filter_marriage"
                    domain="[('event_type', '=', 'marriage')]"
                />
                <filter
                    string="Divorce"
                    name="filter_divorce"
                    domain="[('event_type', '=', 'divorce')]"
                />
                <separator />
                <filter
                    string="Received Today"
                    name="filter_received_today"
                    domain="[('received_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('received_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"
                />
                <filter
                    string="Received This Week"
                    name="filter_received_week"
                    domain="[('received_date', '&gt;=', (context_today() - relativedelta(weeks=1)).strftime('%Y-%m-%d 00:00:00'))]"
                />
                <filter
                    string="Received This Month"
                    name="filter_received_month"
                    domain="[('received_date', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-%d 00:00:00'))]"
                />
                <separator />
                <filter
                    string="Active"
                    name="filter_active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Archived"
                    name="filter_archived"
                    domain="[('active', '=', False)]"
                />
                <separator />
                <filter
                    string="Event Type"
                    name="group_by_event_type"
                    context="{'group_by': 'event_type'}"
                />
                <filter
                    string="Status"
                    name="group_by_state"
                    context="{'group_by': 'state'}"
                />
                <filter
                    string="Person"
                    name="group_by_person"
                    context="{'group_by': 'person_id'}"
                />
                <filter
                    string="Received Date"
                    name="group_by_received_date"
                    context="{'group_by': 'received_date:month'}"
                />
                <filter
                    string="Event Date"
                    name="group_by_event_date"
                    context="{'group_by': 'event_date:month'}"
                />
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_spp_dci_crvs_event" model="ir.actions.act_window">
        <field name="name">CRVS Events</field>
        <field name="res_model">spp.dci.crvs.event</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No CRVS events received yet
            </p>
            <p>
                CRVS events (births, deaths, marriages, divorces) are received
                automatically from Civil Registration and Vital Statistics systems
                via webhook notifications.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem
        id="menu_spp_dci_crvs_event"
        name="CRVS Events"
        parent="spp_dci_client.menu_spp_dci_activity"
        action="action_spp_dci_crvs_event"
        sequence="10"
    />
</odoo>
