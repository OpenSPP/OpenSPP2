<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_spp_dci_crvs_sender_tree" model="ir.ui.view">
        <field name="name">spp.dci.crvs.sender.tree</field>
        <field name="model">spp.dci.crvs.sender</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="sender_id" />
                <field name="algorithm" />
                <field name="last_key_fetch" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_spp_dci_crvs_sender_form" model="ir.ui.view">
        <field name="name">spp.dci.crvs.sender.form</field>
        <field name="model">spp.dci.crvs.sender</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_fetch_public_key"
                        string="Fetch Public Key"
                        type="object"
                        class="btn-primary"
                        help="Fetch public key from JWKS endpoint"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="toggle_active"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-archive"
                        >
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="CRVS Registry Name" />
                        </h1>
                    </div>

                    <!-- DCI Protocol Settings -->
                    <group string="DCI Protocol Settings">
                        <group>
                            <field name="sender_id" help="DCI sender identifier for CRVS registry (e.g., 'crvs.national.gov')" />
                            <field name="algorithm" help="Cryptographic signature algorithm" />
                        </group>
                        <group>
                            <field name="jwks_url" widget="url" help="URL to CRVS registry's JWKS endpoint (/.well-known/jwks.json)" />
                            <field name="last_key_fetch" readonly="1" help="When we last fetched their JWKS" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Public Key" name="public_key">
                            <field name="public_key" widget="ace" options="{'mode': 'text'}" placeholder="PEM-encoded public key for signature verification" />
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes about this CRVS registry..." />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_spp_dci_crvs_sender_search" model="ir.ui.view">
        <field name="name">spp.dci.crvs.sender.search</field>
        <field name="model">spp.dci.crvs.sender</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="sender_id" />
                <separator />
                <filter
                    string="Active"
                    name="filter_active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Inactive"
                    name="filter_inactive"
                    domain="[('active', '=', False)]"
                />
                <separator />
                <filter
                    string="Ed25519"
                    name="filter_ed25519"
                    domain="[('algorithm', '=', 'ed25519')]"
                />
                <filter
                    string="RSA-256"
                    name="filter_rs256"
                    domain="[('algorithm', '=', 'rs256')]"
                />
                <separator />
                <filter
                    string="Algorithm"
                    name="group_by_algorithm"
                    context="{'group_by': 'algorithm'}"
                />
                <filter
                    string="Active Status"
                    name="group_by_active"
                    context="{'group_by': 'active'}"
                />
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_spp_dci_crvs_sender" model="ir.actions.act_window">
        <field name="name">CRVS Sender Registry</field>
        <field name="res_model">spp.dci.crvs.sender</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new CRVS Sender Registry Entry
            </p>
            <p>
                Configure trusted CRVS registries and their public keys for signature verification.
                Public keys can be fetched automatically from CRVS JWKS endpoints.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem
        id="menu_spp_dci_crvs_sender"
        name="CRVS Sender Registry"
        parent="spp_dci_client.menu_spp_dci_config"
        action="action_spp_dci_crvs_sender"
        sequence="25"
    />
</odoo>
