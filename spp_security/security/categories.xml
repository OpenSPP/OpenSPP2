        <field name="sequence">110</field>
    </record>

    <!-- API Domain Category -->
    <record id="category_spp_api" model="ir.module.category">
        <field name="name">API Access</field>
        <field name="description">API and external integration access</field>
        <field name="parent_id" ref="category_spp" />
        <field name="sequence">120</field>
    </record>

    <!-- Audit Domain Category -->
    <record id="category_spp_audit" model="ir.module.category">
        <field name="name">Audit and Compliance</field>
        <field name="description">Audit logging and compliance management</field>
        <field name="parent_id" ref="category_spp" />
        <field name="sequence">130</field>
    </record>

    <!-- Graduation Domain Category -->
    <record id="category_spp_graduation" model="ir.module.category">
        <field name="name">Graduation</field>
        <field name="description">Graduation pathways and assessments</field>
        <field name="parent_id" ref="category_spp" />
        <field name="sequence">140</field>
    </record>

    <!-- Service Directory Domain Category -->
    <record id="category_spp_services" model="ir.module.category">
        <field name="name">Service Directory</field>
        <field name="description">Service provider and referral directory</field>
        <field name="parent_id" ref="category_spp" />
        <field name="sequence">150</field>
    </record>

    <!-- Session Tracking Domain Category -->
    <record id="category_spp_sessions" model="ir.module.category">
        <field name="name">Sessions</field>
        <field name="description">Session and attendance tracking</field>
        <field name="parent_id" ref="category_spp" />
        <field name="sequence">160</field>
    </record>
</odoo>
