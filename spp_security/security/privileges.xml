<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        OpenSPP Privileges (Odoo 19 res.groups.privilege)
        ==================================================
        Privileges define the permission levels shown in the user settings UI.
        They are organized by category and linked to security groups.

        IMPORTANT: Only the Admin privilege is defined here.
        Domain-specific privileges (Registry, Programs, GRM, etc.) are defined
        in their respective modules and only exist when those modules are installed.

        This ensures clean separation: if you only install Registry, you only
        see Registry privileges. If you install Programs too, Programs privileges
        appear automatically.
    -->

    <!-- Admin Privilege - Always available -->
    <record id="privilege_spp_admin" model="res.groups.privilege">
        <field name="name">Administrator</field>
        <field name="category_id" ref="category_spp_admin" />
        <field name="sequence">1</field>
    </record>

    <!-- Restricted Access Privilege - Utility group for self-only access -->
    <record id="privilege_access_restrict_self_officer" model="res.groups.privilege">
        <field name="name">Restricted: Self Only (Officer)</field>
        <field name="category_id" ref="category_spp_admin" />
        <field name="sequence">10</field>
    </record>

    <!--
        Template for domain modules to follow:
        =====================================
        Each domain module should define its own privileges in its security/ folder.

        Example for spp_registry_base/security/privileges.xml:

        <record id="privilege_registry_viewer" model="res.groups.privilege">
            <field name="name">Viewer</field>
            <field name="category_id" ref="spp_security.category_spp_registry"/>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_registry_officer" model="res.groups.privilege">
            <field name="name">Officer</field>
            <field name="category_id" ref="spp_security.category_spp_registry"/>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_registry_manager" model="res.groups.privilege">
            <field name="name">Manager</field>
            <field name="category_id" ref="spp_security.category_spp_registry"/>
            <field name="sequence">30</field>
        </record>
    -->
</odoo>
