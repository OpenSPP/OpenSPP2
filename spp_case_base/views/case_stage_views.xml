<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Case Stage Form View -->
    <record id="view_case_stage_form" model="ir.ui.view">
        <field name="name">spp.case.stage.form</field>
        <field name="model">spp.case.stage</field>
        <field name="arch" type="xml">
            <form string="Case Stage">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group name="basic">
                            <field name="name" required="1" />
                            <field name="sequence" />
                            <field name="phase" required="1" />
                            <field name="active" />
                        </group>
                        <group name="display">
                            <field name="color" />
                            <field name="fold" />
                            <field name="case_count" />
                        </group>
                    </group>
                    <group string="Stage Requirements">
                        <group>
                            <field name="is_closed" />
                            <field name="is_requires_plan" />
                            <field name="is_requires_assessment" />
                        </group>
                        <group>
                            <field name="is_requires_approval" />
                            <field name="min_intensity" />
                        </group>
                    </group>
                    <separator string="Description" />
                    <field
                        name="description"
                        nolabel="1"
                        placeholder="Stage description..."
                        class="oe_inline"
                    />
                </sheet>
            </form>
        </field>
    </record>

    <!-- Case Stage Tree View -->
    <record id="view_case_stage_tree" model="ir.ui.view">
        <field name="name">spp.case.stage.tree</field>
        <field name="model">spp.case.stage</field>
        <field name="arch" type="xml">
            <list string="Case Stages" default_order="sequence,name" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="phase" />
                <field name="is_closed" string="Closed" widget="boolean_toggle" />
                <field
                    name="is_requires_plan"
                    string="Requires Plan"
                    widget="boolean_toggle"
                />
                <field name="is_requires_assessment" string="Requires Assessment" />
                <field name="min_intensity" />
                <field name="case_count" />
                <field name="fold" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <!-- Case Stage Search View -->
    <record id="view_case_stage_search" model="ir.ui.view">
        <field name="name">spp.case.stage.search</field>
        <field name="model">spp.case.stage</field>
        <field name="arch" type="xml">
            <search string="Search Case Stages">
                <field name="name" />
                <filter
                    string="Archived"
                    name="archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <!-- Case Stage Action -->
    <record id="action_case_stage" model="ir.actions.act_window">
        <field name="name">Case Stages</field>
        <field name="path">case-stages</field>
        <field name="res_model">spp.case.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new case stage
            </p>
            <p>
                Stages represent the workflow steps in your case management process.
                Define stages for intake, assessment, planning, implementation, monitoring, and closure.
            </p>
        </field>
    </record>
</odoo>
