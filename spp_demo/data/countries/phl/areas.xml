<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">
    <!-- Philippines Curated Demo Areas
         Focused on NCR (Metro Manila) and CALABARZON (Region IV-A)
         Based on Philippine Standard Geographic Code (PSGC)

         Demo data: noupdate="0" means it will be recreated on module reinstall
    -->

    <!-- ========== REGIONS ========== -->
    <record id="area_phl_ncr" model="spp.area">
        <field name="draft_name">National Capital Region</field>
        <field name="code">PH-00</field>
        <field name="area_type_id" ref="area_kind_phl_region" />
    </record>

    <record id="area_phl_calabarzon" model="spp.area">
        <field name="draft_name">CALABARZON</field>
        <field name="code">PH-40</field>
        <field name="area_type_id" ref="area_kind_phl_region" />
    </record>

    <!-- ========== PROVINCES (NCR is special - no provinces, cities are direct) ========== -->
    <!-- For NCR, we use "Metro Manila" as a logical province grouping -->
    <record id="area_phl_metro_manila" model="spp.area">
        <field name="draft_name">Metro Manila</field>
        <field name="code">PH-00-MM</field>
        <field name="parent_id" ref="area_phl_ncr" />
        <field name="area_type_id" ref="area_kind_phl_province" />
    </record>

