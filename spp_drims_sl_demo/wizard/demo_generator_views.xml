<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Demo Generator Wizard Form -->
    <record id="view_drims_demo_generator_form" model="ir.ui.view">
        <field name="name">spp.drims.demo.generator.form</field>
        <field name="model">spp.drims.demo.generator</field>
        <field name="arch" type="xml">
            <form string="Load DRIMS Demo Data">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <p><strong>This will load comprehensive DRIMS demo data:</strong></p>
                        <ul>
                            <li>Sri Lanka admin boundaries (9 Provinces, 25 Districts, DS/GN Divisions)</li>
                            <li>3 disaster incidents (Monsoon Floods, Landslides, Drought)</li>
                            <li>Donations from UN agencies and NGOs</li>
                            <li>Relief requests at various approval stages</li>
                            <li>Warehouse stock with lot tracking</li>
                            <li>Deployed personnel across incidents</li>
                            <li>Alert triggers and completed dispatches</li>
                        </ul>
                    </div>
                </sheet>
                <footer>
                    <button name="action_generate"
                            string="Load Demo Data"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Demo Generator Action -->
    <record id="action_drims_demo_generator" model="ir.actions.act_window">
        <field name="name">Load DRIMS Demo</field>
        <field name="res_model">spp.drims.demo.generator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Parent menu for Demo Data (under Settings) -->
    <menuitem id="menu_demo_data_root"
              name="Demo Data"
              parent="base.menu_administration"
              sequence="100"
              groups="base.group_system"/>

    <!-- Menu Item (under Settings > Demo Data) -->
    <menuitem id="menu_drims_demo_generator"
              name="Load DRIMS Demo"
              parent="menu_demo_data_root"
              action="action_drims_demo_generator"
              sequence="10"/>
</odoo>
