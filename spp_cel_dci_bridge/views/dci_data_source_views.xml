<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        Surface the bridge's `vendor` discriminator on the upstream
        spp.dci.data.source form so operators can set the adapter
        without having to use developer mode or psql.

        Anchor: under the "Authentication" group, since vendor selection
        sits naturally alongside auth_type as a "which adapter does the
        bridge use" decision.
    -->
    <record id="view_spp_dci_data_source_form_inherit_vendor" model="ir.ui.view">
        <field name="name">spp.dci.data.source.form.inherit.vendor</field>
        <field name="model">spp.dci.data.source</field>
        <field
            name="inherit_id"
            ref="spp_dci_client.view_spp_dci_data_source_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='auth_type']" position="after">
                <field name="vendor" />
            </xpath>
        </field>
    </record>

    <record id="view_spp_dci_data_source_tree_inherit_vendor" model="ir.ui.view">
        <field name="name">spp.dci.data.source.tree.inherit.vendor</field>
        <field name="model">spp.dci.data.source</field>
        <field
            name="inherit_id"
            ref="spp_dci_client.view_spp_dci_data_source_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='registry_type']" position="after">
                <field name="vendor" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
