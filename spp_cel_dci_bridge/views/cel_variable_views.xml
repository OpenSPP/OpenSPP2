<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_cel_variable_form_dci" model="ir.ui.view">
        <field name="name">spp.cel.variable.form.dci</field>
        <field name="model">spp.cel.variable</field>
        <field name="inherit_id" ref="spp_studio.view_logic_variable_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='external_provider_id']" position="after">
                <!--
                    Related field is invisible by itself; it exists to gate
                    the two fields below. Without this, dci_attribute_path
                    and external_failure_policy show for any external
                    provider, including non-DCI REST/scoring providers
                    where they have no meaning.
                -->
                <field name="external_provider_is_dci_backed" invisible="1" />
                <field
                    name="dci_attribute_path"
                    invisible="source_type != 'external' or not external_provider_id or not external_provider_is_dci_backed"
                    required="external_provider_is_dci_backed and source_type == 'external'"
                    placeholder="e.g., has_disability, severity.code, functional_scores.cognition"
                    help="Dotted path into the DCI response payload. Required when the provider is DCI-backed."
                />
                <field
                    name="external_failure_policy"
                    invisible="source_type != 'external' or not external_provider_id or not external_provider_is_dci_backed"
                    help="Behaviour when the external DCI fetch fails for a subject."
                />
            </xpath>
        </field>
    </record>

</odoo>
