    <record id="vocab_livestock" model="spp.vocabulary">
        <field name="name">Livestock Classification (FAO)</field>
        <field name="namespace_uri">urn:fao:livestock:2020</field>
        <field name="version">2020</field>
        <field name="is_system">True</field>
        <field name="is_hierarchical">True</field>
        <field name="domain">agriculture</field>
        <field name="description">FAO livestock classification based on World Census of Agriculture 2020</field>
        <field name="reference_url">https://www.fao.org/world-census-agriculture/</field>
    </record>

    <!-- Group 1: Cattle -->
    <record id="code_livestock_1" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_livestock"/>
        <field name="code">1</field>
        <field name="display">Cattle</field>
        <field name="definition">Cattle (Bos taurus and Bos indicus)</field>
        <field name="sequence">1</field>
    </record>

