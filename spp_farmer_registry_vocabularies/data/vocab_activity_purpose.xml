<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="vocab_activity_purpose" model="spp.vocabulary">
        <field name="name">Activity Purpose</field>
        <field name="namespace_uri">urn:openspp:vocab:activity-purpose</field>
        <field name="is_system">True</field>
        <field name="domain">agriculture</field>
        <field
            name="description"
        >Purpose of agricultural activity (subsistence, commercial, or both)</field>
    </record>

    <record id="code_activity_purpose_subsistence" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_activity_purpose" />
        <field name="code">subsistence</field>
        <field name="display">Subsistence</field>
        <field name="definition">Production primarily for own consumption</field>
        <field name="sequence">1</field>
    </record>

    <record id="code_activity_purpose_commercial" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_activity_purpose" />
        <field name="code">commercial</field>
        <field name="display">Commercial</field>
        <field name="definition">Production primarily for sale in market</field>
        <field name="sequence">2</field>
    </record>

    <record id="code_activity_purpose_both" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_activity_purpose" />
        <field name="code">both</field>
        <field name="display">Both</field>
        <field
            name="definition"
        >Production for both own consumption and commercial sale</field>
        <field name="sequence">3</field>
    </record>
</odoo>
