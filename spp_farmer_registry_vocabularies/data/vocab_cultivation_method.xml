<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="vocab_cultivation_method" model="spp.vocabulary">
        <field name="name">Cultivation Method</field>
        <field name="namespace_uri">urn:openspp:vocab:cultivation-method</field>
        <field name="is_system">True</field>
        <field name="domain">agriculture</field>
        <field
            name="description"
        >Method of crop cultivation based on water source</field>
    </record>

    <record id="code_cultivation_method_irrigated" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_cultivation_method" />
        <field name="code">irrigated</field>
        <field name="display">Irrigated</field>
        <field name="definition">Crops cultivated with irrigation systems</field>
        <field name="sequence">1</field>
    </record>

    <record id="code_cultivation_method_rainfed" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_cultivation_method" />
        <field name="code">rainfed</field>
        <field name="display">Rainfed</field>
        <field name="definition">Crops cultivated relying on rainfall only</field>
        <field name="sequence">2</field>
    </record>
</odoo>
