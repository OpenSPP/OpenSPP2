<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- FAO ASFIS (Aquatic Sciences and Fisheries Information System) Species List -->
    <record id="vocab_aquaculture" model="spp.vocabulary">
        <field name="name">Aquaculture Species (FAO ASFIS)</field>
        <field name="namespace_uri">urn:fao:asfis:2024</field>
        <field name="version">2024</field>
        <field name="is_system">True</field>
        <field name="is_hierarchical">False</field>
        <field name="domain">agriculture</field>
        <field
            name="description"
        >FAO ASFIS aquaculture species classification with 3-alpha codes</field>
        <field
            name="reference_url"
        >https://www.fao.org/fishery/collection/asfis/en</field>
    </record>

    <!-- Common finfish species -->
    <record id="code_aqua_til" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_aquaculture" />
        <field name="code">TIL</field>
        <field name="display">Nile tilapia</field>
        <field name="definition">Oreochromis niloticus</field>
        <field name="reference_uri">http://aims.fao.org/aos/agrovoc/c_32720</field>
        <field name="sequence">1</field>
    </record>

