        <field name="is_template">True</field>
        <field name="is_locked">False</field>
        <field name="state">active</field>
        <field name="sequence">30</field>
    </record> -->

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- GROUP/HOUSEHOLD FILTER TEMPLATES                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->

    <record id="filter_large_households" model="spp.cel.expression">
        <field name="name">Large Households (4+ members)</field>
        <field name="code">large_households_4</field>
        <field name="expression_type">filter</field>
        <field name="context_type">group</field>
        <field name="output_type">boolean</field>
        <field name="cel_expression">hh_size >= 4</field>
        <field name="category_id" ref="category_eligibility" />
        <field name="is_template">True</field>
        <field name="is_locked">False</field>
        <field name="state">active</field>
        <field name="sequence">40</field>
    </record>

    <!-- <record id="filter_woman_headed" model="spp.cel.expression">
        <field name="name">Woman-Headed Household</field>
        <field name="code">woman_headed_household</field>
        <field name="expression_type">filter</field>
        <field name="context_type">group</field>
        <field name="output_type">boolean</field>
        <field name="cel_expression">r.is_woman_headed == true</field>
        <field name="category_id" ref="category_eligibility" />
        <field name="is_template">True</field>
        <field name="is_locked">False</field>
        <field name="state">active</field>
        <field name="sequence">45</field>
    </record> -->

    <record id="filter_has_children_under_5" model="spp.cel.expression">
        <field name="name">Households with Children Under 5</field>
        <field name="code">has_children_under_5</field>
        <field name="expression_type">filter</field>
        <field name="context_type">group</field>
        <field name="output_type">boolean</field>
        <field name="cel_expression">count(m, age_years(m.birthdate) &lt; 5) > 0</field>
        <field name="category_id" ref="category_eligibility" />
        <field name="is_template">True</field>
        <field name="is_locked">False</field>
        <field name="state">active</field>
        <field name="sequence">50</field>
    </record>

    <record id="filter_has_elderly_members" model="spp.cel.expression">
        <field name="name">Households with Elderly Members (60+)</field>
        <field name="code">has_elderly_members</field>
        <field name="expression_type">filter</field>
        <field name="context_type">group</field>
        <field name="output_type">boolean</field>
        <field name="cel_expression">count(m, age_years(m.birthdate) >= 60) > 0</field>
        <field name="category_id" ref="category_eligibility" />
        <field name="is_template">True</field>
        <field name="is_locked">False</field>
        <field name="state">active</field>
        <field name="sequence">55</field>
    </record>

