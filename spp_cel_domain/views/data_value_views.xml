<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================== -->
    <!-- Data Value (Cache) Views                       -->
    <!-- ============================================== -->

    <!-- Data Value Tree View -->
    <record id="view_data_value_tree" model="ir.ui.view">
        <field name="name">spp.data.value.tree</field>
        <field name="model">spp.data.value</field>
        <field name="arch" type="xml">
            <list string="Cached Values" default_order="recorded_at desc" create="0">
                <field name="variable_name"/>
                <field name="subject_ref" string="Subject"/>
                <field name="subject_id" optional="hide"/>
                <field name="subject_model" optional="hide"/>
                <field name="period_key"/>
                <field name="value_type" widget="badge"/>
                <field name="source_type" widget="badge"
                       decoration-info="source_type == 'external'"
                       decoration-success="source_type == 'scoring'"
                       optional="show"/>
                <field name="value_json" widget="json" optional="show"/>
                <field name="provider" optional="hide"/>
                <field name="expires_at" widget="remaining_days"
                       decoration-danger="is_stale"
                       optional="show"/>
                <field name="is_stale" widget="boolean"
                       decoration-danger="is_stale"
                       optional="hide"/>
                <field name="recorded_at" string="Recorded"/>
            </list>
        </field>
    </record>

    <!-- Data Value Form View -->
    <record id="view_data_value_form" model="ir.ui.view">
        <field name="name">spp.data.value.form</field>
        <field name="model">spp.data.value</field>
        <field name="arch" type="xml">
            <form string="Cached Value" create="0">
                <sheet>
                    <widget name="web_ribbon" title="Stale" bg_color="text-bg-danger"
                            invisible="not is_stale"/>
                    <widget name="web_ribbon" title="Invalidated" bg_color="text-bg-warning"
                            invisible="not invalidated_at"/>

                    <group>
                        <group string="Variable">
                            <field name="variable_name"/>
                            <field name="variable_id" readonly="1"/>
                            <field name="value_type"/>
                            <field name="source_type"/>
                        </group>
                        <group string="Subject">
                            <field name="subject_model"/>
                            <field name="subject_id"/>
                            <field name="subject_ref" readonly="1"/>
                            <field name="period_key"/>
                            <field name="provider" invisible="not provider"/>
                        </group>
                    </group>

                    <group string="Value">
                        <field name="value_json" widget="json"/>
                        <field name="coverage" invisible="not coverage"/>
                        <field name="params_hash" invisible="not params_hash"/>
                    </group>

                    <group string="Cache Status">
                        <group>
                            <field name="as_of" invisible="not as_of"/>
                            <field name="expires_at"/>
                            <field name="is_stale" widget="boolean"/>
                        </group>
                        <group>
                            <field name="invalidated_at"/>
                            <field name="invalidated_by_id"/>
                        </group>
                    </group>

                    <group string="Error" invisible="not error_code">
                        <field name="error_code"/>
                        <field name="error_message"/>
                    </group>

                    <group string="Audit">
                        <group>
                            <field name="recorded_at"/>
                            <field name="created_by_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Data Value Search View -->
    <record id="view_data_value_search" model="ir.ui.view">
        <field name="name">spp.data.value.search</field>
        <field name="model">spp.data.value</field>
        <field name="arch" type="xml">
            <search string="Search Cached Values">
                <field name="variable_name"/>
                <field name="subject_id"/>
                <field name="period_key"/>
                <field name="provider"/>

                <separator/>
                <filter string="Valid" name="filter_valid"
                        domain="['|', ('expires_at', '=', False), ('expires_at', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Stale" name="filter_stale"
                        domain="[('is_stale', '=', True)]"/>
                <filter string="Invalidated" name="filter_invalidated"
                        domain="[('invalidated_at', '!=', False)]"/>

                <separator/>
                <filter string="Current Period" name="filter_current"
                        domain="[('period_key', '=', 'current')]"/>
                <filter string="Historical" name="filter_historical"
                        domain="[('period_key', '!=', 'current')]"/>

                <separator/>
                <filter string="External Data" name="filter_external"
                        domain="[('source_type', '=', 'external')]"/>
                <filter string="Scoring Results" name="filter_scoring"
                        domain="[('source_type', '=', 'scoring')]"/>
                <filter string="Aggregates" name="filter_aggregate"
                        domain="[('source_type', '=', 'aggregate')]"/>

                <group>
                    <filter string="Variable" name="group_variable"
                            context="{'group_by': 'variable_name'}"/>
                    <filter string="Period" name="group_period"
                            context="{'group_by': 'period_key'}"/>
                    <filter string="Source Type" name="group_source"
                            context="{'group_by': 'source_type'}"/>
                    <filter string="Provider" name="group_provider"
                            context="{'group_by': 'provider'}"/>
                    <filter string="Recorded" name="group_recorded"
                            context="{'group_by': 'recorded_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Data Value List (Cache Browser) -->
    <record id="action_data_value_list" model="ir.actions.act_window">
        <field name="name">Data Cache</field>
        <field name="path">data-cache</field>
        <field name="res_model">spp.data.value</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_valid': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No cached values found
            </p>
            <p>
                This view shows all cached variable values from the unified data cache.<br/>
                Values are automatically stored here when:
                <ul>
                    <li>External systems push data via API</li>
                    <li>Scoring calculations are performed</li>
                    <li>Variables with TTL caching are evaluated</li>
                </ul>
            </p>
        </field>
    </record>

</odoo>
