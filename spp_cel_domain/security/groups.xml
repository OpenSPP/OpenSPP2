<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Tier 3: Technical read access -->
    <record id="group_cel_domain_read" model="res.groups">
        <field name="name">CEL Domain: Read</field>
        <field
            name="comment"
        >Technical read access to CEL domain configurations.</field>
    </record>

    <!-- Tier 2: User-facing groups -->
    <record id="group_cel_domain_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_cel_domain" />
        <field name="implied_ids" eval="[Command.link(ref('group_cel_domain_read'))]" />
        <field
            name="comment"
        >Can view CEL domain query builder configurations including variables, expressions, and data cache.</field>
    </record>

    <record id="group_cel_domain_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_cel_domain" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_cel_domain_viewer'))]"
        />
        <field
            name="comment"
        >Can manage CEL domain query builder configurations.</field>
    </record>

    <record id="group_cel_domain_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="privilege_id" ref="privilege_cel_domain" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_cel_domain_manager'))]"
        />
        <field
            name="comment"
        >Can manage credentials and sensitive configurations. Includes Manager permissions.</field>
    </record>

    <!-- Link admin to SPP admin -->
    <record id="spp_security.group_spp_admin" model="res.groups">
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_cel_domain_admin'))]"
        />
    </record>
</odoo>
