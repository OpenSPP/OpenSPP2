<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Extend Graduation Assessment Form to show case link -->
    <record id="view_graduation_assessment_form_case" model="ir.ui.view">
        <field name="name">spp.graduation.assessment.form.case</field>
        <field name="model">spp.graduation.assessment</field>
        <field name="inherit_id" ref="spp_graduation.view_graduation_assessment_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="case_id" readonly="state in ('approved', 'rejected')" />
            </xpath>
        </field>
    </record>

    <!-- Extend Graduation Assessment List to show case -->
    <record id="view_graduation_assessment_list_case" model="ir.ui.view">
        <field name="name">spp.graduation.assessment.list.case</field>
        <field name="model">spp.graduation.assessment</field>
        <field name="inherit_id" ref="spp_graduation.view_graduation_assessment_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="case_id" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
