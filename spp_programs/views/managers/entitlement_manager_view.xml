<odoo>

    <!-- Entitlement Manager (wrapper) -->
    <record id="view_entitlement_manager_tree" model="ir.ui.view">
        <field name="name">view_entitlement_manager_tree</field>
        <field name="model">spp.program.entitlement.manager</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list>
                <field name="manager_ref_id" />
                <field name="program_id" />
            </list>
        </field>
    </record>

    <record id="view_entitlement_manager_form" model="ir.ui.view">
        <field name="name">view_entitlement_manager_form</field>
        <field name="model">spp.program.entitlement.manager</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Entitlement Manager">
                <sheet>
                    <group>
                        <field
                            name="manager_ref_id"
                            options="{'no_quick_create':True}"
                            colspan="4"
                            context="{'default_program_id':program_id}"
                        />
                        <field name="program_id" invisible="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Default Entitlement Manager (implementation) -->
    <record id="view_entitlement_manager_default_tree" model="ir.ui.view">
        <field name="name">view_entitlement_manager_default_tree</field>
        <field name="model">spp.program.entitlement.manager.default</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list sample="1">
                <field name="name" />
                <field name="program_id" />
                <field name="amount_per_cycle" />
                <field name="currency_id" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="view_entitlement_manager_default_form" model="ir.ui.view">
        <field name="name">view_entitlement_manager_default_form</field>
        <field name="model">spp.program.entitlement.manager.default</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Entitlement Manager Configuration">
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <div class="oe_title mb24">
                        <label for="name" string="Name:" />
                        <h1>
                            <field id="name" name="name" placeholder="Enter the Manager Name..." />
                        </h1>
                        <field name="program_id" invisible="1" />
                    </div>

                    <group string="Benefit Amounts" name="benefit_amounts">
                        <group>
                            <field name="currency_id" invisible="1" />
                            <field name="amount_per_cycle" string="Amount per Cycle" />
                            <field
                                name="amount_per_individual_in_group"
                                string="Amount per Person (in group)"
                            />
                            <field
                                name="max_individual_in_group"
                                string="Maximum people to count"
                                help="0 means no limit"
                            />
                        </group>
                        <group>
                            <field
                                name="id_type_id"
                                string="ID Type for Entitlements"
                                options="{'no_open':true,'no_create':true,'no_create_edit':true}"
                            />
                        </group>
                    </group>

                    <group string="Transfer Fees" name="transfer_fees">
                        <group>
                            <field name="transfer_fee_pct" string="Fee Percentage (%)" />
                        </group>
                        <group>
                            <field name="transfer_fee_amount" string="Fixed Fee Amount" />
                        </group>
                    </group>

                    <group string="Approval Settings" name="approval_settings">
                        <field
                            name="entitlement_validation_group_id"
                            string="Validation Group"
                            options="{'no_open':True,'no_create':True}"
                            invisible="1"
                        />
                        <field
                            name="approval_definition_id"
                            options="{'no_open':True,'no_create':True,'no_create_edit':True}"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="entitlement_manager_default_filter" model="ir.ui.view">
        <field name="name">entitlement_manager_default_filter</field>
        <field name="model">spp.program.entitlement.manager.default</field>
        <field name="priority" eval="1" />
        <field name="arch" type="xml">
            <search string="Search Entitlement Managers">
                <field name="name" />
                <field name="program_id" />
                <separator />
                <filter string="Program" name="grp_program_id" context="{'group_by': 'program_id'}" />
            </search>
        </field>
    </record>

    <record id="action_entitlement_manager_default" model="ir.actions.act_window">
        <field name="name">Entitlement Managers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="path">program-entitlement-managers</field>
        <field name="res_model">spp.program.entitlement.manager.default</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="entitlement_manager_default_filter" />
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add an Entitlement Manager!
            </p><p>
                Click the create button to enter a new entitlement manager.
            </p>
        </field>
    </record>

</odoo>
