<odoo>
    <!-- Eligibility Manager (wrapper) -->
    <record id="view_eligibility_manager_tree" model="ir.ui.view">
        <field name="name">view_eligibility_manager_tree</field>
        <field name="model">spp.eligibility.manager</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list>
                <field name="manager_ref_id" />
                <field name="program_id" />
            </list>
        </field>
    </record>

    <record id="view_eligibility_manager_form" model="ir.ui.view">
        <field name="name">view_eligibility_manager_form</field>
        <field name="model">spp.eligibility.manager</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Eligibility Manager">
                <sheet>
                    <group>
                        <field
                            name="manager_ref_id"
                            options="{'no_quick_create':True}"
                            colspan="4"
                            context="{'default_program_id':program_id}"
                        />
                        <field name="program_id" invisible="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Default Eligibility Manager (implementation) -->
    <record id="view_eligibility_manager_default_tree" model="ir.ui.view">
        <field name="name">view_eligibility_manager_default_tree</field>
        <field name="model">spp.program.membership.manager.default</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list sample="1">
                <field name="name" />
                <field name="program_id" />
            </list>
        </field>
    </record>

    <record id="view_eligibility_manager_default_form" model="ir.ui.view">
        <field name="name">view_eligibility_manager_default_form</field>
        <field name="model">spp.program.membership.manager.default</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Eligibility Manager Configuration">
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <div class="oe_title mb24">
                        <label for="name" string="Name:" />
                        <h1>
                            <field
                                id="name"
                                name="name"
                                placeholder="Enter the Manager Name..."
                            />
                        </h1>
                        <field name="program_id" invisible="1" />
                    </div>

                    <group
                        string="Geographic Targeting"
                        name="geographic_targeting"
                        colspan="4"
                        col="4"
                        invisible="1"
                    >
                        <field
                            name="admin_area_ids"
                            widget="many2many_tags"
                            colspan="4"
                            string="Target Areas"
                            placeholder="Select administrative areas..."
                        />
                    </group>

                    <group
                        string="Eligibility Criteria"
                        name="eligibility_criteria"
                        colspan="2"
                        col="1"
                    >
                        <field name="target_type" invisible="1" />
                        <field
                            name="eligibility_domain"
                            widget="domain"
                            options="{'model': 'res.partner'}"
                            string="Filter Criteria"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="eligibility_manager_default_filter" model="ir.ui.view">
        <field name="name">eligibility_manager_default_filter</field>
        <field name="model">spp.program.membership.manager.default</field>
        <field name="priority" eval="1" />
        <field name="arch" type="xml">
            <search string="Search Eligibility Managers">
                <field name="name" />
                <field name="program_id" />
                <separator />
                <filter
                    string="Program"
                    name="grp_program_id"
                    context="{'group_by': 'program_id'}"
                />
            </search>
        </field>
    </record>

    <record id="action_eligibility_manager_default" model="ir.actions.act_window">
        <field name="name">Eligibility Managers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="path">program-eligibility-managers</field>
        <field name="res_model">spp.program.membership.manager.default</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="eligibility_manager_default_filter" />
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add an Eligibility Manager!
            </p>
            <p>
                Click the create button to enter a new eligibility manager.
            </p>
        </field>
    </record>
</odoo>
