<odoo>
    <!-- ========================================== -->
    <!-- CYCLE LIST VIEW                            -->
    <!-- ========================================== -->
    <record id="view_cycle_tree" model="ir.ui.view">
        <field name="name">spp.cycle.list</field>
        <field name="model">spp.cycle</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <list sample="1" decoration-muted="state in ('ended', 'cancelled')">
                <field name="name" />
                <field name="program_id" optional="show" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="members_count" string="Beneficiaries" optional="show" />
                <field
                    name="entitlements_count"
                    string="Entitlements"
                    optional="show"
                />
                <field
                    name="state"
                    decoration-primary="state == 'draft'"
                    decoration-warning="state == 'to_approve'"
                    decoration-success="state in ('approved', 'distributed')"
                    decoration-danger="state in ('ended', 'cancelled')"
                    widget="badge"
                />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="hide"
                />
            </list>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- CYCLE SEARCH VIEW                          -->
    <!-- ========================================== -->
    <record id="view_cycle_search" model="ir.ui.view">
        <field name="name">spp.cycle.search</field>
        <field name="model">spp.cycle</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <search string="Search Cycles">
                <field name="name" />
                <field name="program_id" />
                <separator />
                <filter
                    string="Draft"
                    name="draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    string="To Approve"
                    name="to_approve"
                    domain="[('state', '=', 'to_approve')]"
                />
                <filter
                    string="Approved"
                    name="approved"
                    domain="[('state', '=', 'approved')]"
                />
                <filter
                    string="Distributed"
                    name="distributed"
                    domain="[('state', '=', 'distributed')]"
                />
                <filter
                    string="Ended"
                    name="ended"
                    domain="[('state', '=', 'ended')]"
                />
                <filter
                    string="Cancelled"
                    name="cancelled"
                    domain="[('state', '=', 'cancelled')]"
                />
                <separator />
                <filter
                    string="Current Period"
                    name="current"
                    domain="[('start_date', '&lt;=', context_today()), ('end_date', '&gt;=', context_today())]"
                />
                <filter
                    string="Past Cycles"
                    name="past"
                    domain="[('end_date', '&lt;', context_today())]"
                />
                <filter
                    string="Future Cycles"
                    name="future"
                    domain="[('start_date', '&gt;', context_today())]"
                />
                <separator />
                <filter
                    string="Program"
                    name="group_by_program"
                    context="{'group_by': 'program_id'}"
                />
                <filter
                    string="State"
                    name="group_by_state"
                    context="{'group_by': 'state'}"
                />
                <filter
                    string="Start Date"
                    name="group_by_start"
                    context="{'group_by': 'start_date:month'}"
                />
            </search>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- CYCLE FORM VIEW - Clean 4-Tab Structure    -->
    <!-- ========================================== -->
    <record id="view_cycle_form" model="ir.ui.view">
        <field name="name">spp.cycle.form</field>
        <field name="model">spp.cycle</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form string="Cycle">
                <header>
                    <!-- Workflow Buttons -->
                    <button
                        name="copy_beneficiaries_from_program"
                        type="object"
                        string="Copy Beneficiaries"
                        icon="fa-copy"
                        invisible="state != 'draft'"
                        groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_officer,spp_programs.group_programs_validator"
                    />
                    <button
                        name="action_prepare_entitlement"
                        type="object"
                        string="Prepare Entitlements"
                        icon="fa-list"
                        invisible="state not in ('draft', 'to_approve') or total_entitlements_count > 0"
                        groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_officer,spp_programs.group_programs_validator"
                    />
                    <button
                        name="action_submit_for_approval"
                        type="object"
                        string="Submit for Approval"
                        icon="fa-paper-plane"
                        class="btn-success"
                        invisible="state != 'draft' or total_entitlements_count == 0"
                        groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_officer,spp_programs.group_programs_validator"
                    />
                    <button
                        name="validate_entitlement"
                        type="object"
                        string="Approve Entitlements"
                        icon="fa-check"
                        invisible="state not in ('to_approve', 'approved') or not show_approve_entitlements_button or not has_sufficient_funds or not can_approve_entitlements"
                        groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_validator,spp_programs.group_programs_cycle_approver"
                    />
                    <button
                        name="reject_all_entitlements"
                        type="object"
                        string="Reject All Entitlements"
                        icon="fa-times"
                        class="btn-danger"
                        invisible="state not in ('to_approve', 'approved') or not show_approve_entitlements_button or not can_approve_entitlements"
                        groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_validator,spp_programs.group_programs_cycle_approver"
                    />
                    <button
                        name="action_approve"
                        type="object"
                        string="Approve Cycle"
                        icon="fa-thumbs-up"
                        class="btn-success"
                        invisible="state != 'to_approve' or (auto_approve_entitlements and not has_sufficient_funds) or not can_approve"
                        groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_cycle_approver"
                    />
                    <button
                        name="action_reject"
                        type="object"
                        string="Reject Cycle"
                        icon="fa-times"
                        class="btn-danger"
                        invisible="state != 'to_approve' or not can_reject"
                        groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_cycle_approver"
                    />
                    <button
                        name="prepare_payment"
                        type="object"
                        string="Prepare Payments"
                        icon="fa-credit-card"
                        invisible="state != 'approved' or show_approve_entitlements_button or not has_payment_manager"
                        groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_validator"
                    />
                    <button
                        name="send_payment"
                        type="object"
                        string="Send Payments"
                        icon="fa-paper-plane"
                        invisible="state != 'approved' or show_approve_entitlements_button or not has_payment_manager"
                        groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_validator"
                    />
                    <button
                        name="mark_distributed"
                        type="object"
                        string="Mark as Distributed"
                        icon="fa-check-circle"
                        invisible="state != 'approved' or not all_entitlements_approved"
                        groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_validator,spp_programs.group_programs_cycle_approver"
                    />
                    <button
                        name="mark_ended"
                        type="object"
                        string="End Cycle"
                        icon="fa-stop"
                        invisible="state not in ('approved', 'distributed')"
                        groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_validator"
                    />
                    <button
                        name="mark_cancelled"
                        type="object"
                        string="Cancel"
                        icon="fa-times"
                        invisible="state in ('ended', 'cancelled')"
                        groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_validator"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,to_approve,approved,distributed,ended"
                    />
                </header>

                <!-- Locked Warning -->
                <div
                    class="alert alert-warning text-center"
                    role="status"
                    invisible="not is_locked"
                >
                    <i
                    class="fa fa-spinner fa-spin"
                    title="Loading"
                /> Operation in progress:
                    <field name="locked_reason" class="fw-bold" />
                </div>

                <!-- Fund Availability Alert -->
                <div
                    class="alert alert-danger"
                    role="alert"
                    invisible="has_sufficient_funds or state not in ('to_approve', 'approved') or not fund_availability_message"
                >
                    <span>
                        <i class="fa fa-exclamation-triangle" title="Warning" />
                        <field
                            name="fund_availability_message"
                            nolabel="1"
                            style="display: inline; white-space: pre-line;"
                        />
                    </span>
                </div>

                <div
                    class="alert alert-success"
                    role="alert"
                    invisible="not has_sufficient_funds or state not in ('to_approve', 'approved') or not fund_availability_message"
                >
                    <span>
                        <i class="fa fa-check-circle" title="Success" />
                        <field
                            name="fund_availability_message"
                            nolabel="1"
                            style="display: inline; white-space: pre-line;"
                        />
                    </span>
                </div>

                <!-- Approval Waiting Message -->
                <div
                    class="alert alert-info text-center"
                    role="alert"
                    invisible="not show_approval_waiting_message"
                    style="margin: 0;"
                >
                    <field name="show_approval_waiting_message" invisible="1" />
                    <field name="approval_waiting_message" readonly="1" nolabel="1" />
                </div>

                <sheet>
                    <!-- Stat Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button
                            type="object"
                            class="oe_stat_button"
                            icon="fa-users"
                            name="open_members_form"
                        >
                            <field
                                name="members_count"
                                widget="statinfo"
                                string="Beneficiaries"
                            />
                        </button>
                        <button
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list"
                            name="open_entitlements_form"
                        >
                            <field
                                name="total_entitlements_count"
                                widget="statinfo"
                                string="Entitlements"
                            />
                        </button>
                        <button
                            type="object"
                            class="oe_stat_button"
                            icon="fa-credit-card"
                            name="open_payments_form"
                        >
                            <field
                                name="payments_count"
                                widget="statinfo"
                                string="Payments"
                            />
                        </button>
                    </div>

                    <!-- Ribbons -->
                    <widget
                        name="web_ribbon"
                        title="Cancelled"
                        bg_color="bg-danger"
                        invisible="state != 'cancelled'"
                    />
                    <widget
                        name="web_ribbon"
                        title="Ended"
                        bg_color="bg-secondary"
                        invisible="state != 'ended'"
                    />

                    <!-- Title Section -->
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                placeholder="Cycle Name"
                                required="1"
                                readonly="state not in ('draft', 'to_approve')"
                            />
                        </h1>
                    </div>

                    <!-- Hidden fields -->
                    <field name="is_locked" invisible="1" />
                    <field name="has_sufficient_funds" invisible="1" />
                    <field name="available_funds" invisible="1" />
                    <field name="required_funds" invisible="1" />
                    <field name="show_approve_entitlements_button" invisible="1" />
                    <field name="can_approve_entitlements" invisible="1" />
                    <field name="has_payment_manager" invisible="1" />
                    <field name="all_entitlements_approved" invisible="1" />
                    <field name="approval_state" invisible="1" />
                    <field name="can_submit" invisible="1" />
                    <field name="can_approve" invisible="1" />
                    <field name="can_reject" invisible="1" />

                    <!-- Main Content - 4 Tab Structure -->
                    <notebook name="cycle_tabs">
                        <!-- ==================== OVERVIEW TAB ==================== -->
                        <page name="overview" string="Overview">
                            <!-- Basic Info Section - 2 columns -->
                            <group name="basic_info_section" col="2">
                                <group name="cycle_info">
                                    <field
                                        name="program_id"
                                        options="{'no_open': True, 'no_create': True}"
                                        readonly="state not in ('draft',)"
                                    />
                                    <field name="sequence" readonly="1" />
                                    <field
                                        name="company_id"
                                        groups="base.group_multi_company"
                                        options="{'no_create': True}"
                                        readonly="state not in ('draft',)"
                                    />
                                </group>
                                <group name="period_info">
                                    <field
                                        name="start_date"
                                        readonly="state not in ('draft', 'to_approve')"
                                    />
                                    <field
                                        name="end_date"
                                        readonly="state not in ('draft', 'to_approve')"
                                    />
                                </group>
                            </group>

                            <!-- Financial Summary -->
                            <separator string="Financial Summary" />
                            <group name="financial_section" col="2">
                                <group>
                                    <field name="total_amount" readonly="1" />
                                    <field
                                        name="currency_id"
                                        options="{'no_open': True}"
                                        readonly="1"
                                    />
                                </group>
                                <group>
                                    <field name="total_amount_in_words" readonly="1" />
                                </group>
                            </group>

                            <!-- Extension point for additional overview content -->
                            <group name="additional_overview_section" invisible="1">
                                <!-- Additional fields injected by extending modules -->
                            </group>
                        </page>

                        <!-- ==================== CONFIGURATION TAB ==================== -->
                        <page
                            name="configuration"
                            string="Configuration"
                            groups="spp_security.group_spp_admin,spp_programs.group_programs_manager"
                        >
                            <group name="settings_section" col="2">
                                <group>
                                    <field
                                        name="auto_approve_entitlements"
                                        readonly="state not in ('draft', 'to_approve')"
                                    />
                                </group>
                                <group>
                                    <!-- Extension point for additional settings -->
                                </group>
                            </group>

                            <!-- Extension point for additional configuration -->
                            <group name="additional_config_section" invisible="1">
                                <!-- Additional config fields injected by other modules -->
                            </group>
                        </page>

                        <!-- ==================== APPROVAL TAB ==================== -->
                        <page name="approval_tracking" string="Approval">
                            <group string="Approval Status">
                                <group>
                                    <field
                                        name="cycle_approval_definition_id"
                                        readonly="1"
                                        string="Approval Definition"
                                    />
                                    <field
                                        name="approval_state"
                                        readonly="1"
                                        widget="badge"
                                        string="Approval Status"
                                        decoration-info="approval_state == 'draft'"
                                        decoration-warning="approval_state == 'pending'"
                                        decoration-success="approval_state == 'approved'"
                                        decoration-danger="approval_state == 'rejected'"
                                    />
                                </group>
                                <group>
                                    <field
                                        name="submitted_by_id"
                                        readonly="1"
                                        string="Submitted By"
                                    />
                                    <field
                                        name="submitted_date"
                                        readonly="1"
                                        string="Submitted On"
                                    />
                                </group>
                            </group>
                            <group
                                string="Approval Decision"
                                invisible="not approved_date and not rejected_date"
                            >
                                <group>
                                    <field name="approved_date" readonly="1" />
                                    <field name="approved_by" readonly="1" />
                                </group>
                                <group>
                                    <field
                                        name="rejected_by_id"
                                        readonly="1"
                                        string="Rejected By"
                                    />
                                    <field
                                        name="rejected_date"
                                        readonly="1"
                                        string="Rejected On"
                                    />
                                </group>
                            </group>
                            <group
                                string="Rejection Reason"
                                invisible="not rejection_reason"
                            >
                                <field
                                    name="rejection_reason"
                                    readonly="1"
                                    nolabel="1"
                                    colspan="2"
                                />
                            </group>
                            <group string="Approval History">
                                <field
                                    name="approval_review_ids"
                                    nolabel="1"
                                    readonly="1"
                                    colspan="2"
                                >
                                    <list>
                                        <field name="requested_date" />
                                        <field name="reviewer_id" />
                                        <field
                                            name="status"
                                            widget="badge"
                                            decoration-info="status == 'pending'"
                                            decoration-success="status == 'approved'"
                                            decoration-danger="status == 'rejected'"
                                        />
                                        <field name="review_date" />
                                        <field name="comment" />
                                    </list>
                                </field>
                            </group>
                        </page>

                        <!-- ==================== HISTORY TAB ==================== -->
                        <page name="history" string="History">
                            <!-- Audit Section - 2 columns -->
                            <separator string="Audit Information" />
                            <group name="audit_section" col="2">
                                <group>
                                    <field name="create_date" readonly="1" />
                                    <field name="create_uid" readonly="1" />
                                </group>
                                <group>
                                    <field name="write_date" readonly="1" />
                                    <field name="write_uid" readonly="1" />
                                </group>
                            </group>

                            <!-- Extension point for audit log -->
                            <div name="audit_log_section" invisible="1">
                                <!-- Audit log entries injected by spp_audit -->
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- ACTIONS AND MENUS                          -->
    <!-- ========================================== -->
    <record id="action_cycle_list" model="ir.actions.act_window">
        <field name="name">Cycles</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">spp.cycle</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cycle_search" />
        <field name="path">cycles</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No cycles found
            </p>
            <p>
                Cycles are created from a program. Go to Programs and create a new cycle.
            </p>
        </field>
    </record>

    <record id="action_cycle_list_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_cycle_tree" />
        <field name="act_window_id" ref="action_cycle_list" />
    </record>

    <record id="action_cycle_list_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_cycle_form" />
        <field name="act_window_id" ref="action_cycle_list" />
    </record>

    <!-- Cycles menu removed - accessible from Program form -->
</odoo>
