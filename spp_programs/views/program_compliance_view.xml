Compliance Manager Views - Dedicated views for the compliance manager system.
Compliance determines if enrolled beneficiaries meet ONGOING conditions,
separate from eligibility which determines WHO can enroll.
-->
<odoo>
    <!-- ==================== Compliance Manager (Wrapper) ==================== -->

    <record id="view_compliance_manager_tree" model="ir.ui.view">
        <field name="name">view_compliance_manager_tree</field>
        <field name="model">spp.compliance.manager</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list>
                <field name="manager_ref_id" />
                <field name="program_id" />
            </list>
        </field>
    </record>

    <record id="view_compliance_manager_form" model="ir.ui.view">
        <field name="name">view_compliance_manager_form</field>
        <field name="model">spp.compliance.manager</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Compliance Manager">
                <sheet>
                    <group>
                        <field
                            name="manager_ref_id"
                            options="{'no_quick_create':True}"
                            colspan="4"
                            context="{'default_program_id':program_id}"
                        />
                        <field name="program_id" invisible="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================== Default Compliance Manager (Implementation) ==================== -->

    <record id="view_compliance_manager_default_tree" model="ir.ui.view">
        <field name="name">view_compliance_manager_default_tree</field>
        <field name="model">spp.compliance.manager.default</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list sample="1">
                <field name="name" />
                <field name="program_id" />
                <field
                    name="compliance_cel_is_valid"
                    widget="boolean_toggle"
                    readonly="1"
                    string="Valid"
                />
            </list>
        </field>
    </record>

    <record id="view_compliance_manager_default_form" model="ir.ui.view">
        <field name="name">view_compliance_manager_default_form</field>
        <field name="model">spp.compliance.manager.default</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Compliance Manager Configuration">
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <div class="oe_title mb24">
                        <label for="name" string="Name:" />
                        <h1>
                            <field
                                id="name"
                                name="name"
                                placeholder="Enter the Compliance Manager Name..."
                            />
                        </h1>
                        <field name="program_id" invisible="1" />
                    </div>

                    <group col="1" name="cel_expression_section">
                        <!-- Hidden fields for widget context -->
                        <field name="compliance_cel_mode" invisible="1" />
                        <field name="compliance_cel_profile" invisible="1" />
                        <field name="is_compliance_locked" invisible="1" />

                        <!-- Template Lineage Information -->
                        <group
                            col="4"
                            invisible="not source_expression_id"
                            class="oe_read_only"
                        >
                            <field
                                name="source_expression_id"
                                colspan="2"
                                options="{'no_open': False, 'no_create': True}"
                                readonly="1"
                            />
                            <!-- Lock indicator -->
                            <div
                                colspan="2"
                                invisible="not is_compliance_locked"
                                class="text-warning"
                            >
                                <i class="fa fa-lock" title="Locked" />
                                <span class="ms-1 fw-bold">Locked</span>
                            </div>
                        </group>

                        <!-- Selected criteria display (shown when a template is selected) -->
                        <group invisible="not source_expression_id">
                            <field
                                name="source_expression_id"
                                readonly="1"
                                string="Selected Criteria"
                                options="{'no_open': False, 'no_create': True}"
                            />
                        </group>

                        <!-- Lock warning message -->
                        <div
                            class="alert alert-warning mb-2"
                            role="alert"
                            invisible="not is_compliance_locked"
                        >
                            <i class="fa fa-lock me-1" title="Locked" />
                            This compliance criteria is <strong
                        >locked</strong> and cannot be modified.
                            The expression is standardized for compliance purposes.
                            Contact an administrator to unlock if changes are required.
                        </div>

                        <!-- CEL Expression (hidden when locked) -->
                        <div class="w-100" invisible="is_compliance_locked">
                            <group>
                                <field
                                    name="compliance_cel_expression"
                                    widget="cel_expression"
                                    options="{'profile_field': 'compliance_cel_profile'}"
                                    show_symbol_browser="true"
                                    show_validation_count="true"
                                    placeholder="e.g.: age_years(me.birthdate) >= 60 and me.gender == 'female'"
                                />
                            </group>

                            <!-- Action buttons -->
                            <div class="o_row mb-3">
                                <button
                                    name="action_open_compliance_cel_builder"
                                    string="Advanced Builder"
                                    type="object"
                                    class="btn-secondary"
                                    icon="fa-magic"
                                    title="Open the advanced expression builder wizard"
                                />
                                <button
                                    name="action_preview_compliance_beneficiaries"
                                    string="Preview Beneficiaries"
                                    type="object"
                                    class="btn-secondary"
                                    icon="fa-eye"
                                    invisible="not compliance_cel_is_valid"
                                />
                            </div>

                            <!-- Validation alerts -->
                            <div
                                class="alert alert-success"
                                role="status"
                                invisible="not compliance_cel_is_valid or not compliance_cel_expression"
                            >
                                <i class="fa fa-check-circle" title="Success" />
                                Expression is valid.
                                <strong>
                                <field
                                    name="compliance_cel_preview_count"
                                    class="oe_inline"
                                />
                            </strong>
                                enrolled beneficiaries match this compliance criteria.
                            </div>

                            <div
                                class="alert alert-danger"
                                role="alert"
                                invisible="not compliance_cel_preview_error"
                            >
                                <i class="fa fa-exclamation-triangle" title="Warning" />
                                <field
                                    name="compliance_cel_preview_error"
                                    nolabel="1"
                                    class="oe_inline"
                                />
                            </div>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="compliance_manager_default_filter" model="ir.ui.view">
        <field name="name">compliance_manager_default_filter</field>
        <field name="model">spp.compliance.manager.default</field>
        <field name="priority" eval="1" />
        <field name="arch" type="xml">
            <search string="Search Compliance Managers">
                <field name="name" />
                <field name="program_id" />
                <separator />
                <filter
                    string="Has Expression"
                    name="has_expression"
                    domain="[('compliance_cel_expression', '!=', False)]"
                />
                <filter
                    string="No Expression"
                    name="no_expression"
                    domain="[('compliance_cel_expression', '=', False)]"
                />
                <separator />
                <filter
                    string="Program"
                    name="grp_program_id"
                    context="{'group_by': 'program_id'}"
                />
            </search>
        </field>
    </record>

    <record id="action_compliance_manager_default" model="ir.actions.act_window">
        <field name="name">Compliance Managers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="path">program-compliance-managers</field>
        <field name="res_model">spp.compliance.manager.default</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="compliance_manager_default_filter" />
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a Compliance Manager!
            </p>
            <p>
                Click the create button to configure compliance criteria.
                Compliance criteria define ongoing conditions beneficiaries must meet.
            </p>
        </field>
    </record>
</odoo>
