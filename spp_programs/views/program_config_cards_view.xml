<?xml version="1.0" encoding="UTF-8" ?>
<!--
Part of OpenSPP. See LICENSE file for full copyright and licensing details.

User-friendly card-based configuration view for programs.
Replaces the technical manager configuration with intuitive sections.
-->
<odoo>
    <!-- Card-Based Configuration Tab -->
    <record id="view_program_form_config_cards" model="ir.ui.view">
        <field name="name">spp.program.form.config.cards</field>
        <field name="model">spp.program</field>
        <field name="inherit_id" ref="spp_programs.view_program_list_form" />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Replace the Configuration tab content -->
            <xpath expr="//page[@name='configuration']" position="replace">
                <page
                    name="configuration"
                    string="Configuration"
                    groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_validator"
                >
                    <!-- Hidden field for access control -->
                    <field name="can_edit_configuration" invisible="1" />

                    <!-- ==================== ELIGIBILITY SECTION ==================== -->
                    <div class="card mb-3 shadow-sm">
                        <div
                            class="card-header d-flex justify-content-between align-items-center py-2 bg-primary-subtle"
                        >
                            <div class="d-flex align-items-center">
                                <i
                                    class="fa fa-filter fa-lg me-3 text-primary"
                                    title="Eligibility"
                                />
                                <div>
                                    <h5 class="mb-0">Who Qualifies?</h5>
                                    <small
                                        class="text-muted"
                                    >Define eligibility criteria for this program</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span
                                    class="badge rounded-pill bg-success"
                                    invisible="not eligibility_configured"
                                >
                                    <i class="fa fa-check me-1" />Configured
                                </span>
                                <button
                                    name="action_configure_eligibility"
                                    type="object"
                                    class="btn btn-sm btn-primary"
                                    invisible="not eligibility_configured or not can_edit_configuration"
                                    icon="fa-edit"
                                >Edit</button>
                                <button
                                    name="action_configure_eligibility"
                                    type="object"
                                    class="btn btn-sm btn-secondary"
                                    invisible="not eligibility_configured or can_edit_configuration"
                                    icon="fa-eye"
                                >View</button>
                            </div>
                        </div>
                        <div class="card-body py-3">
                            <field name="eligibility_manager_count" invisible="1" />
                            <group invisible="not eligibility_configured">
                                <group>
                                    <field
                                        name="eligibility_manager_type"
                                        string="Method"
                                        readonly="1"
                                    />
                                </group>
                                <group>
                                    <field
                                        name="eligibility_manager_display"
                                        string="Eligibility Method"
                                        readonly="1"
                                    />
                                </group>
                            </group>
                            <!-- Single-manager detail (full width) -->
                            <group invisible="eligibility_manager_count != 1" col="1">
                                <field
                                    name="eligibility_manager_detail"
                                    widget="text"
                                    readonly="1"
                                    nolabel="1"
                                    colspan="2"
                                    placeholder="No eligibility rule configured yet — click Edit above."
                                />
                            </group>
                            <!-- Multi-manager list (0 or 2+ managers) -->
                            <separator
                                string="Eligibility Method"
                                invisible="eligibility_manager_count == 1"
                            />
                            <field
                                name="eligibility_manager_ids"
                                invisible="eligibility_manager_count == 1"
                                readonly="state == 'ended' or not can_edit_configuration"
                                context="{'default_program_id': id}"
                                nolabel="1"
                            >
                                <list editable="bottom" create="1" delete="1">
                                    <field
                                        name="manager_ref_id"
                                        string="Eligibility Method"
                                        options="{'no_quick_create':True}"
                                        context="{'default_program_id': parent.id}"
                                    />
                                    <button
                                        name="open_manager_form"
                                        type="object"
                                        class="btn-link p-0"
                                        icon="fa-cog"
                                        title="Configure eligibility rules"
                                    />
                                </list>
                            </field>
                        </div>
                    </div>

                    <!-- ==================== ENTITLEMENT SECTION ==================== -->
                    <div class="card mb-3 shadow-sm">
                        <div
                            class="card-header d-flex justify-content-between align-items-center py-2 bg-success-subtle"
                        >
                            <div class="d-flex align-items-center">
                                <i
                                    class="fa fa-gift fa-lg me-3 text-success"
                                    title="Entitlement"
                                />
                                <div>
                                    <h5 class="mb-0">What Do They Receive?</h5>
                                    <small
                                        class="text-muted"
                                    >Configure benefits and entitlement amounts</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span
                                    class="badge rounded-pill bg-success"
                                    invisible="not entitlement_configured"
                                >
                                    <i class="fa fa-check me-1" />Configured
                                </span>
                                <button
                                    name="action_configure_entitlement"
                                    type="object"
                                    class="btn btn-sm btn-primary"
                                    invisible="not entitlement_configured or not can_edit_configuration"
                                    icon="fa-edit"
                                >Edit</button>
                                <button
                                    name="action_configure_entitlement"
                                    type="object"
                                    class="btn btn-sm btn-secondary"
                                    invisible="not entitlement_configured or can_edit_configuration"
                                    icon="fa-eye"
                                >View</button>
                            </div>
                        </div>
                        <div class="card-body py-3">
                            <field name="entitlement_manager_count" invisible="1" />
                            <group invisible="not entitlement_configured">
                                <group>
                                    <field
                                        name="entitlement_manager_type"
                                        string="Type"
                                        readonly="1"
                                    />
                                </group>
                                <group>
                                    <field
                                        name="entitlement_manager_display"
                                        string="Entitlement Type"
                                        readonly="1"
                                    />
                                </group>
                            </group>
                            <!-- Single-manager detail (full width) -->
                            <group invisible="entitlement_manager_count != 1" col="1">
                                <field
                                    name="entitlement_manager_detail"
                                    widget="text"
                                    readonly="1"
                                    nolabel="1"
                                    colspan="2"
                                    placeholder="No entitlement configured yet — click Edit above."
                                />
                            </group>
                            <!-- Multi-manager list (0 or 2+ managers) -->
                            <separator
                                string="Entitlement Type"
                                invisible="entitlement_manager_count == 1"
                            />
                            <field
                                name="entitlement_manager_ids"
                                invisible="entitlement_manager_count == 1"
                                readonly="state == 'ended' or not can_edit_configuration"
                                context="{'default_program_id': id}"
                                nolabel="1"
                            >
                                <list editable="bottom" create="1" delete="1">
                                    <field
                                        name="manager_ref_id"
                                        string="Entitlement Type"
                                        options="{'no_quick_create':True}"
                                        context="{'default_program_id': parent.id}"
                                    />
                                    <button
                                        name="open_manager_form"
                                        type="object"
                                        class="btn-link p-0"
                                        icon="fa-cog"
                                        title="Configure entitlement details"
                                    />
                                </list>
                            </field>
                        </div>
                    </div>

                    <!-- ==================== SCHEDULE SECTION ==================== -->
                    <div class="card mb-3 shadow-sm">
                        <div
                            class="card-header d-flex justify-content-between align-items-center py-2 bg-info-subtle"
                        >
                            <div class="d-flex align-items-center">
                                <i
                                    class="fa fa-calendar fa-lg me-3 text-info"
                                    title="Schedule"
                                />
                                <div>
                                    <h5 class="mb-0">Program Schedule</h5>
                                    <small
                                        class="text-muted"
                                    >Configure cycle timing and recurrence</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span
                                    class="badge rounded-pill bg-success"
                                    invisible="not cycle_configured"
                                >
                                    <i class="fa fa-check me-1" />Configured
                                </span>
                                <button
                                    name="action_configure_cycle"
                                    type="object"
                                    class="btn btn-sm btn-primary"
                                    invisible="not cycle_configured or not can_edit_configuration"
                                    icon="fa-edit"
                                >Edit</button>
                                <button
                                    name="action_configure_cycle"
                                    type="object"
                                    class="btn btn-sm btn-secondary"
                                    invisible="not cycle_configured or can_edit_configuration"
                                    icon="fa-eye"
                                >View</button>
                            </div>
                        </div>
                        <div class="card-body py-3">
                            <field name="cycle_manager_count" invisible="1" />
                            <group invisible="not cycle_configured">
                                <group>
                                    <field
                                        name="cycle_manager_display"
                                        string="Schedule"
                                        readonly="1"
                                    />
                                </group>
                            </group>
                            <!-- Single-manager detail (full width) -->
                            <group invisible="cycle_manager_count != 1" col="1">
                                <field
                                    name="cycle_manager_detail"
                                    widget="text"
                                    readonly="1"
                                    nolabel="1"
                                    colspan="2"
                                    placeholder="No schedule configured yet — click Edit above."
                                />
                            </group>
                            <!-- Multi-manager list (0 or 2+ managers) -->
                            <separator
                                string="Schedule Type"
                                invisible="cycle_manager_count == 1"
                            />
                            <field
                                name="cycle_manager_ids"
                                invisible="cycle_manager_count == 1"
                                readonly="state == 'ended' or not can_edit_configuration"
                                context="{'default_program_id': id}"
                                nolabel="1"
                            >
                                <list editable="bottom" create="1" delete="1">
                                    <field
                                        name="manager_ref_id"
                                        string="Schedule Type"
                                        options="{'no_quick_create':True}"
                                        context="{'default_program_id': parent.id}"
                                    />
                                    <button
                                        name="open_manager_form"
                                        type="object"
                                        class="btn-link p-0"
                                        icon="fa-cog"
                                        title="Configure schedule"
                                    />
                                </list>
                            </field>
                        </div>
                    </div>

                    <!-- ==================== COMPLIANCE SECTION ==================== -->
                    <div class="card mb-3 shadow-sm">
                        <div
                            class="card-header d-flex justify-content-between align-items-center py-2 bg-danger-subtle"
                        >
                            <div class="d-flex align-items-center">
                                <i
                                    class="fa fa-check-circle fa-lg me-3 text-danger"
                                    title="Compliance"
                                />
                                <div>
                                    <h5 class="mb-0">Compliance Criteria</h5>
                                    <small
                                        class="text-muted"
                                    >Define ongoing conditions beneficiaries must meet</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span
                                    class="badge rounded-pill bg-success"
                                    invisible="not compliance_configured"
                                >
                                    <i class="fa fa-check me-1" />Configured
                                </span>
                                <!-- Zero-state: offer Add when compliance isn't set up.
                                     Compliance is optional, so the empty state shows an
                                     explicit Add button instead of the generic list. -->
                                <button
                                    name="action_add_compliance_manager"
                                    type="object"
                                    class="btn btn-sm btn-primary"
                                    invisible="compliance_manager_count != 0 or not can_edit_configuration"
                                    icon="fa-plus"
                                >Add</button>
                                <button
                                    name="action_configure_compliance"
                                    type="object"
                                    class="btn btn-sm btn-primary"
                                    invisible="not compliance_configured or not can_edit_configuration"
                                    icon="fa-edit"
                                >Edit</button>
                                <button
                                    name="action_configure_compliance"
                                    type="object"
                                    class="btn btn-sm btn-secondary"
                                    invisible="not compliance_configured or can_edit_configuration"
                                    icon="fa-eye"
                                >View</button>
                            </div>
                        </div>
                        <div class="card-body py-3">
                            <field name="compliance_manager_count" invisible="1" />
                            <!-- Zero-state informational block (compliance is optional) -->
                            <div
                                class="text-muted py-3"
                                invisible="compliance_manager_count != 0"
                            >
                                <i class="fa fa-info-circle me-2" />
                                No compliance criteria configured. Compliance is optional — click
                                <b
                            >Add</b> above to define ongoing conditions beneficiaries must meet.
                            </div>
                            <group invisible="not compliance_configured">
                                <group>
                                    <field
                                        name="compliance_manager_type"
                                        string="Method"
                                        readonly="1"
                                    />
                                </group>
                                <group>
                                    <field
                                        name="compliance_manager_display"
                                        string="Criteria"
                                        readonly="1"
                                    />
                                </group>
                            </group>
                            <!-- Single-manager detail (full width) -->
                            <group invisible="compliance_manager_count != 1" col="1">
                                <field
                                    name="compliance_manager_detail"
                                    widget="text"
                                    readonly="1"
                                    nolabel="1"
                                    colspan="2"
                                    placeholder="No compliance rule configured yet — click Edit above."
                                />
                            </group>
                            <!-- Multi-manager list (2+ managers only — zero-state handled above) -->
                            <separator
                                string="Compliance Method"
                                invisible="compliance_manager_count &lt;= 1"
                            />
                            <field
                                name="compliance_manager_ids"
                                invisible="compliance_manager_count &lt;= 1"
                                readonly="state == 'ended' or not can_edit_configuration"
                                context="{'default_program_id': id}"
                                nolabel="1"
                            >
                                <list editable="bottom" create="1" delete="1">
                                    <field
                                        name="manager_ref_id"
                                        string="Compliance Method"
                                        options="{'no_quick_create':True}"
                                        context="{'default_program_id': parent.id}"
                                    />
                                    <button
                                        name="open_manager_form"
                                        type="object"
                                        class="btn-link p-0"
                                        icon="fa-cog"
                                        title="Configure compliance criteria"
                                    />
                                </list>
                            </field>
                        </div>
                    </div>

                    <!-- ==================== PAYMENT SECTION ==================== -->
                    <div class="card mb-3 shadow-sm">
                        <div
                            class="card-header d-flex justify-content-between align-items-center py-2 bg-warning-subtle"
                        >
                            <div class="d-flex align-items-center">
                                <i
                                    class="fa fa-credit-card fa-lg me-3 text-warning"
                                    title="Payment"
                                />
                                <div>
                                    <h5 class="mb-0">Payment Processing</h5>
                                    <small
                                        class="text-muted"
                                    >Configure how payments are made</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span
                                    class="badge rounded-pill bg-success"
                                    invisible="not payment_configured"
                                >
                                    <i class="fa fa-check me-1" />Configured
                                </span>
                                <!-- Zero-state: offer Add when payment isn't set up.
                                     Mirrors the Compliance pattern (#952). -->
                                <button
                                    name="action_add_payment_manager"
                                    type="object"
                                    class="btn btn-sm btn-primary"
                                    invisible="payment_manager_count != 0 or not can_edit_configuration"
                                    icon="fa-plus"
                                >Add</button>
                                <button
                                    name="action_configure_payment"
                                    type="object"
                                    class="btn btn-sm btn-primary"
                                    invisible="not payment_configured or not can_edit_configuration"
                                    icon="fa-edit"
                                >Edit</button>
                                <button
                                    name="action_configure_payment"
                                    type="object"
                                    class="btn btn-sm btn-secondary"
                                    invisible="not payment_configured or can_edit_configuration"
                                    icon="fa-eye"
                                >View</button>
                            </div>
                        </div>
                        <div class="card-body py-3">
                            <field name="payment_manager_count" invisible="1" />
                            <!-- Zero-state informational block -->
                            <div
                                class="text-muted py-3"
                                invisible="payment_manager_count != 0"
                            >
                                <i class="fa fa-info-circle me-2" />
                                No payment processing configured. Click <b
                            >Add</b> above to define how payments are made.
                            </div>
                            <group invisible="not payment_configured">
                                <group>
                                    <field
                                        name="payment_manager_display"
                                        string="Settings"
                                        readonly="1"
                                    />
                                </group>
                            </group>
                            <!-- Single-manager detail (full width) -->
                            <group invisible="payment_manager_count != 1" col="1">
                                <field
                                    name="payment_manager_detail"
                                    widget="text"
                                    readonly="1"
                                    nolabel="1"
                                    colspan="2"
                                    placeholder="No payment processing configured yet — click Edit above."
                                />
                            </group>
                            <!-- Multi-manager list (2+ managers only — zero-state handled above) -->
                            <separator
                                string="Payment Method"
                                invisible="payment_manager_count &lt;= 1"
                            />
                            <field
                                name="payment_manager_ids"
                                invisible="payment_manager_count &lt;= 1"
                                readonly="state == 'ended' or not can_edit_configuration"
                                context="{'default_program_id': id}"
                                nolabel="1"
                            >
                                <list editable="bottom" create="1" delete="1">
                                    <field
                                        name="manager_ref_id"
                                        string="Payment Method"
                                        options="{'no_quick_create':True}"
                                        context="{'default_program_id': parent.id}"
                                    />
                                    <button
                                        name="open_manager_form"
                                        type="object"
                                        class="btn-link p-0"
                                        icon="fa-cog"
                                        title="Configure payment settings"
                                    />
                                </list>
                            </field>
                        </div>
                    </div>

                    <!-- ==================== DEDUPLICATION SECTION ==================== -->
                    <!--
                        OP#1171: this was the last configuration block still
                        shown as a bare group with an inline editable list,
                        whose only column was the wrapper's Reference field —
                        "Add a line" dropped the user onto "pick a model, then
                        find or create a record of it". Now a card like
                        Compliance and Payment, with Add opening a dialog that
                        asks for the method and then a name.
                    -->
                    <div class="card mb-3 shadow-sm">
                        <div
                            class="card-header d-flex justify-content-between align-items-center py-2 bg-info-subtle"
                        >
                            <div class="d-flex align-items-center">
                                <i
                                    class="fa fa-copy fa-lg me-3 text-info"
                                    title="Duplicate Detection"
                                />
                                <div>
                                    <h5 class="mb-0">Duplicate Detection</h5>
                                    <small
                                        class="text-muted"
                                    >Check for duplicate beneficiaries by phone, ID, etc.</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span
                                    class="badge rounded-pill bg-success"
                                    invisible="not deduplication_configured"
                                >
                                    <i class="fa fa-check me-1" />Configured
                                </span>
                                <!-- Still offered once configured: a program may
                                     legitimately check by ID and by phone. -->
                                <button
                                    name="action_add_deduplication_manager"
                                    type="object"
                                    class="btn btn-sm btn-primary"
                                    invisible="not can_edit_configuration or state == 'ended'"
                                    icon="fa-plus"
                                >Add</button>
                                <!--
                                    Only offered when there is exactly one
                                    method. With several there is nothing
                                    sensible for a single button to open, and
                                    each row in the body below carries its own
                                    (OP#1171).
                                -->
                                <button
                                    name="action_configure_deduplication"
                                    type="object"
                                    class="btn btn-sm btn-primary"
                                    invisible="deduplication_manager_count != 1 or not can_edit_configuration"
                                    icon="fa-edit"
                                >Edit</button>
                                <button
                                    name="action_configure_deduplication"
                                    type="object"
                                    class="btn btn-sm btn-secondary"
                                    invisible="deduplication_manager_count != 1 or can_edit_configuration"
                                    icon="fa-eye"
                                >View</button>
                            </div>
                        </div>
                        <div class="card-body py-3">
                            <field name="deduplication_manager_count" invisible="1" />
                            <div
                                class="text-muted py-3"
                                invisible="deduplication_manager_count != 0"
                            >
                                <i class="fa fa-info-circle me-2" />
                                No duplicate detection configured. It is optional — click <b
                            >Add</b> above to check for duplicate beneficiaries.
                            </div>
                            <!--
                                Every configured method, each with its own cog,
                                rather than a summary line and a single Edit
                                button. A program may check by ID and by phone,
                                and the header Edit could only ever open one of
                                them (OP#1171).

                                no_open keeps the row itself inert: opening the
                                wrapper would put the manager_ref_id Reference
                                field back in front of the user, which is what
                                this ticket set out to remove. The cog goes
                                straight to the method's own form.
                            -->
                            <field
                                name="deduplication_manager_ids"
                                nolabel="1"
                                colspan="2"
                                invisible="not deduplication_configured"
                                readonly="state == 'ended' or not can_edit_configuration"
                                options="{'create': [('id', '&lt;', 0)], 'link': [('id', '&lt;', 0)]}"
                            >
                                <!--
                                    "Add a line" is denied through 'link', not
                                    'create'. This field is a Many2many, and for
                                    those the list renderer reads
                                    `"link" in activeActions ? link : create`
                                    (web/…/list_renderer.js) — so create="0" on
                                    the list and a create domain here were both
                                    dead letters, and the row that survived
                                    opened the *link* dialog: every deduplication
                                    manager in the database, other programs'
                                    included, ready to be mis-wired into this one
                                    (OP#1171 round 1).

                                    Both keys take a domain evaluated against the
                                    parent record. A program id is always
                                    positive, so neither ever matches. 'unlink'
                                    is left alone: removing a method with the ✕
                                    stays available.
                                -->
                                <list create="0" no_open="true">
                                    <field name="display_name" string="Method" />
                                    <button
                                        name="open_manager_form"
                                        type="object"
                                        class="btn-link p-0"
                                        icon="fa-cog"
                                        title="Configure this method"
                                    />
                                </list>
                            </field>
                        </div>
                    </div>

                    <!-- ==================== OPTIONAL FEATURES ==================== -->
                    <separator string="Optional Features" />

                    <group col="2">
                        <!-- Notifications -->
                        <group string="Notifications">
                            <div class="mb-2 text-muted small" colspan="2">
                                Send SMS or other notifications to beneficiaries.
                            </div>
                            <field name="has_outgoing_mail_server" invisible="1" />
                            <field
                                name="send_email_notifications"
                                string="Email notifications"
                                readonly="not has_outgoing_mail_server or state == 'ended' or not can_edit_configuration"
                            />
                            <div
                                class="text-muted small"
                                colspan="2"
                                invisible="has_outgoing_mail_server"
                            >
                                <i class="fa fa-info-circle me-1" />
                                No outgoing mail server is configured. Ask your administrator to set one up under
                                <b
                            >Settings → Technical → Email → Outgoing Mail Servers</b> before enabling email
                                notifications.
                            </div>
                            <field
                                name="notification_manager_summary"
                                string="Channel"
                                readonly="1"
                                invisible="not notification_configured"
                            />
                            <field
                                name="notification_manager_ids"
                                readonly="state == 'ended' or not can_edit_configuration"
                                context="{'default_program_id': id}"
                                nolabel="1"
                                colspan="2"
                            >
                                <list editable="bottom" create="1" delete="1">
                                    <field
                                        name="manager_ref_id"
                                        string="Channel"
                                        options="{'no_quick_create':True}"
                                        context="{'default_program_id': parent.id}"
                                    />
                                    <button
                                        name="open_manager_form"
                                        type="object"
                                        class="btn-link p-0"
                                        icon="fa-cog"
                                        title="Configure"
                                    />
                                </list>
                            </field>
                        </group>
                    </group>

                    <!-- ==================== ACCOUNTING ==================== -->
                    <separator string="Accounting" />
                    <group col="2">
                        <group>
                            <field
                                name="journal_id"
                                string="Disbursement Journal"
                                options="{'no_open': True, 'no_quick_create': True, 'no_create': True}"
                                readonly="state == 'ended' or not can_edit_configuration"
                            />
                        </group>
                        <group>
                            <field
                                name="is_one_time_distribution"
                                readonly="state == 'ended' or not can_edit_configuration"
                            />
                        </group>
                    </group>

                    <!-- Hidden program manager (usually not user-configured) -->
                    <field name="program_manager_ids" invisible="1" />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
