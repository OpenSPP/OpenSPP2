Part of OpenSPP. See LICENSE file for full copyright and licensing details.

User-friendly card-based configuration view for programs.
Replaces the technical manager configuration with intuitive sections.
-->
<odoo>
    <!-- Card-Based Configuration Tab -->
    <record id="view_program_form_config_cards" model="ir.ui.view">
        <field name="name">spp.program.form.config.cards</field>
        <field name="model">spp.program</field>
        <field name="inherit_id" ref="spp_programs.view_program_list_form" />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Replace the Configuration tab content -->
            <xpath expr="//page[@name='configuration']" position="replace">
                <page
                    name="configuration"
                    string="Configuration"
                    groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_validator"
                >
                    <!--
                        Every card here works the same way (OP#1172): a +Add
                        button that asks which method and what to call it, a row
                        per configured method with its own cog, and an Edit
                        button only when there is exactly one — with several,
                        one button has nothing sensible to open.

                        The rows deliberately carry no "Add a line". These
                        fields are mostly Many2many, and for those the list
                        renderer decides that row from 'link', not 'create'
                        (web/…/list_renderer.js), so the create attribute alone
                        never suppressed it. The row that survived opened a
                        picker listing every program's managers, and picking one
                        wired another program's configuration into this one
                        while it went on running against the program it was
                        created for. Both keys are denied with a domain that
                        never matches; 'unlink' is left alone, so the ✕ still
                        removes a method.
                    -->
                    <!-- Hidden field for access control -->
                    <field name="can_edit_configuration" invisible="1" />

                    <!-- ==================== ELIGIBILITY SECTION ==================== -->
                    <div class="card mb-3 shadow-sm">
                        <div
                            class="card-header d-flex justify-content-between align-items-center py-2 bg-primary-subtle"
                        >
                            <div class="d-flex align-items-center">
                                <i
                                    class="fa fa-filter fa-lg me-3 text-primary"
                                    title="Eligibility"
                                />
                                <div>
                                    <h5 class="mb-0">Who Qualifies?</h5>
                                    <small
                                        class="text-muted"
                                    >Define eligibility criteria for this program</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span
                                    class="badge rounded-pill bg-success"
                                    invisible="not eligibility_configured"
                                >
                                    <i class="fa fa-check me-1" />Configured
                                </span>
                                <!--
                                    Offered whenever configuration can be edited: a
                                    program may legitimately run more than one method,
                                    and this is the only way in now that the inline
                                    Reference field is gone (OP#1172).
                                -->
                                <button
                                    name="action_add_manager"
                                    type="object"
                                    context="{'manager_category': 'eligibility'}"
                                    class="btn btn-sm btn-primary"
                                    invisible="not can_edit_configuration or state == 'ended'"
                                    icon="fa-plus"
                                >Add</button>
                                <button
                                    name="action_configure_eligibility"
                                    type="object"
                                    class="btn btn-sm btn-primary"
                                    invisible="eligibility_manager_count != 1 or not can_edit_configuration"
                                    icon="fa-edit"
                                >Edit</button>
                                <button
                                    name="action_configure_eligibility"
                                    type="object"
                                    class="btn btn-sm btn-secondary"
                                    invisible="eligibility_manager_count != 1 or can_edit_configuration"
                                    icon="fa-eye"
                                >View</button>
                            </div>
                        </div>
                        <div class="card-body py-3">
                            <field name="eligibility_manager_count" invisible="1" />
                            <div
                                class="text-muted py-3"
                                invisible="eligibility_manager_count != 0"
                            >
                                <i class="fa fa-info-circle me-2" />
                                No eligibility method configured — click <b
                            >Add</b> above to choose who qualifies for this program.
                            </div>
                            <group invisible="not eligibility_configured">
                                <group>
                                    <field
                                        name="eligibility_manager_type"
                                        string="Method"
                                        readonly="1"
                                    />
                                </group>
                                <group>
                                    <field
                                        name="eligibility_manager_display"
                                        string="Eligibility Method"
                                        readonly="1"
                                    />
                                </group>
                            </group>
                            <!-- Single-manager detail (full width) -->
                            <group invisible="eligibility_manager_count != 1" col="1">
                                <field
                                    name="eligibility_manager_detail"
                                    widget="text"
                                    readonly="1"
                                    nolabel="1"
                                    colspan="2"
                                    placeholder="No eligibility rule configured yet — click Edit above."
                                />
                            </group>
                            <separator
                                string="Eligibility Method"
                                invisible="eligibility_manager_count == 0"
                            />
                            <!-- Every method configured here, each with its own cog. Adding goes through +Add above; see the comment at the top of this page. -->
                            <field
                                name="eligibility_manager_ids"
                                invisible="eligibility_manager_count == 0"
                                readonly="state == 'ended' or not can_edit_configuration"
                                nolabel="1"
                                colspan="2"
                                options="{'create': [('id', '&lt;', 0)], 'link': [('id', '&lt;', 0)]}"
                            >
                                <list create="0" no_open="true">
                                    <field
                                        name="display_name"
                                        string="Eligibility Method"
                                    />
                                    <button
                                        name="open_manager_form"
                                        type="object"
                                        class="btn-link p-0"
                                        icon="fa-cog"
                                        title="Configure eligibility rules"
                                    />
                                </list>
                            </field>
                        </div>
                    </div>

                    <!-- ==================== ENTITLEMENT SECTION ==================== -->
                    <div class="card mb-3 shadow-sm">
                        <div
                            class="card-header d-flex justify-content-between align-items-center py-2 bg-success-subtle"
                        >
                            <div class="d-flex align-items-center">
                                <i
                                    class="fa fa-gift fa-lg me-3 text-success"
                                    title="Entitlement"
                                />
                                <div>
                                    <h5 class="mb-0">What Do They Receive?</h5>
                                    <small
                                        class="text-muted"
                                    >Configure benefits and entitlement amounts</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span
                                    class="badge rounded-pill bg-success"
                                    invisible="not entitlement_configured"
                                >
                                    <i class="fa fa-check me-1" />Configured
                                </span>
                                <!--
                                    Offered whenever configuration can be edited: a
                                    program may legitimately run more than one method,
                                    and this is the only way in now that the inline
                                    Reference field is gone (OP#1172).
                                -->
                                <button
                                    name="action_add_manager"
                                    type="object"
                                    context="{'manager_category': 'entitlement'}"
                                    class="btn btn-sm btn-primary"
                                    invisible="not can_edit_configuration or state == 'ended'"
                                    icon="fa-plus"
                                >Add</button>
                                <button
                                    name="action_configure_entitlement"
                                    type="object"
                                    class="btn btn-sm btn-primary"
                                    invisible="entitlement_manager_count != 1 or not can_edit_configuration"
                                    icon="fa-edit"
                                >Edit</button>
                                <button
                                    name="action_configure_entitlement"
                                    type="object"
                                    class="btn btn-sm btn-secondary"
                                    invisible="entitlement_manager_count != 1 or can_edit_configuration"
                                    icon="fa-eye"
                                >View</button>
                            </div>
                        </div>
                        <div class="card-body py-3">
                            <field name="entitlement_manager_count" invisible="1" />
                            <div
                                class="text-muted py-3"
                                invisible="entitlement_manager_count != 0"
                            >
                                <i class="fa fa-info-circle me-2" />
                                No entitlement type configured — click <b
                            >Add</b> above to choose what beneficiaries receive.
                            </div>
                            <group invisible="not entitlement_configured">
                                <group>
                                    <field
                                        name="entitlement_manager_type"
                                        string="Type"
                                        readonly="1"
                                    />
                                </group>
                                <group>
                                    <field
                                        name="entitlement_manager_display"
                                        string="Entitlement Type"
                                        readonly="1"
                                    />
                                </group>
                            </group>
                            <!-- Single-manager detail (full width) -->
                            <group invisible="entitlement_manager_count != 1" col="1">
                                <field
                                    name="entitlement_manager_detail"
                                    widget="text"
                                    readonly="1"
                                    nolabel="1"
                                    colspan="2"
                                    placeholder="No entitlement configured yet — click Edit above."
                                />
                            </group>
                            <separator
                                string="Entitlement Type"
                                invisible="entitlement_manager_count == 0"
                            />
                            <!-- Every method configured here, each with its own cog. Adding goes through +Add above; see the comment at the top of this page. -->
                            <field
                                name="entitlement_manager_ids"
                                invisible="entitlement_manager_count == 0"
                                readonly="state == 'ended' or not can_edit_configuration"
                                nolabel="1"
                                colspan="2"
                                options="{'create': [('id', '&lt;', 0)], 'link': [('id', '&lt;', 0)]}"
                            >
                                <list create="0" no_open="true">
                                    <field
                                        name="display_name"
                                        string="Entitlement Type"
                                    />
                                    <button
                                        name="open_manager_form"
                                        type="object"
                                        class="btn-link p-0"
                                        icon="fa-cog"
                                        title="Configure entitlement details"
                                    />
                                </list>
                            </field>
                        </div>
                    </div>

                    <!-- ==================== SCHEDULE SECTION ==================== -->
                    <div class="card mb-3 shadow-sm">
                        <div
                            class="card-header d-flex justify-content-between align-items-center py-2 bg-info-subtle"
                        >
                            <div class="d-flex align-items-center">
                                <i
                                    class="fa fa-calendar fa-lg me-3 text-info"
                                    title="Schedule"
                                />
                                <div>
                                    <h5 class="mb-0">Program Schedule</h5>
                                    <small
                                        class="text-muted"
                                    >Configure cycle timing and recurrence</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span
                                    class="badge rounded-pill bg-success"
                                    invisible="not cycle_configured"
                                >
                                    <i class="fa fa-check me-1" />Configured
                                </span>
                                <!--
                                    Offered whenever configuration can be edited: a
                                    program may legitimately run more than one method,
                                    and this is the only way in now that the inline
                                    Reference field is gone (OP#1172).
                                -->
                                <button
                                    name="action_add_manager"
                                    type="object"
                                    context="{'manager_category': 'cycle'}"
                                    class="btn btn-sm btn-primary"
                                    invisible="not can_edit_configuration or state == 'ended'"
                                    icon="fa-plus"
                                >Add</button>
                                <button
                                    name="action_configure_cycle"
                                    type="object"
                                    class="btn btn-sm btn-primary"
                                    invisible="cycle_manager_count != 1 or not can_edit_configuration"
                                    icon="fa-edit"
                                >Edit</button>
                                <button
                                    name="action_configure_cycle"
                                    type="object"
                                    class="btn btn-sm btn-secondary"
                                    invisible="cycle_manager_count != 1 or can_edit_configuration"
                                    icon="fa-eye"
                                >View</button>
                            </div>
                        </div>
                        <div class="card-body py-3">
                            <field name="cycle_manager_count" invisible="1" />
                            <div
                                class="text-muted py-3"
                                invisible="cycle_manager_count != 0"
                            >
                                <i class="fa fa-info-circle me-2" />
                                No schedule configured — click <b
                            >Add</b> above to choose how often this program runs.
                            </div>
                            <group invisible="not cycle_configured">
                                <group>
                                    <field
                                        name="cycle_manager_display"
                                        string="Schedule"
                                        readonly="1"
                                    />
                                </group>
                            </group>
                            <!-- Single-manager detail (full width) -->
                            <group invisible="cycle_manager_count != 1" col="1">
                                <field
                                    name="cycle_manager_detail"
                                    widget="text"
                                    readonly="1"
                                    nolabel="1"
                                    colspan="2"
                                    placeholder="No schedule configured yet — click Edit above."
                                />
                            </group>
                            <separator
                                string="Schedule Type"
                                invisible="cycle_manager_count == 0"
                            />
                            <!-- Every method configured here, each with its own cog. Adding goes through +Add above; see the comment at the top of this page. -->
                            <field
                                name="cycle_manager_ids"
                                invisible="cycle_manager_count == 0"
                                readonly="state == 'ended' or not can_edit_configuration"
                                nolabel="1"
                                colspan="2"
                                options="{'create': [('id', '&lt;', 0)], 'link': [('id', '&lt;', 0)]}"
                            >
                                <list create="0" no_open="true">
                                    <field name="display_name" string="Schedule Type" />
                                    <button
                                        name="open_manager_form"
                                        type="object"
                                        class="btn-link p-0"
                                        icon="fa-cog"
                                        title="Configure schedule"
                                    />
                                </list>
                            </field>
                        </div>
                    </div>

                    <!-- ==================== COMPLIANCE SECTION ==================== -->
                    <div class="card mb-3 shadow-sm">
                        <div
                            class="card-header d-flex justify-content-between align-items-center py-2 bg-danger-subtle"
                        >
                            <div class="d-flex align-items-center">
                                <i
                                    class="fa fa-check-circle fa-lg me-3 text-danger"
                                    title="Compliance"
                                />
                                <div>
                                    <h5 class="mb-0">Compliance Criteria</h5>
                                    <small
                                        class="text-muted"
                                    >Define ongoing conditions beneficiaries must meet</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span
                                    class="badge rounded-pill bg-success"
                                    invisible="not compliance_configured"
                                >
                                    <i class="fa fa-check me-1" />Configured
                                </span>
                                <!-- Zero-state: offer Add when compliance isn't set up.
                                     Compliance is optional, so the empty state shows an
                                     explicit Add button instead of the generic list. -->
                                <!--
                                    Offered whenever configuration can be edited: a
                                    program may legitimately run more than one method,
                                    and this is the only way in now that the inline
                                    Reference field is gone (OP#1172).
                                -->
                                <button
                                    name="action_add_manager"
                                    type="object"
                                    context="{'manager_category': 'compliance'}"
                                    class="btn btn-sm btn-primary"
                                    invisible="not can_edit_configuration or state == 'ended'"
                                    icon="fa-plus"
                                >Add</button>
                                <button
                                    name="action_configure_compliance"
                                    type="object"
                                    class="btn btn-sm btn-primary"
                                    invisible="compliance_manager_count != 1 or not can_edit_configuration"
                                    icon="fa-edit"
                                >Edit</button>
                                <button
                                    name="action_configure_compliance"
                                    type="object"
                                    class="btn btn-sm btn-secondary"
                                    invisible="compliance_manager_count != 1 or can_edit_configuration"
                                    icon="fa-eye"
                                >View</button>
                            </div>
                        </div>
                        <div class="card-body py-3">
                            <field name="compliance_manager_count" invisible="1" />
                            <!-- Zero-state informational block (compliance is optional) -->
                            <div
                                class="text-muted py-3"
                                invisible="compliance_manager_count != 0"
                            >
                                <i class="fa fa-info-circle me-2" />
                                No compliance criteria configured. Compliance is optional — click
                                <b
                            >Add</b> above to define ongoing conditions beneficiaries must meet.
                            </div>
                            <group invisible="not compliance_configured">
                                <group>
                                    <field
                                        name="compliance_manager_type"
                                        string="Method"
                                        readonly="1"
                                    />
                                </group>
                                <group>
                                    <field
                                        name="compliance_manager_display"
                                        string="Criteria"
                                        readonly="1"
                                    />
                                </group>
                            </group>
                            <!-- Single-manager detail (full width) -->
                            <group invisible="compliance_manager_count != 1" col="1">
                                <field
                                    name="compliance_manager_detail"
                                    widget="text"
                                    readonly="1"
                                    nolabel="1"
                                    colspan="2"
                                    placeholder="No compliance rule configured yet — click Edit above."
                                />
                            </group>
                            <separator
                                string="Compliance Method"
                                invisible="compliance_manager_count == 0"
                            />
                            <!-- Every method configured here, each with its own cog. Adding goes through +Add above; see the comment at the top of this page. -->
                            <field
                                name="compliance_manager_ids"
                                invisible="compliance_manager_count == 0"
                                readonly="state == 'ended' or not can_edit_configuration"
                                nolabel="1"
                                colspan="2"
                                options="{'create': [('id', '&lt;', 0)], 'link': [('id', '&lt;', 0)]}"
                            >
                                <list create="0" no_open="true">
                                    <field
                                        name="display_name"
                                        string="Compliance Method"
                                    />
                                    <button
                                        name="open_manager_form"
                                        type="object"
                                        class="btn-link p-0"
                                        icon="fa-cog"
                                        title="Configure compliance criteria"
                                    />
                                </list>
                            </field>
                        </div>
                    </div>

                    <!-- ==================== PAYMENT SECTION ==================== -->
                    <div class="card mb-3 shadow-sm">
                        <div
                            class="card-header d-flex justify-content-between align-items-center py-2 bg-warning-subtle"
                        >
                            <div class="d-flex align-items-center">
                                <i
                                    class="fa fa-credit-card fa-lg me-3 text-warning"
                                    title="Payment"
                                />
                                <div>
                                    <h5 class="mb-0">Payment Processing</h5>
                                    <small
                                        class="text-muted"
                                    >Configure how payments are made</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span
                                    class="badge rounded-pill bg-success"
                                    invisible="not payment_configured"
                                >
                                    <i class="fa fa-check me-1" />Configured
                                </span>
                                <!-- Zero-state: offer Add when payment isn't set up.
                                     Mirrors the Compliance pattern (#952). -->
                                <!--
                                    Offered whenever configuration can be edited: a
                                    program may legitimately run more than one method,
                                    and this is the only way in now that the inline
                                    Reference field is gone (OP#1172).
                                -->
                                <button
                                    name="action_add_manager"
                                    type="object"
                                    context="{'manager_category': 'payment'}"
                                    class="btn btn-sm btn-primary"
                                    invisible="not can_edit_configuration or state == 'ended'"
                                    icon="fa-plus"
                                >Add</button>
                                <button
                                    name="action_configure_payment"
                                    type="object"
                                    class="btn btn-sm btn-primary"
                                    invisible="payment_manager_count != 1 or not can_edit_configuration"
                                    icon="fa-edit"
                                >Edit</button>
                                <button
                                    name="action_configure_payment"
                                    type="object"
                                    class="btn btn-sm btn-secondary"
                                    invisible="payment_manager_count != 1 or can_edit_configuration"
                                    icon="fa-eye"
                                >View</button>
                            </div>
                        </div>
                        <div class="card-body py-3">
                            <field name="payment_manager_count" invisible="1" />
                            <!-- Zero-state informational block -->
                            <div
                                class="text-muted py-3"
                                invisible="payment_manager_count != 0"
                            >
                                <i class="fa fa-info-circle me-2" />
                                No payment processing configured. Click <b
                            >Add</b> above to define how payments are made.
                            </div>
                            <group invisible="not payment_configured">
                                <group>
                                    <field
                                        name="payment_manager_display"
                                        string="Settings"
                                        readonly="1"
                                    />
                                </group>
                            </group>
                            <!-- Single-manager detail (full width) -->
                            <group invisible="payment_manager_count != 1" col="1">
                                <field
                                    name="payment_manager_detail"
                                    widget="text"
                                    readonly="1"
                                    nolabel="1"
                                    colspan="2"
                                    placeholder="No payment processing configured yet — click Edit above."
                                />
                            </group>
                            <separator
                                string="Payment Method"
                                invisible="payment_manager_count == 0"
                            />
                            <!-- Every method configured here, each with its own cog. Adding goes through +Add above; see the comment at the top of this page. -->
                            <field
                                name="payment_manager_ids"
                                invisible="payment_manager_count == 0"
                                readonly="state == 'ended' or not can_edit_configuration"
                                nolabel="1"
                                colspan="2"
                                options="{'create': [('id', '&lt;', 0)], 'link': [('id', '&lt;', 0)]}"
                            >
                                <list create="0" no_open="true">
                                    <field
                                        name="display_name"
                                        string="Payment Method"
                                    />
                                    <button
                                        name="open_manager_form"
                                        type="object"
                                        class="btn-link p-0"
                                        icon="fa-cog"
                                        title="Configure payment settings"
                                    />
                                </list>
                            </field>
                        </div>
                    </div>

                    <!-- ==================== NOTIFICATIONS SECTION ==================== -->
                    <div class="card mb-3 shadow-sm">
                        <div
                            class="card-header d-flex justify-content-between align-items-center py-2 bg-secondary-subtle"
                        >
                            <div class="d-flex align-items-center">
                                <i
                                    class="fa fa-bell fa-lg me-3 text-secondary"
                                    title="Notifications"
                                />
                                <div>
                                    <h5 class="mb-0">Notifications</h5>
                                    <small
                                        class="text-muted"
                                    >Send SMS or other notifications to beneficiaries</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span
                                    class="badge rounded-pill bg-success"
                                    invisible="not notification_configured"
                                >
                                    <i class="fa fa-check me-1" />Configured
                                </span>
                                <!--
                                    Offered whenever configuration can be edited: a
                                    program may legitimately run more than one method,
                                    and this is the only way in now that the inline
                                    Reference field is gone (OP#1172).
                                -->
                                <button
                                    name="action_add_manager"
                                    type="object"
                                    context="{'manager_category': 'notification'}"
                                    class="btn btn-sm btn-primary"
                                    invisible="not can_edit_configuration or state == 'ended'"
                                    icon="fa-plus"
                                >Add</button>
                                <button
                                    name="action_configure_notification"
                                    type="object"
                                    class="btn btn-sm btn-primary"
                                    invisible="notification_manager_count != 1 or not can_edit_configuration"
                                    icon="fa-edit"
                                >Edit</button>
                                <button
                                    name="action_configure_notification"
                                    type="object"
                                    class="btn btn-sm btn-secondary"
                                    invisible="notification_manager_count != 1 or can_edit_configuration"
                                    icon="fa-eye"
                                >View</button>
                            </div>
                        </div>
                        <div class="card-body py-3">
                            <field name="notification_manager_count" invisible="1" />
                            <field name="has_outgoing_mail_server" invisible="1" />
                            <group>
                                <field
                                    name="send_email_notifications"
                                    string="Email notifications"
                                    readonly="not has_outgoing_mail_server or state == 'ended' or not can_edit_configuration"
                                />
                            </group>
                            <div
                                class="text-muted small"
                                invisible="has_outgoing_mail_server"
                            >
                                <i class="fa fa-info-circle me-1" />
                                No outgoing mail server is configured. Ask your administrator to set one up under
                                <b
                            >Settings → Technical → Email → Outgoing Mail Servers</b> before enabling email
                                notifications.
                            </div>
                            <div
                                class="text-muted py-3"
                                invisible="notification_manager_count != 0"
                            >
                                <i class="fa fa-info-circle me-2" />
                                No notification channel configured. It is optional — click <b
                            >Add</b> above to message beneficiaries.
                            </div>
                            <separator
                                string="Channel"
                                invisible="notification_manager_count == 0"
                            />
                            <!-- Every channel configured here, each with its own cog. Adding goes through +Add above; see the comment at the top of this page. -->
                            <field
                                name="notification_manager_ids"
                                invisible="notification_manager_count == 0"
                                readonly="state == 'ended' or not can_edit_configuration"
                                nolabel="1"
                                colspan="2"
                                options="{'create': [('id', '&lt;', 0)], 'link': [('id', '&lt;', 0)]}"
                            >
                                <list create="0" no_open="true">
                                    <field name="display_name" string="Channel" />
                                    <button
                                        name="open_manager_form"
                                        type="object"
                                        class="btn-link p-0"
                                        icon="fa-cog"
                                        title="Configure this channel"
                                    />
                                </list>
                            </field>
                        </div>
                    </div>

                    <!-- ==================== OPTIONAL FEATURES ==================== -->
                    <separator string="Optional Features" />

                    <group col="2">
                        <!-- Deduplication -->
                        <group string="Duplicate Detection">
                            <div class="mb-2 text-muted small" colspan="2">
                                Check for duplicate beneficiaries by phone, ID, etc.
                            </div>
                            <field
                                name="deduplication_manager_summary"
                                string="Method"
                                readonly="1"
                                invisible="not deduplication_configured"
                            />
                            <field
                                name="deduplication_manager_ids"
                                readonly="state == 'ended' or not can_edit_configuration"
                                context="{'default_program_id': id}"
                                nolabel="1"
                                colspan="2"
                            >
                                <list editable="bottom" create="1" delete="1">
                                    <field
                                        name="manager_ref_id"
                                        string="Method"
                                        options="{'no_quick_create':True}"
                                        context="{'default_program_id': parent.id}"
                                    />
                                    <button
                                        name="open_manager_form"
                                        type="object"
                                        class="btn-link p-0"
                                        icon="fa-cog"
                                        title="Configure"
                                    />
                                </list>
                            </field>
                        </group>
                    </group>

                    <!-- ==================== ACCOUNTING ==================== -->
                    <separator string="Accounting" />
                    <group col="2">
                        <group>
                            <field
                                name="journal_id"
                                string="Disbursement Journal"
                                options="{'no_open': True, 'no_quick_create': True, 'no_create': True}"
                                readonly="state == 'ended' or not can_edit_configuration"
                            />
                        </group>
                        <group>
                            <field
                                name="is_one_time_distribution"
                                readonly="state == 'ended' or not can_edit_configuration"
                            />
                        </group>
                    </group>

                    <!-- Hidden program manager (usually not user-configured) -->
                    <field name="program_manager_ids" invisible="1" />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
