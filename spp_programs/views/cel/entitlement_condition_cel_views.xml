<odoo>
    <!-- Extend Cash Entitlement Manager Form to add CEL support for items -->
    <record id="view_entitlement_item_form_cel" model="ir.ui.view">
        <field name="name">spp.program.entitlement.manager.cash.form.cel</field>
        <field name="model">spp.program.entitlement.manager.cash</field>
        <field
            name="inherit_id"
            ref="spp_programs.view_entitlement_manager_cash_form"
        />
        <field name="arch" type="xml">
            <!-- Replace the condition field with our enhanced version -->
            <xpath expr="//field[@name='condition']" position="replace">
                <group col="4" colspan="4">
                    <!-- Mode Selection -->
                    <field
                        name="condition_mode"
                        widget="radio"
                        options="{'horizontal': true}"
                        colspan="4"
                    />

                    <!-- Domain Mode (existing behavior) -->
                    <div
                        invisible="condition_mode != 'domain'"
                        class="w-100"
                        colspan="4"
                    >
                        <field
                            name="condition"
                            widget="domain"
                            options="{'model': 'res.partner'}"
                        />
                    </div>

                    <!-- CEL Mode (new) - Using enhanced CEL widget -->
                    <div invisible="condition_mode != 'cel'" class="w-100" colspan="4">
                        <field
                            name="cel_condition"
                            widget="cel_expression"
                            cel_profile="registry_groups"
                            show_symbol_browser="true"
                            show_validation_count="true"
                            placeholder="e.g.: age_years(r.birthdate) >= 60 and is_female(r.gender_id)"
                            nolabel="1"
                        />

                        <!-- Action buttons -->
                        <div class="o_row mb-3">
                            <button
                                name="action_test_cel_expression"
                                string="Test Expression"
                                type="object"
                                class="btn-secondary"
                                icon="fa-check"
                                invisible="not cel_condition"
                            />
                            <button
                                name="action_preview_beneficiaries"
                                string="Preview Beneficiaries"
                                type="object"
                                class="btn-secondary"
                                icon="fa-eye"
                                invisible="not cel_is_valid"
                            />
                        </div>

                        <!-- Validation Status -->
                        <div
                            class="alert alert-success"
                            role="status"
                            invisible="not cel_is_valid or not cel_condition"
                        >
                            <i class="fa fa-check-circle" title="Success" />
                            Expression is valid.
                            <strong>
                            <field name="cel_preview_count" class="oe_inline" />
                        </strong>
                            beneficiaries match this criteria.
                        </div>

                        <div
                            class="alert alert-danger"
                            role="alert"
                            invisible="not cel_preview_error"
                        >
                            <i class="fa fa-exclamation-triangle" title="Warning" />
                            <field
                                name="cel_preview_error"
                                nolabel="1"
                                class="oe_inline"
                            />
                        </div>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
