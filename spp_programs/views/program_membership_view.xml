<odoo>
    <record id="view_program_membership_tree" model="ir.ui.view">
        <field name="name">view_program_membership_tree</field>
        <field name="model">spp.program.membership</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list default_order='partner_id asc' create="0">
                <button
                    name="open_registrant_form"
                    type="object"
                    title="Open registrant form"
                    icon="fa-external-link"
                    class="btn-success"
                />
                <!--
                    OP#1170: one-click reset for a single row. The "Back to
                    Draft" server action below covers a whole selection, but
                    select-then-cog is a lot of clicks for one record. Hidden
                    unless the row is actually resettable, so this stays out of
                    the way on every other membership list.
                -->
                <button
                    name="back_to_draft"
                    type="object"
                    title="Back to draft"
                    string="Back to Draft"
                    class="btn-link"
                    invisible="state not in ('duplicated', 'not_eligible')"
                    groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_validator"
                />
                <field name="partner_id" />
                <field name="program_id" />
                <field name="enrollment_date" />
                <field name="exit_date" />
                <field name="exit_reason" />
                <field name="delivery_mechanism_value" column_invisible="1" />
                <field
                    name="state"
                    decoration-primary="state=='draft'"
                    decoration-warning="state=='paused'"
                    decoration-success="state=='enrolled'"
                    decoration-danger="state=='exited'"
                    widget="badge"
                    string="Status"
                />
            </list>
        </field>
    </record>

    <record id="view_program_membership_form" model="ir.ui.view">
        <field name="name">view_program_membership_form</field>
        <field name="model">spp.program.membership</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Program Membership" edit="0" create="0">
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,enrolled,paused,exited"
                    />
                    <button
                        name="verify_eligibility"
                        type="object"
                        string="Verify Eligibility"
                        title="Verify eligibility"
                        class="btn-primary"
                        invisible="state not in ('draft','enrolled')"
                        groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_validator"
                    />
                    <button
                        name="enroll_eligible_registrants"
                        type="object"
                        title="Enroll eligible registrants"
                        string="Enroll"
                        class="btn-primary"
                        invisible="state != 'draft'"
                        groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_validator"
                    />
                    <button
                        name="deduplicate_beneficiaries"
                        type="object"
                        title="Deduplicate beneficiaries"
                        string="Deduplicate"
                        class="btn-primary"
                        invisible="state not in ('draft','enrolled')"
                        groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_validator"
                    />

                    <button
                        name="back_to_draft"
                        type="object"
                        title="Back to draft"
                        string="Back to draft"
                        class="btn-primary"
                        invisible="state not in ('not_eligible','duplicated')"
                        groups="spp_security.group_spp_admin,spp_programs.group_programs_manager,spp_programs.group_programs_validator"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <widget
                        name="web_ribbon"
                        title="DRAFT"
                        bg_color="bg-primary"
                        invisible="state != 'draft'"
                    />
                    <widget
                        name="web_ribbon"
                        title="ENROLLED"
                        bg_color="bg-success"
                        invisible="state != 'enrolled'"
                    />
                    <widget
                        name="web_ribbon"
                        title="PAUSED"
                        bg_color="bg-warning"
                        invisible="state != 'paused'"
                    />
                    <widget
                        name="web_ribbon"
                        title="EXITED"
                        bg_color="bg-danger"
                        invisible="state != 'exited'"
                    />
                    <widget
                        name="web_ribbon"
                        title="DUPLICATE"
                        bg_color="bg-danger"
                        invisible="state != 'duplicated'"
                    />
                    <widget
                        name="web_ribbon"
                        title="NOT ELIGIBLE"
                        bg_color="bg-danger"
                        invisible="state != 'not_eligible'"
                    />
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="state != 'duplicated'"
                    >
                        <strong>Duplicate Reason: </strong>
                        <field name="duplicate_reason" nolabel="1" />
                    </div>
                    <div class="oe_title mb24">
                        <label for="partner_id" string="Registrant:" />
                        <h1>
                            <field
                                id="partner_id"
                                name="partner_id"
                                placeholder="Enter the registrant name..."
                            />
                        </h1>
                        <label
                            for="program_id"
                            string="Program:"
                            invisible="context.get('default_program_id',False)"
                        />
                        <h2 invisible="context.get('default_program_id',False)">
                            <field
                                name="program_id"
                                placeholder="program..."
                                invisible="context.get('default_program_id',False)"
                            />
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="registrant_id" />
                            <field
                                name="tags_ids"
                                widget="many2many_tags"
                                string="Tags:"
                                options="{'color_field': 'color'}"
                            />
                        </group>
                        <group>
                            <field name="registration_date" readonly="1" />
                            <field name="enrollment_date" readonly="1" />
                            <field name="exit_date" />
                            <field name="exit_reason" />
                            <field
                                name="delivery_mechanism_value"
                                colspan="4"
                                invisible="1"
                            />
                        </group>
                    </group>
                    <field name="is_group" invisible="1" />
                    <field name="is_registrant" invisible="1" />
                    <notebook name="registrant_detail">
                        <page name="basic_info" string="Basic Info">
                            <group>
                                <group>
                                    <field name="address" class="o_address_format" />
                                    <field name="email" widget="email" />
                                </group>
                                <group>
                                    <field
                                        name="phone_number_ids"
                                        nolabel="1"
                                        colspan="2"
                                        widget="x2many_no_padding"
                                    >
                                        <list>
                                            <field
                                                name="phone_no"
                                                string="Phone Numbers"
                                                widget="phone"
                                                options="{'enable_sms': false}"
                                            />
                                            <field name="country_id" />
                                            <field name="date_collected" />
                                            <field
                                                name="disabled"
                                                column_invisible="1"
                                            />
                                        </list>
                                    </field>
                                </group>
                                <group>
                                    <field name="birthdate" />
                                    <field name="age" />
                                    <field name="birth_place" />
                                    <field
                                        name="gender_id"
                                        domain="[('namespace_uri', '=', 'urn:iso:std:iso:5218')]"
                                    />
                                </group>
                            </group>
                        </page>
                        <page string="Bank Details" name="banks">
                            <field
                                name="bank_ids"
                                nolabel="1"
                                colspan="2"
                                widget="x2many_no_padding"
                            >
                                <list editable="bottom">
                                    <field name="bank_id" />
                                    <field name="acc_number" />
                                    <field name="acc_type" invisible="1" />
                                    <field name="iban" />
                                </list>
                            </field>
                        </page>
                        <page string="IDs" name="ids">
                            <field
                                name="reg_ids"
                                nolabel="1"
                                colspan="2"
                                widget="x2many_no_padding"
                            >
                                <list editable="bottom">
                                    <field name="id_type_id" />
                                    <field name="value" string="ID Number" />
                                    <field name="expiry_date" />
                                </list>
                            </field>
                        </page>
                        <page string="Relationships" name="relationships">
                            <group string="Registrant is related to:">
                                <field
                                    name="related_1_ids"
                                    nolabel="1"
                                    colspan="2"
                                    widget="x2many_no_padding"
                                >
                                    <list editable="bottom">
                                        <field
                                            name="source"
                                            domain="[('is_registrant','=',True),('id','!=',id)]"
                                            string="Registrant"
                                        />
                                        <field
                                            name="relation_as_str"
                                            string="Relation"
                                        />
                                        <field name="start_date" />
                                        <field name="end_date" />
                                        <field name="disabled" />
                                        <field name="disabled_by" />
                                    </list>
                                </field>
                            </group>
                            <group string="Others Related to this Registrant:">
                                <field
                                    name="related_2_ids"
                                    nolabel="1"
                                    colspan="2"
                                    widget="x2many_no_padding"
                                >
                                    <list>
                                        <field
                                            name="destination"
                                            domain="[('is_registrant','=',True),('id','!=',id)]"
                                            string="Registrant"
                                        />
                                        <field
                                            name="relation_as_str"
                                            string="Relation"
                                        />
                                        <field name="start_date" />
                                        <field name="end_date" />
                                        <field name="disabled" />
                                        <field name="disabled_by" />
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page
                            name="group_members"
                            string="Members of Group"
                            invisible="not is_group"
                        >
                            <group>
                                <field
                                    name="group_membership_ids"
                                    nolabel="1"
                                    colspan="2"
                                    widget="x2many_no_padding"
                                >
                                    <list>
                                        <field
                                            name="individual"
                                            domain="[('is_registrant','=',True),('is_group','=',False)]"
                                            string="Member Name"
                                            context="{'form_view_ref':'spp_registry.view_individuals_form'}"
                                        />
                                        <field
                                            name="individual_birthdate"
                                            string="Date of Birth"
                                        />
                                        <field
                                            name="individual_gender"
                                            string="Gender"
                                        />
                                        <field
                                            name="membership_type_ids"
                                            string="Membership Types"
                                            widget="many2many_tags"
                                        />
                                        <field name="start_date" />
                                        <field name="ended_date" />
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page
                            name="individual_groups"
                            string="Groups"
                            invisible="is_group"
                        >
                            <group>
                                <field
                                    name="individual_membership_ids"
                                    nolabel="1"
                                    colspan="2"
                                >
                                    <list editable="bottom">
                                        <field
                                            name="group"
                                            domain="[('is_registrant','=',True),('is_group','=',True)]"
                                            string="Group Name"
                                            context="{'form_view_ref':'spp_registry.view_individuals_form'}"
                                        />
                                        <field
                                            name="membership_type_ids"
                                            string="Membership Types"
                                            widget="many2many_tags"
                                        />
                                        <field name="start_date" />
                                        <field name="ended_date" />
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page name="program" string="Other Programs">
                            <field
                                name="program_membership_ids"
                                readonly="1"
                                nolabel="1"
                                colspan="2"
                            >
                                <list>
                                    <field name="program_id" />
                                    <field name="enrollment_date" />
                                    <field name="exit_date" />
                                    <field name="exit_reason" />
                                    <field
                                        name="delivery_mechanism_value"
                                        column_invisible="1"
                                    />
                                    <field
                                        name="state"
                                        decoration-primary="state=='draft'"
                                        decoration-warning="state=='paused'"
                                        decoration-success="state=='enrolled'"
                                        decoration-danger="state=='exited'"
                                        widget="badge"
                                        string="Status"
                                    />
                                </list>
                            </field>
                        </page>
                        <page name="entitlement" string="Entitlements">
                            <field
                                name="entitlement_ids"
                                readonly="1"
                                nolabel="1"
                                colspan="2"
                            >
                                <list>
                                    <field name="name" />
                                    <field name="ern" />
                                    <field name="code" />
                                    <field name="cycle_id" />
                                    <field name="valid_from" />
                                    <field name="valid_until" />
                                    <field name="state" />
                                    <field name="payment_status" />
                                    <field name="payment_date" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="program_membership_filter" model="ir.ui.view">
        <field name="name">program_membership_filter</field>
        <field name="model">spp.program.membership</field>
        <field name="priority" eval="1" />
        <field name="arch" type="xml">
            <search string="Search Program Memberships">
                <field name="partner_id" />
                <field name="program_id" />
                <separator />
                <filter name="filter_enrollment_date" date="enrollment_date" />
                <filter name="filter_exit_date" date="exit_date" />
                <separator />
                <filter
                    name="draft_state"
                    string="Draft"
                    domain="[('state','=','draft')]"
                />
                <filter
                    name="enrolled_state"
                    string="Enrolled"
                    domain="[('state','=','enrolled')]"
                />
                <filter
                    name="paused_state"
                    string="Paused"
                    domain="[('state','=','paused')]"
                />
                <filter
                    name="exited_state"
                    string="Exited"
                    domain="[('state','=','exited')]"
                />
                <filter
                    name="not_eligible"
                    string="Not Eligible"
                    domain="[('state','=','not_eligible')]"
                />
                <separator />
                <filter
                    string="Enrollment Date"
                    name="enrollment_date"
                    context="{'group_by':'enrollment_date'}"
                />
                <filter
                    string="Exit Date"
                    name="exit_date"
                    context="{'group_by':'exit_date'}"
                />
                <separator orientation="vertical" />
                <filter
                    string="State"
                    name="grp_state"
                    context="{'group_by': 'state'}"
                />
                <!-- <searchpanel>
                    <field name="group" icon="fa-users"/>
                </searchpanel> -->
            </search>
        </field>
    </record>

    <record id="action_program_membership" model="ir.actions.act_window">
        <field name="name">Programs Membership</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">spp.program.membership</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="program_membership_filter" />
        <field name="path">beneficiaries</field>
        <field name="context">{'create': False}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No program memberships found!
            </p>
            <p>
                Program memberships are created through the enrollment workflow.
            </p>
        </field>
    </record>

    <record id="action_program_membership_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_program_membership_tree" />
        <field name="act_window_id" ref="action_program_membership" />
    </record>

    <record id="action_program_membership_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_program_membership_form" />
        <field name="act_window_id" ref="action_program_membership" />
    </record>

    <!-- <menuitem
        id="menu_program_membership"
        name="Beneficiaries"
        action="action_program_membership"
        parent="spp_program_root"
        sequence="20"
        groups="spp_security.group_spp_admin"
    /> -->

    <!--
        OP#1170: bulk reset from any membership list, including the Duplicates
        list reached from a program's smart button. Follows the same shape as
        spp_programs' "Reset to Draft" on entitlements: filter the selection to
        what can actually move, act on that, and only complain when nothing in
        the selection qualifies — so one stray row does not block the other
        forty-nine.
    -->
    <record id="action_membership_back_to_draft_multi" model="ir.actions.server">
        <field name="name">Back to Draft</field>
        <field name="model_id" ref="model_spp_program_membership" />
        <field name="binding_model_id" ref="model_spp_program_membership" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    eligible_records = records.filtered(lambda m: m.state in ("duplicated", "not_eligible"))
    if eligible_records:
        eligible_records.back_to_draft()
    else:
        raise UserError(
            "No eligible memberships selected. Only duplicated or not-eligible "
            "memberships can be returned to draft."
        )
        </field>
        <field
            name="group_ids"
            eval="[(4, ref('spp_security.group_spp_admin')), (4, ref('spp_programs.group_programs_manager')), (4, ref('spp_programs.group_programs_validator'))]"
        />
    </record>
</odoo>
