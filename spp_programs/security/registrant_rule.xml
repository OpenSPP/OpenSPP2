<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
        <!-- Programs Domain Record Rules -->
        <!-- Following ADR-004 naming convention: rule_{model}_{purpose} -->

        <record id="rule_spp_program_membership_disabled" model="ir.rule">
            <field name="name">Program Membership: Exclude Disabled</field>
            <field name="model_id" ref="spp_programs.model_spp_program_membership" />
            <field name="domain_force">[("partner_id.disabled", "=", False)]</field>
            <field name="global">True</field>
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="rule_spp_program_membership_disabled_edit" model="ir.rule">
            <field name="name">Program Membership: Manage Active</field>
            <field name="model_id" ref="spp_programs.model_spp_program_membership" />
            <field name="domain_force">[("partner_id.disabled", "=", False)]</field>
            <field name="groups" eval="[Command.link(ref('group_programs_officer')), Command.link(ref('group_programs_manager'))]" />
            <field name="global">False</field>
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
        </record>

        <record id="rule_spp_cycle_membership_disabled" model="ir.rule">
            <field name="name">Cycle Membership: Exclude Disabled</field>
            <field name="model_id" ref="spp_programs.model_spp_cycle_membership" />
            <field name="domain_force">[("partner_id.disabled", "=", False)]</field>
            <field name="global">True</field>
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="rule_spp_cycle_membership_disabled_edit" model="ir.rule">
            <field name="name">Cycle Membership: Manage Active</field>
            <field name="model_id" ref="spp_programs.model_spp_cycle_membership" />
            <field name="domain_force">[("partner_id.disabled", "=", False)]</field>
            <field name="groups" eval="[Command.link(ref('group_programs_officer')), Command.link(ref('group_programs_manager'))]" />
            <field name="global">False</field>
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
        </record>

        <record id="rule_spp_program_company" model="ir.rule">
            <field name="name">Program: Multi-Company Access</field>
            <field name="model_id" ref="spp_programs.model_spp_program" />
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="global">True</field>
        </record>
</odoo>
