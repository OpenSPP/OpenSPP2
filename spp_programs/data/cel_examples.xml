        <field name="name">Female-Headed Household Bonus</field>
        <field name="expression">base_amount * 1.2 if r.is_woman_headed else base_amount</field>
        <field name="description">20% bonus for female-headed households</field>
        <field name="category">amount</field>
        <field name="target_type">group</field>
        <field name="sequence">60</field>
    </record> -->

    <!-- <record id="cel_amount_disability_supplement" model="spp.cel.example">
        <field name="name">Disability Supplement</field>
        <field name="expression">base_amount + (200 if r.disabled else 0)</field>
        <field name="description">Additional 200 for beneficiaries with disabilities</field>
        <field name="category">amount</field>
        <field name="target_type">individual</field>
        <field name="sequence">70</field>
    </record> -->

    <record id="cel_amount_elderly_bonus" model="spp.cel.example">
        <field name="name">Senior Citizen Bonus</field>
        <field
            name="expression"
        >base_amount * 1.15 if r.age >= 60 else base_amount</field>
        <field name="description">15% bonus for beneficiaries aged 60+</field>
        <field name="category">amount</field>
        <field name="target_type">individual</field>
        <field name="sequence">80</field>
    </record>

    <!-- Household Size Tiers -->
    <record id="cel_amount_household_tier" model="spp.cel.example">
        <field name="name">Tiered by Household Size</field>
        <field
            name="expression"
        >300 if hh_size &lt;= 3 else (500 if hh_size &lt;= 6 else 700)</field>
        <field name="description">300 for 1-3 members, 500 for 4-6, 700 for 7+</field>
        <field name="category">amount</field>
        <field name="target_type">group</field>
        <field name="sequence">90</field>
    </record>

    <!-- Combined Formulas -->
    <!-- <record id="cel_amount_complex" model="spp.cel.example">
        <field name="name">Complex Formula (Base + Children + Bonus)</field>
        <field name="expression">base_amount + (r.children_count * 30) + (100 if r.disabled else 0)</field>
        <field name="description">Base amount + 30 per child + 100 disability bonus</field>
        <field name="category">amount</field>
        <field name="target_type">both</field>
        <field name="sequence">100</field>
    </record> -->

    <record id="cel_amount_minimum_guarantee" model="spp.cel.example">
        <field name="name">Minimum Guarantee</field>
        <field name="expression">max(hh_size * 80, 200)</field>
        <field name="description">80 per member, minimum 200 guaranteed</field>
        <field name="category">amount</field>
        <field name="target_type">group</field>
        <field name="sequence">110</field>
    </record>

    <!-- ================================================== -->
    <!-- CEL ENTITLEMENT CONDITION FORMULA EXAMPLES         -->
    <!-- ================================================== -->
    <!-- These formulas determine which beneficiaries qualify for specific entitlement items -->

    <!-- Age-Based Conditions -->
    <record id="cel_condition_seniors" model="spp.cel.example">
        <field name="name">Senior Citizens Only</field>
        <field name="expression">age_years(r.birthdate) >= 60</field>
        <field name="description">Only beneficiaries aged 60 and above</field>
        <field name="category">condition</field>
        <field name="target_type">individual</field>
        <field name="sequence">10</field>
    </record>

    <record id="cel_condition_children_under_5" model="spp.cel.example">
        <field name="name">Households with Children Under 5</field>
        <field
            name="expression"
        >members.exists(m, age_years(m.birthdate) &lt; 5)</field>
        <field
            name="description"
        >Households with at least one child under 5 years old</field>
        <field name="category">condition</field>
        <field name="target_type">group</field>
        <field name="sequence">20</field>
    </record>

    <record id="cel_condition_school_age" model="spp.cel.example">
        <field name="name">Households with School-Age Children</field>
        <field
            name="expression"
        >members.count(m, age_years(m.birthdate) >= 6 and age_years(m.birthdate) &lt;= 18) >= 1</field>
        <field
            name="description"
        >Households with children between 6 and 18 years old</field>
        <field name="category">condition</field>
        <field name="target_type">group</field>
        <field name="sequence">30</field>
    </record>

    <!-- Gender-Based Conditions -->
    <record id="cel_condition_female" model="spp.cel.example">
        <field name="name">Female Beneficiaries</field>
        <field name="expression">is_female(r.gender_id)</field>
        <field name="description">Only female beneficiaries</field>
        <field name="category">condition</field>
        <field name="target_type">individual</field>
        <field name="sequence">40</field>
    </record>

    <record id="cel_condition_female_headed" model="spp.cel.example">
        <field name="name">Female-Headed Households</field>
        <field
            name="expression"
        >members.exists(m, head(m) and is_female(m.gender_id))</field>
        <field name="description">Households headed by a woman</field>
        <field name="category">condition</field>
        <field name="target_type">group</field>
        <field name="sequence">50</field>
    </record>

