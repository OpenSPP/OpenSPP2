    <record id="cel_inkind_minimum_guarantee" model="spp.cel.example">
        <field name="name">Minimum Guarantee</field>
        <field name="expression">max(hh_size * 3, 10)</field>
        <field name="description">3 per member, minimum 10 guaranteed</field>
        <field name="category">inkind_qty</field>
        <field name="target_type">group</field>
        <field name="sequence">120</field>
    </record>

    <!-- ============================================================ -->
    <!-- CEL COMPLIANCE CRITERIA EXAMPLES                             -->
    <!-- ============================================================ -->
    <!-- These expressions define ongoing compliance requirements for beneficiaries -->

    <!-- School Attendance Compliance -->
    <record id="cel_compliance_school_attendance" model="spp.cel.example">
        <field name="name">School-Age Children Enrolled</field>
        <field
            name="expression"
        >members.count(m, age_years(m.birthdate) >= 6 and age_years(m.birthdate) &lt;= 18 and m.is_enrolled_school == false) == 0</field>
        <field
            name="description"
        >All school-age children (6-18) must be enrolled in school</field>
        <field name="category">compliance</field>
        <field name="target_type">group</field>
        <field name="sequence">10</field>
    </record>

    <record id="cel_compliance_attendance_rate" model="spp.cel.example">
        <field name="name">Minimum School Attendance Rate</field>
        <field name="expression">r.school_attendance_rate >= 80</field>
        <field
            name="description"
        >Individual must maintain at least 80% school attendance</field>
        <field name="category">compliance</field>
        <field name="target_type">individual</field>
        <field name="sequence">20</field>
    </record>

    <!-- Health-Related Compliance -->
    <record id="cel_compliance_health_checkup" model="spp.cel.example">
        <field name="name">Regular Health Checkups</field>
        <field name="expression">days_ago(r.last_health_checkup) &lt;= 180</field>
        <field name="description">Health checkup within last 6 months (180 days)</field>
        <field name="category">compliance</field>
        <field name="target_type">individual</field>
        <field name="sequence">30</field>
    </record>

    <record id="cel_compliance_children_vaccinated" model="spp.cel.example">
        <field name="name">Children Under 5 Vaccinated</field>
        <field
            name="expression"
        >members.count(m, age_years(m.birthdate) &lt; 5 and m.vaccinations_complete == false) == 0</field>
        <field
            name="description"
        >All children under 5 must have complete vaccinations</field>
        <field name="category">compliance</field>
        <field name="target_type">group</field>
        <field name="sequence">40</field>
    </record>

    <record id="cel_compliance_prenatal_care" model="spp.cel.example">
        <field name="name">Pregnant Women Prenatal Care</field>
        <field
            name="expression"
        >members.count(m, m.is_pregnant and m.prenatal_visits &lt; 4) == 0</field>
        <field
            name="description"
        >Pregnant household members must have at least 4 prenatal visits</field>
        <field name="category">compliance</field>
        <field name="target_type">group</field>
        <field name="sequence">50</field>
    </record>

    <!-- Documentation Compliance -->
    <record id="cel_compliance_id_valid" model="spp.cel.example">
        <field name="name">Valid Identification</field>
        <field name="expression">r.id_expiry_date >= today()</field>
        <field name="description">Beneficiary ID must not be expired</field>
        <field name="category">compliance</field>
        <field name="target_type">individual</field>
        <field name="sequence">60</field>
    </record>

    <record id="cel_compliance_address_verified" model="spp.cel.example">
        <field name="name">Address Verified Recently</field>
        <field name="expression">days_ago(r.address_verification_date) &lt;= 365</field>
        <field name="description">Address must be verified within the last year</field>
        <field name="category">compliance</field>
        <field name="target_type">both</field>
        <field name="sequence">70</field>
    </record>

    <!-- Training/Program Participation -->
    <record id="cel_compliance_training_complete" model="spp.cel.example">
        <field name="name">Training Program Completed</field>
        <field name="expression">r.training_hours >= 40</field>
        <field
            name="description"
        >Beneficiary completed at least 40 hours of training</field>
        <field name="category">compliance</field>
        <field name="target_type">individual</field>
        <field name="sequence">80</field>
    </record>

