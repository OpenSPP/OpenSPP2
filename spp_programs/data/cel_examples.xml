    <!-- Household Size Conditions -->
    <record id="cel_condition_large_household" model="spp.cel.example">
        <field name="name">Large Households (5+ members)</field>
        <field name="expression">hh_size >= 5</field>
        <field name="description">Households with 5 or more members</field>
        <field name="category">condition</field>
        <field name="target_type">group</field>
        <field name="sequence">80</field>
    </record>

    <record id="cel_condition_many_dependents" model="spp.cel.example">
        <field name="name">High Dependency Ratio</field>
        <field
            name="expression"
        >members.count(m, age_years(m.birthdate) &lt; 18 or age_years(m.birthdate) >= 60) >= 3</field>
        <field
            name="description"
        >Households with 3+ dependents (children or elderly)</field>
        <field name="category">condition</field>
        <field name="target_type">group</field>
        <field name="sequence">90</field>
    </record>

    <!-- Combined Criteria -->
    <record id="cel_condition_pregnant_lactating" model="spp.cel.example">
        <field name="name">Women of Reproductive Age</field>
        <field
            name="expression"
        >is_female(r.gender_id) and age_years(r.birthdate) >= 15 and age_years(r.birthdate) &lt;= 49</field>
        <field name="description">Women aged 15-49 (reproductive age)</field>
        <field name="category">condition</field>
        <field name="target_type">individual</field>
        <field name="sequence">100</field>
    </record>

    <record id="cel_condition_elderly_head" model="spp.cel.example">
        <field name="name">Elderly-Headed Households</field>
        <field
            name="expression"
        >members.exists(m, head(m) and age_years(m.birthdate) >= 60)</field>
        <field name="description">Households headed by someone 60 or older</field>
        <field name="category">condition</field>
        <field name="target_type">group</field>
        <field name="sequence">110</field>
    </record>

    <!-- ============================================================ -->
    <!-- CEL IN-KIND QUANTITY FORMULA EXAMPLES                        -->
    <!-- ============================================================ -->
    <!-- These formulas calculate in-kind item quantities based on beneficiary data -->

    <!-- Basic Quantity Formulas -->
    <record id="cel_inkind_fixed" model="spp.cel.example">
        <field name="name">Fixed Quantity</field>
        <field name="expression">10</field>
        <field name="description">Simple fixed quantity of 10 units</field>
        <field name="category">inkind_qty</field>
        <field name="target_type">both</field>
        <field name="sequence">10</field>
    </record>

    <record id="cel_inkind_per_member" model="spp.cel.example">
        <field name="name">Quantity Per Household Member</field>
        <field name="expression">hh_size * 2</field>
        <field name="description">2 units per household member</field>
        <field name="category">inkind_qty</field>
        <field name="target_type">group</field>
        <field name="sequence">20</field>
    </record>

    <record id="cel_inkind_base_plus_members" model="spp.cel.example">
        <field name="name">Base + Per Member</field>
        <field name="expression">base_quantity + hh_size</field>
        <field name="description">Base quantity plus 1 per household member</field>
        <field name="category">inkind_qty</field>
        <field name="target_type">group</field>
        <field name="sequence">30</field>
    </record>

    <!-- Child-Related Formulas -->
    <record id="cel_inkind_per_child" model="spp.cel.example">
        <field name="name">Quantity Per Child</field>
        <field name="expression">r.children_count * 3</field>
        <field name="description">3 units per child in household</field>
        <field name="category">inkind_qty</field>
        <field name="target_type">group</field>
        <field name="sequence">40</field>
    </record>

    <record id="cel_inkind_per_child_capped" model="spp.cel.example">
        <field name="name">Per Child with Maximum Cap</field>
        <field name="expression">min(r.children_count * 5, 25)</field>
        <field name="description">5 units per child, maximum 25 units</field>
        <field name="category">inkind_qty</field>
        <field name="target_type">group</field>
        <field name="sequence">50</field>
    </record>

