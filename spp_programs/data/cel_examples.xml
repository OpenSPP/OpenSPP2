<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!-- ================================================== -->
    <!-- CEL AMOUNT FORMULA EXAMPLES                        -->
    <!-- ================================================== -->
    <!-- These formulas calculate entitlement amounts dynamically based on beneficiary data -->

    <!-- Basic Amount Formulas -->
    <record id="cel_amount_fixed" model="spp.cel.example">
        <field name="name">Fixed Amount</field>
        <field name="expression">500</field>
        <field name="description">Simple fixed amount of 500</field>
        <field name="category">amount</field>
        <field name="target_type">both</field>
        <field name="sequence">10</field>
    </record>

    <record id="cel_amount_per_member" model="spp.cel.example">
        <field name="name">Amount Per Household Member</field>
        <field name="expression">hh_size * 100</field>
        <field name="description">100 currency units per household member</field>
        <field name="category">amount</field>
        <field name="target_type">group</field>
        <field name="sequence">20</field>
    </record>

    <record id="cel_amount_base_plus_dependents" model="spp.cel.example">
        <field name="name">Base + 10% Per Dependent</field>
        <field name="expression">base_amount * (1 + r.dependents_count * 0.1)</field>
        <field
            name="description"
        >Base amount increased by 10% for each dependent</field>
        <field name="category">amount</field>
        <field name="target_type">both</field>
        <field name="sequence">30</field>
    </record>

    <!-- Child-Related Formulas -->
    <record id="cel_amount_per_child" model="spp.cel.example">
        <field name="name">Per Child Amount</field>
        <field name="expression">r.children_count * 50</field>
        <field name="description">50 currency units per child in household</field>
        <field name="category">amount</field>
        <field name="target_type">group</field>
        <field name="sequence">40</field>
    </record>

    <record id="cel_amount_per_child_capped" model="spp.cel.example">
        <field name="name">Per Child with Maximum Cap</field>
        <field name="expression">min(r.children_count * 50, 500)</field>
        <field name="description">50 per child, maximum 500 total</field>
        <field name="category">amount</field>
        <field name="target_type">group</field>
        <field name="sequence">50</field>
    </record>

    <!-- Conditional Formulas -->
