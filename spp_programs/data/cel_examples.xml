    <!-- Household Size Tiers -->
    <record id="cel_inkind_household_tier" model="spp.cel.example">
        <field name="name">Tiered by Household Size</field>
        <field
            name="expression"
        >10 if hh_size &lt;= 3 else (20 if hh_size &lt;= 6 else 30)</field>
        <field
            name="description"
        >10 units for 1-3 members, 20 for 4-6, 30 for 7+</field>
        <field name="category">inkind_qty</field>
        <field name="target_type">group</field>
        <field name="sequence">80</field>
    </record>

    <!-- Food Ration Examples -->
    <record id="cel_inkind_rice_ration" model="spp.cel.example">
        <field name="name">Rice Ration (kg per person)</field>
        <field name="expression">hh_size * 5</field>
        <field name="description">5 kg of rice per household member</field>
        <field name="category">inkind_qty</field>
        <field name="target_type">group</field>
        <field name="sequence">90</field>
    </record>

    <record id="cel_inkind_cooking_oil" model="spp.cel.example">
        <field name="name">Cooking Oil (liters per household)</field>
        <field name="expression">max(2, hh_size)</field>
        <field name="description">1 liter per member, minimum 2 liters</field>
        <field name="category">inkind_qty</field>
        <field name="target_type">group</field>
        <field name="sequence">100</field>
    </record>

