        <field name="name">Work/Community Service Hours</field>
        <field name="expression">r.work_hours_month >= 20 or r.age >= 60 or r.disabled</field>
        <field name="description">20 work hours/month (exemptions: seniors 60+ and disabled)</field>
        <field name="category">compliance</field>
        <field name="target_type">individual</field>
        <field name="sequence">90</field>
    </record> -->

    <!-- Financial Compliance -->
    <record id="cel_compliance_bank_account" model="spp.cel.example">
        <field name="name">Active Bank Account</field>
        <field name="expression">r.has_bank_account == true</field>
        <field name="description">Beneficiary must have an active bank account</field>
        <field name="category">compliance</field>
        <field name="target_type">individual</field>
        <field name="sequence">100</field>
    </record>

    <record id="cel_compliance_income_threshold" model="spp.cel.example">
        <field name="name">Income Below Threshold</field>
        <field name="expression">r.monthly_income &lt;= 5000</field>
        <field
            name="description"
        >Monthly income must remain below 5000 threshold</field>
        <field name="category">compliance</field>
        <field name="target_type">both</field>
        <field name="sequence">110</field>
    </record>
</odoo>
