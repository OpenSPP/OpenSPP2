<odoo noupdate="1">
    <!-- Program Viewer Role -->
    <!-- For users who need read-only access to program data -->
    <record id="global_role_program_viewer" model="res.users.role">
        <field name="name">Program Viewer</field>
        <field name="role_type">global</field>
        <field
            name="comment"
        >Read-only access to program, cycle, and entitlement records.</field>
        <field
            name="implied_ids"
            eval="[
                Command.link(ref('base.group_user')),
                Command.link(ref('group_programs_viewer')),
            ]"
        />
    </record>

    <!-- Admin -->
    <record id="spp_user_roles.global_role_admin" model="res.users.role">
        <field
            name="implied_ids"
            eval="
            [
                Command.link(ref('spp_programs.group_programs_manager')),
            ]"
        />
    </record>

    <!-- Program Manager -->
    <record id="spp_user_roles.global_role_program_manager" model="res.users.role">
        <field
            name="implied_ids"
            eval="
            [
                Command.link(ref('spp_programs.group_programs_manager')),
                Command.link(ref('spp_registry.group_registry_viewer')),
                Command.link(ref('spp_registry.group_registry_write')),
                Command.link(ref('spp_cel_domain.group_cel_domain_viewer')),
                Command.link(ref('spp_approval.group_approval_approver')),
                Command.link(ref('job_worker.group_queue_job_manager')),
            ]"
        />
    </record>

    <!-- Finance -->
    <record id="spp_user_roles.global_role_finance" model="res.users.role">
        <field
            name="implied_ids"
            eval="
            [
                Command.link(ref('spp_programs.group_programs_validator')),
            ]"
        />
    </record>

    <!-- Program Validator -->
    <record id="global_role_program_validator" model="res.users.role">
        <field name="name">Global Program Validator</field>
        <field name="role_type">global</field>
        <field name="comment">This role allows users to validate programs.</field>
        <field
            name="implied_ids"
            eval="
            [
                Command.link(ref('base.group_user')),
                Command.link(ref('spp_programs.group_programs_validator')),
                Command.link(ref('spp_programs.group_programs_viewer')),
                Command.link(ref('spp_registry.group_registry_viewer')),
                Command.link(ref('spp_registry.group_registry_write')),
                Command.link(ref('spp_approval.group_approval_approver')),
            ]"
        />
    </record>

    <!-- Program Cycle Approver -->
    <record id="global_role_program_cycle_approver" model="res.users.role">
        <field name="name">Global Program Cycle Approver</field>
        <field name="role_type">global</field>
        <field name="comment">This role allows users to approve program cycles.</field>
        <field
            name="implied_ids"
            eval="
            [
                Command.link(ref('base.group_user')),
                Command.link(ref('spp_programs.group_programs_cycle_approver')),
                Command.link(ref('spp_programs.group_programs_viewer')),
                Command.link(ref('spp_registry.group_registry_viewer')),
                Command.link(ref('spp_registry.group_registry_write')),
                Command.link(ref('spp_approval.group_approval_approver')),
                Command.link(ref('job_worker.group_queue_job_manager')),
            ]"
        />
    </record>
</odoo>
