<?xml version="1.0" encoding="UTF-8"?>
<!--
    OpenSPP Programs - Approval Definitions

    Default approval definitions for cycles and entitlements.
    These can be customized per deployment.
-->
<odoo noupdate="1">
    <!--
        Cycle Approval Definition
        Requires cycle approver for cycles
    -->
    <record id="approval_definition_cycle" model="spp.approval.definition">
        <field name="name">Cycle Approval - Cycle Approver</field>
        <field name="model_id" ref="spp_programs.model_spp_cycle"/>
        <field name="approval_type">group</field>
        <field name="approval_group_id" ref="spp_programs.group_programs_cycle_approver"/>
        <field name="is_require_comment">False</field>
        <field name="notify_on_submit">True</field>
        <field name="sla_days">3</field>
        <field name="active">True</field>
    </record>

    <!--
        Entitlement Approval Definition
        Requires program validator approval for entitlements
    -->
    <record id="approval_definition_entitlement" model="spp.approval.definition">
        <field name="name">Entitlement Approval - Program Validator</field>
        <field name="model_id" ref="spp_programs.model_spp_entitlement"/>
        <field name="approval_type">group</field>
        <field name="approval_group_id" ref="spp_programs.group_programs_validator"/>
        <field name="is_require_comment">False</field>
        <field name="notify_on_submit">True</field>
        <field name="sla_days">3</field>
        <field name="active">True</field>
    </record>

    <!--
        In-Kind Entitlement Approval Definition
        Requires program validator approval for in-kind entitlements
    -->
    <record id="approval_definition_entitlement_inkind" model="spp.approval.definition">
        <field name="name">In-Kind Entitlement Approval - Program Validator</field>
        <field name="model_id" ref="spp_programs.model_spp_entitlement_inkind"/>
        <field name="approval_type">group</field>
        <field name="approval_group_id" ref="spp_programs.group_programs_validator"/>
        <field name="is_require_comment">False</field>
        <field name="notify_on_submit">True</field>
        <field name="sla_days">3</field>
        <field name="active">True</field>
    </record>
</odoo>
