    <record id="eligibility_template_elderly_headed" model="spp.cel.expression">
        <field name="name">Elderly-Headed Households (60+)</field>
        <field name="code">eligibility_elderly_headed</field>
        <field name="expression_type">filter</field>
        <field name="context_type">group</field>
        <field
            name="cel_expression"
        >members.exists(m, head(m) and age_years(m.birthdate) >= 60)</field>
        <field name="output_type">boolean</field>
        <field name="state">active</field>
        <field name="is_template">True</field>
        <field name="is_locked">False</field>
        <field name="sequence">42</field>
    </record>

