    <record id="eligibility_template_high_dependency" model="spp.cel.expression">
        <field name="name">High Dependency Ratio (3+ dependents)</field>
        <field name="code">eligibility_high_dependency</field>
        <field name="expression_type">filter</field>
        <field name="context_type">group</field>
        <field
            name="cel_expression"
        >members.count(m, age_years(m.birthdate) &lt; 18 or age_years(m.birthdate) >= 60) >= 3</field>
        <field name="output_type">boolean</field>
        <field name="state">active</field>
        <field name="is_template">True</field>
        <field name="is_locked">False</field>
        <field name="sequence">51</field>
    </record>

