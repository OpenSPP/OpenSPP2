"- age_years(me.birthdate) >= 60\n"
"- me.gender == 'female' and age_years(me.birthdate) >= 18\n"
"- members.exists(m, age_years(m.birthdate) < 5)\n"
"- metric('household.size') >= 4"

#. module: spp_programs
