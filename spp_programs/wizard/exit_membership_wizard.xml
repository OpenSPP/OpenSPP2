<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_exit_membership_wizard_form" model="ir.ui.view">
        <field name="name">spp.program.membership.exit.wizard.form</field>
        <field name="model">spp.program.membership.exit.wizard</field>
        <field name="arch" type="xml">
            <form string="Exit Program">
                <sheet>
                    <group>
                        <field name="membership_id" invisible="1" />
                        <field name="registrant_name" readonly="1" />
                        <field name="program_name" readonly="1" />
                        <field name="exit_date" />
                        <field
                            name="exit_reason"
                            placeholder="e.g. Graduated, Opted out, Moved out of service area"
                        />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_confirm_exit"
                        type="object"
                        string="Exit Program"
                        class="btn-danger"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
