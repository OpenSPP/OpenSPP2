<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="create_program_wizard_form_view_inherit_spp_programs_compliance_criteria" model="ir.ui.view">
        <field name="name">spp.program.create.wizard.view.form.inherit</field>
        <field name="model">spp.program.create.wizard</field>
        <field name="inherit_id" ref="spp_programs.create_program_wizard_form_view" />
        <field name="priority">1000000</field>
        <field name="arch" type="xml">
            <!-- Domain-based compliance is deprecated - CEL compliance is used instead -->
            <!-- Keep this view as a low-priority no-op to maintain backward compatibility -->
            <xpath expr="//form" position="attributes">
                <attribute name="data-compliance-deprecated">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
