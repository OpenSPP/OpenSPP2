<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_gis_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_gis_user" />
        <field name="comment">Can view GIS data and maps.</field>
    </record>

    <record id="group_gis_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="privilege_id" ref="privilege_gis_admin" />
        <field
            name="comment"
        >Full GIS management including configuration and data administration.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_gis_user'))]" />
    </record>

    <!-- Link admin group to spp_admin -->
    <record id="spp_security.group_spp_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_gis_admin'))]" />
    </record>
</odoo>
