<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!--
        OpenSPP-DR CEL data provider — links the CEL framework to the
        DCI source. default_ttl_seconds is the provider-level fallback
        for variables that don't override it.
    -->
    <record id="openspp_dr_provider" model="spp.data.provider">
        <field name="name">OpenSPP Disability Registry</field>
        <field name="code">openspp_dr</field>
        <field name="active" eval="True" />
        <field name="dci_data_source_id" ref="openspp_dr_source" />
        <field name="default_ttl_seconds">86400</field>
    </record>
</odoo>
