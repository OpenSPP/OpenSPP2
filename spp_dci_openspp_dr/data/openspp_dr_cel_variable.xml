<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!--
        Override spp_studio.var_has_disability so the semantic
        `has_disability` CEL accessor sources from the OpenSPP-DR
        instance over DCI instead of from a local res.partner field.

        spp_studio ships var_has_disability with source_type='field'
        reading res.partner.is_person_with_disability. Installing this
        preset replaces that source with the DR DCI provider —
        declaratively stating "the OpenSPP-DR instance is the authority
        for disability status in this deployment."

        The variable NAME and cel_accessor stay 'has_disability'
        (semantic, vendor-neutral, per ADR-023 §1a). Existing CEL rules
        that reference `has_disability == true` continue to work — they
        now evaluate against the cached DCI value instead of the local
        field.

        post_init_hook (spp_dci_openspp_dr/__init__.py) re-asserts these
        fields on every install/upgrade so drift from manual edits or
        cross-module data loads gets corrected automatically.
    -->
    <record id="spp_studio.var_has_disability" model="spp.cel.variable">
        <field name="source_type">external</field>
        <field name="source_model">res.partner</field>
        <field name="source_field" />
        <field name="external_provider_id" ref="openspp_dr_provider" />
        <field name="dci_attribute_path">has_disability</field>
        <field name="cache_strategy">ttl</field>
        <field name="cache_ttl_seconds">300</field>
        <field name="external_failure_policy">null</field>
        <field name="state">active</field>
        <field name="active" eval="True" />
    </record>
</odoo>
