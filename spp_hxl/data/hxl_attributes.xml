<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Gender Attributes -->
    <record id="hxl_attr_f" model="spp.hxl.attribute">
        <field name="code">+f</field>
        <field name="name">Female</field>
        <field name="description">Female gender disaggregation</field>
        <field name="category">gender</field>
        <field name="is_standard" eval="True" />
    </record>

    <record id="hxl_attr_m" model="spp.hxl.attribute">
        <field name="code">+m</field>
        <field name="name">Male</field>
        <field name="description">Male gender disaggregation</field>
