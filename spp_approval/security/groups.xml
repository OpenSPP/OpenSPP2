<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approval Domain Groups -->
    <!-- Following ADR-004 three-tier architecture -->

    <!-- Tier 3: Technical base groups -->
    <record id="group_approval_read" model="res.groups">
        <field name="name">Approval: Read</field>
        <field name="comment">Technical group for read access to approval models.</field>
    </record>

    <record id="group_approval_write" model="res.groups">
        <field name="name">Approval: Write</field>
        <field name="comment">Technical group for write access to approval models.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_approval_read'))]"/>
    </record>

    <record id="group_approval_create" model="res.groups">
        <field name="name">Approval: Create</field>
        <field name="comment">Technical group for create access to approval models.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_approval_read'))]"/>
    </record>

    <!-- Tier 2: User-facing groups -->
    <record id="group_approval_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_approval"/>
        <field name="comment">Can view approval records. Cannot modify data.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_approval_read'))]"/>
    </record>

    <record id="group_approval_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="privilege_id" ref="privilege_approval"/>
        <field name="comment">Can view and edit approval records. Cannot delete.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_approval_viewer')), Command.link(ref('group_approval_write')), Command.link(ref('group_approval_create'))]"/>
    </record>

    <record id="group_approval_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_approval"/>
        <field name="comment">Full approval management including delete operations.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_approval_officer'))]"/>
    </record>

    <!-- Special role: Approver (can approve/reject records) -->
    <!-- Uses separate privilege so it can be combined with basic roles -->
    <record id="group_approval_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="privilege_id" ref="privilege_approval_specialized"/>
        <field name="comment">SPECIALIZED ROLE: Can approve or reject records assigned to them. This is a functional role (not part of Viewer/Officer/Manager hierarchy). Inherits Viewer permissions. Assign alongside or instead of Officer based on workflow needs.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_approval_viewer'))]"/>
    </record>

    <!-- Link manager and approver to admin -->
    <!-- Admins get full management AND approver capabilities -->
    <record id="spp_security.group_spp_admin" model="res.groups">
        <field name="implied_ids" eval="[
            Command.link(ref('group_approval_manager')),
            Command.link(ref('group_approval_approver')),
        ]"/>
    </record>

    <!-- Backward compatibility: Map old group names to new ones -->
    <record id="group_approval_admin" model="res.groups">
        <field name="name">Approval Administrator (Deprecated)</field>
        <field name="comment">Deprecated: Use group_approval_manager instead. This group is kept for backward compatibility.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_approval_manager'))]"/>
    </record>
</odoo>
