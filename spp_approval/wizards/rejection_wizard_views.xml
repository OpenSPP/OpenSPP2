<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rejection Wizard Form View -->
    <record id="rejection_wizard_view_form" model="ir.ui.view">
        <field name="name">spp.approval.rejection.wizard.form</field>
        <field name="model">spp.approval.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Record">
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="reason" placeholder="Please provide a reason for rejection..." widget="text"/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
