<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Revision Request Wizard Form View -->
    <record id="revision_wizard_view_form" model="ir.ui.view">
        <field name="name">spp.approval.revision.wizard.form</field>
        <field name="model">spp.approval.revision.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Revision">
                <group>
                    <field name="res_model" invisible="1" />
                    <field name="res_id" invisible="1" />
                    <field
                        name="notes"
                        placeholder="Please describe what changes are needed..."
                        widget="text"
                    />
                </group>
                <footer>
                    <button
                        name="action_request_revision"
                        type="object"
                        string="Request Revision"
                        class="btn-warning"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
