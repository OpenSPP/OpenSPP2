<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_res_config_settings_form_inherit_spp_branding_kit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.openspp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="OpenSPP Branding" string="OpenSPP Branding" name="spp_branding_kit" logo="/spp_branding_kit/static/description/icon.png">
                    <block title="System Branding" name="spp_branding_block">
                        <setting help="Set your organization's system name for the interface">
                            <field name="spp_system_name" />
                        </setting>
                        <setting help="Display 'Powered by OpenSPP' branding">
                            <field name="is_spp_show_powered_by" />
                        </setting>
                        <setting help="Customize interface for OpenSPP-specific workflows">
                            <field name="is_spp_hide_odoo_referral" />
                        </setting>
                    </block>

                    <block title="Help &amp; Support" name="spp_links_block">
                        <setting help="Documentation link for your OpenSPP users">
                            <field name="spp_documentation_url" placeholder="https://docs.openspp.org" />
                        </setting>
                        <setting help="Support website for your OpenSPP implementation">
                            <field name="spp_support_url" placeholder="https://openspp.org" />
                        </setting>
                    </block>

                    <block title="Analytics &amp; Improvement" name="spp_telemetry_block">
                        <setting help="Help improve OpenSPP by sharing anonymous usage statistics">
                            <field name="is_spp_telemetry_enabled" />
                        </setting>
                        <setting
                            help="Analytics collection endpoint"
                            invisible="not is_spp_telemetry_enabled"
                        >
                            <field
                                name="spp_telemetry_endpoint"
                                placeholder="https://telemetry.openspp.org"
                            />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
