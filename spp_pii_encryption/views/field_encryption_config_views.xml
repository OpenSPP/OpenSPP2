<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- List View -->
    <record id="spp_field_encryption_config_list" model="ir.ui.view">
        <field name="name">spp.field.encryption.config.list</field>
        <field name="model">spp.field.encryption.config</field>
        <field name="arch" type="xml">
            <list decoration-muted="not encryption_enabled">
                <field name="model_id" />
                <field name="field_id" />
                <field name="encryption_enabled" widget="boolean_toggle" />
                <field name="blind_index_enabled" widget="boolean_toggle" />
                <field name="index_type" />
                <field name="index_field_name" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="spp_field_encryption_config_form" model="ir.ui.view">
        <field name="name">spp.field.encryption.config.form</field>
        <field name="model">spp.field.encryption.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_toggle_encryption"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-lock"
                        >
                            <field
                                name="encryption_enabled"
                                widget="boolean_button"
                                options='{"terminology": {"string_true": "Encrypted", "string_false": "Not Encrypted"}}'
                            />
                        </button>
                        <button
                            name="action_toggle_blind_index"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-search"
                        >
                            <field
                                name="blind_index_enabled"
                                widget="boolean_button"
                                options='{"terminology": {"string_true": "Searchable", "string_false": "Not Searchable"}}'
                            />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group string="Field Selection">
                            <field name="model_id" options="{'no_create': True}" />
                            <field name="field_id" options="{'no_create': True}" />
                        </group>
                        <group string="Encryption Settings">
                            <field name="encryption_enabled" />
                            <field
                                name="blind_index_enabled"
                                invisible="not encryption_enabled"
                            />
                            <field
                                name="index_type"
                                invisible="not blind_index_enabled"
                            />
                            <field
                                name="index_field_name"
                                readonly="1"
                                invisible="not blind_index_enabled"
                            />
                        </group>
                    </group>
                    <group string="Notes">
                        <field
                            name="notes"
                            nolabel="1"
                            placeholder="Optional notes about this encryption configuration..."
                        />
                    </group>
                    <group string="Technical Information" groups="base.group_no_one">
                        <field name="model_name" />
                        <field name="field_name" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="spp_field_encryption_config_search" model="ir.ui.view">
        <field name="name">spp.field.encryption.config.search</field>
        <field name="model">spp.field.encryption.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_id" />
                <field name="field_id" />
                <field name="model_name" />
                <field name="field_name" />
                <separator />
                <filter
                    name="filter_encrypted"
                    string="Encrypted"
                    domain="[('encryption_enabled', '=', True)]"
                />
                <filter
                    name="filter_not_encrypted"
                    string="Not Encrypted"
                    domain="[('encryption_enabled', '=', False)]"
                />
                <separator />
                <filter
                    name="filter_searchable"
                    string="Searchable"
                    domain="[('blind_index_enabled', '=', True)]"
                />
                <filter
                    name="filter_not_searchable"
                    string="Not Searchable"
                    domain="[('blind_index_enabled', '=', False)]"
                />
                <separator />
                <filter
                    name="filter_exact"
                    string="Exact Index"
                    domain="[('index_type', '=', 'exact')]"
                />
                <filter
                    name="filter_partial"
                    string="Partial Index"
                    domain="[('index_type', '=', 'partial')]"
                />
                <filter
                    name="filter_phonetic"
                    string="Phonetic Index"
                    domain="[('index_type', '=', 'phonetic')]"
                />
                <separator />
                <filter
                    name="filter_archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group name="group_by">
                    <filter
                        name="group_model"
                        string="Model"
                        context="{'group_by': 'model_id'}"
                    />
                    <filter
                        name="group_index_type"
                        string="Index Type"
                        context="{'group_by': 'index_type'}"
                    />
                    <filter
                        name="group_encrypted"
                        string="Encryption Status"
                        context="{'group_by': 'encryption_enabled'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="spp_field_encryption_config_action" model="ir.actions.act_window">
        <field name="name">Field Encryption Configuration</field>
        <field name="res_model">spp.field.encryption.config</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="spp_field_encryption_config_search" />
        <field name="context">{'search_default_filter_encrypted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure field-level encryption
            </p>
            <p>
                Select which fields should be encrypted with AES-256-GCM.
                Enable blind indexes to allow searching encrypted values without decryption.
            </p>
            <p>
                <b>Index Types:</b>
                <ul>
                    <li><b>Exact Match:</b> Full value matching (normalized)</li>
                    <li><b>Partial (Last 4):</b> Match last 4 characters only</li>
                    <li><b>Phonetic (Soundex):</b> Sound-alike matching for names</li>
                </ul>
            </p>
        </field>
    </record>
</odoo>
