<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Portal home card -->
    <template
        id="portal_my_home_change_requests"
        inherit_id="portal.portal_my_home"
        priority="40"
    >
        <xpath expr="//div[@id='portal_common_category']" position="before">
            <div
                class="o_portal_category row g-2 mt-3"
                id="portal_change_request_category"
            >
                <t t-call="portal.portal_docs_entry">
                    <t
                        t-set="icon"
                        t-value="'/spp_demo_child_benefit/static/src/img/change_request.svg'"
                    />
                    <t t-set="title">Change Requests</t>
                    <t t-set="url" t-value="'/my/change-requests'" />
                    <t
                        t-set="text"
                    >Update your family's information and track the approval</t>
                    <t t-set="config_card" t-value="True" />
                </t>
            </div>
        </xpath>
    </template>

    <!-- Breadcrumbs -->
    <template
        id="portal_breadcrumbs_change_requests"
        inherit_id="portal.portal_breadcrumbs"
        priority="40"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li
                t-if="page_name == 'change_requests'"
                t-attf-class="breadcrumb-item #{'active' if not (change_request or change_request_detail) else ''}"
            >
                <a
                    t-if="change_request or change_request_detail"
                    href="/my/change-requests"
                >Change Requests</a>
                <t t-else="">Change Requests</t>
            </li>
            <li
                t-if="page_name == 'change_requests' and change_request == 'new'"
                class="breadcrumb-item active"
            >
                New Request
            </li>
            <li
                t-if="page_name == 'change_requests' and change_request_detail"
                class="breadcrumb-item active"
            >
                <t t-out="change_request.name" />
            </li>
        </xpath>
    </template>

    <!-- List -->
    <template id="portal_my_change_requests" name="My Change Requests">
        <t t-call="portal.portal_layout">
            <t t-call="spp_child_benefit.portal_page_header">
                <t t-set="page_title">Change Requests</t>
                <t
                    t-set="page_subtitle"
                >Ask the programme to update the information it holds about you or your family. Nothing changes until a programme officer has approved the request.</t>
                <a
                    href="/my/change-requests/new"
                    class="btn btn-primary"
                >New Request</a>
            </t>
            <t t-if="not change_requests" t-call="spp_child_benefit.portal_empty_state">
                <t t-set="empty_title">No change requests yet</t>
                <t t-set="empty_text">Submit one when your family's details change.</t>
                <a
                    href="/my/change-requests/new"
                    class="btn btn-primary"
                >New Request</a>
            </t>
            <t t-if="change_requests" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Concerns</th>
                        <th class="d-none d-md-table-cell">Type</th>
                        <th class="d-none d-md-table-cell">Submitted</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="change_requests" t-as="cr">
                        <tr>
                            <td>
                                <a t-attf-href="/my/change-requests/#{cr.id}">
                                    <strong t-out="cr.name" />
                                </a>
                            </td>
                            <td>
                                <span t-out="cr.registrant_id.name" />
                            </td>
                            <td class="d-none d-md-table-cell">
                                <span t-out="cr.request_type_id.name" />
                            </td>
                            <td class="d-none d-md-table-cell">
                                <span t-field="cr.create_date" />
                            </td>
                            <td>
                                <span
                                    t-attf-class="badge o_spp_badge--#{'ok' if cr.approval_state == 'approved' else 'danger' if cr.approval_state == 'rejected' else 'warn' if cr.approval_state == 'revision' else 'info'}"
                                    t-out="state_labels.get(cr.approval_state, cr.approval_state)"
                                />
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <!-- New request -->
    <template id="portal_change_request_new" name="New Change Request">
        <t t-call="portal.portal_layout">
            <t t-set="title">New Change Request</t>
            <t t-call="spp_child_benefit.portal_page_header">
                <t t-set="page_title">New Change Request</t>
                <t
                    t-set="page_subtitle"
                >Correct details for yourself or a family member. Nothing changes until a programme officer approves.</t>
            </t>
            <div class="o_spp_panel">
                <h2>Who is this request for?</h2>
                <!-- Picking a family member reloads the form with that person's current values. -->
                <form action="/my/change-requests/new" method="get" class="mb-3">
                    <label
                        for="registrant_picker"
                        class="form-label"
                    >This request concerns</label>
                    <select
                        id="registrant_picker"
                        name="registrant_id"
                        class="form-select"
                        onchange="this.form.submit()"
                    >
                        <t t-foreach="family_members" t-as="member">
                            <option
                                t-att-value="member.id"
                                t-att-selected="'selected' if member == registrant else None"
                            >
                                <t t-out="member.name" />
                                <t
                                    t-if="member == request.env.user.partner_id"
                                > (myself)</t>
                            </option>
                        </t>
                    </select>
                    <div
                        class="form-text"
                    >Yourself, or a member of your family on whose behalf you are filing.</div>
                </form>
            </div>
            <form action="/my/change-requests/submit" method="post" class="mt-3">
                <input
                    type="hidden"
                    name="csrf_token"
                    t-att-value="request.csrf_token()"
                />
                <input type="hidden" name="registrant_id" t-att-value="registrant.id" />
                <div class="o_spp_panel">
                    <h2>Details to correct</h2>
                    <p
                        class="form-text mb-3"
                    >The current values are shown. Leave a field as it is to keep the current value.</p>
                    <div class="row">
                        <t t-foreach="fields" t-as="field">
                            <t t-set="name" t-value="field[0]" />
                            <t t-set="label" t-value="field[1]" />
                            <t t-set="kind" t-value="field[2]" />
                            <t t-set="value" t-value="current.get(name)" />
                            <div class="col-12 col-md-6 mb-3">
                                <label
                                    t-att-for="name"
                                    class="form-label"
                                    t-out="label"
                                />
                                <t t-if="kind == 'gender'">
                                    <select
                                        t-att-id="name"
                                        t-att-name="name"
                                        class="form-select"
                                    >
                                        <option value="">—</option>
                                        <t t-foreach="genders" t-as="gender">
                                            <option
                                                t-att-value="gender.id"
                                                t-att-selected="'selected' if value and gender.id == value.id else None"
                                                t-out="gender.display or gender.code"
                                            />
                                        </t>
                                    </select>
                                </t>
                                <t t-elif="kind == 'date'">
                                    <input
                                        type="date"
                                        t-att-id="name"
                                        t-att-name="name"
                                        class="form-control"
                                        t-att-value="value and value.isoformat() or ''"
                                    />
                                </t>
                                <t t-else="">
                                    <input
                                        type="text"
                                        t-att-id="name"
                                        t-att-name="name"
                                        class="form-control"
                                        t-att-value="value or ''"
                                    />
                                </t>
                            </div>
                        </t>
                    </div>
                    <div class="mb-1">
                        <label
                            for="reason"
                            class="form-label"
                        >Reason for the change</label>
                        <textarea
                            id="reason"
                            name="reason"
                            class="form-control"
                            rows="3"
                        />
                    </div>
                </div>
                <div class="o_spp_form_actions">
                    <button
                        type="submit"
                        class="btn btn-primary"
                    >Submit for approval</button>
                    <a
                        href="/my/change-requests"
                        class="btn btn-outline-secondary"
                    >Cancel</a>
                </div>
            </form>
        </t>
    </template>

    <!-- Detail -->
    <template id="portal_change_request_detail" name="Change Request">
        <t t-call="portal.portal_layout">
            <t t-set="title" t-value="change_request.name" />
            <t t-call="spp_child_benefit.portal_page_header">
                <t t-set="page_title" t-value="change_request.name" />
                <t
                    t-set="page_subtitle"
                    t-value="change_request.request_type_id.name"
                />
                <span
                    t-attf-class="badge o_spp_badge--#{'ok' if change_request.approval_state == 'approved' else 'danger' if change_request.approval_state == 'rejected' else 'warn' if change_request.approval_state == 'revision' else 'info'}"
                    t-out="state_label"
                />
            </t>
            <dl class="row mb-3">
                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9" t-out="change_request.request_type_id.name" />
                <dt class="col-sm-3">Concerns</dt>
                <dd class="col-sm-9" t-out="change_request.registrant_id.name" />
                <dt class="col-sm-3">Submitted</dt>
                <dd class="col-sm-9">
                    <span t-field="change_request.create_date" />
                </dd>
                <t t-if="change_request.description">
                    <dt class="col-sm-3">Reason</dt>
                    <dd class="col-sm-9" t-out="change_request.description" />
                </t>
                <t t-if="review_comment">
                    <dt class="col-sm-3">Reviewer's comment</dt>
                    <dd class="col-sm-9" t-out="review_comment" />
                </t>
            </dl>
            <t t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Field</th>
                        <th>Current</th>
                        <th>Requested</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="rows" t-as="row">
                        <tr
                            t-att-class="'o_spp_row_changed' if row['changed'] else None"
                        >
                            <td t-out="row['label']" />
                            <td>
                                <t t-out="row['current'] or '—'" />
                            </td>
                            <td>
                                <strong
                                    t-if="row['changed']"
                                    t-out="row['proposed'] or '—'"
                                />
                                <t t-else="" t-out="row['proposed'] or '—'" />
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
            <p class="text-muted small">
                Highlighted rows are the changes you requested. Your record is updated only once the request is
                approved.
            </p>
        </t>
    </template>
</odoo>
