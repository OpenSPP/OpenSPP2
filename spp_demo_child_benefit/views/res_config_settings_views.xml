<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_demo_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.demo.child.benefit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="30" />
        <field name="inherit_id" ref="spp_registry.res_config_settings_registry_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='registry_settings']" position="inside">
                <block
                    title="Demonstration Environment"
                    name="demo_environment_block"
                    groups="base.group_system"
                >
                    <setting
                        string="Create Demonstration Environment"
                        help="Creates the demonstration programme, families, enrolled
                              beneficiaries, schedules, cycle and users. Safe to click
                              twice: it does nothing when the environment already exists."
                    >
                        <field name="demo_environment_ready" invisible="1" />
                        <div class="mt8">
                            <button
                                name="action_create_demo_environment"
                                type="object"
                                string="Create Demo Environment"
                                class="btn-primary"
                                invisible="demo_environment_ready"
                            />
                            <span
                                class="badge text-bg-success"
                                invisible="not demo_environment_ready"
                            >Ready</span>
                            <span
                                class="text-muted ms-2"
                                invisible="not demo_environment_ready"
                            >
                                <field name="demo_beneficiary_count" readonly="1" class="me-1" />
                                enrolled beneficiaries
                            </span>
                        </div>
                    </setting>
                    <setting
                        string="Localization Pack"
                        help="Optional JSON pack that renames the demonstration data
                              (programme name, currency, banks, areas, people) into a
                              country's own terms. Stored and re-applied automatically
                              whenever the environment is re-created."
                    >
                        <div class="mt8">
                            <field
                                name="demo_localization_file"
                                filename="demo_localization_filename"
                                widget="binary"
                            />
                            <field name="demo_localization_filename" invisible="1" />
                            <button
                                name="action_apply_demo_localization"
                                type="object"
                                string="Apply Localization"
                                class="btn-secondary mt8"
                            />
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
