<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="user_programme_officer" model="res.users">
        <field name="name">Programme Officer</field>
        <field name="login">officer</field>
        <!-- Demo boxes have no mail server: notify staff in the inbox, never by e-mail. -->
        <field name="notification_type">inbox</field>
        <field name="password">Cbp-Officer-Demo-2026!</field>
        <field
            name="group_ids"
            eval="[Command.link(ref('base.group_user')), Command.link(ref('spp_programs.group_programs_officer')), Command.link(ref('spp_registry.group_registry_officer')), Command.link(ref('spp_change_request_v2.group_cr_user'))]"
        />
    </record>
    <record id="user_programme_manager" model="res.users">
        <field name="name">Programme Manager</field>
        <field name="login">manager</field>
        <field name="notification_type">inbox</field>
        <field name="password">Cbp-Manager-Demo-2026!</field>
        <field
            name="group_ids"
            eval="[Command.link(ref('base.group_user')), Command.link(ref('spp_programs.group_programs_manager')), Command.link(ref('spp_registry.group_registry_manager')), Command.link(ref('spp_change_request_v2.group_cr_manager'))]"
        />
    </record>
</odoo>
