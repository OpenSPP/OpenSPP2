<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
    Hardening for the demo's portal login.

    Stock spp_grm scopes portal users to their own tickets (read-only ACL plus
    an own-partner record rule), but it still grants base.group_portal read on
    the staff team roster and the SLA rules. That is latent until a portal user
    exists; this demo creates several, so we remove those reads here.

    This override lives in the demo module to keep stock spp_grm untouched; the
    underlying gap is tracked as a follow-up for spp_grm itself.
    -->
    <record id="spp_grm.access_spp_grm_team_portal_user" model="ir.model.access">
        <field name="perm_read">0</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="spp_grm.access_spp_grm_sla_rule_portal_user" model="ir.model.access">
        <field name="perm_read">0</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>
