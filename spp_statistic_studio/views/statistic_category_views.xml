<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════════
         METRIC CATEGORY VIEWS (Statistic Categories)
         Note: Migrated from spp.statistic.category to spp.metric.category
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- List View -->
    <record id="spp_metric_category_view_list" model="ir.ui.view">
        <field name="name">spp.metric.category.view.list</field>
        <field name="model">spp.metric.category</field>
        <field name="arch" type="xml">
            <list string="Metric Categories" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="spp_metric_category_view_form" model="ir.ui.view">
        <field name="name">spp.metric.category.view.form</field>
        <field name="model">spp.metric.category</field>
        <field name="arch" type="xml">
            <form string="Metric Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Demographics"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Identity">
                            <field name="code" placeholder="e.g., demographics"/>
                            <field name="description" placeholder="Description of this category..."/>
                            <field name="sequence"/>
                            <field name="parent_id"/>
                            <field name="active" invisible="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="spp_metric_category_view_search" model="ir.ui.view">
        <field name="name">spp.metric.category.view.search</field>
        <field name="model">spp.metric.category</field>
        <field name="arch" type="xml">
            <search string="Metric Categories">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="spp_metric_category_action" model="ir.actions.act_window">
        <field name="name">Metric Categories</field>
        <field name="res_model">spp.metric.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="spp_metric_category_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first metric category
            </p>
            <p>
                Categories help organize metrics by theme (Demographics, Vulnerability, Programs, etc.)
            </p>
        </field>
    </record>

</odoo>
