<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Statistics Menus for Studio
        ===========================
        Adds Statistics configuration under Studio > Settings
    -->

    <!-- Statistics - under Settings (seq 50, before Versioning) -->
    <menuitem
        id="menu_settings_statistics"
        name="Statistics"
        parent="spp_studio.menu_studio_config"
        sequence="50"
        groups="spp_studio.group_studio_manager"
    />

    <!-- All Statistics -->
    <menuitem
        id="menu_statistic_list"
        name="All Statistics"
        parent="menu_settings_statistics"
        action="spp_statistic_action"
        sequence="10"
        groups="spp_studio.group_studio_manager"
    />

    <!-- Statistic Categories -->
    <menuitem
        id="menu_statistic_category_list"
        name="Categories"
        parent="menu_settings_statistics"
        action="spp_metric_category_action"
        sequence="20"
        groups="spp_studio.group_studio_manager"
    />
</odoo>
