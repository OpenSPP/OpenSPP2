<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Configuration parameters for DCI client compliance testing -->

    <!-- Mock registry URL (can be overridden for different environments) -->
    <record id="config_mock_registry_url" model="ir.config_parameter">
        <field name="key">dci.client_compliance.mock_registry_url</field>
        <field name="value">http://mock_registry:3335</field>
    </record>

    <!-- Bearer token for compliance testing -->
    <record id="config_bearer_token" model="ir.config_parameter">
        <field name="key">dci.client_compliance.bearer_token</field>
        <field name="value">compliance-test-api-key-12345</field>
    </record>

    <!-- Test data source pointing to mock registry -->
    <record id="test_data_source" model="spp.dci.data.source" forcecreate="false">
        <field name="name">DCI Compliance Test</field>
        <field name="code">dci_compliance_test</field>
        <field name="base_url">http://mock_registry:3335</field>
        <field name="registry_type">social</field>
        <field name="our_sender_id">spmis.compliance.test</field>
        <field name="our_callback_uri">http://openspp.dci.local:8069/dci/callback</field>
        <field name="is_compliance_test">True</field>
        <field name="state">active</field>
        <field name="auth_type">bearer</field>
        <field name="bearer_token">compliance-test-api-key-12345</field>
    </record>

</odoo>
