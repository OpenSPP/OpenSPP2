<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Aggregation Domain Category -->
    <record id="category_spp_aggregation" model="ir.module.category">
        <field name="name">Analytics Engine</field>
        <field name="description">Analytics queries and statistical analysis</field>
        <field name="parent_id" ref="spp_security.category_spp" />
        <field name="sequence">36</field>
    </record>

    <!-- Aggregation Privilege -->
    <record id="privilege_aggregation" model="res.groups.privilege">
        <field name="name">Analytics</field>
        <field name="category_id" ref="category_spp_aggregation" />
        <field
            name="description"
        >Access to analytics queries and statistical analysis</field>
    </record>

    <!-- Tier 3: Technical base groups -->
    <record id="group_aggregation_read" model="res.groups">
        <field name="name">Aggregation: Read</field>
        <field
            name="comment"
        >Technical group for read access to aggregation models.</field>
    </record>

    <record id="group_aggregation_write" model="res.groups">
        <field name="name">Aggregation: Write</field>
        <field
            name="comment"
        >Technical group for write access to aggregation models.</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_aggregation_read'))]"
        />
    </record>

    <!-- Tier 2: User-facing groups -->
    <record id="group_aggregation_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_aggregation" />
        <field
            name="comment"
        >Can view aggregate statistics only. No individual records.</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_aggregation_read'))]"
        />
    </record>

    <record id="group_aggregation_officer" model="res.groups">
        <field name="name">Analyst</field>
        <field name="privilege_id" ref="privilege_aggregation" />
        <field
            name="comment"
        >Can query aggregations with individual record access.</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_aggregation_viewer')), Command.link(ref('group_aggregation_write'))]"
        />
    </record>

    <record id="group_aggregation_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_aggregation" />
        <field
            name="comment"
        >Full aggregation management including scope and access rule configuration.</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_aggregation_officer'))]"
        />
    </record>

    <!-- Link manager to admin -->
    <record id="spp_security.group_spp_admin" model="res.groups">
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_aggregation_manager'))]"
        />
    </record>
</odoo>
