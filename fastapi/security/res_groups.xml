<odoo>
    <!-- FastAPI Groups -->
    <record id="group_fastapi_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_fastapi_user" />
        <field name="comment">Can access FastAPI endpoints.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <record id="group_fastapi_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_fastapi_manager" />
        <field
            name="comment"
        >Full FastAPI management including endpoint configuration and administration.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_fastapi_user'))]" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
    </record>

    <!-- Link manager group to admin -->
    <record id="spp_security.group_spp_admin" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_fastapi_manager'))]" />
    </record>

    <!-- create a basic group providing the minimal access rights to retrieve
     the user running the endpoint handlers and performs authentication -->
    <record id="group_fastapi_endpoint_runner" model="res.groups">
        <field name="name">FastAPI Endpoint Runner</field>
        <field name="privilege_id" ref="privilege_fastapi_endpoint_runner" />
        <field
            name="comment"
        >Technical group for users running FastAPI endpoint handlers.</field>
    </record>
</odoo>
