<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Registry Domain Privilege -->
    <!-- Single consolidated privilege for all registry access levels -->

    <record id="privilege_registry" model="res.groups.privilege">
        <field name="name">Registry</field>
        <field name="category_id" ref="spp_security.category_spp_registry" />
        <field name="description">Access to registry management system</field>
    </record>

    <!-- Specialized Roles Privilege -->
    <!-- Separate privilege for functional roles that can be combined with basic access levels -->

    <record id="privilege_registry_specialized" model="res.groups.privilege">
        <field name="name">Registry: Specialized Roles</field>
        <field name="category_id" ref="spp_security.category_spp_registry" />
        <field
            name="description"
        >Specialized functional roles for registry security (Restrict Access To Self)</field>
    </record>
</odoo>
