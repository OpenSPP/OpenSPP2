<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
        <!-- Registry Domain Record Rules -->
        <!-- Following ADR-004 naming convention: rule_{model}_{purpose} -->

        <!-- Self access rules -->
        <record id="rule_res_users_self" model="ir.rule">
            <field name="name">Res Users: Self Access Only</field>
            <field name="model_id" ref="base.model_res_users" />
            <field name="global" eval="False" />
            <field name="domain_force">[('id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_registry_restrict_self'))]" />
        </record>

        <record id="rule_res_partner_self" model="ir.rule">
            <field name="name">Res Partner: Self Access Only</field>
            <field name="model_id" ref="base.model_res_partner" />
            <field name="global" eval="False" />
            <field name="domain_force">[('id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_registry_restrict_self'))]" />
        </record>

        <!-- Menu visibility aligned with menu group restrictions -->
        <!-- DISABLED: This rule was causing access issues for system users during module installation -->
        <!-- Menu visibility should be handled by menu 'groups' attributes, not record rules -->
        <!-- Record rules on ir.ui.menu can interfere with system operations and module installation -->
        <!--
        <record id="rule_ir_ui_menu_registry_visibility" model="ir.rule">
            <field name="name">Menu: Registry Visibility</field>
            <field name="model_id" ref="base.model_ir_ui_menu" />
            <field name="domain_force">['|', ('group_ids', '=', False), ('group_ids', 'in', user._get_group_ids())]</field>
            <field name="global" eval="False" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
            <field name="groups" eval="[Command.link(ref('base.group_user'))]" />
        </record>
        -->

        <!-- Group membership rules -->
        <!-- Global rules to exclude disabled registrants from membership queries -->
        <record model="ir.rule" id="rule_spp_group_membership_group">
            <field name="name">Group Membership: Exclude Disabled Groups</field>
            <field name="model_id" ref="model_spp_group_membership" />
            <field name="domain_force">[("group.disabled", "=", False)]</field>
            <field name="global" eval="True" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
        </record>

        <record model="ir.rule" id="rule_spp_group_membership_individual">
            <field name="name">Individual Membership: Exclude Disabled Individuals</field>
            <field name="model_id" ref="model_spp_group_membership" />
            <field name="domain_force">[("individual.disabled", "=", False)]</field>
            <field name="global" eval="True" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
        </record>
</odoo>
