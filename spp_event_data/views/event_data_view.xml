<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!-- EVENT DATA VIEWS -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <record id="view_spp_event_data_tree" model="ir.ui.view">
        <field name="name">spp.event.data.tree</field>
        <field name="model">spp.event.data</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('cancelled', 'expired', 'superseded')"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'pending'">
                <button
                    name="open_form"
                    type="object"
                    icon="fa-external-link"
                    title="Open Form"
                    class="btn-success"
                    invisible="not data_record_id and not res_id"
                />
                <field name="event_type_id" optional="show" />
                <field name="event_type_code" optional="hide" />
                <field name="partner_id" />
                <field name="name" />
                <field name="collection_date" />
                <field name="collector_id" optional="hide" />
                <field name="collector_name" optional="hide" />
                <field name="source_type" optional="show" />
                <field name="source_reference" optional="hide" />
                <field name="expiry_date" optional="show" />
                <!-- change_request_count field added by spp_change_request module -->
                <field
                    name="state"
                    decoration-success="state == 'active'"
                    decoration-warning="state == 'pending'"
                    decoration-info="state == 'draft'"
                    decoration-muted="state in ('cancelled', 'expired', 'superseded', 'inactive')"
                    widget="badge"
                />
                <field
                    name="approval_state"
                    optional="show"
                    decoration-success="approval_state == 'approved'"
                    decoration-warning="approval_state == 'pending'"
                    decoration-info="approval_state == 'draft'"
                    decoration-danger="approval_state == 'rejected'"
                    widget="badge"
                />
                <!-- Legacy fields (hidden by default) -->
                <field name="model" optional="hide" />
                <field name="res_id" optional="hide" />
                <field name="registrar" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_spp_event_data_form" model="ir.ui.view">
        <field name="name">spp.event.data.form</field>
        <field name="model">spp.event.data</field>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Standard state actions -->
                    <button name="action_activate" string="Activate"
                            type="object" class="btn-primary"
                            invisible="state != 'draft' or event_type_id.is_requires_approval" />
                    <button name="action_cancel" string="Cancel"
                            class="btn-danger"
                            type="object"
                            invisible="state in ('cancelled', 'expired', 'superseded')" />
                    <button name="action_set_draft" string="Reset to Draft"
                            type="object"
                            invisible="state not in ('cancelled',)" />
                    <button name="open_form" type="object"
                            class="btn-primary" icon="fa-external-link"
                            invisible="not data_record_id and not res_id"
                            string="View Data" />
                    <!-- Approval workflow buttons -->
                    <button name="action_submit_for_approval" string="Submit for Approval"
                            type="object" class="btn-primary"
                            invisible="approval_state != 'draft' or not event_type_id.is_requires_approval"/>
                    <button name="action_approve" string="Approve"
                            type="object" class="btn-success"
                            invisible="not can_approve"/>
                    <button name="action_reject" string="Reject"
                            type="object" class="btn-danger"
                            invisible="not can_reject"/>
                    <button name="action_reset_to_draft" string="Reset to Draft"
                            type="object"
                            invisible="approval_state not in ('rejected', 'revision')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,active" />
                </header>
                <sheet>
                    <group>
                        <group string="Event Information">
                            <field name="event_type_id" options="{'no_create': True}" />
                            <field name="event_type_code" invisible="1" />
                            <field name="partner_id" readonly="state != 'draft'"
                                   options="{'no_create': True}" />
                            <field name="name" readonly="1" />
                        </group>
                        <group string="Collection Details">
                            <field name="collection_date" readonly="state != 'draft'" />
                            <field name="collector_id" />
                            <field name="collector_name" />
                            <field name="expiry_date" />
                            <field name="is_expired" invisible="1" />
                        </group>
                    </group>

                    <notebook>
                        <!-- Event Data Tab -->
                        <page string="Event Data" name="event_data">
                            <field name="data_json" invisible="1"/>
                            <style>
                                .o_event_data_list {
                                    font-size: 0.9rem;
                                }
                                .o_event_data_list .d-flex {
                                    padding: 4px 0;
                                    border-bottom: 1px solid #f0f0f0;
                                }
                                .o_event_data_list .d-flex:last-child {
                                    border-bottom: none;
                                }
                                .o_event_data_list strong {
                                    font-size: 0.95rem;
                                }
                            </style>
                            <div invisible="not data_json">
                                <field name="data_html" nolabel="1" readonly="1"/>
                            </div>
                            <div invisible="data_json" class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle me-2" title="Info"/>
                                <span>
                                    Event data is stored in a dedicated model.
                                    Click "View Data" to see the details.
                                </span>
                            </div>
                        </page>

                        <!-- Source Information Tab -->
                        <page string="Source" name="source"
                              invisible="source_type == 'internal'">
                            <group>
                                <group>
                                    <field name="source_type" readonly="1" />
                                    <field name="source_reference" />
                                    <field name="source_url" widget="url" />
                                </group>
                                <group>
                                    <field name="source_received_date" />
                                </group>
                            </group>
                            <group string="Raw Source Data" invisible="not source_raw_data">
                                <field name="source_raw_data" widget="json" nolabel="1" />
                            </group>
                        </page>

                        <!-- Supersede Information Tab -->
                        <page string="History" name="history">
                            <group>
                                <group>
                                    <field name="supersedes_id" readonly="1" />
                                </group>
                                <group>
                                    <field name="superseded_by_id" readonly="1" />
                                </group>
                            </group>
                        </page>

                        <!-- Legacy Tab (for backward compatibility) -->
                        <page string="Legacy Data" name="legacy"
                              invisible="not model">
                            <group>
                                <group>
                                    <field name="model" readonly="1" />
                                    <field name="res_id" readonly="1" />
                                </group>
                                <group>
                                    <field name="registrar" readonly="1" />
                                </group>
                            </group>
                        </page>

                        <!-- Approval Tab (from spp.approval.mixin) -->
                        <page string="Approval" name="approval"
                              invisible="not event_type_id.is_requires_approval">
                            <group>
                                <group string="Approval Status">
                                    <field name="approval_state" readonly="1"/>
                                    <field name="can_submit" invisible="1"/>
                                    <field name="can_approve" invisible="1"/>
                                    <field name="can_reject" invisible="1"/>
                                </group>
                                <group string="Submission">
                                    <field name="submitted_by_id" readonly="1"/>
                                    <field name="submitted_date" readonly="1"/>
                                </group>
                            </group>
                            <group invisible="approval_state not in ('approved', 'rejected', 'revision')">
                                <group string="Approval Details"
                                       invisible="approval_state != 'approved'">
                                    <field name="approved_by_id" readonly="1"/>
                                    <field name="approved_date" readonly="1"/>
                                </group>
                                <group string="Rejection Details"
                                       invisible="approval_state != 'rejected'">
                                    <field name="rejected_by_id" readonly="1"/>
                                    <field name="rejected_date" readonly="1"/>
                                    <field name="rejection_reason" readonly="1"/>
                                </group>
                                <group string="Revision Request"
                                       invisible="approval_state != 'revision'">
                                    <field name="revision_requested_by_id" readonly="1"/>
                                    <field name="revision_requested_date" readonly="1"/>
                                    <field name="revision_notes" readonly="1"/>
                                </group>
                            </group>
                            <group string="Approval Reviews">
                                <field name="approval_review_ids" nolabel="1" readonly="1">
                                    <list>
                                        <field name="requested_date"/>
                                        <field name="requested_by_id"/>
                                        <field name="status" widget="badge"
                                               decoration-success="status == 'approved'"
                                               decoration-warning="status == 'pending'"
                                               decoration-danger="status == 'rejected'"/>
                                        <field name="reviewer_id"/>
                                        <field name="review_date"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_spp_event_data_search" model="ir.ui.view">
        <field name="name">spp.event.data.search</field>
        <field name="model">spp.event.data</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="partner_id" />
                <field name="event_type_id" />
                <field name="event_type_code" />
                <field name="source_reference" />
                <separator />
                <filter name="active" string="Active" domain="[('state', '=', 'active')]" />
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]" />
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]" />
                <separator />
                <filter name="expired" string="Expired" domain="[('is_expired', '=', True)]" />
                <separator />
                <filter name="today" string="Today"
                        domain="[('collection_date', '=', context_today().strftime('%Y-%m-%d'))]" />
                <filter name="this_week" string="This Week"
                        domain="[('collection_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]" />
                <filter name="this_month" string="This Month"
                        domain="[('collection_date', '>=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]" />
                <separator />
                <filter name="group_type" string="Event Type" context="{'group_by': 'event_type_id'}" />
                <filter name="group_state" string="State" context="{'group_by': 'state'}" />
                <filter name="group_source" string="Source Type" context="{'group_by': 'source_type'}" />
                <filter name="group_partner" string="Registrant" context="{'group_by': 'partner_id'}" />
                <filter name="group_date" string="Collection Date" context="{'group_by': 'collection_date:month'}" />
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_spp_event_data" model="ir.actions.act_window">
        <field name="name">Event Data</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">spp.event.data</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No events found
            </p>
            <p>
                Events are created from surveys, field visits, or external system syncs.
                Configure Event Types first to define the structure.
            </p>
        </field>
    </record>

    <record id="action_spp_event_data_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_spp_event_data_tree" />
        <field name="act_window_id" ref="action_spp_event_data" />
    </record>

    <record id="action_spp_event_data_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_spp_event_data_form" />
        <field name="act_window_id" ref="action_spp_event_data" />
    </record>


</odoo>
