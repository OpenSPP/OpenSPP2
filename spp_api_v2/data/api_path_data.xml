<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- API Path Configurations -->

    <!-- Individual Resource Path -->
    <record id="api_path_individual" model="spp.api.path">
        <field name="sequence">10</field>
        <field name="name">Individual</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field
            name="description"
        >Individual registrants in the social protection registry</field>
        <field name="allow_custom_filters">False</field>
        <field name="max_filter_complexity">10</field>
        <field
            name="filter_domain"
        >[('is_registrant', '=', True), ('is_group', '=', False)]</field>
    </record>

    <!-- Group Resource Path -->
    <record id="api_path_group" model="spp.api.path">
        <field name="sequence">20</field>
        <field name="name">Group</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field
            name="description"
        >Group registrants (households, families) in the social protection registry</field>
        <field name="allow_custom_filters">False</field>
        <field name="max_filter_complexity">10</field>
        <field
            name="filter_domain"
        >[('is_registrant', '=', True), ('is_group', '=', True)]</field>
    </record>
</odoo>
