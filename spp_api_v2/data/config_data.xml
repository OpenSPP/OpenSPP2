<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
        <!-- JWT Secret Configuration:
             The JWT secret is automatically generated by the post_init_hook
             when the module is installed. This ensures a cryptographically
             secure random value is used by default.

             To override, set via System Parameters:
             Key: spp_api_v2.jwt_secret
             Value: <your-secure-random-value>

             Generate a custom secret with:
             python -c "import secrets; print(secrets.token_urlsafe(64))"
        -->

        <!-- Default token expiration in seconds (1 hour) -->
        <record id="config_token_expiration" model="ir.config_parameter">
            <field name="key">spp_api_v2.token_expiration</field>
            <field name="value">3600</field>
        </record>

        <!-- Default rate limit per minute -->
        <record id="config_rate_limit_minute" model="ir.config_parameter">
            <field name="key">spp_api_v2.rate_limit_per_minute</field>
            <field name="value">60</field>
        </record>

        <!-- Default rate limit per day -->
        <record id="config_rate_limit_day" model="ir.config_parameter">
            <field name="key">spp_api_v2.rate_limit_per_day</field>
            <field name="value">10000</field>
        </record>
</odoo>
