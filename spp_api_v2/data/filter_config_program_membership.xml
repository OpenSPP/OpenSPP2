<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <!-- ProgramMembership Filters -->

        <!-- State filter: in list -->
        <record id="filter_membership_state" model="spp.api.path.filter">
            <field name="sequence">10</field>
            <field name="path_id" ref="api_path_program_membership" />
            <field name="name">state</field>
            <field name="field_path">state</field>
            <field name="filter_type">in</field>
            <field name="label">Status</field>
            <field name="description">Filter by membership status (draft, enrolled, paused, exited, duplicated)</field>
            <field name="allowed_operators">in</field>
            <field name="max_values">10</field>
            <field name="is_indexed">True</field>
        </record>

        <!-- Program filter: exact match (nested field) -->
        <record id="filter_membership_program" model="spp.api.path.filter">
            <field name="sequence">20</field>
            <field name="path_id" ref="api_path_program_membership" />
            <field name="name">program_id</field>
            <field name="field_path">program_id</field>
            <field name="filter_type">exact</field>
            <field name="label">Program</field>
            <field name="description">Filter by program ID</field>
            <field name="allowed_operators">eq</field>
            <field name="is_indexed">True</field>
        </record>

        <!-- Partner/Beneficiary filter: exact match -->
        <record id="filter_membership_partner" model="spp.api.path.filter">
            <field name="sequence">30</field>
            <field name="path_id" ref="api_path_program_membership" />
            <field name="name">partner_id</field>
            <field name="field_path">partner_id</field>
            <field name="filter_type">exact</field>
            <field name="label">Beneficiary</field>
            <field name="description">Filter by beneficiary (partner) ID</field>
            <field name="allowed_operators">eq</field>
            <field name="is_indexed">True</field>
        </record>

        <!-- Enrollment Date filter: range -->
        <record id="filter_membership_enrollment_date" model="spp.api.path.filter">
            <field name="sequence">40</field>
            <field name="path_id" ref="api_path_program_membership" />
            <field name="name">enrollment_date</field>
            <field name="field_path">enrollment_date</field>
            <field name="filter_type">range</field>
            <field name="label">Enrollment Date</field>
            <field name="description">Filter by enrollment date</field>
            <field name="allowed_operators">eq,gt,gte,lt,lte</field>
            <field name="is_indexed">True</field>
        </record>

        <!-- Exit Date filter: range -->
        <record id="filter_membership_exit_date" model="spp.api.path.filter">
            <field name="sequence">50</field>
            <field name="path_id" ref="api_path_program_membership" />
            <field name="name">exit_date</field>
            <field name="field_path">exit_date</field>
            <field name="filter_type">range</field>
            <field name="label">Exit Date</field>
            <field name="description">Filter by exit date</field>
            <field name="allowed_operators">eq,gt,gte,lt,lte</field>
        </record>

        <!-- Exit Date null check filter -->
        <record id="filter_membership_exit_date_null" model="spp.api.path.filter">
            <field name="sequence">51</field>
            <field name="path_id" ref="api_path_program_membership" />
            <field name="name">has_exited</field>
            <field name="field_path">exit_date</field>
            <field name="filter_type">null</field>
            <field name="label">Has Exited</field>
            <field name="description">Filter by whether membership has exit date (true = no exit date / still active)</field>
            <field name="allowed_operators">null</field>
        </record>

        <!-- Last Updated filter: range -->
        <record id="filter_membership_write_date" model="spp.api.path.filter">
            <field name="sequence">60</field>
            <field name="path_id" ref="api_path_program_membership" />
            <field name="name">write_date</field>
            <field name="field_path">write_date</field>
            <field name="filter_type">range</field>
            <field name="label">Last Updated</field>
            <field name="description">Filter by last modification date</field>
            <field name="allowed_operators">gt,gte,lt,lte</field>
            <field name="is_indexed">True</field>
        </record>

        <!-- Create Date filter: range -->
        <record id="filter_membership_create_date" model="spp.api.path.filter">
            <field name="sequence">70</field>
            <field name="path_id" ref="api_path_program_membership" />
            <field name="name">create_date</field>
            <field name="field_path">create_date</field>
            <field name="filter_type">range</field>
            <field name="label">Created Date</field>
            <field name="description">Filter by creation date</field>
            <field name="allowed_operators">gt,gte,lt,lte</field>
            <field name="is_indexed">True</field>
        </record>

        <!-- Filter Presets for ProgramMembership -->

        <!-- Active Members Preset -->
        <record id="preset_active_members" model="spp.api.filter.preset">
            <field name="name">active_members</field>
            <field name="path_id" ref="api_path_program_membership" />
            <field name="description">Members with enrolled or active status (not exited)</field>
            <field name="is_public">True</field>
            <field name="filter_json">[
    {"field": "state", "operator": "in", "value": ["enrolled", "paused"]}
]</field>
        </record>

        <!-- Recently Enrolled Preset -->
        <record id="preset_recently_enrolled" model="spp.api.filter.preset">
            <field name="name">recently_enrolled</field>
            <field name="path_id" ref="api_path_program_membership" />
            <field name="description">Members enrolled in the last 30 days</field>
            <field name="is_public">True</field>
            <field name="filter_json">[
    {"field": "state", "operator": "eq", "value": "enrolled"}
]</field>
        </record>

    </data>
</odoo>
