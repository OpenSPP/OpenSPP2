<?xml version="1.0" encoding="UTF-8" ?>
<!--
   Part of OpenSPP. See LICENSE file for full copyright and licensing details.
   Hide system_id entries from Identity Documents UI — they are internal
   identifiers used only for API addressability.
-->
<odoo>
    <!-- Hide system_id rows from both individual and group identity documents -->
    <record id="view_res_partner_form_hide_system_id" model="ir.ui.view">
        <field name="name">res.partner.form.hide.system.id</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_individuals_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='ids_section']/field[@name='reg_ids']"
                position="attributes"
            >
                <attribute
                    name="domain"
                >[('id_type_id.code', '!=', 'system_id')]</attribute>
            </xpath>
            <xpath
                expr="//group[@name='group_ids_section']/field[@name='reg_ids']"
                position="attributes"
            >
                <attribute
                    name="domain"
                >[('id_type_id.code', '!=', 'system_id')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
