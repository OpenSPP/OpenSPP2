<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- API Extension Tree View -->
    <record id="view_api_extension_tree" model="ir.ui.view">
        <field name="name">spp.api.extension.tree</field>
        <field name="model">spp.api.extension</field>
        <field name="arch" type="xml">
            <list string="API Extensions">
                <field name="name" />
                <field name="url" />
                <field name="module_id" />
                <field name="applies_to" />
                <field name="active" />
            </list>
        </field>
    </record>

    <!-- API Extension Form View -->
    <record id="view_api_extension_form" model="ir.ui.view">
        <field name="name">spp.api.extension.form</field>
        <field name="model">spp.api.extension</field>
        <field name="arch" type="xml">
            <form string="API Extension">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group name="basic">
                            <field name="name" />
                            <field name="url" />
                            <field name="module_id" />
                            <field name="applies_to" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page name="fields" string="Fields">
                            <field name="field_ids">
                                <list>
                                    <field name="name" />
                                    <field name="field_description" />
                                    <field name="ttype" />
                                    <field name="model_id" />
                                </list>
                            </field>
                        </page>
                        <page name="schema" string="JSON Schema">
                            <field
                                name="schema_json"
                                widget="ace"
                                options="{'mode': 'javascript'}"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- API Extension Action -->
    <record id="action_api_extension" model="ir.actions.act_window">
        <field name="name">API Extensions</field>
        <field name="res_model">spp.api.extension</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                    No API Extensions Registered
                </p>
            <p>
                    API extensions are registered by domain modules (e.g., spp_farmer_registry)
                    to expose their custom fields via the API V2 interface.
                </p>
            <p>
                    Extensions are typically registered automatically via post_init_hook
                    when a module is installed.
                </p>
        </field>
    </record>
</odoo>
