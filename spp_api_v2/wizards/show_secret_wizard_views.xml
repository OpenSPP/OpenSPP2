<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Show Secret Wizard Form View -->
        <record id="view_show_secret_wizard_form" model="ir.ui.view">
            <field name="name">spp.api.client.show.secret.wizard.form</field>
            <field name="model">spp.api.client.show.secret.wizard</field>
            <field name="arch" type="xml">
                <form string="API Client Credentials">
                    <div class="alert alert-warning" role="alert">
                        <strong>Important:</strong> Copy the Client Secret now. It will not be shown again after you close this dialog.
                    </div>
                    <group>
                        <field name="client_name" />
                        <field name="oauth_client_id" widget="CopyClipboardChar" />
                        <field name="client_secret" widget="CopyClipboardChar" />
                    </group>
                    <footer>
                        <button string="I've Copied the Secret" type="object" name="action_close" class="btn-primary" />
                        <button string="Cancel" class="btn-secondary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action for the wizard -->
        <record id="action_show_secret_wizard" model="ir.actions.act_window">
            <field name="name">API Client Credentials</field>
            <field name="res_model">spp.api.client.show.secret.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
