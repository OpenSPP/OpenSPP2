#. module: spp_api_v2
#: model:res.groups,comment:spp_api_v2.group_api_v2_manager
msgid ""
"\n"
"                Full control over API V2 configuration.\n"
"                Managers can create/modify API clients, manage scopes, and configure access.\n"
"            "
msgstr ""

#. module: spp_api_v2
#: model:res.groups,comment:spp_api_v2.group_api_v2_create
msgid ""
"\n"
"                Technical privilege for creating API V2 records.\n"
"                Users with this group can create new API clients and scopes.\n"
"            "
msgstr ""

#. module: spp_api_v2
#: model:res.groups,comment:spp_api_v2.group_api_v2_read
msgid ""
"\n"
"                Technical privilege for reading API V2 data.\n"
"                Users with this group can read API clients, scopes, and consent records.\n"
"            "
msgstr ""

#. module: spp_api_v2
#: model:res.groups,comment:spp_api_v2.group_api_v2_write
msgid ""
"\n"
"                Technical privilege for writing API V2 data.\n"
"                Users with this group can modify API clients, scopes, and consent records.\n"
"            "
msgstr ""

#. module: spp_api_v2
#: model:res.groups,comment:spp_api_v2.group_api_v2_viewer
msgid ""
"\n"
"                Users can view API V2 clients, scopes, and consent records.\n"
"                This is a read-only role for monitoring and auditing API access.\n"
"            "
msgstr ""

#. module: spp_api_v2
#: model:res.groups,comment:spp_api_v2.group_api_v2_officer
msgid ""
"\n"
"                Users can view and manage consent records.\n"
"                Officers can grant/revoke consent but cannot modify API clients.\n"
"            "
msgstr ""

