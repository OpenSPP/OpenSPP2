#. module: spp_api_v2
#: model:res.groups,comment:spp_api_v2.group_api_v2_manager
msgid ""
"\n"
"                Full control over API V2 configuration.\n"
"                Managers can create/modify API clients, manage scopes, and "
"configure access.\n"
"            "
msgstr ""
"\\n                Contrôle complet de la configuration de l'API V2."
"\\n                Les gestionnaires peuvent créer/modifier des clients API, "
"gérer les portées et configurer les accès.\\n            "

#. module: spp_api_v2
#: model:res.groups,comment:spp_api_v2.group_api_v2_create
msgid ""
"\n"
"                Technical privilege for creating API V2 records.\n"
"                Users with this group can create new API clients and "
"scopes.\n"
"            "
msgstr ""
"\\n                Privilège technique pour créer des enregistrements API V2."
"\\n                Les utilisateurs de ce groupe peuvent créer de nouveaux "
"clients API et des portées.\\n            "

#. module: spp_api_v2
#: model:res.groups,comment:spp_api_v2.group_api_v2_read
msgid ""
"\n"
"                Technical privilege for reading API V2 data.\n"
"                Users with this group can read API clients, scopes, and "
"consent records.\n"
"            "
msgstr ""
"\\n                Privilège technique pour lire les données API V2."
"\\n                Les utilisateurs de ce groupe peuvent consulter les "
"clients API, les portées et les enregistrements de consentement."
"\\n            "

#. module: spp_api_v2
#: model:res.groups,comment:spp_api_v2.group_api_v2_write
msgid ""
"\n"
"                Technical privilege for writing API V2 data.\n"
"                Users with this group can modify API clients, scopes, and "
"consent records.\n"
"            "
msgstr ""
"\\n                Privilège technique pour modifier les données API V2."
"\\n                Les utilisateurs de ce groupe peuvent modifier les "
"clients API, les portées et les enregistrements de consentement."
"\\n            "

#. module: spp_api_v2
#: model:res.groups,comment:spp_api_v2.group_api_v2_viewer
msgid ""
"\n"
"                Users can view API V2 clients, scopes, and consent records.\n"
"                This is a read-only role for monitoring and auditing API "
"access.\n"
"            "
msgstr ""
"\\n                Les utilisateurs peuvent consulter les clients API V2, "
"les portées et les enregistrements de consentement.\\n                Ce "
"rôle est en lecture seule pour le suivi et l'audit des accès à l'API."
"\\n            "

#. module: spp_api_v2
#: model:res.groups,comment:spp_api_v2.group_api_v2_officer
msgid ""
"\n"
"                Users can view and manage consent records.\n"
"                Officers can grant/revoke consent but cannot modify API "
"clients.\n"
"            "
msgstr ""
"\\n                Les utilisateurs peuvent consulter et gérer les "
"enregistrements de consentement.\\n                Les agents peuvent "
"accorder/révoquer les consentements mais ne peuvent pas modifier les clients "
"API.\\n            "

