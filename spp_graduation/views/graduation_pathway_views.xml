<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Graduation Pathway Search View -->
    <record id="view_graduation_pathway_search" model="ir.ui.view">
        <field name="name">spp.graduation.pathway.search</field>
        <field name="model">spp.graduation.pathway</field>
        <field name="arch" type="xml">
            <search string="Graduation Pathways">
                <field name="name" />
                <field name="code" />
                <separator />
                <filter
                    string="Positive Exit"
                    name="positive_exit"
                    domain="[('is_positive_exit', '=', True)]"
                />
                <filter
                    string="Negative Exit"
                    name="negative_exit"
                    domain="[('is_positive_exit', '=', False)]"
                />
                <separator />
                <filter
                    string="Archived"
                    name="archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <!-- Graduation Pathway List View -->
    <record id="view_graduation_pathway_tree" model="ir.ui.view">
        <field name="name">spp.graduation.pathway.list</field>
        <field name="model">spp.graduation.pathway</field>
        <field name="arch" type="xml">
            <list string="Graduation Pathways">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" optional="show" />
                <field name="is_positive_exit" />
                <field name="criteria_count" string="Criteria" />
                <field name="is_assessment_required" optional="show" />
                <field name="is_approval_required" optional="show" />
                <field name="post_graduation_monitoring_months" optional="show" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <!-- Graduation Pathway Form View -->
    <record id="view_graduation_pathway_form" model="ir.ui.view">
        <field name="name">spp.graduation.pathway.form</field>
        <field name="model">spp.graduation.pathway</field>
        <field name="arch" type="xml">
            <form string="Graduation Pathway">
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Pathway name..." />
                        </h1>
                    </div>
                    <group col="2">
                        <group name="main_info">
                            <field name="code" />
                            <field name="sequence" />
                            <field name="active" invisible="1" />
                        </group>
                        <group name="settings">
                            <field name="is_positive_exit" widget="boolean_toggle" />
                            <field
                                name="is_assessment_required"
                                widget="boolean_toggle"
                            />
                            <field
                                name="is_approval_required"
                                widget="boolean_toggle"
                            />
                            <field name="post_graduation_monitoring_months" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <group name="description_section" string="Description" col="2">
                        <field
                            name="description"
                            nolabel="1"
                            colspan="2"
                            placeholder="Describe the graduation pathway..."
                        />
                    </group>
                    <notebook>
                        <page string="Criteria" name="criteria">
                            <field name="criteria_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="code" optional="show" />
                                    <field name="assessment_method" />
                                    <field name="weight" />
                                    <field name="is_required" />
                                    <field name="description" optional="hide" />
                                    <field name="active" widget="boolean_toggle" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Graduation Pathway Action -->
    <record id="action_graduation_pathway" model="ir.actions.act_window">
        <field name="name">Graduation Pathways</field>
        <field name="res_model">spp.graduation.pathway</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Graduation Pathway
            </p>
            <p>
                Define pathways for beneficiary graduation from programs.
            </p>
        </field>
    </record>
</odoo>
