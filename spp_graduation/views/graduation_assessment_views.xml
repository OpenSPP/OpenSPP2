<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Criteria Response Form View (popup for evidence attachments) -->
    <record id="view_graduation_criteria_response_form" model="ir.ui.view">
        <field name="name">spp.graduation.criteria.response.form</field>
        <field name="model">spp.graduation.criteria.response</field>
        <field name="arch" type="xml">
            <form string="Criteria Response">
                <group col="2">
                    <group name="response_main">
                        <field name="criteria_id" readonly="1" />
                        <field name="score" />
                        <field name="is_met" widget="boolean_toggle" />
                        <field name="value" />
                    </group>
                    <group name="response_detail">
                        <field name="notes" />
                    </group>
                </group>
                <group name="evidence_section" string="Evidence">
                    <field
                        name="evidence_attachment_ids"
                        widget="many2many_binary"
                        nolabel="1"
                        colspan="2"
                    />
                </group>
            </form>
        </field>
    </record>

    <!-- Graduation Assessment List View -->
    <record id="view_graduation_assessment_tree" model="ir.ui.view">
        <field name="name">spp.graduation.assessment.list</field>
        <field name="model">spp.graduation.assessment</field>
        <field name="arch" type="xml">
            <list
                string="Graduation Assessments"
                decoration-muted="state == 'draft'"
                decoration-warning="state == 'submitted'"
                decoration-success="state == 'approved'"
                decoration-danger="state == 'rejected'"
            >
                <field name="name" />
                <field name="partner_id" />
                <field name="pathway_id" />
                <field name="assessment_date" />
                <field
                    name="assessor_id"
                    widget="many2one_avatar_user"
                    optional="show"
                />
                <field name="readiness_score" widget="percentage" optional="show" />
                <field name="is_required_criteria_met" optional="show" />
                <field name="recommendation" optional="show" />
                <field
                    name="state"
                    widget="badge"
                    decoration-muted="state == 'draft'"
                    decoration-warning="state == 'submitted'"
                    decoration-success="state == 'approved'"
                    decoration-danger="state == 'rejected'"
                />
            </list>
        </field>
    </record>

    <!-- Graduation Assessment Kanban View -->
    <record id="view_graduation_assessment_kanban" model="ir.ui.view">
        <field name="name">spp.graduation.assessment.kanban</field>
        <field name="model">spp.graduation.assessment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <progressbar
                    field="state"
                    colors='{"draft": "secondary", "submitted": "warning",
                                     "approved": "success", "rejected": "danger"}'
                />
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="partner_id" />
                                    </strong>
                                </div>
                                <field
                                    name="state"
                                    widget="label_selection"
                                    options="{'classes': {'draft': 'secondary', 'submitted': 'warning',
                                                            'approved': 'success', 'rejected': 'danger'}}"
                                />
                            </div>
                            <div>
                                <field name="pathway_id" />
                            </div>
                            <div>
                                <i class="fa fa-calendar me-1" title="Date" />
                                <field name="assessment_date" />
                            </div>
                            <div>
                                <strong>Score: </strong>
                                <field name="readiness_score" widget="percentage" />
                            </div>
                            <div t-if="record.recommendation.raw_value">
                                <field
                                    name="recommendation"
                                    widget="badge"
                                    decoration-success="recommendation == 'graduate'"
                                    decoration-warning="recommendation == 'extend'"
                                    decoration-danger="recommendation == 'exit'"
                                    decoration-info="recommendation == 'defer'"
                                />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Graduation Assessment Form View -->
    <record id="view_graduation_assessment_form" model="ir.ui.view">
        <field name="name">spp.graduation.assessment.form</field>
        <field name="model">spp.graduation.assessment</field>
        <field name="arch" type="xml">
            <form string="Graduation Assessment">
                <header>
                    <button
                        name="action_submit"
                        string="Submit"
                        type="object"
                        invisible="state != 'draft'"
                        class="oe_highlight"
                    />
                    <button
                        name="action_approve"
                        string="Approve"
                        type="object"
                        invisible="state != 'submitted'"
                        class="oe_highlight"
                        groups="spp_graduation.group_spp_graduation_manager"
                    />
                    <button
                        name="action_reject"
                        string="Reject"
                        type="object"
                        invisible="state != 'submitted'"
                        groups="spp_graduation.group_spp_graduation_manager"
                    />
                    <button
                        name="action_reset_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="state not in ('submitted', 'rejected')"
                        groups="spp_graduation.group_spp_graduation_manager"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,submitted,approved"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" />

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>

                    <!-- Alert banners -->
                    <div
                        class="alert alert-warning mb-3"
                        invisible="state != 'submitted'"
                        role="alert"
                    >
                        <i class="fa fa-clock-o me-2" title="Pending" />
                        <strong>Pending Review</strong>
                        <p
                            class="mb-0"
                        >This assessment is awaiting manager approval.</p>
                    </div>
                    <div
                        class="alert alert-danger mb-3"
                        invisible="state != 'rejected'"
                        role="alert"
                    >
                        <i class="fa fa-times me-2" title="Rejected" />
                        <strong>Rejected</strong>
                        <p
                            class="mb-0"
                        >This assessment was rejected. Review and reset to draft to resubmit.</p>
                    </div>

                    <notebook>
                        <!-- Tab 1: Overview -->
                        <page name="overview" string="Overview">
                            <group col="2">
                                <group name="main_info">
                                    <field
                                        name="partner_id"
                                        readonly="state in ('approved', 'rejected')"
                                    />
                                    <field
                                        name="pathway_id"
                                        readonly="state in ('approved', 'rejected')"
                                    />
                                    <field
                                        name="assessment_date"
                                        readonly="state in ('approved', 'rejected')"
                                    />
                                    <field
                                        name="assessor_id"
                                        widget="many2one_avatar_user"
                                        readonly="state in ('approved', 'rejected')"
                                    />
                                </group>
                                <group name="status_info">
                                    <field name="readiness_score" widget="percentage" />
                                    <field
                                        name="is_required_criteria_met"
                                        widget="boolean_toggle"
                                        readonly="1"
                                    />
                                    <field name="graduation_date" readonly="1" />
                                    <field name="monitoring_end_date" readonly="1" />
                                    <field
                                        name="approved_by_id"
                                        readonly="1"
                                        invisible="state != 'approved'"
                                    />
                                    <field
                                        name="approved_date"
                                        readonly="1"
                                        invisible="state != 'approved'"
                                    />
                                    <field
                                        name="company_id"
                                        groups="base.group_multi_company"
                                    />
                                </group>
                            </group>
                        </page>

                        <!-- Tab 2: Criteria Responses -->
                        <page string="Criteria Responses" name="responses">
                            <field
                                name="response_ids"
                                readonly="state in ('approved', 'rejected')"
                            >
                                <list editable="bottom">
                                    <field name="criteria_id" />
                                    <field name="score" />
                                    <field name="is_met" widget="boolean_toggle" />
                                    <field name="value" />
                                    <field name="notes" />
                                    <field
                                        name="evidence_attachment_ids"
                                        widget="many2many_binary"
                                    />
                                </list>
                                <form>
                                    <group col="2">
                                        <group name="response_main">
                                            <field name="criteria_id" readonly="1" />
                                            <field name="score" />
                                            <field
                                                name="is_met"
                                                widget="boolean_toggle"
                                            />
                                            <field name="value" />
                                        </group>
                                        <group name="response_detail">
                                            <field name="notes" />
                                        </group>
                                    </group>
                                    <group name="evidence_section" string="Evidence">
                                        <field
                                            name="evidence_attachment_ids"
                                            widget="many2many_binary"
                                            nolabel="1"
                                            colspan="2"
                                        />
                                    </group>
                                </form>
                            </field>
                        </page>

                        <!-- Tab 3: Recommendation -->
                        <page string="Recommendation" name="recommendation">
                            <group col="2">
                                <group name="recommendation_info">
                                    <field
                                        name="recommendation"
                                        readonly="state in ('approved', 'rejected')"
                                    />
                                </group>
                                <group name="recommendation_extra" />
                            </group>
                            <group name="recommendation_notes_section">
                                <field
                                    name="recommendation_notes"
                                    nolabel="1"
                                    colspan="2"
                                    placeholder="Enter detailed recommendation notes..."
                                    readonly="state in ('approved', 'rejected')"
                                />
                            </group>
                        </page>

                        <!-- Tab 4: History -->
                        <page
                            name="history"
                            string="History"
                            groups="base.group_no_one"
                        >
                            <group name="metadata">
                                <field name="create_uid" readonly="1" />
                                <field name="create_date" readonly="1" />
                                <field name="write_uid" readonly="1" />
                                <field name="write_date" readonly="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Graduation Assessment Search View -->
    <record id="view_graduation_assessment_search" model="ir.ui.view">
        <field name="name">spp.graduation.assessment.search</field>
        <field name="model">spp.graduation.assessment</field>
        <field name="arch" type="xml">
            <search string="Graduation Assessments">
                <field name="name" />
                <field name="partner_id" />
                <field name="pathway_id" />
                <field name="assessor_id" />
                <separator />
                <filter
                    string="My Assessments"
                    name="my_assessments"
                    domain="[('assessor_id', '=', uid)]"
                />
                <separator />
                <filter
                    string="Draft"
                    name="draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    string="Submitted"
                    name="submitted"
                    domain="[('state', '=', 'submitted')]"
                />
                <filter
                    string="Approved"
                    name="approved"
                    domain="[('state', '=', 'approved')]"
                />
                <filter
                    string="Rejected"
                    name="rejected"
                    domain="[('state', '=', 'rejected')]"
                />
                <separator />
                <filter
                    string="Ready to Graduate"
                    name="graduate"
                    domain="[('recommendation', '=', 'graduate')]"
                />
                <separator />
                <filter
                    string="Assessment Date"
                    name="assessment_date"
                    date="assessment_date"
                />
                <group>
                    <filter
                        string="Pathway"
                        name="group_pathway"
                        context="{'group_by': 'pathway_id'}"
                    />
                    <filter
                        string="Assessor"
                        name="group_assessor"
                        context="{'group_by': 'assessor_id'}"
                    />
                    <filter
                        string="State"
                        name="group_state"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        string="Recommendation"
                        name="group_recommendation"
                        context="{'group_by': 'recommendation'}"
                    />
                    <filter
                        string="Assessment Date"
                        name="group_assessment_date"
                        context="{'group_by': 'assessment_date'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Graduation Assessment Graph View -->
    <record id="view_graduation_assessment_graph" model="ir.ui.view">
        <field name="name">spp.graduation.assessment.graph</field>
        <field name="model">spp.graduation.assessment</field>
        <field name="arch" type="xml">
            <graph string="Graduation Assessments" type="bar">
                <field name="pathway_id" />
                <field name="state" />
            </graph>
        </field>
    </record>

    <!-- Graduation Assessment Pivot View -->
    <record id="view_graduation_assessment_pivot" model="ir.ui.view">
        <field name="name">spp.graduation.assessment.pivot</field>
        <field name="model">spp.graduation.assessment</field>
        <field name="arch" type="xml">
            <pivot string="Graduation Assessments">
                <field name="pathway_id" type="row" />
                <field name="state" type="col" />
                <field name="readiness_score" type="measure" />
            </pivot>
        </field>
    </record>

    <!-- Graduation Assessment Action -->
    <record id="action_graduation_assessment" model="ir.actions.act_window">
        <field name="name">Graduation Assessments</field>
        <field name="res_model">spp.graduation.assessment</field>
        <field name="view_mode">list,kanban,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Graduation Assessment
            </p>
            <p>
                Assess beneficiaries for graduation readiness.
            </p>
        </field>
    </record>

    <!-- My Assessments Action -->
    <record id="action_graduation_assessment_my" model="ir.actions.act_window">
        <field name="name">My Assessments</field>
        <field name="res_model">spp.graduation.assessment</field>
        <field name="view_mode">list,kanban,form,graph,pivot</field>
        <field name="context">{'search_default_my_assessments': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Graduation Assessment
            </p>
            <p>
                View and manage your graduation assessments.
            </p>
        </field>
    </record>
</odoo>
