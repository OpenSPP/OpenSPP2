<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Graduation Assessment Tree View -->
    <record id="view_graduation_assessment_tree" model="ir.ui.view">
        <field name="name">spp.graduation.assessment.tree</field>
        <field name="model">spp.graduation.assessment</field>
        <field name="arch" type="xml">
            <list string="Graduation Assessments">
                <field name="name" />
                <field name="partner_id" />
                <field name="pathway_id" />
                <field name="assessment_date" />
                <field name="assessor_id" />
                <field name="readiness_score" />
                <field name="is_required_criteria_met" />
                <field name="recommendation" />
                <field name="state" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" widget="badge" />
            </list>
        </field>
    </record>

    <!-- Graduation Assessment Kanban View -->
    <record id="view_graduation_assessment_kanban" model="ir.ui.view">
        <field name="name">spp.graduation.assessment.kanban</field>
        <field name="model">spp.graduation.assessment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="partner_id" />
                <field name="pathway_id" />
                <field name="assessment_date" />
                <field name="readiness_score" />
                <field name="state" />
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="partner_id" />
                                    </strong>
                                </div>
                            </div>
                            <div>
                                <field name="pathway_id" />
                            </div>
                            <div>
                                <i class="fa fa-calendar" />
                                <t t-out="record.assessment_date.value" />
                            </div>
                            <div>
                                <strong>Score:</strong>
                                <t t-out="record.readiness_score.value" />%
                            </div>
                            <div>
                                <field name="recommendation" widget="badge" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Graduation Assessment Form View -->
    <record id="view_graduation_assessment_form" model="ir.ui.view">
        <field name="name">spp.graduation.assessment.form</field>
        <field name="model">spp.graduation.assessment</field>
        <field name="arch" type="xml">
            <form string="Graduation Assessment">
                <header>
                    <button name="action_submit" string="Submit" type="object" invisible="state != 'draft'" class="oe_highlight" />
                    <button name="action_approve" string="Approve" type="object" invisible="state != 'submitted'" class="oe_highlight" groups="spp_graduation.group_spp_graduation_manager" />
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'" groups="spp_graduation.group_spp_graduation_manager" />
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state in ('draft', 'approved')" groups="spp_graduation.group_spp_graduation_manager" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state in ('approved', 'rejected')" />
                            <field name="pathway_id" readonly="state in ('approved', 'rejected')" />
                            <field name="assessment_date" readonly="state in ('approved', 'rejected')" />
                            <field name="assessor_id" readonly="state in ('approved', 'rejected')" />
                        </group>
                        <group>
                            <field name="readiness_score" widget="percentage" />
                            <field name="is_required_criteria_met" />
                            <field name="recommendation" readonly="state in ('approved', 'rejected')" />
                            <field name="graduation_date" readonly="1" />
                            <field name="monitoring_end_date" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                    </group>
                    <group invisible="state != 'approved'">
                        <group>
                            <field name="approved_by_id" readonly="1" />
                            <field name="approved_date" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Criteria Responses" name="responses">
                            <field name="response_ids" readonly="state in ('approved', 'rejected')">
                                <list editable="bottom">
                                    <field name="criteria_id" />
                                    <field name="score" />
                                    <field name="is_met" />
                                    <field name="value" />
                                    <field name="notes" />
                                </list>
                            </field>
                        </page>
                        <page string="Recommendation" name="recommendation">
                            <group col="2">
                                <field
                                    name="recommendation_notes"
                                    nolabel="1"
                                    colspan="2"
                                    placeholder="Enter detailed recommendation notes..."
                                    readonly="state in ('approved', 'rejected')"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Graduation Assessment Search View -->
    <record id="view_graduation_assessment_search" model="ir.ui.view">
        <field name="name">spp.graduation.assessment.search</field>
        <field name="model">spp.graduation.assessment</field>
        <field name="arch" type="xml">
            <search string="Graduation Assessments">
                <field name="name" />
                <field name="partner_id" />
                <field name="pathway_id" />
                <field name="assessor_id" />
                <filter string="My Assessments" name="my_assessments" domain="[('assessor_id', '=', uid)]" />
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]" />
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]" />
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]" />
                <filter string="Ready to Graduate" name="graduate" domain="[('recommendation', '=', 'graduate')]" />
                <separator />
                <filter string="Assessment Date" name="assessment_date" date="assessment_date" />
                <group>
                    <filter string="Pathway" name="group_pathway" context="{'group_by': 'pathway_id'}" />
                    <filter string="Assessor" name="group_assessor" context="{'group_by': 'assessor_id'}" />
                    <filter string="State" name="group_state" context="{'group_by': 'state'}" />
                    <filter string="Recommendation" name="group_recommendation" context="{'group_by': 'recommendation'}" />
                    <filter string="Assessment Date" name="group_assessment_date" context="{'group_by': 'assessment_date'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Graduation Assessment Action -->
    <record id="action_graduation_assessment" model="ir.actions.act_window">
        <field name="name">Graduation Assessments</field>
        <field name="res_model">spp.graduation.assessment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Graduation Assessment
            </p>
            <p>
                Assess beneficiaries for graduation readiness.
            </p>
        </field>
    </record>

    <!-- My Assessments Action -->
    <record id="action_graduation_assessment_my" model="ir.actions.act_window">
        <field name="name">My Assessments</field>
        <field name="res_model">spp.graduation.assessment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_my_assessments': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Graduation Assessment
            </p>
            <p>
                View and manage your graduation assessments.
            </p>
        </field>
    </record>
</odoo>
