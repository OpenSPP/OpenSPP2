<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Company Isolation Rules -->
    <record id="rule_spp_graduation_pathway_company" model="ir.rule">
        <field name="name">Graduation Pathway: Multi-Company Access</field>
        <field name="model_id" ref="model_spp_graduation_pathway" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global">True</field>
    </record>

    <record id="rule_spp_graduation_assessment_company" model="ir.rule">
        <field name="name">Graduation Assessment: Multi-Company Access</field>
        <field name="model_id" ref="model_spp_graduation_assessment" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global">True</field>
    </record>

    <!-- Assessment Rules -->
    <record id="rule_spp_graduation_assessment_user" model="ir.rule">
        <field name="name">Graduation Assessment: User - Own</field>
        <field name="model_id" ref="model_spp_graduation_assessment" />
        <field name="domain_force">[('assessor_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_spp_graduation_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="rule_spp_graduation_assessment_manager" model="ir.rule">
        <field name="name">Graduation Assessment: Manager - All</field>
        <field name="model_id" ref="model_spp_graduation_assessment" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('group_spp_graduation_manager'))]"
        />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <!-- Criteria Response Rules -->
    <record id="rule_spp_graduation_criteria_response_user" model="ir.rule">
        <field name="name">Graduation Criteria Response: User - Own</field>
        <field name="model_id" ref="model_spp_graduation_criteria_response" />
        <field name="domain_force">[('assessment_id.assessor_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_spp_graduation_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <record id="rule_spp_graduation_criteria_response_manager" model="ir.rule">
        <field name="name">Graduation Criteria Response: Manager - All</field>
        <field name="model_id" ref="model_spp_graduation_criteria_response" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('group_spp_graduation_manager'))]"
        />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
</odoo>
